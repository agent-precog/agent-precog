@CONFERENCE{Wang2025,
	author = {Wang, Weishuo},
	title = {Research and Application of Machine Vision Algorithm Based on Deep Learning Feature Extraction, Edge Computing Optimization and Rapid Reconstruction in Flexible Assembly Precision Control and Reconfigurable Flexible Assembly},
