@ARTICLE{Ahmed2026,
	author = {Ahmed, Mukhtar and Chen, Jinfu and Akpaku, Ernest and Latif, Ajmal},
	title = {Hardware-Aware Graph Neural Networks for Energy-Efficient Malicious Traffic Detection on Edge Devices},
	year = {2026},
	journal = {IEEE Transactions on Mobile Computing},
	pages = {},
	doi = {10.1109/TMC.2026.3746571},
	url = {https://www.scopus.com/pages/publications/105054766603?origin=resultslist},
	abstract = {The rapid proliferation of mobile, IoT, and edge centric communication infrastructures has intensified the need for intelligent network traffic analysis that can operate directly on resource-constrained edge devices under strict latency, energy, and hardware limitations. Existing graph-based traffic detection approaches primarily focus on improving detection accuracy while often neglecting inference latency, power consumption, and practical deployment constraints on embedded and mobile plat forms. This paper proposes EOGNN, an Edge-Optimized Graph Neural Network framework for efficient malicious network traffic detection on edge devices using hardware-aware neural architecture search and adaptive graph learning. The framework integrates multi-scale graph representation learning, adaptive attention-based message passing, and Pareto-driven architecture exploration to jointly balance detection performance, inference latency, and energy efficiency under realistic edge deployment conditions. Network traffic flows are represented as multi-scale graphs that capture both localized communication behaviors and global interaction patterns, while adaptive edge-aware pruning enables sparse and efficient message propagation with reduced computational overhead. A hardware-aware optimization strategy further adapts graph neural network architectures according to the computational and energy characteristics of the evaluated edge platforms through latency-energy-aware architecture exploration. Comprehensive evaluations on four representative communication-network benchmark datasets demonstrate that EOGNN improves inference efficiency and reduces energy consumption compared to recent graph-based baselines while maintaining high traffic classification performance, achieving up to 98.6% accuracy and an F1-score of 98.4%.  © 2002 IEEE.},
