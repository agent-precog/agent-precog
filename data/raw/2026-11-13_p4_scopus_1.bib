@CONFERENCE{Ye2024359,
	author = {Ye, Xinwang and Chen, Zongju and Deng, Jinwu},
	title = {Recombination Cost Volume Stereo Matching on Edge Devices},
	year = {2024},
	journal = {2024 IEEE 6th International Conference on Power, Intelligent Computing and Systems, ICPICS 2024},
	pages = {359 - 362},
	doi = {10.1109/ICPICS62053.2024.10796764},
	url = {https://www.scopus.com/pages/publications/85216235128?origin=resultslist},
	abstract = {Stereo matching plays an essential role in 3D reconstruction and robot navigation. In recent years, the accuracy of stereo matching has been greatly improved, but it is at the cost of speed. Stereo matching is very vital to obtain real-time inference speed on some small embedding devices. Therefore, we propose RCVNet, which can achieve real-time inference on some small edge devices with relative high accuracy. The construction of the cost volume is constructed by multiplying two 3D volumes to build a 4D recombination cost volume (RCV), which is very lightweight, and has global context features and single-channel full correlation. In order to further obtain detailed features, we construct a multi-scale receptive filed information fusion module (MRF) to enhance the acquisition of local information and global information. Experimental results show that it obtains competitive results on KITTI 2012 and KITTI 2015. RCVNet outperform is better than most lightweight networks and achieves real-time inference on NVIDIA Jetson Nano.  © 2024 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Fang2026511,
	author = {Fang, Xiaotian and Yang, Yahui and Wang, Shuyuan},
	title = {Energy-Efficient Context-Aware Multimodal AI Inference at the Edge},
	year = {2026},
	journal = {2026 6th International Conference on Intelligent Communications and Computing, ICICC 2026},
	pages = {511 - 516},
	doi = {10.1109/ICICC71012.2026.11637959},
	url = {https://www.scopus.com/pages/publications/105048497800?origin=resultslist},
	abstract = {Deploying multimodal artificial intelligence models on resource-constrained edge devices faces inherent bottlenecks in energy consumption and computational latency, as conventional full-modality inference pipelines keep all perception encoders active regardless of task context and environmental conditions, causing substantial power waste and degraded real-time performance. To address this challenge, this work presents an energy-efficient context-aware multimodal edge inference framework featuring a lightweight modality activation sparsity evaluation unit, dynamic computation path scheduling, and a cross-modal speculative skipping mechanism. The framework quantifies the information value of each input modality in real time according to scene context, task complexity, and device power status, and adaptively activates or deactivates corresponding visual, audio, and sensor encoders, while tuning model quantization precision and operator fusion strategies to align with runtime resource budgets. Validated on NVIDIA Jetson Nano and Raspberry Pi 5 edge platforms across VQAv2, MMBench, and multimodal perception benchmarks, the proposed framework delivers a 42.3% reduction in end-to-end energy consumption and a 30%-65% decrease in inference latency against static full-modality baselines, alongside 1. 5 × to 2. 3 × higher throughput with an accuracy loss no more than 1.2%. The runtime context scheduling module introduces less than 9 ms of latency overhead and only 0.32 W of additional power draw, with per-inference energy as low as 0.6 J; for battery-powered mobile edge devices, the framework extends continuous operating duration by over 72% under typical perception workloads. These findings confirm that context-aware adaptive scheduling can dramatically boost the energy efficiency of edge multimodal inference without sacrificing task performance, offering a viable deployment solution for low-power Internet of Things, intelligent surveillance, and human-robot interaction scenarios. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

@CONFERENCE{Anuganti2025270,
	author = {Anuganti, Tharunaditya and Goud, Kalimera Nandu and Sankaran, Sriram},
	title = {AI-Powered Intrusion Detection Systems for IoT Devices with Risk Scoring and Automated Response},
	year = {2025},
	journal = {Proceedings - 2025 IEEE International Symposium on Smart Electronic Systems, iSES 2025},
	pages = {270 - 275},
	doi = {10.1109/iSES67504.2025.00058},
	url = {https://www.scopus.com/pages/publications/105038700165?origin=resultslist},
	abstract = {The proliferation of resource-constrained Internet of Things (IoT) devices has created a vast and vulnerable attack surface. Conventional security solutions, often reliant on cloud-based analytics, are ill-suited for the edge, introducing critical latency between threat detection and response. This paper introduces a holistic, AI-powered framework for edge-native intrusion detection, risk scoring, and automated mitigation on low-power IoT devices. Our approach integrates a lightweight ensemble of Random Forest and XGBoost models with a dynamic, multi-factor risk scoring engine, enabling a tiered, automated response directly on-device. Evaluated on the CICIDS2017 benchmark and validated on Raspberry Pi-class hardware, the system achieves 99.8% detection accuracy with sub-second inference latency. Furthermore, it demonstrates operational robustness by reducing alert fatigue through the filtering of over 60% of benign events while maintaining a low false positive rate. This work validates the viability of deploying autonomous, closed-loop security systems on constrained IoT endpoints, providing a scalable and effective foundation for real-time edge defense.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Surantha2025298,
	author = {Surantha, Nico and Zhang, Hanfei},
	title = {Low-Latency Power Line Component Detection using Quantized YOLO on Edge Devices},
	year = {2025},
	journal = {Proceedings - 2025 IEEE International Conference on Smart Internet of Things, SmartIoT 2025},
	pages = {298 - 303},
	doi = {10.1109/SmartIoT66867.2025.00049},
	url = {https://www.scopus.com/pages/publications/105032177906?origin=resultslist},
	abstract = {Regular inspection of power line systems is crucial for detecting faults early and ensuring the reliable and continuous delivery of high-voltage electricity. Recent advancements in drone, edge computing, deep learning, and high-resolution imaging offer new opportunities for real-time, autonomous inspection. While existing research has explored drone-based inspections, achieving efficient and accurate real-time detection of power line components remains a challenge, particularly in low-latency and limited-power environments. This study proposes the hardware-software co-optimization of real-time power line component detection using You Only Look Once (YOLO)v7. In terms of software optimization, model quantization is conducted for You Only Look Once (YOLO)v7 using the ONNX framework to reduce model complexity. The YOLOv7-Tiny, the lightweight version of YOLOv7, is also evaluated in this research. In terms of hardware optimization, the GPU accelerator of Jetson Orin Nano is employed using the TensorRT framework. A custom power line dataset comprising connectors, insulators, and hangers was developed for evaluating model performance. Simulation results demonstrate that the quantized YOLOv7 model achieves a mean average precision (mAP) about 89.8%. In hardware evaluation, the Jetson Orin Nano implementation confirms the feasibility of real-time detection with lower latency and power consumption compared to implementations using Raspberry Pi 5. It is proven by the highest edge-AI deployment score  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@ARTICLE{Reddy2025297,
	author = {Reddy, D. Ramesh and Krishna, Jakka Bala and Madava, Ramagiri},
	title = {Traffic Sign Detection on Jetson Nano Using YOLOV8 Deep Learning Model},
	year = {2025},
	journal = {Lecture Notes in Networks and Systems},
	volume = {1479 LNNS},
	pages = {297 - 311},
	doi = {10.1007/978-3-031-95017-9_28},
	url = {https://www.scopus.com/pages/publications/105013616504?origin=resultslist},
	abstract = {Traffic signs are essential for the safety of autonomous vehicles, aiding in speed regulation, stops, and lane management to prevent accidents and improve navigation. Traffic sign detection is crucial for road safety, particularly in autonomous driving systems, where accurate and timely recognition is key. The challenge lies in detecting signs under diverse conditions, including varying lighting, weather, and occlusions. The proposed model uses a deep learning model, YOLOv8, for real-time traffic sign detection. By leveraging the processing capabilities of the NVIDIA Jetson Nano, the model delivers fast and precise object detection with low latency. The proposed approach offers an efficient solution for real-time traffic sign recognition, enhancing the safety and effectiveness of modern transportation systems. The performance metrics of proposed system i.e., precision, recall, mAP are 99.8%, 95%, 90.5%. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Mao202492,
	author = {Mao, Yufei and Weiss, Roland and Zhang, Yi and Li, Yu and Rothmann, Marc and Porrmann, Mario},
	title = {FPGA Acceleration of DL-Based Real-Time DC Series Arc Fault Detection},
	year = {2024},
	journal = {2024 IEEE International Parallel and Distributed Processing Symposium Workshops, IPDPSW 2024},
	pages = {92 - 98},
	doi = {10.1109/IPDPSW63119.2024.00031},
	url = {https://www.scopus.com/pages/publications/85200767050?origin=resultslist},
	abstract = {A direct current (DC) series arc fault is an unintended and hazardous electrical discharge in a DC circuit. It poses a safety risk as it can potentially cause fire and damage electrical components. The urgency of detecting DC series arc faults lies in their potential to escalate into hazardous situations swiftly. Rapid identification of abnormal patterns associated with DC series arc faults is essential to trigger intervention measures immediately. In recent years, the focus of studies for the detection algorithms has been shifting from conventional methods toward machine learning (ML)-based approaches, because ML-based algorithms have the advantage of adapting to different circuit dynamics. While ML-based approaches have yielded positive results in the identification, implementing such computationally intensive algorithms in a time-critical application remains a challenge. This paper addresses this challenge through a hardware solution, proposing an embedded real-time detection system with an FPGA-based hardware accelerator to enhance efficiency. The solution implements an optimized ML-based algorithm on an Avnet Ultra96-V2 board. The hardware performance of the board is evaluated and compared to an NVIDIA Jetson Xavier NX board. The results show high efficiency of the FPGA-based accelerator for DC series arc fault detection, achieving a runtime of 60 μs and power consumption of 3.04 W at peak performance. This meets the application requirements and is comparable to the NVIDIA board, which achieves a minimum runtime of 143 μ s with 2.96 W.  © 2024 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 9}
}

@CONFERENCE{Dong20191214,
	author = {Dong, Jiansheng and Yuan, Jingling and Li, Lin and Zhong, Xian and Liu, Weiru},
	title = {An efficient semantic segmentation method using pyramid ShuffleNet V2 with vortex pooling},
	year = {2019},
	journal = {Proceedings - International Conference on Tools with Artificial Intelligence, ICTAI},
	volume = {2019-November},
	pages = {1214 - 1220},
	doi = {10.1109/ICTAI.2019.00-98},
	url = {https://www.scopus.com/pages/publications/85081089677?origin=resultslist},
	abstract = {Efficient and accurate semantic segmentation is particularly important especially for applications like autonomous driving which requires real-time inference speed and high performance. Many works try to compromise spatial resolution to achieve real-time inference speed, which leads to poor performance. As a result, real-time segmentation task for embedded devices is still an open problem. In this paper, we focus on building a network with better performance possible while still achieve real-time inference speed. We first use a pyramid kernel size to capture more spatial information instead of using just a 3×3 kernel size for DWConvolution in ShuffleNet v2. Meanwhile, an efficient Vortex Pooling module is employed to aggregate the contextual information and generate high-resolution features. Compared with other state-of-the-art real-time semantic segmentation networks, the proposed network achieves similar inference speed and better performance on embedded device. Specifically, we achieve state-of-the-art 73.46% mean IoU on Cityscapes test dataset, for a 768×1024 input, a speed of 46.1 frames per second on NVIDIA Jetson AGX Xavier embedded development board is achieved. © 2019 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5; All Open Access; Green Open Access}
}

@CONFERENCE{Vandersteegen2019,
	author = {Vandersteegen, Maarten and Van Beeck, Kristof and Goedeme, Toon},
	title = {Super accurate low latency object detection on a surveillance UAV},
	year = {2019},
	journal = {Proceedings of the 16th International Conference on Machine Vision Applications, MVA 2019},
	pages = {},
	doi = {10.23919/MVA.2019.8758060},
	url = {https://www.scopus.com/pages/publications/85070477766?origin=resultslist},
	abstract = {Drones have proven to be useful in many industry segments such as security and surveillance, where e.g. on-board real-time object tracking is a necessity for autonomous flying guards. Tracking and following suspicious objects is therefore required in real-time on limited hardware. With an object detector in the loop, low latency becomes extremely important. In this paper, we propose a solution to make object detection for UAVs both fast and super accurate. We propose a multi-dataset learning strategy yielding top eye-sky object detection accuracy. Our model generalizes well on unseen data and can cope with different flying heights, optically zoomed-in shots and different viewing angles. We apply optimization steps such that we achieve minimal latency on embedded on-board hardware by fusing layers, quantizing calculations to 16-bit floats and 8-bit integers, with negligible loss in accuracy. We validate on NVIDIA's Jetson TX2 and Jetson Xavier platforms where we achieve a speed-wise performance boost of more than 10×. © 2019 MVA Organization.},
