	title = {An Edge-Robot Collaborative Inspection Framework Based on an Indoor Edge-Cloud Station},
	year = {2025},
	journal = {2025 4th International Conference on Artificial Intelligence, Human-Computer Interaction and Robotics, AIHCIR 2025},
