@ARTICLE{Kalogiannis202613379,
	author = {Kalogiannis, Konstantinos and Hussain, Ahmed Mohamed and Li, Hexu and Papadimitratos, Panos},
	title = {Attention in Motion: Secure Platooning via Transformer-Based Misbehavior Detection},
	year = {2026},
	journal = {IEEE Transactions on Intelligent Transportation Systems},
