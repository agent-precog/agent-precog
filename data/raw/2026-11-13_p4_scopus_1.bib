@CONFERENCE{Hnatushenko2026108,
	author = {Hnatushenko, Volodymyr and Pashchenko, Oleksandr and Khomenko, Volodymyr and Ratov, Boranbay},
	title = {Real-time Anomaly Detection for Downhole Tool Failure Using Edge AI},
	year = {2026},
