@CONFERENCE{Goswami20251074,
	author = {Goswami, Anjali and Kadao, Anjali Krushna},
	title = {Edge AI Integration for Real-Time Control in Embedded Computing Systems},
	year = {2025},
	journal = {4th International Conference on Applied Artificial Intelligence and Computing, ICAAIC 2025},
	pages = {1074 - 1082},
	doi = {10.1109/ICAAIC64647.2025.11330470},
	url = {https://www.scopus.com/pages/publications/105034903898?origin=resultslist},
	abstract = {Embedded systems that integrate Artificial Intelligence (AI) have dramatically improved the efficiency of a wide range of applications with real-time control requirements, enabling fine-grained, low-latency decisions. This document reviews the Design, Implementation, and Performance of Edge AI models in embedded computational systems, specifically for real-time control tasks in resource-constrained scenarios. Edge AI differs from traditional Cloud AI because it is executed directly on edge devices (microcontrollers, FPGAs, or SoC platforms), which offer the advantages of reducing communication overhead, minimizing latency, and lowering power consumption. An overview of the primary architectural considerations for integrating edge AI, including hardware accelerators, model compression techniques (pruning, quantization), and power-efficient neural networks, is presented first. The significance of edge inference in uncertain and dynamic systems is illustrated with examples of real-time Control applications: autonomous robots, smart grids, and factory automation. The work also discusses the integration of AI techniques into traditional control systems and the improvement of system flexibility and robustness offered by such hybrid approaches. The system, a lightweight convolutional neural network running on an ARM Cortex-M processor to control a motor, is presented as an example of an autonomous drive system. The system provides inference latency of under 20 milliseconds and maintains reliability across different ambient disruptions. Experimental results suggest that edge AI controller systems outperform traditional PID controllers in terms of Response and adaptability. Also covers future challenges and opportunities for scaling Edge AI for advanced control tasks, including real-time scheduling, model generalization, security, and interfacing with diverse computing architectures. The results indicate that Edge AI must indeed be, and increasingly will be, embedded in control systems that need to respond immediately and are resource-constrained. This paper summarizes the current developments, accomplishments, and prospects of Edge AI for embedded Real-time Control and provides the basis for researchers and practitioners to advance intelligent embedded systems. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
