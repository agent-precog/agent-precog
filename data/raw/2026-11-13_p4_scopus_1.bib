@CONFERENCE{Mei202646,
	author = {Mei, Teng and Pei, Chengxuan and Canini, Marco and Xiao, Yunming},
	title = {MCSched: Memory-Controller-Aware Scheduling for Embodied LLM Workloads on NVIDIA Jetson},
	year = {2026},
	journal = {APSys 2026 - Proceedings of the 17th ACM SIGOPS Asia-Pacific Workshop on Systems},
	pages = {46 - 52},
	doi = {10.1145/3838177.3841726},
	url = {https://www.scopus.com/pages/publications/105052111387?origin=resultslist},
	abstract = {Embodied LLM systems increasingly co-locate latency-critical robotics pipelines with compute- and memory-intensive language-model inference on edge platforms such as NVIDIA Jetson. This co-location avoids cloud round trips and enables privacy-preserving, low-latency interaction, but it also creates a new source of resource interference. Our experiments show that the deadline miss rate of a real-time task can reach nearly 100% under co-running LLM inference. The root cause is that, although robotics workloads and LLM inference typically execute on the CPU and GPU, respectively, they share the same unified-memory subsystem on edge platforms. As a result, Memory-Controller (MC) capacity can become a hidden bottleneck even when conventional compute resources do not appear saturated. Based on this finding, we propose MCSched, a lightweight MC-aware runtime scheduler for embodied LLM systems. MCSched combines coarse MC-pressure signals with foreground timing feedback and temporarily gates background LLM execution when robotics tasks approach deadline risk. In our prototype experiments, MCSched successfully reduced the deadline miss rate of the camera task and PCL task by up to 83.35% and 74.11%, respectively, on the ROS-LLM framework while maintaining LLM inference speed. These observations provide preliminary but compelling evidence that MC-aware scheduling is a practical operating system/runtime direction for deployable embodied AI on unified memory edge devices. © 2026 Copyright held by the owner/author(s).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

@BOOK{Yahyati202697,
	author = {Yahyati, Chaymae and Lamaakal, Ismail and El Makkaoui, Khalid and Maleh, Yassine and Ouahbi, Ibrahim},
	title = {When TinyML meets blockchain: Trustworthy intelligence at the edge},
	year = {2026},
	journal = {Blockchain Frameworks for Scalable, Secure, and Regulated Ecosystems},
	pages = {97 - 113},
	doi = {10.1201/9781003714804-5},
	url = {https://www.scopus.com/pages/publications/105054351237?origin=resultslist},
	abstract = {Edge intelligence is increasingly delivered by TinyML models executing on severely resource-constrained microcontrollers. While this shift enables low-latency, private, and bandwidth-efficient inference, it also raises a central question: how can such edge decisions be made trustworthy—i.e., provably authentic, intact, and auditable—without relying on a single authority? This chapter argues that distributed ledgers provide the missing accountability backbone for TinyML. We first formalize a threat model for extreme-edge deployments (sensor spoofing, model tampering, identity impersonation, and log manipulation) and derive trust requirements encompassing data origin, model integrity, non-repudiation, and traceability under minimal disclosure. We then present a layered reference architecture that combines on-device attestation with consortium-ledger anchoring of compact proofs while keeping detailed evidence off-chain under access control. We analyze design trade-offs (energy and memory overheads, networking and consensus constraints, privacy and compliance, governance and liability) and outline a research agenda on verifiable inference, auditable continual learning, swarm-level accountability, and green-by-design trust. The result is a principled pathway to turn fast, private edge decisions into defensible evidence for safety, security, and compliance-critical applications. © 2027 selection and editorial matter, Ismail Lamaakal, Khalid El Makkaoui, Yassine Maleh,  and Ibrahim Ouahbi; individual chapters, the contributors.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

