@ARTICLE{Patil2026,
	author = {Patil, Kamalesh and Jadhav, Savitri and Gunale, Kishanprasad},
	title = {FALCONS: Federated adversarial and lightweight classifier with offline & non-gradient shielding for traffic sign recognition in autonomous vehicles},
	year = {2026},
	journal = {Array},
