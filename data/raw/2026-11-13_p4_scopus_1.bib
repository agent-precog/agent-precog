	url = {https://www.scopus.com/pages/publications/105038942038?origin=resultslist},
	abstract = {Affective Computing (AfC) aims to detect, interpret, and respond to human emotions by analyzing multimodal psychophysiological signals, including facial expressions, vocal cues, and physiological data such as ECG, EEG, and EDA. To improve system responsiveness and privacy, Affective Edge Computing (AEC) integrates AfC with edge computing frameworks, enabling real-time, localized processing of emotion data on devices such as wearables, smartphones, and embedded systems. This approach reduces latency, minimizes network dependency, and preserves user privacy by retaining sensitive data at the source. Lightweight machine learning and signal processing models on edge devices enable efficient, real-time emotion classification within limited computational resources. However, developing a scalable, distributed architecture that integrates multimodal data acquisition, local emotion recognition, optional fog-based load balancing, and cloud-based analytics remains a key challenge. Ensuring responsiveness and efficiency is especially critical in sensitive applications such as mental health monitoring, human-robot interaction, and mobile affective systems, where privacy, low latency, and reliability are essential. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Badar202619893,
	author = {Badar, Hafiz Muhammad Sanaullah and Hussain, Israr and Kashif Bashir, Ali and Alturki, Nazik and Fan, Gaojuan and Zhang, Chongsheng},
	title = {Edge-Optimized Lightweight and Transformer Backbones for Real-Time Road Damage Detection in IIoT Systems},
	year = {2026},
	journal = {IEEE Internet of Things Journal},
	volume = {13},
	number = {10},
	pages = {19893 - 19904},
	doi = {10.1109/JIOT.2025.3644661},
	url = {https://www.scopus.com/pages/publications/105025518661?origin=resultslist},
	abstract = {Accurate and efficient road damage detection is critical for maintaining urban infrastructure and ensuring public safety in Intelligent Internet of Things (IIoT) systems. There remains a significant challenge to achieving a balance between detection accuracy and real-time inference on resource-constrained edge devices despite advances in deep learning. This article addresses this gap by enhancing the YOLOv9c object detection framework with two distinct backbone architectures: MobileNet V3-Small, which is a lightweight convolutional neural network optimized for edge deployment, and Swin Transformer, which is a hierarchical vision transformer that captures rich contextual features. We present a systematic, dual-backbone performance benchmark that quantifies the critical trade-off between computational efficiency and detection precision, which is essential for guiding IIoT deployment strategies. We conducted experiments on the street view road damage detection (SVRDD) dataset to evaluate detection accuracy, computational efficiency, and latency. The MobileNet backbone achieves the highest mean average precision (mAP@0.5) of 74.0% (a 1.5% gain over baseline) and recall of 68.8% (a 7.3% gain over baseline), demonstrating improved accuracy while maintaining a low inference time on a baseline GPU, indicating its suitability for deployment on IoT edge devices. Importantly, the MobileNet variant reduces the parameter count from 25.6 M to 2.54 M and the Giga floating-point operations per second (GFLOPs) from 102.3 to 0.49, making it more efficient for IIoT edge devices. Both backbones performed better than the YOLOv9c baseline model in terms of accuracy, thus providing scalable and practical solutions for real-time infrastructure monitoring. These findings contribute to the development of intelligent, efficient, and scalable object detection systems tailored for smart city and IIoT environments.  © 2014 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7; All Open Access; Green Open Access}
}

@CONFERENCE{Gopisetty2026,
	author = {Gopisetty, Guru Kesava Dasu and Maram, Balajee and Sai, Manikonda Srinivasa Sesha},
	title = {Integrating Reinforcement Learning and Cognitive AI for Low-Latency and Resilient High-Speed Network Optimization},
	year = {2026},
	journal = {6th Biennial International Conference on Nascent Technologies in Engineering, ICNTE 2026},
	pages = {},
	doi = {10.1109/ICNTE66387.2026.11437463},
	url = {https://www.scopus.com/pages/publications/105036658707?origin=resultslist},
	abstract = {High-speed networks are handling a growing amount of information that requires adaptive optimization at timelines of a few milliseconds in order to satisfy ultrareliable low-latency communication bassoses (URLLC). Classical rule-based orchestration and static optimization tend to fail in the face of partial observerability and dynamic workloads resulting in tail-latency failures and sluggish response to disruption. The proposed hybrid framework combines the reinforcement-based learned behavior with cognitive AI reasoning and enables resilience in intent driven control of networks. We formalize the problem as an optimization of p95/p99 latency, mean time to recovery and control overhead under firm capacity and SLA constraints. We apply the use of multi-agent policies edge deployment combined with the coordination of dialectical inference to support real-time adaptation. Experimental evaluations on a variety of topologies and workloads report consistently reductions of 30+ percent in p99 tail latency and faster recovery over heuristic baselines. The system is published with reproduced artifacts, such as code, datasets, and containerized implementations, in order to achieve a sense of transparency and to have a verifiable progress.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Mika2026205,
	author = {Mika, Kevin and Kucza, Nils and Porrmann, Florian and Hagemeyer, Jens},
	title = {Optimizing AI on the Edge: Partitioning Neural Networks Across Heterogeneous Accelerators},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {16008 LNCS},
	pages = {205 - 217},
	doi = {10.1007/978-3-032-02725-2_16},
	url = {https://www.scopus.com/pages/publications/105019644237?origin=resultslist},
	abstract = {Edge AI demands the deployment of complex neural networks under strict constraints on compute, memory, and power particularly in real-time applications such as autonomous vehicles, smart surveillance, and industrial inspection. We present a workload-aware partitioning strategy for neural networks on the u.RECS platform, a modular edge microserver integrating an NVIDIA Jetson Orin NX GPU and Hailo-8 AI accelerators in a compact Mini-ITX form factor. Using YOLOv7 as a case study, we demonstrate how model layers can be distributed across heterogeneous accelerators to exploit their complementary strengths, high-throughput parallelism on the GPU and energy-efficient inference on the Hailo-8. Our method minimizes inter-device communication by selecting a single, low-bandwidth split point and supports fully local inference. Experimental results show up to 1.7× performance gains and energy efficiency improvements over single-accelerator baselines, reaching 95 FPS at 3.3 FPS/Watt. These results demonstrate practical benefits of heterogeneous partitioning for far-edge scenarios where low latency, low power, and high throughput are essential. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Shivakumar2026435,
	author = {Shivakumar, E. and Agoramoorthy, Moorthy and Sathyanarayanan, D. and Tf, Michael Raj and Uthirapathy, Samson Ebenezar},
	title = {Graph Neural Network-Based Adaptive Data Imputation and Outlier Detection for Streaming IoT Time Series},
	year = {2026},
	journal = {Proceedings of the 4th International Conference on Intelligent Data Communication Technologies and Internet of Things, IDCioT 2026},
	pages = {435 - 441},
	doi = {10.1109/IDCIoT67589.2026.11455698},
	url = {https://www.scopus.com/pages/publications/105036967258?origin=resultslist},
	abstract = {The proliferation of Internet of Things (IoT) ecosystems has led to an explosion of streaming time series data from a multitude of sensors. This data is often incomplete due to sensor failures or transmission errors, and can contain anomalous readings due to noise or malicious activity. Traditional data imputation and outlier detection methods are often ill-suited for the dynamic and non-stationary nature of streaming IoT data, and fail to capture the complex spatial and temporal correlations between interconnected sensors. To address these challenges, this paper introduces a novel framework that leverages Graph Neural Networks (GNNs) for adaptive online learning to perform real-time data imputation and outlier detection. Our approach models the IoT sensor network as a dynamic graph, where GNNs are used to learn the intricate dependencies between sensors and infer missing values and identify anomalies by considering both the local neighborhood and the global network structure. A key innovation of this work is the development of an adaptive learning mechanism that continuously updates the model to handle non-stationary data streams and concept drift, enabling it to maintain high performance over extended periods without the need for periodic retraining. Extensive experiments on real-world streaming IoT datasets demonstrate that our GNN-based framework significantly outperforms state-of-the-art baselines in both imputation accuracy and anomaly detection, while maintaining low latency suitable for edge deployment. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5}
}

@CONFERENCE{Paulchamy2026822,
	author = {Paulchamy, B. and Bhattacharya, Sandip and Jaya, J. and Anand, B.},
	title = {Real-Time Drowsiness Monitoring via Deep Learning-Driven Brain-Computer Interface},
	year = {2026},
	journal = {7th International Conference on Electronics and Sustainable Communication Systems, ICESC 2026 - Proceedings},
	pages = {822 - 827},
	doi = {10.1109/ICESC70182.2026.11687528},
	url = {https://www.scopus.com/pages/publications/105052165850?origin=resultslist},
	abstract = {Accidents related to drowsiness are an issue of concern in high-stakes environments such as automotive transport and industrial processes. The study presents an efficient, real-time Brain-Computer Interface (BCI) solution that identifies fatigue in its early stages by processing neurophysiological data using a powerful Deep Learning (DL) architecture. The system uses a wearable low-channel Electroencephalogram (EEG) device to record brainwave activity in the frontal and occipital lobes. We use a hybrid CNNLSTM (Convolutional Neural Network -Long Short-Term Memory) model to deal with the noise of the Electroencephalography (EEG) data. The Convolutional Neural Network (CNN) element extracts spatial features from the signal at various levels. In contrast, the LSTM layer extracts time-related features that capture the gradual change in alertness to drowsiness. A Transfer Learning method is incorporated to reduce the effort required for subject-specific calibration. Initial tests indicate that the suggested model reaches a classification accuracy of 96.4 percent on test data sets (e.g., SEED-VIG), which is much higher than the traditional Support Vector Machine (SVM) baselines. Moreover, the system has an inference latency of <200 ms, which makes it suitable for an edge computing platform such as the NVIDIA Jetson. This BCI system can serve as a proactive safety measure by bypassing external physical cues (such as eye blinks or steering patterns) and directly accessing the neural antecedents of sleep. These results indicate that neuro-monitoring based on deep learning can provide a safe, high-fidelity, and reliable solution to real-time aversion of fatigue-induced catastrophes. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Lamaakal20263359,
	author = {Lamaakal, Ismail and Elgarrab, Idris and Alouach, Abdennour and Maleh, Yassine and El Makkaoui, Khalid and Ouahbi, Ibrahim and Alanezi, Ahmad and Khalifa, Hany S.},
	title = {A Vehicular-Edge Federated, Quantized YOLOv12 System for Real-Time 3D Hand-Gestures- Based AAV Control},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {3359 - 3385},
	doi = {10.1109/ACCESS.2025.3647565},
	url = {https://www.scopus.com/pages/publications/105025896293?origin=resultslist},
	abstract = {This paper tackles gesture-controlled autonomous aerial vehicles (AAV) teleoperation under strict latency, bandwidth, and privacy constraints by shifting both learning and inference to the vehicular edge. A YOLOv12–Nano detector is trained via federated learning across 10 vehicular clients (SuperNodes) coordinated by Flower on Azure (SuperLink), exchanging encrypted model updates instead of raw video. The perception stack follows a disciplined PyTorch→ONNX (static shapes)→INT8 post-training quantization path and runs as a TensorRT engine (batch=1) on Jetson Xavier NX, while the full sensing→actuation chain is validated in Unreal Engine/AirSim with PX4 SITL through ROS 2/MAVLink bridge. AAV–GESTURE (119 HD clips, 13 gestures) is curated to 10 control-ready gestures with actor/environment disjoint splits, tight-box annotation, auto-orientation, 640×640 grayscale preprocessing, light augmentations, and a stratified 512-frame calibration subset. The INT8 model attains mAP@0.5:0.95 = 0.947 and mAP@0.5 = 0.987, sustaining 58.2 FPS with 49.8 ± 3.2 ms detector latency and 58 ± 6 mJ per inference; the end-toend camera→actuation latency averages 103.2 ± 7.9 ms (95th percentile 114.5 ms). In federation, client fraction C=0.3 with TopK+INT8 compression converges to near-centralized accuracy while transmitting ∼ 2.1 MB per round and tolerating moderate packet loss. Results indicate that combining INT8 quantization with bandwidth-aware FL yields real-time, privacy-preserving gesture-to-AAV control that generalizes under non-IID clients and demonstrates closed-loop viability within a sub-120 ms safety budget. © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5; All Open Access; Gold Open Access}
}

@ARTICLE{Solangi2026382,
	author = {Solangi, Hanan},
	title = {A credit-based arbitration mechanism with finite-time fairness guarantees for autonomous multi-agent systems},
	year = {2026},
	journal = {International Journal of Intelligent Unmanned Systems},
	volume = {14},
	number = {3},
	pages = {382 - 404},
	doi = {10.1108/IJIUS-07-2026-0309},
	url = {https://www.scopus.com/pages/publications/105052535567?origin=resultslist},
	abstract = {Purpose – This paper addresses repeated unfairness in multi-robot coordination, where the same agents may repeatedly yield at shared bottlenecks, leading to missed deadlines, reduced throughput, and safety violations. The purpose is to propose a lightweight arbitration mechanism that guarantees bounded unfairness for autonomous agents in warehouse logistics and urban unmanned systems. Design/methodology/approach – Each robot maintains a bounded local credit state that increases after yielding and decreases after passing. During every contention event, robots are ranked according to their credit values, with deterministic ID-based tie-breaking used when credits are equal. A finite-time theoretical analysis is developed to derive an explicit worst-case bound on cumulative cost disparity between any pair of robots. The proposed method is evaluated through numerical simulations involving corridor- and intersection-style contention scenarios and is further validated through deployment on a TI LaunchXL-F28379D embedded controller. Experimental measurements demonstrate an average execution latency of 2.738 µs over 1, 000 arbitration events, confirming the feasibility of real-time edge deployment. Findings – The proposed mechanism guarantees that the cumulative cost difference between any two robots remains uniformly bounded regardless of interaction history, preventing persistent unfairness and starvation. Simulation results demonstrate lower unfairness than representative baseline methods while requiring only a bounded integer credit state and minimal communication, making the approach suitable for practical warehouse and autonomous traffic applications. Originality/value – Unlike existing approaches that provide fairness only in expectation or at equilibrium, this work provides a deterministic finite-time worst-case fairness guarantee that holds for every agent at every moment. The mechanism is parameter-insensitive, requires minimal communication, and integrates into existing robot software stacks without hardware modifications, offering practical value for real-world unmanned systems. © 2026, Emerald Publishing Limited},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Yang2026,
	author = {Yang, Fengze and Yu, Bo and Zhou, Yang and Luo, Xuewen and Tu, Zhengzhong and Liu, Chenxi},
	title = {Edge-based multimodal sensor data fusion with Vision-Language-Action (VLA) model for real-time autonomous vehicle accident avoidance},
	year = {2026},
	journal = {Engineering Applications of Artificial Intelligence},
	volume = {180},
	pages = {},
	doi = {10.1016/j.engappai.2026.115186},
	url = {https://www.scopus.com/pages/publications/105039759738?origin=resultslist},
	abstract = {Autonomous driving (AD) systems relying solely on onboard sensors may fail to detect distant or occluded hazards, potentially causing preventable collisions; however, existing transformer-based Vehicle-to-Everything (V2X) approaches either lack effective multimodal fusion and reasoning or struggle to meet real-time performance requirements under complex traffic conditions. This paper proposes the R eal-time E dge-based A utonomous C o-pilot T rajectory planner (REACT), a V2X-integrated trajectory optimization framework for AD based on a fine-tuned lightweight Vision–Language–Action (VLA) model explicitly grounded in low-level control generation. REACT integrates infrastructure-provided hazard alerts with onboard sensor data, capturing surrounding traffic dynamics and vehicle intents through visual embeddings, interpreting numerical data from symbolic inputs, and employing contextual reasoning to predict control-aware residual action sequences. To enable robust real-time deployment on edge devices, REACT employs a Residual Trajectory Fusion (RTF) module that predicts discrete residual controls and fuses them with a nominal plan, together with edge-adaptation strategies to reduce model complexity and improve inference efficiency. Evaluated on the DeepAccident benchmark, REACT achieves state-of-the-art performance, a 84.9% collision rate reduction, a 50.6% Video Panoptic Quality, and a 0.57-second inference latency on the Jetson AGX Orin. Ablation studies validate the contribution of each input modality, architectural component, and edge adaptation strategy. These results highlight the effectiveness of lightweight control-grounded VLA reasoning for real-time cooperative planning on edge platforms and underscore the potential of language-guided residual control generation for improving traffic safety. © 2026 Elsevier Ltd.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

@CONFERENCE{Zhou2026529,
	author = {Zhou, Chengwei and Lee, Brandon and Jia, Zhaoyan and Yu, Hoatian and Chen, Xuming and Pulliam, Christopher L. and Majerus, Steve J. A. and Pedram, Massoud and Hnat, Sandra and Datta, Gourav},
	title = {Agentic Multimodal Sensing for Energy-Efficient Fall Detection in Powered Exoskeletons for Spinal Cord Injury},
	year = {2026},
	journal = {Proceedings - 2026 IEEE/ACM Conference on Connected Health: Applications, Systems and Engineering Technologies, CHASE 2026},
	pages = {529 - 534},
	doi = {10.1109/CHASE69719.2026.00090},
	url = {https://www.scopus.com/pages/publications/105050622736?origin=resultslist},
	abstract = {Falls during powered exoskeleton use pose severe safety risks for individuals with spinal cord injury (SCI), yet current devices rely on reactive threshold-based detection that cannot anticipate instability or adapt sensing to conserve battery life during extended community ambulation. We present the first application of agentic multimodal sensing to exoskeleton fall detection, deploying the Adaptive Multimodal Intelligence (AMI) framework on a novel synchronized dataset of IMU and joint kinematic signals collected during controlled standing perturbation experiments with neurotypical participants using a Motor-Assisted Hybrid Neuroprosthesis (MAHNP). Our dataset comprises 718 labeled trials across 10 perturbation conditions from 7 participants (5 training, 2 test), capturing the full spectrum of directional instability events during quiet standing, heel strike, midstance, and toe-off phases. By jointly learning which sensors to activate and how to fuse their signals, AMI achieves 93.2% balanced accuracy in detecting pre-fall instability signatures within 27 ms of perturbation onset, while reducing average sensor utilization to 37.7% and inference energy to 0.21× of full-sensing operation at the most aggressive gating level, all deployed on an NVIDIA Jetson platform under realistic wearable constraints. These results demonstrate that intelligent, task-driven sensing policies can enable reliable anticipatory fall protection under the strict energy and latency constraints of wearable exoskeleton systems.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Han2026274,
	author = {Han, Dongqi and Yuan, Dongming and Liu, Yuan'An},
	title = {A Cloud-Edge Collaborative Enabling Architecture Based on a Heterogeneous Embedded Platform},
	year = {2026},
	journal = {Proceedings of 2026 2nd International Conference on Big Data, Communication Technology and Computer Applications, BDCTA 2026},
	pages = {274 - 280},
	doi = {10.1145/3801359.3801403},
	url = {https://www.scopus.com/pages/publications/105038877701?origin=resultslist},
	abstract = {As the application of artificial intelligence in edge scenarios becomes increasingly widespread, cloud-edge collaborative computing has become a new solution for achieving low latency and reliable intelligent services. However, edge devices are limited by size, energy consumption, and limited computing resources, while tightly coupled embedded platforms lack flexibility and scalability. To address these challenges, this paper proposes a cloud-edge collaborative support architecture based on heterogeneous embedded platforms. At the architectural level, a lightweight cloud-edge framework is designed to support the integration and coordination of heterogeneous edge computing resources. At the hardware level, a modular and multi-domain heterogeneous embedded platform is implemented, which realizes flexible configuration and upgrade of CPUs, NPUs, and FPGAs computing units through standardized interfaces. The proposed architecture can achieve adaptive collaboration among the cloud, edge, and device layers under different network conditions and task requirements. Experimental results show that the proposed solution has improved performance in edge inference, scalability, and operational flexibility, providing a new practical solution for autonomous edge computing clusters and intelligent base station systems.  © 2026 Copyright held by the owner/author(s).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Yun2026,
	author = {Yun, Seongjin and Kim, Jeong-Si},
	title = {CADE: Context-aware dispatch engine for energy-efficient VLM inference on heterogeneous edge with discrete neural processing units},
	year = {2026},
	journal = {Journal of Systems Architecture},
	volume = {181},
	pages = {},
	doi = {10.1016/j.sysarc.2026.104016},
	url = {https://www.scopus.com/pages/publications/105052195339?origin=resultslist},
	abstract = {As deployments of vision-language models on edge platforms grow in domains such as industrial inspection, service robotics, and real-time surveillance, selecting the execution device for each request becomes a key engineering challenge. Heterogeneous systems that combine general-purpose GPUs and discrete NPUs expose multiple execution paths with different latency and energy profiles, and no single device is preferable across model scales and decoding regimes. Existing schedulers mainly rely on system-level metrics such as queue depth or utilization and therefore cannot account for the operational intent of individual requests. To complement such schedulers with context-awareness, we propose CADE, a context-aware dispatch engine that extracts contextual intent directly from internal VLM representations and produces a routing signal that can inform scheduling decisions. CADE reuses hidden states from the multimodal pipeline and applies a compact classifier to infer whether a request should prioritize latency or energy, then uses a confidence-adaptive dispatcher to route transformer-based text decoders to either a latency-optimized GPU path or an energy-optimized NPU path. On a heterogeneous edge AI platform combining an NVIDIA Jetson AGX Orin with a Mobilint MLA100 NPU, CADE keeps 94 percent of latency-critical requests on the low-latency device and improves energy-efficiency by 7.6 percent over a GPU-only baseline, adding 0.22 percent of total inference latency. © 2026},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Shi2026,
	author = {Shi, Jiejie and Chen, Huacai and Han, Liangying},
	title = {EASE-CloudNet: Adaptive Safety Alignment for Edge–Cloud SLMs via GNN-Informed Selective Reasoning and Multi-Objective Distillation},
	year = {2026},
	journal = {Electronics (Switzerland)},
	volume = {15},
	number = {17},
	pages = {},
	doi = {10.3390/electronics15174015},
	url = {https://www.scopus.com/pages/publications/105050315455?origin=resultslist},
	abstract = {EASE-CloudNet is a two-phase safety-alignment framework for generative small language models (SLMs) deployed on resource-constrained edge nodes. Its input is a natural-language user query and its output is a safe, helpful natural-language response or refusal; network-traffic classification and resource-scheduling actions are outside the task evaluated in this study. In Phase 1, a cloud teacher uses a security policy graph to generate structured safety rationales and response targets, which are distilled into Qwen2.5-1.5B/3B and Llama3.2-3B students. In Phase 2, an offline heterogeneous graph and a two-layer GraphSAGE model identify vulnerable semantic regions; these vulnerability targets supervise a lightweight edge-side router. We formulate deployment cost as a differentiable gate-conditioned expectation, so measured latency and energy constants affect the router through its reasoning probability. In the Qwen2.5-1.5B ablation experiments, the full model obtains 3.9% StrongREJECT ASR, 54.7% MMLU accuracy, and 70 average generated tokens; an A100 reference profile reports 18.8 ms/query and 2.37 J/query, or 3.3% latency and 2.6% measured GPU-energy overhead over the unaligned model. Physical edge runs measured a direct/reasoning end-to-end latency of 41.2/68.7 ms on Jetson Orin NX and 62.5/105.3 ms on Snapdragon 8 Gen 3, with a direct/reasoning energy of 0.48/0.79 and 0.71/1.18 J/query, respectively. Equal-seed Holm–Bonferroni-corrected tests confirm lower ASR than EASE on StrongREJECT and WildJailbreak for all three base models ((Formula presented.)). © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Saleem2026,
	author = {Saleem, L. Abdul and Jerith, G. Gifta},
	title = {A deep learning driven framework with ObjTrackNet for real-time object and human detection in smart video surveillance},
	year = {2026},
	journal = {Discover Computing},
	volume = {29},
