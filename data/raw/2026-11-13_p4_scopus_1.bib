@ARTICLE{Dong202510664,
	author = {Dong, Jun and Cheng, Jintao and Wu, Jin and Zhang, Chengxi and Zhao, Shunyi and Tang, Xiaoyu},
	title = {Real-Time AIoT for AAV Antenna Interference Detection via Edge–Cloud Collaboration},
	year = {2025},
	journal = {IEEE Internet of Things Journal},
	volume = {12},
	number = {8},
	pages = {10664 - 10680},
	doi = {10.1109/JIOT.2024.3512867},
	url = {https://www.scopus.com/pages/publications/105002677923?origin=resultslist},
	abstract = {In the fifth-generation (5G) era, eliminating communication interference sources is crucial for maintaining network performance. Interference often originates from unauthorized or malfunctioning antennas, and radio monitoring agencies must address numerous sources of such antennas annually. Autonomous aerial vehicles (AAVs) can improve inspection efficiency. However, the data transmission delay in the existing cloud-only (CO) artificial intelligence (AI) mode fails to meet the low latency requirements for real-time performance. Therefore, we propose a computer vision-based AI of Things (AIoT) system to detect antenna interference sources for AAVs. The system adopts an optimized edge-cloud collaboration (ECC+) mode, combining a keyframe selection algorithm (KSA), focusing on reducing end-to-end latency (E2EL) and ensuring reliable data transmission, which aligns with the core principles of ultrareliable low-latency communication (URLLC). At the core of our approach is an end-to-end antenna localization scheme based on the tracking-by-detection (TBD) paradigm, including a detector (EdgeAnt) and a tracker (AntSort). EdgeAnt achieves state-of-the-art (SOTA) performance with a mean average precision (mAP) of 42.1% on our custom antenna interference source dataset, requiring only three million parameters and 14.7 GFLOPs. On the COCO dataset, EdgeAnt achieves 38.9% mAP with 5.4 GFLOPs. We deployed EdgeAnt on Jetson Xavier NX (TRT) and Raspberry Pi 4B (NCNN), achieving real-time inference speeds of 21.1 (1088) and 4.8 (640) frames/s (FPS), respectively. Compared with CO mode, the ECC+ mode reduces E2EL by 88.9%, increases accuracy by 28.2%. Additionally, the system offers excellent scalability for coordinated multiple AAVs inspections. © 2014 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 10; All Open Access; Green Open Access}
}

@CONFERENCE{Trabelsi2025,
	author = {Trabelsi, Salem and Gontara, Salah and Khalifa, Khaled Ben and Mtibaa, Abdellatif},
	title = {Designing a Teacher - Student Knowledge Distillation Framework for Accurate and Efficient Epilepsy Prediction on Edge Devices},
	year = {2025},
	journal = {19th International Conference on Innovations in Intelligent Systems and Applications, INISTA 2025 - Proceedings},
	pages = {},
	doi = {10.1109/INISTA68122.2025.11249604},
	url = {https://www.scopus.com/pages/publications/105030485586?origin=resultslist},
	abstract = {Epileptic seizure prediction is a critical challenge in clinical neuroscience, where early warnings can greatly improve patient safety and quality of life. Deep learning (DL) models have shown strong potential by automatically capturing spatiotemporal electroencephalogram (EEG) features, yet their large size and computational demands hinder deployment in real-time or resource-constrained settings. Traditional compression methods such as pruning and quantization reduce complexity but often degrade performance. In this study, we propose a teacher-student knowledge distillation (KD) framework, where a high-capacity 1D CNN-BiLSTM with attention teacher transfers its predictive power to a 1D CNN-BiGRU with attention lightweight student. The student reaches near-teacher accuracy (97% vs. 99%) while reducing parameters, compressing model size by 99%, and lowering inference latency by up to 69%. Unlike standard quantization methods, which trade either accuracy or compression, our KD approach achieves both extreme compactness with reliable accuracy and fast inference. These results highlight our framework as a practical solution for enabling real-time seizure prediction on Internet of Things (IoT) edge devices. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Zhao20242160,
	author = {Zhao, Wenhao and Wang, Lin and Duan, Fei},
	title = {ELPG: End-to-End Latency Prediction for Deep-Learning Model Inference on Edge Devices},
	year = {2024},
	journal = {Proceedings of the IEEE International Conference on Computer and Communications, ICCC},
	number = {2024},
	pages = {2160 - 2165},
	doi = {10.1109/ICCC62609.2024.10942010},
	url = {https://www.scopus.com/pages/publications/105006533904?origin=resultslist},
	abstract = {The demand for running deep learning models on edge devices is increasing. In order to achieve lower latency and higher accuracy on edge devices, many studies have custom-designed deep learning models for edge devices, among which hardware-aware neural architecture search (HW - NAS) is the most successful. HW-NAS require measuring the model's in-ference latency on real edge devices to guide the design of model structures. Directly measuring inference latency on edge devices is prohibitively expensive, leading many works to predict model inference latency using various methods. In this paper, we propose ELPG, an end-to-end inference latency predictor based on Graph Neural Networks and Gate Recurrent Unit. ELPG represents a model as a kernel sequence, and use this sequence as input to predict the model's inference latency. ELPG has no restrictions on the structure of the model and can predict the inference latency of the current advanced CNNs and their variants. Experimental results indicate that ELPG achieves higher prediction accuracy compared to existing methods, and with only 100 latency data, ELPG achieves 82.15% accuracy on Jetson Nano.  © 2024 IEEE.},
