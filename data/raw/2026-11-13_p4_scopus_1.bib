	url = {https://www.scopus.com/pages/publications/105037937509?origin=resultslist},
	abstract = {Graphical User Interface (GUI) automation plays a crucial role in modern computing, enabling automated software testing, supporting accessibility for differently-abled users, improving efficiency in robotic process automation (RPA), and facilitating intelligent interaction with web-based systems. With the growing complexity of user interfaces, traditional rule-based and vision-only approaches have become insufficient, as they lack scalability and semantic understanding. Recent developments in computer vision, deep learning, and multimodal vision-language models have significantly advanced the automation of GUI element detection, interpretation, and task execution. This paper presents an extensive literature review of twenty state-of-the-art research contributions that collectively span GUI detection, multimodal learning, mobile interface automation, and autonomous web agents. We analyze these works in terms of their methodologies, strengths, and limitations, and classify them into thematic categories to highlight trends in GUI automation research. Based on the identified gaps, we propose a consolidated system architecture that combines hybrid GUI detection models, semantic reasoning through vision-language integration, and a modular automation engine for robust deployment across different platforms. The comparative synthesis of reviewed works reveals that hybrid approaches and multimodal reasoning frameworks outperform traditional methods, but challenges remain in terms of scalability, generalization, and real-world performance  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

