	title = {Cross-Scenario Generalization Performance Verification of Spatiotemporal Attention CNN-LSTM Battery RUL Prediction Model},
	year = {2026},
	journal = {2026 5th International Conference on Electronic Electrical Engineering and Automatic Control, EEEAC 2026},
