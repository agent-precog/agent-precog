@ARTICLE{Tami2026,
	author = {Tami, Mohammad and Hasasneh, Ahmad and Ashqar, Huthaifa I. and Elhenawy, Mohammed},
	title = {SafeDriveEdge: multimodal vision-language reasoning for real-time decision support in intelligent vehicles},
	year = {2026},
