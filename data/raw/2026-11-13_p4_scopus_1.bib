@CONFERENCE{Chen2025,
	author = {Chen, Kepeng and Han, Bowen and Zhang, Jinsong and Wang, An},
	title = {Transmission Line Fault Detection Algorithm and Intelligent Operation and Maintenance Platform Based on Deep Learning},
	year = {2025},
	journal = {2025 3rd World Conference on Communication and Computing, WCONF 2025},
	pages = {},
	doi = {10.1109/WCONF64849.2025.11233291},
	url = {https://www.scopus.com/pages/publications/105029712138?origin=resultslist},
	abstract = {This paper proposes a fault detection algorithm and intelligent operation and maintenance platform based on deep learning to address the problems of low efficiency and insufficient accuracy in detecting small targets in traditional transmission line inspections. At the algorithmic level, a lightweight multi-scale detection model LMD-YOLO is designed, which reduces the parameter size of the feature extraction module by 40% through GhostButleneck. Combined with adaptive spatial feature fusion (ASFF) and pyramid segmentation attention (PSA) mechanisms, it enhances the expression of small target features and background noise suppression; Optimizing bounding box regression using CIoU loss function and implementing it on a self built dataset mAP@0.5 Reaching 94.8%, an increase of 0.2% compared to YOLOv5s, the detection accuracy of small defects with an area ratio of less than 5% has been improved to 89.2%, while maintaining a real-time inference speed of 32.5FPS. The intelligent operation and maintenance platform adopts a front-end and back-end separation architecture. The front-end is based on Vue.js for visual interaction, and the back-end relies on SpringBoot to build business logic and integrate SuperMapGIS for spatial management of transmission lines. By optimizing model deployment through TensorRT, inference latency was reduced by 42% on NVIDIA Jetson AGXX Aviar devices. Practical application shows that the platform has increased inspection efficiency by 400%, reduced defect omission rate from 18% to 6.3%, and achieved an accuracy rate of 98.3% in generating work orders. Experiments have shown that the system outperforms existing methods in terms of detection accuracy, computational efficiency, and engineering practicality, providing an effective solution for intelligent operation and maintenance of transmission lines. In the future, we will explore multimodal data fusion and spatiotemporal graph neural network technology to further enhance the adaptability and fault prediction ability of the system in complex environments.  © 2025 IEEE.},
