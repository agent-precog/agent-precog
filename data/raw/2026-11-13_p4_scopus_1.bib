@CONFERENCE{Harini2026950,
	author = {Harini, M. and Shimi, K.V. and Jeyanthi, P.},
	title = {AI-Powered Navigation System with Real-Time Traffic Analysis, Accident Alerts and Road Condition Monitoring},
	year = {2026},
	journal = {Proceedings of 9th International Conference on Trends in Electronics and Informatics, ICOEI 2026},
