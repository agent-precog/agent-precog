@CONFERENCE{Xie2020960,
	author = {Xie, Jing and Xie, Min},
	title = {Packet delay analysis of safe cooperating cyber-physical systems (SafeCOP)},
	year = {2020},
	journal = {Proceedings of the 29th European Safety and Reliability Conference, ESREL 2019},
	pages = {960 - 967},
	doi = {10.3850/978-981-11-2724-3_0119-cd},
	url = {https://www.scopus.com/pages/publications/85089179846?origin=resultslist},
	abstract = {Many Cyber-physical systems (CPS) are safety-critical and subject to strict delay constraints. In a safe cooperating CPS where a platoon of multiple bathymetry vessels is built to cooperatively perform ocean depth measurement tasks, the delay constraints become particularly significant since these cooperative CPS communicate via time-varying wireless channels. To assure timely detection of anomalies and quick responses, it is imperative to analyze the worst-case delay of individual packets. Network calculus (NC) provides a theoretical framework for analysing worst-case performance guarantees in networked systems. This paper proposes a max-plus-based NC ((max,+)NC) approach to derive per-packet delay bounds in a multi-CPS network. We consider multiple traffic flows that are aggregated before being served. With (max,+)-NC, the aggregate flow is modeled based on the cumulative packet inter-arrival time. The aggregate flow is served in a first-in-first-out (FIFO) manner and transmitted via wireless channels in time-division multiple access (TDMA). Then a (max,+)-NC service model is define to characterize the guaranteed cumulative per-packet service time. Given these two models, a per-packet delay bound is derived with consideration of the access delay, queueing delay, and processing delay in the CPS. Practical experiments run on devices simulating the same operations and radio transmissions as in the bathymetry vessels. The obtained results demonstrate that our analysis could provide tight bounds on the actual delay of individual packets. The results can be applied to instruct the CPS implementation, configuration and assist operations in responding to safety-critical events in time. © 2019 European Safety and Reliability Association. Published by Research Publishing, Singapore.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Rahman2025145023,
