@ARTICLE{Ye202512934,
	author = {Ye, Wei and Xia, Qiming and Wu, Hai and Dong, Zhen and Zhong, Ruofei and Wang, Cheng and Wen, Chenglu},
	title = {Fade3D: Fast and Deployable 3D Object Detection for Autonomous Driving},
