@CONFERENCE{Niu2026768,
	author = {Niu, Chenxu and Li, Le and Zhou, Shuwang and Zhang, Yibin and Hu, Xiaoyuan and Liu, Zhaoyang},
	title = {LightMambaVLA: Efficient Vision-Language-Action Modeling with State Space Models and Flow Matching},
	year = {2026},
	journal = {2026 9th International Conference on Computer Information Science and Application Technology, CISAT 2026},
	pages = {768 - 771},
	doi = {10.1109/CISAT71030.2026.11682592},
	url = {https://www.scopus.com/pages/publications/105051792805?origin=resultslist},
	abstract = {Vision-Language-Action (VLA) models have shown great promise in robotic manipulation. However, standard Transformer backbones require quadratic computation and large memory, restricting their deployment for high-frequency control on edge hardware. Furthermore, diffusion-based action policies often suffer from high inference latency. To address these issues, we propose LightMambaVLA, an efficient architecture that replaces Transformers with a linear-complexity Mamba State Space Model (O(N)) to process multimodal contexts. For action generation, we use an Interleaved Action Expert based on Conditional Flow Matching (CFM) to produce smooth trajectories in fewer sampling steps. We also introduce a "Text-First"input layout and a State Dropout regularizer to reduce causal confusion. Evaluated on the LIBERO benchmark under a strict sub-2GB memory budget, LightMambaVLA performs strongly on core coplanar spatial reasoning tasks, reaching up to 87.0% success. However, the aggressive 8 × 8 visual pooling required to meet the sub-2GB constraint inherently limits fine-grained 3D spatial resolution. This trade-off drops the overall average success rate to 34.0%, highlighting that maintaining Z-axis perception under tight memory limits remains a key challenge for edge-deployed VLAs.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Wang20261501,
