}

@ARTICLE{Liu2026,
	author = {Liu, Xinpeng and Zhao, Junhui and Wu, Zhengyuan and Li, Huaicheng},
	title = {A priority-aware dual-channel feature fusion method for urban rail service traffic classification},
	year = {2026},
	journal = {Applied Intelligence},
	volume = {56},
