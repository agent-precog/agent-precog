	doi = {10.1109/ICEESI68020.2026.11583628},
	url = {https://www.scopus.com/pages/publications/105045178330?origin=resultslist},
	abstract = {Real-time and accurate traffic object detection is a fundamental requirement for intelligent transportation systems (ITS), autonomous driving, and smart city surveillance, particularly when deployed on resource-constrained edge devices. Conventional deep learning-based object detection models often achieve high accuracy at the expense of increased computational complexity, memory consumption, and inference latency, limiting their suitability for embedded platforms. This paper presents an efficient and lightweight traffic object detection framework based on the YOLOv8-tiny architecture, specifically designed for real-time edge deployment. The proposed methodology employs a single-stage detection pipeline capable of simultaneously localizing and classifying multiple traffic-related objects, including cars, buses, trucks, motorcycles, and pedestrians, from both static images and video streams. The model is trained on a publicly available annotated traffic dataset and evaluated across diverse traffic densities and illumination conditions to assess robustness and generalization capability. Experimental results demonstrate that the proposed system achieves a mean Average Precision (mAP@0.5) of 86.2% while maintaining an inference speed of approximately 9 ms per frame and a compact model size of nearly 5.2 MB. These results indicate that YOLOv8-tiny offers an effective trade-off between detection accuracy and computational efficiency, making it highly suitable for real-time traffic monitoring, autonomous perception, and edge-based intelligent transportation applications. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

