	doi = {10.1109/ICMLAS67792.2026.11483680},
	url = {https://www.scopus.com/pages/publications/105038623699?origin=resultslist},
	abstract = {Modern digital applications are expected to deliver highly personalized, responsive, and context-aware user experiences across devices and platforms. Traditional static user interfaces, however, struggle to adapt to diverse user behaviors, environments, and accessibility needs. This paper presents a practical architectural approach to AI-driven adaptive user interfaces (UIs) that dynamically adjust layout, content, and interactions based on learned user behavior. The proposed architecture integrates machine learning models and lightweight reinforcement learning techniques with mobile and web application layers to enable real-time UI adaptation. User interaction signals such as navigation patterns, feature usage, performance metrics, and contextual data are collected through secure telemetry pipelines and processed using edge-first and cloud-assisted intelligence. The system emphasizes modular design, allowing adaptive logic to evolve independently of core UI components while maintaining performance, security, and scalability. Real-world implementation insights are discussed using cross-platform mobile and web ecosystems, highlighting challenges such as latency constraints, privacy-aware data collection, model deployment strategies, and explainability of adaptive behaviors. The paper also explores trade-offs between on-device inference and server-side intelligence, along with strategies to ensure consistency across platforms. By focusing on production-ready patterns rather than theoretical models, this work demonstrates how AI-driven adaptive UIs can be safely and effectively deployed in enterprise-scale applications. The approach aims to improve usability, engagement, and accessibility while preserving user trust and system maintainability, making it suitable for intelligent and autonomous digital systems. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Kalita2026,
	author = {Kalita, Diana and Lyakhov, Pavel and Andreev, Valery and Butusov, Denis},
	title = {Monocular 3D Position Estimation of a Moving Vehicle Based on a Kalman-Goldschmidt Adaptive Filter},
	year = {2026},
	journal = {Journal of Sensor and Actuator Networks},
	volume = {15},
	number = {3},
	pages = {},
	doi = {10.3390/jsan15030048},
	url = {https://www.scopus.com/pages/publications/105042935223?origin=resultslist},
	abstract = {Determining the 3D position of a vehicle from a 2D image plays a key role in video surveillance, autonomous driving, and spatial localization. However, localization accuracy can significantly degrade in conditions of incomplete or synthetic measurement noise and keypoint jitter. In this paper, we propose a new iterative 3D position estimation algorithm (KGA). This algorithm includes geometric correction and calibration steps for converting from 2D to 3D coordinates; trajectory prediction and correction using a Kalman filter; and adaptive tuning of the filter parameters using the Goldschmidt algorithm. Experiments confirm that KGA outperforms the standard (FK) and modified (MFK) Kalman filters in accuracy and convergence speed, demonstrating robustness to various camera angles and noise levels. The novelty of this approach lies in the integration of the Goldschmidt algorithm into the Kalman filter to create an adaptation mechanism that dynamically adjusts the measurement noise covariance based on instantaneous innovation magnitude. Unlike end-to-end deep learning trackers or nonlinear filters (EKF/UKF), KGA is designed as a lightweight post-processing stage that can be seamlessly integrated into existing detection pipelines while maintaining the low computational footprint required for UAV-based edge deployment. The algorithm is of practical value for computer vision systems requiring accurate and robust tracking under varying observational conditions, with current implementation suitable for offline or buffered processing, and clear pathways to real-time deployment through code optimization. The algorithm is of practical value for computer vision systems requiring accurate and robust tracking under varying observational conditions. © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

