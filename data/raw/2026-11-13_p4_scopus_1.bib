@ARTICLE{Tsai2026117754,
	author = {Tsai, Shang-En},
	title = {Bounded Deterministic Replay for Asynchronous Acoustic–Visual UAS Tracking},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {117754 - 117774},
	doi = {10.1109/ACCESS.2026.3718076},
	url = {https://www.scopus.com/pages/publications/105046286374?origin=resultslist},
	abstract = {Asynchronous acoustic–visual tracking for uncrewed aerial systems (UAS) is constrained not only by sensor noise, but also by temporally inconsistent measurements caused by acoustic propagation delay, visual pipeline latency, jitter, dropout, and out-of-sequence packet arrivals. Assimilating such packets at arrival time introduces biased state corrections and degrades short-horizon prediction fidelity, whereas many classical out-of-sequence measurement approaches do not provide an explicit embedded runtime contract. This paper proposes a bounded deterministic replay kernel that restores delayed measurements to their acquisition time using fixed-depth ring-buffer checkpoints and deterministic repropagation. The replay scheduler is type-agnostic and handles both 3D position and bearing-only observations through a unified timestamped packet interface. Full-state maneuvering tracking is handled by an IMM-UKF branch, while degraded bearing-only operation is handled by an MSC-EKF branch under the same replay infrastructure. Bounded embedded execution is achieved through static memory allocation, capped replay admission, capped repropagation depth, and deadline-aware latency monitoring. Hardware-in-the-loop experiments on a Jetson Orin Nano + TMS570LC4357 prototype evaluate tracking accuracy and runtime determinism jointly under controlled delay, jitter, dropout, burst loss, and out-of-sequence measurement injection. At the validated 200 Hz operating point, the proposed kernel achieves 1.2 ± 0.2 m RMSE with no injected delay, 1.8 ± 0.3 m RMSE at 100 ms delay, and 3.9 ± 0.6 m RMSE at 500 ms delay, while maintaining 0% lock loss and zero deadline misses. Its measured p99 tick latency is 2.5 ms under nominal operation and 4.12 ms under deep replay, both below the 5 ms tick budget. The 400 Hz configuration is reported only as a stress-test regime to characterize timing headroom and overload behavior, not as the primary deployment claim. The reported deterministic behavior refers to the tested HIL runtime envelope and should not be interpreted as formal real-time or safety certification. © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

@CONFERENCE{Caiza2026491,
