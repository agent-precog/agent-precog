@ARTICLE{Wang202642332,
	author = {Wang, Junnan and Enright, Daniel and Kim, Hyoseung},
	title = {StateShield: Real-Time Defense Against Adversarial Attacks on Edge-Deployed DRL Agents},
	year = {2026},
	journal = {IEEE Internet of Things Journal},
	volume = {13},
	number = {18},
	pages = {42332 - 42346},
	doi = {10.1109/JIOT.2026.3710678},
	url = {https://www.scopus.com/pages/publications/105044337791?origin=resultslist},
	abstract = {Deep reinforcement learning (DRL) is increasingly deployed on resource-constrained edge devices for intelligent Internet of Things (IoT) applications, ranging from smart sensing to autonomous robots. However, DRL agents remain vulnerable to adversarial observation attacks that can compromise decision-making processes in latency-sensitive control loops. While runtime defenses exist, their design imposes heavy computational overhead at every control step, making them impractical for edge deployment. This article presents StateShield, a defense framework specifically designed for edge AI systems that reconciles robust security with real-time operation. StateShield introduces a lightweight detection mechanism anchored on the StateShield region (SSR) - a sparse, deterministic subset of the state that forces attackers to reveal themselves through gradient significance. We integrate this detector into a pipelined DRL execution architecture that minimizes inference latency through parallelization and speculative execution. We present a timing analysis of our framework for heterogeneous CPU-GPU edge platforms and validate our methodology across three diverse domains: robotic navigation, edge cluster scheduling, and visual control. Experiments on an NVIDIA AGX Xavier demonstrate that StateShield achieves an average of 96% detection accuracy against gradient-based attacks while reducing end-to-end latency by up to 96% compared to the state-of-the-art DRL defenses and maintaining deadline compliance under high-contention scenarios.  © 2014 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Podbucki2026,
	author = {Podbucki, Kacper and Szalwach, Bartłomiej},
	title = {Cost-Effective Edge AI: Hailo-8 Powered Raspberry Pi vs. NVIDIA Jetson AGX Orin in Airport Infrastructure Monitoring},
	year = {2026},
	journal = {Electronics (Switzerland)},
	volume = {15},
