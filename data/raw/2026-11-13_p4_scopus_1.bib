@ARTICLE{Dai202622343,
	author = {Dai, Zifeng and Xie, Hui and Wei, Shengjun and Hu, Changzhen},
	title = {Meta-Policy-Based Multi-Agent Reinforcement Learning for Dynamic UAV Networks: Resolving Hybrid Action Spaces and Non-Stationarity},
	year = {2026},
	journal = {IEEE Transactions on Vehicular Technology},
	volume = {75},
	number = {10},
	pages = {22343 - 22356},
	doi = {10.1109/TVT.2026.3700721},
	url = {https://www.scopus.com/pages/publications/105041259280?origin=resultslist},
	abstract = {Synergistically optimizing cooperative trajectory and task offloading in UAV-assisted Mobile Edge Computing (MEC) is a critical challenge for 6G-enabled ubiquitous computing. However, existing multi-agent reinforcement learning (MARL) frameworks suffer from severe gradient scale mismatch in hybrid action spaces, multiplier oscillations under non-convex fairness constraints, and strategic non-stationarity in dynamic environments. This paper proposes MAPA-MARL, a novel meta-policy framework designed to structurally resolve these bottlenecks. Specifically, we formulate the joint optimization as a Constrained Markov Decision Process (CMDP) and introduce a PID-Lagrangian mechanism to enforce Jain’s Fairness Index, utilizing Exponential Moving Average (EMA) filtered derivative damping to safely suppress the instability typical of traditional dual ascent. To handle the hybrid decision-making space, we develop a Dual-Head Actor architecture integrated with a Variance-Bounded Zero-temperature Gumbel-Rao (ZGR) estimator. This provides a low-variance empirical gradient proxy, effectively mitigating the gradient variance explosion and preventing the meta-initialization collapse induced by conventional discrete relaxations. Furthermore, a Sparsity-Induced Inverse-Distance Soft-Mask is proposed; rather than merely reducing computational complexity, it acts as a topological regularizer to block polluted gradients from distant agents, thereby stabilizing local coordination. To anchor convergence against peer-evolution without inter-UAV parameter sharing, we integrate an RNN-based implicit opponent modeling module augmented with Hessian-Vector Product (HVP) second-order curvature compensation. Extensive simulations demonstrate that MAPA-MARL achieves superior Pareto efficiency with a minimal 18.5 MB memory footprint and millisecond-level onboard inference latency, confirming its robust viability for resource-constrained edge deployment. © 1967-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Abbass2026,
	author = {Abbass, Waseem and Abbas, Nasim and Majeed, Uzma},
	title = {Prevail: A 6G spatio-temporal graph learning framework for traffic vulnerability prediction},
	year = {2026},
	journal = {Computer Communications},
	volume = {250},
	pages = {},
	doi = {10.1016/j.comcom.2026.108466},
	url = {https://www.scopus.com/pages/publications/105034271755?origin=resultslist},
	abstract = {AbstractThe rapid growth of connected and autonomous vehicles in 6G-enabled urban environments demands predictive intelligence that is not only accurate but also operationally feasible under stringent real-time, bandwidth, and energy constraints. Existing spatio-temporal graph neural network (ST-GNN) approaches achieve strong predictive accuracy but often disregard deployment limitations such as latency budgets, communication overhead, and robustness to corruption, thereby limiting their practical utility. To address these challenges, we propose PREVAIL, a resource-aware ST-GNN framework for proactive vulnerability prediction in intelligent transportation systems. PREVAIL embeds deployment realism directly into its learning objective through budget-aware training that couples accuracy with latency and bandwidth penalties. In addition, it integrates anytime inference for early exits, hierarchical scheduling for city-scale scalability, and corruption-aware training to enhance resilience under packet loss, quantization, and latency-induced staleness. Extensive experiments on benchmark traffic datasets (METR-LA, PEMS-BAY) and large-scale mobility traces (NYC Taxi, Chicago CTA) demonstrate that PREVAIL achieves up to 12.5% lower prediction error and 15.3% higher top-k detection accuracy compared to state-of-the-art baselines including DCRNN, Graph WaveNet, and STGCN. Robustness evaluations confirm graceful degradation under adverse network conditions, while deployment tests on Jetson Nano and Raspberry Pi platforms validate sub-second to near-real-time inference with superior accuracy-per-watt performance. Experiments on incident and demand surges further illustrate PREVAIL’s ability to provide actionable foresight in complex traffic scenarios. These results collectively establish PREVAIL as a cyber-resilient and deployment-feasible solution under practical operational constraints, effectively bridging the gap between algorithmic advances and the operational demands of next-generation intelligent transportation systems. © 2026 Elsevier B.V. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

