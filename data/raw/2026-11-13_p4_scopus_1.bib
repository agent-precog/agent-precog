@ARTICLE{Jia2025,
	author = {Jia, Liye and Guan, Runwei and Zhao, Haocheng and Zhao, Qiuchi and Man, Ka Lok and Smith, Jeremy and Yu, Limin and Yue, Yutao},
	title = {Radarnext: lightweight and real-time 3D object detector based on 4D mmWave imaging radar},
