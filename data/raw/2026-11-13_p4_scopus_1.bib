	doi = {10.1109/ICMSCI67830.2026.11469199},
	url = {https://www.scopus.com/pages/publications/105037954639?origin=resultslist},
	abstract = {Mass gatherings in public venues and transport hubs pose safety risks due to overcrowding and unexpected emergencies. Nevertheless, most of the existing crowdmonitoring systems are solely dependent on single-modality sensing, centralized cloud processing, or laborious manual oversight. This paper presents the design of a resilient and privacy-preserving IoT for crowd safety management that effectively integrates multiple sensing modalities: RGB/thermal vision, WiFi-based crowd estimation, and acoustic/event sensing alongside lightweight inference at the edge on resource-constrained devices. A self-healing network can independently detect faults, dynamically reconfigure, and maintain continuity, while an intelligent multi-channel alert engine prioritizes notifications across push, SMS, sirens, and responder consoles. Multi-modal sensor fusion leverages WiFi-based probabilistic estimation and fuses it with visionbased density modeling to improve robustness in low-light or occluded environments. The notion of self-healing further reduces downtime and blind-spots, while edge-first alerting ensures rapid, low-latency dissemination of critical warnings. With a comprehensive prototype evaluation, the system demonstrates high accuracy, fast response times, and is resilient to sensor failures and varying crowd conditions.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

