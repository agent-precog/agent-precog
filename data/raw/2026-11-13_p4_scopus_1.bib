}

@ARTICLE{Paul20263021,
	author = {Paul, Anal and Singh, Keshav},
	title = {Large AI Model-Driven Quantum-Enhanced Transformer-VQC Federated DRL for Privacy Preservation in Vehicular Networks},
	year = {2026},
