	doi = {10.1007/978-3-032-39708-9_3},
	url = {https://www.scopus.com/pages/publications/105052847113?origin=resultslist},
	abstract = {The use of multimodal artificial intelligence (AI) in autonomous systems has gained significant attention, as the integration of visual, LiDAR, and radar data can improve perception and decision-making capabilities. However, developing architectures that effectively combine multiple sensing modalities while meeting real-time constraints, operating under limited energy budgets, and maintaining reliability in uncertain environments remains a major challenge. This study proposes and evaluates a multimodal AI architecture for real-time decision-making in autonomous systems, focusing on task accuracy, computational efficiency, and safety under constrained embedded hardware conditions. The proposed framework integrates a cross-attention transformer, a sparsely gated Mixture-of-Experts module, and adaptive early-exit classifiers to support efficient multimodal processing. Experiments were conducted using the nuScenes and Waymo Open datasets. Validation was supported by industry deployment reports and structured expert interviews from the automotive, robotics, and aerospace sectors. Hardware evaluations on NVIDIA Jetson AGX Orin and Jetson Orin Nano platforms measured latency, jitter, deadline-miss rate, and energy consumption. The proposed architecture achieved up to 71% 3D mAP, while reducing average latency to 41 ms on AGX Orin and 55 ms on Orin Nano. Energy consumption per decision was reduced by more than 40%, and the deadline-miss rate was less than 5%. Calibration error was reduced by more than 50%, and robustness evaluations indicated consistent performance under sensor dropouts, temporal misalignments, and simulated adverse weather conditions. The results suggest that multimodal architectures incorporating adaptive computation and uncertainty calibration can improve real-time efficiency, robustness, and safety on edge computing platforms. The study contributes a multimodal architecture for real-time decision-making in autonomous systems. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2027.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Chavhan2026,
	author = {Chavhan, Suresh and Kancharala, Gowtham and Moussa, Sherif},
	title = {Wireless edge intelligence: A GenAI-enhanced reinforcement learning framework for efficient autonomous vehicle navigation},
	year = {2026},
