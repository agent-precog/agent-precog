@ARTICLE{Liu2026,
	author = {Liu, Fante and Caremel, Cedric and D. Ta, Tung and Fan, Yeman and Dai, Feng and Kawahara, Yoshihiro and Kamezaki, Mitsuhiro},
	title = {PhysRes-MPC: Physical Hysteretic Reservoir Computing for Embedded Control of Liquid-to-Gas Phase-Change Actuators},
	year = {2026},
