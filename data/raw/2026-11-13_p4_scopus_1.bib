}

@BOOK{Kulandaivelu2026261,
	author = {Kulandaivelu, Suresh and Mazar, Syied and Sangeetha, N. and Rajavelu, Sathiyapriya and Garhwal, Anita},
	title = {Spatiotemporal Attention-Based CNN-BiLSTM Model for Robust Lane and Obstacle Detection in IoV-Enabled Autonomous Driving},
	year = {2026},
