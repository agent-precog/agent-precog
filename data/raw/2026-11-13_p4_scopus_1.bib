@CONFERENCE{Zhen2026,
	author = {Zhen, Hao and Chen, Guijun and Guan, Fangli and Zhang, Jianhui},
	title = {EGS-Light-YOLOv12: Lightweight YOLOv12 for UAV Small-Object Detection},
	year = {2026},
	journal = {DLCV 2026 - 2026 IEEE 3rd International Conference on Deep Learning and Computer Vision},
	pages = {},
	doi = {10.1109/DLCV69906.2026.11635272},
	url = {https://www.scopus.com/pages/publications/105047676179?origin=resultslist},
	abstract = {With the widespread deployment of unmanned aerial vehicles (UAV) in traffic inspection, urban security, and emergency rescue, UAV-view object detection is required to maintain high accuracy for small objects while satisfying the demands of real-time inference and lightweight edge deployment. However, existing methods generally retain high-level detection branches that are more suitable for medium and large objects, yielding limited gains for small-object detection while introducing additional computational overhead. In addition, insufficient feature representation makes weak-textured small objects highly dependent on contextual cues, whereas enhancement strategies dominated by local convolutions struggle to preserve fine-grained structural details. Under lightweight design constraints, multiscale upsampling and feature fusion are also prone to introducing channel imbalance and semantic noise, thereby degrading robustness in dense and complex scenes. To address these issues, this paper proposes EGS-Light-YOLOv12. To alleviate structural redundancy, the detection head and multi-scale branches are pruned and restructured to reduce redundant computation. To improve feature representation, a C3k2_EVA module is proposed, where EVA incorporates large-kernel convolution and efficient attention to enlarge the effective receptive field and strengthen the representation of weak semantic structures. To enhance feature transmission stability, GSConvE and SNI are further proposed to improve convolutional modeling efficiency and stabilize semantic propagation through channel-adaptive soft interpolation while suppressing fusion noise. The proposed method contains 2.2M parameters, with a model size of 4. 6 ~ M B and 1 8. 5 ~ G F L O P s. ~ O n ~ the VisDrone2019 dataset, it achieves 42.1 mAP@0.5 and 25.5 mAP@0.5:0.95.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

