}

@CONFERENCE{Huang2026392,
	author = {Huang, Runxi and Yu, Mingxuan and Tsoi, Mingyu and Ouyang, Xiaomin},
	title = {MMEdge: Accelerating On-device Multimodal Inference via Pipelined Sensing and Encoding},
	year = {2026},
	journal = {SenSys 2026 - Proceedings of the 2026 ACM/IEEE International Conference on Embedded Artificial Intelligence and Sensing Systems, Part of CPS-IoTWeek 2026},
	pages = {392 - 406},
	doi = {10.1145/3774906.3800485},
	url = {https://www.scopus.com/pages/publications/105041082266?origin=resultslist},
	abstract = {Real-time multimodal inference on resource-constrained edge devices is essential for applications such as autonomous driving, human-computer interaction, and mobile health. However, prior work often overlooks the tight coupling between sensing dynamics and model execution, as well as the complex inter-modality dependencies. In this paper, we propose MMEdge, a new on-device multimodal inference framework based on pipelined sensing and encoding. Instead of waiting for complete sensor inputs, MMEdge decomposes the entire inference process into a sequence of fine-grained sensing and encoding units, allowing computation to proceed incrementally as data arrive. MMEdge also introduces a lightweight but effective temporal aggregation module that captures rich temporal dynamics across different pipelined units to maintain accuracy performance. Such pipelined design also opens up opportunities for fine-grained cross-modal optimization and early decision-making during inference. To further enhance system performance under resource variability and input data complexity, MMEdge incorporates an adaptive multimodal configuration optimizer that dynamically selects optimal sensing and model configurations for each modality under latency constraints, and a cross-modal speculative skipping mechanism that bypasses future units of slower modalities when early predictions reach sufficient confidence. We evaluate MMEdge using two public multimodal datasets and deploy it on a real-world unmanned aerial vehicle (UAV)-based multimodal testbed. The results show that MMEdge significantly reduces end-to-end latency while maintaining high task accuracy across various system and data dynamics. A video demonstration of MMEdge's performance in real world is available at https://youtu.be/qRew7sT-iWw. <sup>1</sup> © 2026 Copyright held by the owner/author(s).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Peng202629,
	author = {Peng, Sitian and Wang, Rui},
	title = {EdgeCurator: Efficient Cross-Modal Grounding for Real-Time Language-Guided UAV Navigation},
	year = {2026},
	journal = {EReL-MIR 2026 - Proceedings of the 2nd International Workshop on Efficient Representation Learning for Multimodal Information Retrieval},
	pages = {29 - 37},
	doi = {10.1145/3840749.3841574},
	url = {https://www.scopus.com/pages/publications/105055791553?origin=resultslist},
	abstract = {Deploying cross-modal representations on a micro Unmanned Aerial Vehicle (UAV) requires accurate language-vision alignment and low-latency inference under tight compute constraints. Heavy Vision-Language Models (VLMs) provide strong semantic reasoning but are often unsuitable for an onboard control loop, whereas lightweight visual backbones commonly defer language fusion to a separate planning stage. We present EdgeCurator, a compact end-to-end early-fusion framework for real-time language-guided UAV navigation in access-controlled indoor spaces. Its Semantic-Spatial Grounding (SSG) Head converts lightweight text embeddings into semantic queries and uses conditioned deformable cross-attention to sparsely sample multi-scale visual features. On the custom Expo-VLN benchmark, EdgeCurator uses 14.8M parameters, runs at 54 FPS on an NVIDIA Jetson Orin NX, and reaches 67.3% grounding accuracy and 62.8% navigation success. We additionally report 60 controlled physical trials with two target types, achieving 78.3% success. These trials test onboard Sim2Real feasibility for pre-opening inspection and curation assistance; they do not establish operation around visitors or generalization to full exhibition deployments. The results position EdgeCurator as an efficiency-oriented cross-modal representation and grounding system for resource-constrained aerial agents.  © 2026 Copyright held by the owner/author(s).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@CONFERENCE{Badiger20261210,
	author = {Badiger, Sadashiv and Sandipkumar, Aniketanand and Shaikh, Altaf and Jaiswal, Anil Brijlal},
	title = {Edge-AI Based Activity Recognition for Elderly Homes},
	year = {2026},
