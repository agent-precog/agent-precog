@ARTICLE{Cao2026,
	author = {Cao, Yuhan and Zhu, Haotian and Zhao, Bimei and Guan, Wenbo and Lai, Yuping},
	title = {LightGT: Lightweight graph-aware LLM-style transformer for industrial control intrusion detection},
	year = {2026},
	journal = {Neurocomputing},
	volume = {706},
	pages = {},
	doi = {10.1016/j.neucom.2026.134970},
	url = {https://www.scopus.com/pages/publications/105050638706?origin=resultslist},
	abstract = {The cybersecurity of Industrial Control Systems (ICS), which are crucial for a nation's essential infrastructure, is closely tied to the reliable operation of sectors like manufacturing and energy. As industrial control networks become increasingly interconnected and exposed to external communication channels, novel cyber threats—such as ransomware and Advanced Persistent Threats (APTs)—are continually emerging. Accurate and prompt intrusion detection has become crucial for ensuring industrial safety. However, traditional methods depend on signature matching and Deep Packet Inspection (DPI), which present significant limitations when addressing encrypted traffic, proprietary protocols, and multi-stage Advanced Persistent Threat (APT) attacks. Detection delays and increased false positive rates stem from several factors, including the lag in updating signature databases, the challenges in identifying dynamic device topologies, and the complexities of modeling long-term contextual dependencies associated with packet length. This paper proposes LightGT, a lightweight Transformer architecture inspired by LLM-style design principles—namely byte-level tokenization and attention-based sequence modeling—for intrusion detection in industrial control systems. This model uses byte-level tokenization to convert raw PCAP traffic into semantic units while preserving the fine-grained details of protocol fields. It enhances sequence-level representations with device communication graph features through a topology-aware fusion module, allowing awareness of lateral movement within attack chains across devices. To substantially decrease memory usage and latency while maintaining the ability to model bidirectional context, a block attention mechanism has been developed that lowers computational complexity from O(L<sup>2</sup>) to O(KC<sup>2</sup>). The model exhibits a profound semantic comprehension of industrial control protocols such as Modbus and S7Comm. It achieves this by hierarchically extracting features from byte-level patterns, progressing to more abstract representations of multi-stage attack behaviors through a stacked encoder comprising 36 layers. LightGT demonstrates a marked superiority over various baseline models while meeting the inference latency criteria essential for industrial edge deployment. This conclusion is drawn from experimental findings on the CIC-Modbus, TON IoT, and CSET 2016 Modbus datasets, which yielded F1 scores of 99.04%, 99.21%, and 92.97%, respectively. © 2026 Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

