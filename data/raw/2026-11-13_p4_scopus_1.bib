	url = {https://www.scopus.com/pages/publications/105037466511?origin=resultslist},
	abstract = {In the long-haul maritime transportation, approximately 1.9 million seafarers work for extended periods in steel-enclosed environments, isolated from onshore facilities. They are vulnerable to disturbances from factors such as circadian rhythm disorders, glare, vibration, and noise, which lead to unstable conditions and potential safety risks. Statistics indicate that the incidence of symptoms related to impaired operational capabilities among seafarers is roughly four times that of onshore populations, and maritime accidents associated with human error account for approximately 13%. Addressing this practical scenario, this paper proposes MAR-MHNet: a shipborne multimodal monitoring framework integrating cross- modal reliability-aware attention (RA-CMA) and self-adaptive Bayesian threshold (SABT). RA-CMA achieves fine-grained alignment of visual and audio modalities through bidirectional Cross-Attention, measures modal credibility using attention entropy, and dynamically fuses them via gating. SABT derives thresholds online based on the minimum posterior risk, outputting interpretable "normal/alarm"labels and continuous risk scores. The model is pre-trained on DAIC-WOZ/CMU- MOSEI/MSP-IMPROV and adapted to real shipborne data (14,006 6-second segments) using MMD+GRL. It achieves Macro-F1=91.2% and AUC=0.946 on the main task (6.2% and 0.031 higher than strong baselines; p<0.01), with inference on Jetson Xavier at ≈110 ms/window (memory ≈1.3 GB). Ablation experiments show that removing the reliability gating or using fixed thresholds reduces F1 by ≈3.1% and ≈2.4%, respectively. The framework combines high accuracy, low latency, and deployability, providing an engineering path for active crew state monitoring and shipborne safety. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Kirnos2026,
	author = {Kirnos, Vasily P. and Mogulev, Maxim A. and Priorov, Andrey L.},
