}

@ARTICLE{Bhattacharjee2026,
	author = {Bhattacharjee, Parichay and Sinha, Ditipriya},
	title = {Internet of things for the future of smart manufacturing: A five-layer architectural survey of technologies, applications, and research frontiers},
