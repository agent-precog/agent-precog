}

@ARTICLE{Shen2026,
	author = {Shen, Zixuan and Xiao, Jian and Dong, Boyi and Wei, Zhengzhe and Tan, Yulong and Wu, Zhigang and Zheng, Yuanjin and Wang, Chao},
	title = {MT-REN: An Energy-Efficient Metric–Topology-Fusion Reconfigurable End-to-End GVD-NeuroSLAM Accelerator for Autonomous Microrobots},
	year = {2026},
	journal = {IEEE Transactions on Very Large Scale Integration (VLSI) Systems},
	pages = {},
	doi = {10.1109/TVLSI.2026.3718298},
	url = {https://www.scopus.com/pages/publications/105047053712?origin=resultslist},
	abstract = {Path exploration, localization, and mapping are fundamental capabilities for autonomous microrobots, which require high energy efficiency and low hardware overhead for long-term edge deployment. However, it remains challenging to simultaneously achieve high energy efficiency, high precision, and low latency on energy-constrained robotic platforms. To address the above challenges, this article proposes a brain-inspired metric–topology-fusion reconfigurable GVD-NeuroSLAM hardware accelerator. At the algorithm level, a metric–topology-fusion GVD-NeuroSLAM algorithm is proposed, where a generalized Voronoi diagram (GVD) provides topology-constrained metric estimation to enhance the precision of NeuroSLAM, while NeuroSLAM provides metric-corrected exploration-direction refinement to achieve efficient exploration. At the architecture level, a reconfigurable end-to-end GVD-NeuroSLAM hardware accelerator, MT-REN, is proposed, which integrates a topology-guided LiDAR point filtering module and a metric-guided continuous attractor neural network (CANN) module to reduce redundant exploration energy consumption while improving SLAM precision. At the microarchitecture level, a fast-convergence CORDIC-based configurable coordinate calculation module and a workload-aware reconfigurable dual-mode processing element (PE) cluster are developed to further enhance energy efficiency, hardware utilization, and computational speed. FPGA implementation results show that the proposed MT-REN achieves significantly higher energy efficiency than conventional visual SLAM (VSLAM) accelerators and higher precision with negligible hardware and latency overhead than the state-of-the-art NeuroSLAM accelerator. © 1993-2012 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Alizadeh Arasi2026,
	author = {Alizadeh Arasi, Aysan and Sadighi, Ali},
	title = {Vision-based tactile sensing for robotic grasping: An autoencoder-based approach to generalizable slip detection},
	year = {2026},
	journal = {Results in Engineering},
	volume = {32},
	pages = {},
	doi = {10.1016/j.rineng.2026.111965},
	url = {https://www.scopus.com/pages/publications/105044949286?origin=resultslist},
	abstract = {Vision-based tactile sensing provides detailed contact information for manipulation tasks such as slip detection, enabling grippers to adjust forces dynamically when handling unknown objects. While deep learning can relieve us of performing manual feature engineering on images obtained from tactile sensors, these models often overfit and require extensive labeled data, resulting in object-specific rather than generalizable slip cues. This work presents an autoencoder-based tactile learning framework that leverages abundant unlabeled tactile images to improve slip detection across unseen object conditions while meeting real-time inference requirements. By employing unsupervised representation learning, the proposed approach is shown to make slip-related temporal cues more distinctive, emphasizing slip-relevant dynamics while reducing reliance on labeled data. Under domain shift, the proposed Encoder–LSTM remains consistently competitive with the CNN–LSTM baseline in F1-score and achieves comparable accuracy to a strong spatiotemporal ConvLSTM baseline while reducing inference latency by more than a factor of two. The learned representation also supports multi-task tactile perception, enabling slip detection and normal/tangential force estimation with 95% confidence intervals of 0.246 N and 0.103 N, respectively. The full pipeline achieves 19.5 ms inference on a Jetson Nano, compared with 49.8 ms for ConvLSTM. Integrated into a closed-loop control system, the method relies solely on tactile feedback to maintain stable grasps, demonstrating accurate, low-latency slip perception for adaptive robotic manipulation. © 2026 The Author(s).},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Wei2026,
	author = {Wei, Zhe and Wang, Rui and Dai, Rong and Xu, Haibo and Zhang, Huan and Zou, Yurong},
	title = {YOLO-Crack: Geometry-Guided Real-Time Crack Detection Framework Toward Edge Deployment},
	year = {2026},
