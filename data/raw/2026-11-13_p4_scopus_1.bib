	author = {Shao, Yang and Cui, Jiale and Tang, Chen and Liu, Zhenqing and Xu, Fengjiao and Zhai, Ruifang and Yang, Wanneng and Song, Peng},
	title = {From on-device vision to assisted harvesting: A lightweight real-time ripeness evaluation system for truss-harvested cherry tomatoes on augmented reality glasses},
	year = {2026},
	journal = {Artificial Intelligence in Agriculture},
	volume = {16},
	number = {3},
	pages = {1984 - 1999},
	doi = {10.1016/j.aiia.2026.08.003},
	url = {https://www.scopus.com/pages/publications/105048181471?origin=resultslist},
	abstract = {The transition from experience-driven manual harvesting to data-driven intelligent management represents a pivotal shift in modern facility agriculture. However, the widespread adoption of fully autonomous systems remains constrained by the environmental complexity of greenhouses and the high cost of agricultural robotics. Focusing on the practical challenges of truss-harvested tomato production, this study proposes an augmented reality (AR)-assisted real-time maturity assessment and in-situ decision-support system that bridges manual labor and intelligent automation through human–machine collaboration. At the core of the system is DGTruss-YOLO, an improved lightweight YOLOv11 model tailored for resource-constrained wearable devices. The architecture integrates a Spatial–Channel Reconstruction Convolution (ScConv) module to suppress spatial and channel-wise feature redundancy, and a Multi-scale Feature Modulation-based Auxiliary Feature Pyramid Network (MFM-MAFPN) to jointly capture fine-grained individual fruit textures and the global structural characteristics of tomato trusses. To ensure seamless edge deployment, a simplified standard convolution-based Efficient_Detect head is employed to enhance hardware compatibility and inference efficiency on AR smart glasses. Furthermore, a practical weighted grading strategy is introduced to map fruit-level recognition results to a five-grade (A-E) truss maturity index, aligning visual perception outcomes with practical harvesting requirements. Experimental results demonstrate that the optimized model reduces parameter count and computational complexity by 11.07% and 12.70%, respectively, compared to the baseline YOLOv11, while maintaining a stable real-time inference speed of 15–20 FPS on AR smart glasses. The proposed system achieves a truss-level maturity assessment accuracy of 95.26% with 100% adjacent-tolerance accuracy, providing a consistent model-based truss-level maturity assessment to support harvesting decisions in complex greenhouse environments. By providing intuitive, hands-free, and in-situ visual guidance, this work establishes a practical technical pipeline for human–machine collaborative harvesting and offers a practical reference for deploying edge-side deep learning solutions in sustainable and intelligent agricultural production. © 2026 The Authors},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

