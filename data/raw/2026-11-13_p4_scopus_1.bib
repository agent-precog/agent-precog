@ARTICLE{Sarkhi2025629,
	author = {Sarkhi, Mohammed},
	title = {Distributed MADRL with Proactive Traffic Prediction for Scalable and Reliable 6G Resource Allocation},
	year = {2025},
	journal = {International Journal of Intelligent Engineering and Systems},
	volume = {18},
	number = {11},
	pages = {629 - 644},
	doi = {10.22266/ijies2025.1231.39},
	url = {https://www.scopus.com/pages/publications/105022406427?origin=resultslist},
	abstract = {Future wireless communications (6G and onwards) are faced with capital issues of dynamic resource management due to limited availability of the spectrum, Quality of Service (QoS) requirements, and energy efficiency concerns. Traditional static or reactive methods are unable to meet the stringent latency and reliability requirements of applications like ultra-reliable low-latency communication (URLLC), resulting in degradation of network performance. To address this, we propose a new Multi-Agent Deep Reinforcement Learning (MADRL) framework with the addition of Gated Recurrent Unit (GRU)-aided traffic prediction. Our method enables distributed base stations (BSs) to pre-provision resources by predicting future requests, optimizing throughput, URLLC reliability, and power efficiency in a coordinated fashion. Simulations in 3GPP-calibrated environments demonstrate that the system achieves 99.999% URLLC reliability (0.0008% packet loss), 15% increased throughput compared to traditional methods, and scalability to 100+ BSs with minimal loss in performance. Innovations are a multi-objective reward function that compromises between QoS metrics and implicit coordination among neighboring base stations. The system has energy efficiency at 21.5W per BS, even surpassing centralized solutions with 3× higher energy costs. The practical viability of the framework is illustrated by the fact that it complies with Open Radio Access Network (O-RAN) standards whereby a total control-loop latency of 5ms is well within the Near-Real-Time RAN Intelligent Controller (Near-RT RIC) window and is also supported with real-world datasets.This work fills the gap between practice and theory, offering a template for intelligent 6G networks that can satisfy heterogeneous requirements with scalability and operational feasibility. The future directions involve federated learning extensions and light GRU models for edge deployment. This article is licensed under a Creative Commons Attribution-ShareAlike 4.0 International License. License details: https://creativecommons.org/licenses/by-sa/4.0/},
	type = {Article},
	publication_stage = {Final},
