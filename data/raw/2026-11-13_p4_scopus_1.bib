@ARTICLE{Xu2025,
	author = {Xu, Weiyue and Su, Qiong and Ji, Tianyu and Sun, Haonan and Chen, Wei and Ji, Changying and Wang, Tianyi},
	title = {Real-time pest monitoring with RSCDet: Deploying a novel lightweight detection model on embedded systems},
	year = {2025},
