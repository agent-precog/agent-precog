	doi = {10.1109/CCWC67433.2026.11393728},
	url = {https://www.scopus.com/pages/publications/105035597609?origin=resultslist},
	abstract = {Additive manufacturing (AM) workloads in the Industry 4.0/5.0 era impose heterogeneous and deterministic Quality of Service (QoS) requirements across high-rate video, closed-loop control, and dense sensing. Existing 5G control and orchestration stacks emphasize full life-cycle management across multi-domain, telecom-scale infrastructures, coupling numerous services (policy, inventory, analytics, orchestration) and relying on NFV-MANO workflows. These approaches increase footprint and complexity, making low-cost edge deployments and reproducible N6-path QoS enforcement difficult in industrial settings. In contrast, we present a modular and lightweight SDN-enabled 5G network slicing framework for AM that leaves the 3GPP core unmodified and enforces slice-specific QoS on the N6 path. The design integrates the OpenAirInterface (OAI) 5G Core with an Open Network Operating System (ONOS)controlled Open vSwitch (OVS) to enable programmable traffic steering and externalized QoS control. Industrial use cases map to three logical slices: enhanced Mobile Broadband (eMBB) for video monitoring, Ultra-Reliable Low-Latency Communications (URLLC) for robotic control, and massive Machine-Type Communications (mMTC) for sensor telemetry using a simple, deterministic classifier that is readily extendable to QFI-aware policies. Experiments on a Docker-based testbed show sub- 10 ms URLLC latency with tight jitter, ≈ 100 Mb / s eMBB throughput under rate shaping, and >99% mMTC delivery reliability while consuming <25% CPU and ∼ 420MB memory. Compared to NFV/MANO-driven orchestrators reported in prior work, this corresponds to an overall ∼ 70% reduction in control-plane footprint and ≈ 200 ms reconfiguration time. The OAI-ONOSOVS integration offers a reproducible, scalable, and edge-ready approach to deterministic industrial 5 G networking for nextgeneration additive manufacturing. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Shishira2026,
