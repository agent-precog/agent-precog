@ARTICLE{Ali20261532,
	author = {Ali, Adnan and Li, Jinlong and Ahmed, Farooq and Xie, Hai and Alsisi, Rayan Hamza},
	title = {RobuGCL: Stability-Aware Graph Contrastive Learning Against AI-Enabled Attacks in Consumer Electronics},
	year = {2026},
	journal = {IEEE Transactions on Consumer Electronics},
	volume = {72},
	number = {1},
	pages = {1532 - 1543},
	doi = {10.1109/TCE.2025.3649554},
	url = {https://www.scopus.com/pages/publications/105034618578?origin=resultslist},
	abstract = {Graph contrastive learning (GCL) is a powerful paradigm for self-supervised representation learning on consumer electronics (CE) graphs. Conventional GCL lacks temporal, multi-channel adversary modeling and typically relies on uniform, all-node negatives, making it fragile under CE adversarial conditions and memory- and latency-intensive on-device budgets. We propose RobuGCL, a stability-aware framework designed for CE memory, compute, and latency constraints. RobuGCL integrates two co-designed components: (i) a Temporal Adversarial Contrastive Attack (TACA), which periodically applies worst-case structure, feature, and projection perturbations together with a stability regularizer to align clean and perturbed embeddings; and (ii) a budgeted, adaptive negative sampler, which partitions negatives into easy/medium/hard pools and expands the sampled set only when the training loss plateaus, under a strict 50% global cap, effectively halving the worst-case contrastive denominator versus all-negatives. This design allows the contrastive objective to respond dynamically to attack-induced distribution shifts while bounding peak memory compared to all-negatives baselines. We evaluate RobuGCL on nine public benchmarks: the clean-training variant (RobuGCL<sub>c</sub>) on all nine and the full adversarial model on eight (DBLP is excluded during the adversarial pass for GPU memory). Relative to the strongest published baseline per dataset, the full RobuGCL achieves state-of-the-art micro-F1 on 7/8 adversarially trained datasets (and 8/9 when including RobuGCL<sub>c</sub> on DBLP), with gains up to + 2.40 percentage points. Under unseen attacks at 35% budget (RANDOM, DICE, DICE<sub>d</sub>), RobuGCL incurs \le 1.0% relative F1-Drop on five of six datasets for deletion-only DICE<sub>d</sub>, while mixed DICE (additions + deletions) is more disruptive. By jointly addressing robustness and efficiency, RobuGCL advances practical graph representation learning for CE applications such as recommendation, personalization, and IoT analytics. © 1975-2011 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Madavath202625,
	author = {Madavath, Abilash Philip and Aubeeluck, Chandra Yuvesh and Raju, Augustin and Hackeloer, Felix and Zwanzig, Florian and Pyschny, Nicolas},
	title = {Classical Trajectory Planning for Dual-Camera Visual Servoing on Edge Systems},
	year = {2026},
	journal = {2026 12th International Conference on Mechatronics and Robotics Engineering, ICMRE 2026},
	pages = {25 - 30},
	doi = {10.1109/ICMRE69538.2026.11533919},
	url = {https://www.scopus.com/pages/publications/105042174619?origin=resultslist},
	abstract = {Grasping moving objects in industrial environments requires precise synchronization between perception and robot actuation. While deep learning has advanced object detection, the latency introduced by Edge AI computation can degrade interception accuracy in high-speed conveyor applications. This paper presents a comparative analysis of trajectory prediction and interception algorithms implemented on an edge platform (NVIDIA Jetson Orin Nano). The proposed system utilizes a dual-camera architecture, handing over control from a conveyor overhead predictor to a local wrist-mounted visual servo. We study two prediction algorithms (RANSAC-based linear extrapolation versus Kalman filtering) and five interception strategies (Analytical Linear, Fixed-Point Iteration, Newton-Raphson, Secant, and Bisection methods) against ground-truth data obtained via an OptiTrack motion capture system. Results indicate that while RANSAC offers superior fitting accuracy, the Kalman filter provides the low-latency performance required for real-time control. Among interception solvers, the Newton-Raphson method demonstrated the optimal balance between computational speed and stability. Furthermore, we analyze the impact of adding lead time on the interception success rate. The results quantify these trade-offs, establishing design guidelines for algorithm selection in real-time dynamic picking.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Vontela2026651,
	author = {Vontela, Prashanth Reddy},
	title = {AI-Driven Adaptive User Interfaces: Architecture & Real-World Implementation},
	year = {2026},
	journal = {Proceedings of 3rd International Conference on Machine Learning and Autonomous Systems, ICMLAS 2026},
