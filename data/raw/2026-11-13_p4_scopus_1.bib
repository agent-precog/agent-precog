@CONFERENCE{Liu20251139,
	author = {Liu, Jinshuo and Li, Zhuangzhuang and Huang, Weijie},
	title = {Self-Supervised Multimodal 3D Object Recognition for Embodied Robotic Manipulation},
	year = {2025},
	journal = {2025 7th International Academic Exchange Conference on Science and Technology Innovation, IAECST 2025},
	pages = {1139 - 1143},
	doi = {10.1109/IAECST68792.2025.11415249},
	url = {https://www.scopus.com/pages/publications/105035830629?origin=resultslist},
	abstract = {To reduce the dependence on manual labels and improve robustness of embodied robots in complex 3D environments, this paper proposes a self-supervised multimodal 3D object recognition method based on RGB-depth-point cloud visual fusion. A unified multimodal acquisition and preprocessing pipeline is first established, where RGB images, aligned depth maps, and registered point clouds undergo denoising, geometric normalization, and cross-modal calibration to enhance structural and appearance consistency. On top of this, we design a selfsupervised cross-modal fusion network that combines a pointcloud encoder and an image-depth encoder with shared projection heads. Contrastive alignment and masked reconstruction tasks are jointly optimized, enabling label-free learning of geometry- and texture-aware representations. A lightweight attention fusion module dynamically adjusts modality weights according to local confidence, balancing robustness and efficiency. Experiments on a simulated tabletop benchmark and a real embodied manipulation setup show that the proposed method achieves higher 3D recognition accuracy and robustness than single-modality and supervised baselines, while requiring no manual labels for pretraining and maintaining real-time inference on an embedded GPU.  © 2025 IEEE.},
