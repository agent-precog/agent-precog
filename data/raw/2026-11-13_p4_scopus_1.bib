@CONFERENCE{Idrees2026894,
	author = {Idrees, Ali Kadhum and Idrees, Sara Kadhum and Azar, Joseph and Couturier, Raphael and Gechter, Franck and Schuster, Rolf},
	title = {EHALEYO: Edge AI-Based High-Accuracy, Lightweight, Enhanced YOLOv11 for Real-Time Small UAV Detection in Complex Environments},
	year = {2026},
	journal = {2026 International Wireless Communications and Mobile Computing Conference, IWCMC 2026},
