	pages = {},
	doi = {10.1016/j.jocs.2026.102990},
	url = {https://www.scopus.com/pages/publications/105049163879?origin=resultslist},
	abstract = {Graph Neural Networks (GNNs) are being increasingly explored in biomedical analysis, recommender systems, and scientific computing. Their deployment at the edge is attractive for latency, privacy, and bandwidth considerations, yet their behavior on resource-constrained hardware remains underexplored, especially regarding a systems and energy-efficiency perspective.To determine whether the benefits of reduced precision generalize across hardware platforms, workloads, and operating conditions, in this work, we compare single-precision floating point (FP32) and half-precision floating point (FP16) execution using five representative GNN architectures, namely GCN, GAT, GraphSAGE, GIN, and GraphGPS, on six graph datasets spanning node- and graph-level tasks. Experiments are performed on three NVIDIA Jetson power modes (15 W, 30 W, and 60 W) and on a desktop-class x86 system, while varying batch size and random seed. Efficiency is evaluated in terms of latency, throughput, energy consumption, energy per inference, and GPU memory usage, as well as predictive performance. The results show that reduced precision does not always act as an accelerator for edge GNN deployment. FP16 shows its clearest advantages during inference, particularly for selected compute-intensive configurations, whereas its effect on training energy and throughput remains mixed under constrained Jetson power modes. Dataset scale and workload structure further modulate these effects, however this interaction requires further investigation. Power mode and batch size seem to strongly affect absolute efficiency, while recurrent architecture-specific patterns remain visible across platforms and datasets. In particular, lightweight models such as GAT and GCN generally favor low-latency operation, whereas GraphGPS often achieves higher throughput at the cost of increased latency or energy consumption. © 2026 Published by Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Xu2026118938,
	author = {Xu, Yan and Chen, Jiabao and Liang, Mengmeng and Ben, Cheng},
	title = {Pruned-CAFM: A Lightweight UAV Remote Sensing Algorithm for Transmission-Line Foreign-Object Detection via Cross-Domain Transfer Learning, Cross-Layer Attention, and Dynamic Sparse Pruning},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {118938 - 118950},
	doi = {10.1109/ACCESS.2026.3717262},
	url = {https://www.scopus.com/pages/publications/105046335168?origin=resultslist},
	abstract = {Uncrewed aerial vehicle (UAV)-based transmission-line inspection represents a critical application of remote sensing for ensuring power grid safety. Detecting foreign objects - such as kite strings, plastic films, bird nests, and dust nets - on high-voltage lines demands algorithms that simultaneously achieve high recall, lightweight deployment, and real-time inference on resource-constrained edge devices. Existing methods either prioritize detection accuracy at the cost of prohibitive model complexity, or sacrifice small-object sensitivity in pursuit of compactness, and rarely address the semantic gap between generic pre-trained feature spaces and specialized UAV remote sensing domains. We present Pruned-CAFM, a novel algorithm that resolves this accuracy-efficiency dilemma through two synergistic innovations within a cross-domain transfer learning framework. First, we propose the Cross-layer Attention Feature Fusion Module (CAFM), which integrates multi-scale receptive field aggregation with a sequential channel-spatial hybrid attention mechanism employing a lightweight 7×7 depthwise separable convolution for spatial re-calibration, effectively suppressing complex backgrounds and sharpening feature representations of tiny foreign objects in UAV remote sensing imagery. Second, we introduce a domain-adaptive cross-domain transfer pruning paradigm: a YOLOv8s backbone pre-trained on COCO is first domain-adapted to the transmission-line visible-light remote sensing task via quantified feature distribution alignment, then subjected to L1 -regularized sparse training followed by global threshold-based structured pruning with topological-connectivity protection, and knowledge reconstruction fine-tuning - effectively bridging the COCO-to-TL-FOD semantic gap while eliminating task-irrelevant redundancy. Experiments on the self-constructed TL-FOD dataset (5000 UAV images covering kite, balloon, bird nest, and trash categories under diverse meteorological conditions) demonstrate that Pruned-CAFM achieves 97.5% mAP@0.5 and 95.9% recall with only 4.08M parameters and 12.21GFLOPs, delivering 115.1FPS on an NVIDIA Jetson Xavier NX edge platform. Compared with the YOLOv8s baseline, the model compresses parameters by 63.2% while improving recall by 2.1 percentage points, demonstrating a competitive accuracy-efficiency operating point for lightweight remote sensing object detection. The domain-adaptive transfer pruning paradigm is designed to be modality-agnostic, providing a generalizable framework whose extension to thermal infrared UAV inspection scenarios is identified as a promising direction for future work.  © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

