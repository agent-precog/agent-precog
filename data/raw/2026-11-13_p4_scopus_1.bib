@ARTICLE{Junaid Gul2026,
	author = {Junaid Gul, M. and Paul, Anal and Singh, Keshav and Garai, Partha},
	title = {An Energy-Aware Multi-Objective RL Agent for Green Traffic Signal Control on the Edge},
	year = {2026},
