@ARTICLE{Lee202683337,
	author = {Lee, Jong-Phil and Kim, Bo-Young},
	title = {A Three-Stage On-Device Machine Learning Pipeline for Service-Aware Power Optimization in 5G User Equipment},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {83337 - 83350},
	doi = {10.1109/ACCESS.2026.3698478},
	url = {https://www.scopus.com/pages/publications/105041044723?origin=resultslist},
	abstract = {Advancements in next-generation wireless communication technologies, such as 5G, have enabled the utilization of Ultra-Reliable Low-Latency Communication (URLLC) and Enhanced Mobile Broadband (eMBB) resources. To enhance user-perceived performance, or Quality of Experience (QoE), it is essential to appropriately allocate network resources to applications based on their specific requirements. Consequently, there is a growing necessity for intelligent resource management at the User Equipment (UE) level. This study proposes a three-stage on-device ML pipeline for service-aware power optimization in 5G UE. The pipeline consists of: 1) a Traffic Classifier (XGBoost) that performs real-time binary classification of RT/NRT traffic; 2) a NO-DATA Predictor (Student-LogReg with Knowledge Distillation) that forecasts traffic-idle intervals in NRT sessions; and 3) a Finite State Machine (FSM) Controller that selectively suspends classifier inference during predicted NO-DATA periods. The FSM Controller suspends classifier operation at P(NO-DATA) ≥ 0.80 for two consecutive slots and resumes at P(NO-DATA) < 0.60, enabling recovery within one slot. Experimental evaluations on real-world KT 5G SA network traffic data demonstrate that the proposed framework achieves a 61.42% reduction in classifier inference calls while maintaining a QoE error rate of 0.26% and zero RECLASSIFY events, confirming that the Predictor's DATA Recall of 98.35% effectively serves as a safety net against classifier misclassification. This approach provides a practical solution for implementing application-aware, energy-efficient network management in resource-constrained on-device environments. To validate generalizability beyond simulation, the pipeline was installed on a custom-built Android measurement application and field-tested on seven Samsung Galaxy device models across six countries (Korea, Japan, Australia, Mexico, Brazil, and the United Kingdom) on commercial networks, yielding 28 measurement sessions with RECLASSIFY = 0 in all cases. Real-world field measurements show reduction rates ranging from 19.6% to 60.4%, with NRT applications (YouTube, Netflix) achieving a mean of 46.1% compared to 33.2% for RT applications (YouTube Live, Zoom), confirming a 12.9 pp service-type gap consistent with the simulation results © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Javed2026,
