@ARTICLE{Chen20261,
	author = {Chen, Quanliang and Zhang, Lin and Ma, Jialin and Khadka, Ashim},
	title = {A Lightweight Real-Time Vision Framework for Road Infrastructure Monitoring in Intelligent Transportation Systems},
	year = {2026},
	journal = {Mechatronics and Intelligent Transportation Systems},
