	doi = {10.1109/ECCST68196.2025.11441149},
	url = {https://www.scopus.com/pages/publications/105037354744?origin=resultslist},
	abstract = {Real-time perception of construction machinery behaviors is critical for safety and efficiency in Digital Twin systems. However, existing spatio-temporal networks (e.g., 13D) are too heavy for edge devices, while lightweight 2D networks suffer from feature confusion due to lack of temporal context. To address this, we propose a Cloud-Edge Collaborative SpatioTemporal Distillation Framework. We employ an asymmetric transfer strategy: a cloud-based ResNet-50 teacher with Temporal Shift Modules (TSM) captures long-term dependencies, which are transferred to an edge-based MobileNetV3 student via a novel Multi-scale Feature Adaptation mechanism. This aligns intermediate attention patterns, enabling the lightweight model to mimic temporal reasoning. Experiments on our Construction-5K dataset show the method achieves 89.1% accuracy on NVIDIA Jetson Xavier NX (a 2.9% gain over baseline) at 55 FPS using TensorRT FP16, balancing high accuracy with edge real-time constraints. © 2025 IEEE.},
