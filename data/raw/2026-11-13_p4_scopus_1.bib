	abstract = {Internet-of-Things (IoT) gateways must detect largescale cyber attacks in real time under tight latency, memory, and energy constraints. Recent IoT intrusion datasets such as CICIoT2023 and Edge-IIoTset show that modern attacks involve heterogeneous devices, protocols, and attack categories [1], [2]. Time-aware multi-entity graph neural networks (GNNs) can model these interactions, but many studies still emphasize cloud-side accuracy while reporting limited device-centric evidence such as tail latency, peak memory, and energy per inference. This paper presents a device-centric benchmarking framework for compressed GNNs deployed on IoT edge gateways. We start from a high-capacity teacher GNN (GraphSAGE/GAT/GCNII) trained on time-aware multi-entity graphs and derive a lightweight student, LightGNN, based on simplified propagation and attention-based readout. The compression pipeline combines multi-objective knowledge distillation, structured channel/layer pruning, and degree-aware INT8 quantization-aware training (QAT). The deployment stack exports models to ONNX and supports ONNX Runtime with Arm Compute Library/ArmNN on ARM single-board computers and TensorRT on NVIDIA Jetson platforms. The protocol is designed to evaluate predictive performance, p50/p95 latency, peak memory, and energy when calibrated power traces are available. The current quantitative evidence is reported as a pilot GPU benchmark; ARM, Jetson, INT8, and energy results are explicitly treated as required followup evidence. The benchmarking scope is made explicit through a comparison matrix covering tabular IDS, full GNN, LightGNN, pruning/QAT, and runtime variants. The target constraints, i.e., Δ F1 ≤ 2 percentage points, p95 speedup ≥3×, and memory reduction ≥4×, are therefore stated as acceptance criteria rather than achieved claims. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

