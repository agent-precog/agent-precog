@CONFERENCE{Mathews2026544,
	author = {Mathews, Boban and Shaharkar, Bhushan Bharat and Panda, Kailash Chandra and Karthick, N. and Maranan, Ramya and Sivaramkrishnan, M.},
	title = {Real-Time IoT Monitoring of Battery Packs in EVs using Thermal Imaging and Edge AI Models},
