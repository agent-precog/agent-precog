@CONFERENCE{Shrivastava2025,
	author = {Shrivastava, Anurag and Alsalami, Zaid and Nagini, Rallabandi Venkata Santoshi Saraswati Swetha and Sharma, Aman and Khan, Irfan and Gupta, Manish},
	title = {Graph Neural Networks for Real-Time Biosignal Analysis in Wearable Healthcare Devices},
	year = {2025},
	journal = {2025 IEEE 5th International Conference on ICT in Business Industry and Government, ICTBIG 2025},
	pages = {},
	doi = {10.1109/ICTBIG68706.2025.11323898},
	url = {https://www.scopus.com/pages/publications/105032865259?origin=resultslist},
	abstract = {Wearable healthcare devices continuously capture diverse biosignals (ECG, PPG, EEG, EMG, and IMU data) that can enable early detection, continuous monitoring, and personalized intervention. Traditional signal-processing and deep-learning approaches treat biosignals as sequences or images, often neglecting the inherent relational and topological structure among sensors, anatomical sites, and temporal segments. Graph Neural Networks (GNNs) provide a principled framework to encode such relational information, fuse multimodal streams, and perform inference with explicit modeling of inter-sensor and inter-feature dependencies. This paper presents a comprehensive treatment of GNN architectures, representation strategies, and optimization techniques tailored for real-time biosignal analysis in wearable systems. We (1) formalize biosignal-to-graph transformations that preserve physiological adjacency and functional coupling, (2) evaluate spatial, temporal, and spatio-temporal GNN variants for latency-constrained tasks (arrhythmia detection, cuffless blood-pressure estimation, EEG-based event detection, and activity recognition), (3) propose lightweight graph convolution and message-passing modules designed for edge inference and energy-efficient deployment, and (4) assess robustness to noise, missing channels, and variable sampling using both open benchmarks and a curated wearable dataset. Results demonstrate that appropriately constructed GNNs improve detection accuracy and calibration while reducing feature-engineering requirements, and that model pruning, quantization, and architecture search enable real-time inference on resource-limited wearable hardware. We conclude with a roadmap addressing clinical validation, privacy-preserving ondevice learning, and standardization of graph construction for reproducible biosignal GNN research. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Asif20184875,
