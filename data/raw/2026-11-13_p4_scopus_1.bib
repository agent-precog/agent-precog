@ARTICLE{Barillaro2026,
	author = {Barillaro, Luca and Zucco, Chiara and Agapito, Giuseppe},
	title = {Accuracy vs Efficiency: Benchmarking Graph Neural Networks on edge GPU hardware},
	year = {2026},
	journal = {Journal of Computational Science},
