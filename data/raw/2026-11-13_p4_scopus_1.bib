	url = {https://www.scopus.com/pages/publications/105034481025?origin=resultslist},
	abstract = {Steel surface defect detection is crucial for ensuring product quality and process reliability in industrial manufacturing; however, existing methods often struggle to simultaneously achieve high accuracy, real-time efficiency, and strong cross-dataset generalization. This paper proposes AGE-YOLO (Accurate, Generalized, and Efficient YOLO (You Only Look Once)), an enhanced detection framework built upon the YOLO version 11 (YOLOv11) architecture. It is designed to address these challenges by incorporating three key components: (1) a Feature-Context Multi-Aggregation Network (FC-MANet) that integrates Convolutional Gated Linear Units (CGLU) and Partial Convolution (PConv) to capture irregular defect features while mitigating background artifacts through dynamic gating; (2) an Adaptive Cross-scale Fusion (ACF) module that dynamically aligns and fuses multi-level features via joint spatial–channel guidance, effectively suppressing irrelevant background responses; and (3) a Shared Insight Focus Head (SIFHead) employing lightweight shared convolutions with Group Normalization (GN) to enhance localization consistency, particularly for small defects. Experimental results on the GC10-DET dataset demonstrate that AGE-YOLO achieves a mean Average Precision (mAP) of 72.8% at an Intersection over Union (IoU) threshold of 0.5 (mAP@0.5), outperforming YOLOv11n (nano) baseline by 5.2% and recent YOLOv12n and YOLOv13n variants by 5.8% and 5.6%, respectively. The method also surpasses the Real-Time DEtection TRansformer (RT-DETR) by 3.6% mAP while using only 10.4% of its parameters. With 3.41 million parameters and 7.7 Giga Floating-Point Operations (GFLOPs), AGE-YOLO achieves a real-time inference speed of 189 frames per second (FPS) at 640 × 640 resolution on an NVIDIA RTX 4090D Graphics Processing Unit (GPU). Furthermore, hardware validation on the NVIDIA Jetson Orin Nano platform shows that, after optimization with the NVIDIA TensorRT inference engine using 16-bit floating-point (FP16) precision, the model attains a throughput of 74.6 FPS, confirming its suitability for real-time edge deployment. Additional experiments on the Northeastern University steel defect dataset (NEU-DET) and the printed circuit board defect dataset released by the Peking University Open Laboratory on Human–Robot Interaction (HRIPCB) demonstrate mAP@0.5 scores of 85.4% and 95.7%, respectively, yielding an average improvement of 4.5% over representative lightweight detectors. The implementation of this work is publicly available at https://github.com/gnmtdt/AGE-YOLO . Copyright © 2026. Published by Elsevier Ltd.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@CONFERENCE{Li202653,
	author = {Li, Yushan and Fujita, Satoshi},
	title = {A Two-Tier Secure Event Model for Privacy-Preserving IoT with Encrypted Reductions: A Parametric Feasibility Study},
	year = {2026},
	journal = {Proceedings - 2026 IEEE International Parallel and Distributed Processing Symposium Workshops, IPDPSW 2026},
	pages = {53 - 56},
	doi = {10.1109/IPDPSW71298.2026.00013},
	url = {https://www.scopus.com/pages/publications/105048969540?origin=resultslist},
	abstract = {Distributed computational models for time-sensitive IoT applications face a critical tradeoff: centralized architectures compromise privacy and are exposed to network tail latencies, while pure peer-to-peer models provide limited support for scalable community-level analytics. To address this, we propose a Two-Tier Secure Event Model that models the edge as stateful autonomous agents and the cloud as a stateless encrypted reduction operator. Tier 1 supports data sovereignty and low-latency local safety actions via append-only logs; Tier 2 performs additive Homomorphic Encryption (HE) reductions over encrypted vectors to enable community analytics without exposing raw data.To assess feasibility under bounded resources, we implement a parametric evaluation harness in Rust. We conduct sensitivity analysis by injecting literature-backed latency budgets for cryptographic operations across a range of constrained edge profiles, while exposing the pipeline to wide-area network (WAN) variability using public HTTPS endpoints. Across 3,000 end-to-end traces (1,000 per profile) collected in discontinuous sessions to capture temporal variance, results indicate sub-second (<1s) latency at P95 under baseline budgets, while conservative profiles reveal a long tail dominated by wide-area variability. Breakdown analysis further shows that WAN jitter, rather than on-device cryptographic overhead, dominates P95 tail latency in our measurement setup, supporting the design choice of local-first auditing to minimize reliance on unstable cloud connectivity. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Sun20261006,
