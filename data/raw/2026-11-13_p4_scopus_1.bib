@ARTICLE{Huang2026,
	author = {Huang, Changyan and Zhang, Lixing and Duan, Wanting and Jia, Guohai and Tang, Ruohan and Huang, Dan},
	title = {YOLOv8n-MMSP: A Lightweight Real-Time Vehicle Detector for Edge-Based Perception in Intelligent Transportation Systems},
