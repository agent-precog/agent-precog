@CONFERENCE{Ullian2026,
	author = {Ullian, Laura-Anne and Chang, Yusun and Voicu, Razvan Cristian},
	title = {Aging in Place: Doorway Activity Detection and Contextual Alerting for Dementia Wandering Risk},
	year = {2026},
	journal = {Conference Proceedings - IEEE SOUTHEASTCON},
	pages = {},
	doi = {10.1109/SoutheastCon63549.2026.11476463},
	url = {https://www.scopus.com/pages/publications/105037851352?origin=resultslist},
	abstract = {Wandering and elopement among people living with dementia remain persistent and high-consequence safety risks, particularly in aging-in-place contexts where continuous inperson supervision is often infeasible. In missing-person incidents, even short delays in awareness can reduce the likelihood of a safe recovery, and caregivers frequently lack time-critical contextual information (e.g., clothing, apparent intent, or whether a door was approached deliberately) that could accelerate appropriate action. This paper presents the design and evaluation of an eventtriggered residential monitoring prototype that detects doorway-area activity, issues an immediate on-device voice prompt intended to support reorientation, and records synchronized audio-video to preserve situational context. The resulting clip is uploaded to cloud storage and delivered to a designated caregiver via an automated WhatsApp notification containing a downloadable link. The system is implemented on an NVIDIA Jetson Orin NX edge-computing platform with a CSI camera, USB microphone, and USB speaker. The software pipeline performs continuous motion detection within a configurable region of interest (ROI), low-latency event recording with a pre-roll buffer, FFmpeg-based audio-video muxing, and integration with Amazon S3 for clip storage and Twilio's WhatsApp API for notification delivery. In controlled bench trials (n=80 motion triggers; n=15 recording trials), the prototype achieved a mean motion-to-record latency of 65.8 ms (observed range: 61.5-69.3 ms) and delivered end-to-end alerts in 12-17 s. These results demonstrate the feasibility of low-friction, context-forward alerting that can reduce time-to-awareness and provide caregivers with actionable information during suspected dementia-related exit events, while motivating privacy, security, and reliability considerations required for responsible deployment. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Zhu2026,
	author = {Zhu, Kemeng and Zhu, Dingju and Mao, Shihua and Wu, Jinchen and Kong, Depeng and Yung, Kaileung and Ip, Andrew W.H.},
	title = {Scale-Robust Cross-Scale Representation Learning for Aerial Crop Pest Recognition},
