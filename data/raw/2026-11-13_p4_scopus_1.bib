@CONFERENCE{Baptista202671,
	author = {Baptista, Rafael R. and De Lima Salgado, André and Godoy, Ricardo V. and Becker, Marcelo and Boaventura, Thiago and Lahr, Gustavo J. G.},
	title = {Evaluating Zero-Shot and One-Shot Adaptation of Small Language Models in Leader-Follower Interaction},
	year = {2026},
	journal = {Proceedings of the IEEE RAS and EMBS International Conference on Biomedical Robotics and Biomechatronics},
	pages = {71 - 77},
	doi = {10.1109/BioRob66782.2026.11681882},
	url = {https://www.scopus.com/pages/publications/105051621877?origin=resultslist},
	abstract = {Leader-follower interaction is an important paradigm in human-robot interaction (HRI). Yet, assigning roles in real-time remains challenging for resource-constrained mobile and assistive robots. While large language models (LLMs) have shown promise for natural communication, their size and latency limit on-device deployment. Small language models (SLMs) offer a potential alternative, but their effectiveness for role classification in HRI has not been systematically evaluated. In this paper, we present a benchmark of SLMs for leader-follower communication, introducing a novel dataset derived from a published database and augmented with synthetic samples to capture interaction-specific dynamics. We investigate two adaptation strategies: prompt engineering and fine-tuning, studied under zero-shot and one-shot interaction modes, compared with an untrained baseline. Experiments with Qwen2.5-0.5B reveal that zero-shot fine-tuning achieves robust classification performance (86.66% accuracy) while maintaining low latency (22.2 ms per sample), significantly outperforming baseline and prompt-engineered approaches. However, results also indicate a performance degradation in one-shot modes, where increased context length challenges the model's architectural capacity. These findings demonstrate that fine-tuned SLMs provide an effective solution for direct role assignment, while highlighting critical trade-offs between dialogue complexity and classification reliability on the edge. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

@CONFERENCE{Ghuge2025,
	author = {Ghuge, Kalyani and Jadhav, Swapnil and Kharkar, Yadhni and Koshatwar, Prasad and Luniya, Chaitanya and Ghanwat, Harshada},
	title = {Autonomous Firefighting Drone Using ROS, YOLOv8, and ArduPilot with Intelligent Fire-Extinguishing Ball Deployment in Simulated Environments},
	year = {2025},
	journal = {2nd Asian Conference on Intelligent Technologies, ACOIT 2025},
	pages = {},
	doi = {10.1109/ACOIT66109.2025.11436282},
	url = {https://www.scopus.com/pages/publications/105036109673?origin=resultslist},
	abstract = {This paper presents an autonomous firefighting UAV that integrates ROS2, AirSim, ArduPilot, and a YOLOv8n-based detector to identify fire, smoke, and human victims and deliver fire-extinguishing balls. We quantify system performance across simulation and real-world trials (30 missions): detection mAP@0.5 = 0.925 (avg), end-to-end response time = 58.3 ± 14.2 s, payload delivery accuracy = 0.35 ± 0.18 m, and overall mission success = 80%. Ablation experiments show YOLOv8n provides a favorable tradeoff between inference latency (3.5 ms/frame after TensorRT) and detection accuracy compared to baselines. We discuss failure modes (wind, heavy smoke), statistical significance of results, and practical considerations for field deployment. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
