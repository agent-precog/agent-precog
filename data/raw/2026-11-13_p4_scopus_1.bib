@ARTICLE{He2026,
	author = {He, Qiyi and Zhang, Yifan and Liu, Jieying and Zhou, Wen and Zhang, Tingting and Hu, Minlong and Xu, Ao and Lin, Qiao},
	title = {HCA-IDS: A Semantics-Aware Heterogeneous Cross-Attention Network for Robust Intrusion Detection in CAVs},
	year = {2026},
