@CONFERENCE{Sriharsha Upadhya2026,
	author = {Sriharsha Upadhya, P. and Guruprasad},
	title = {An Adaptive Multimodal Bird Deterrent System for UAVs Using Deep Learning and Reinforcement Learning},
	year = {2026},
	journal = {Proceedings of 2026 5th OPJU International Technology Conference on Smart Computing for Innovation and Advancement in Industry 5.0, OTCON 2026},
	pages = {},
	doi = {10.1109/OTCON69332.2026.11629944},
	url = {https://www.scopus.com/pages/publications/105047885354?origin=resultslist},
	abstract = {Increasing operational concerns regarding birds interfering with Unmanned Aerial Vehicles (UAVs) can cause collateral damage and disruptions in missions and create safety issues. All current deterrent methods (e.g., static visual deterrents and continuous acoustic broadcasting) are subject to rapid habituation due to birds learning to ignore repeated nonthreatening stimuli. This paper presents an adaptive multimodal bird deterrence system that combines visual detection (using a YOLOv8 Nano) and acoustic detection (using BirdNET) with an epsilon-greedy Q-learning agent to select the best deterrents. This work makes three major contributions: (1) A confidenceweighted fusion of visual and acoustic detection from the two aforementioned modalities using a Bayesian combination inspired method; (2) An adaptive deterrent selection agent capable of selecting predator calls to use as deterrents based on a reward function that is aware of habituation; and (3) A context-aware threat assessment module capable of modulating the threat score based on time of day, size of the flock and repeat visitation history. Using the YOLOv8 visual classifier, the authors demonstrated an overall accuracy of 83% across seven species with a dataset size of 2,847 images. In addition, Q-learning simulations demonstrated stabilization of Q-values and learning of rotating deterrent choices across 200 episodes of deterrent selection for each target species in response to habituation. Feasibility of edge deployment was evaluated for CPU-constrained, single-threaded environments simulating hardware equivalent to ARM CortexA72 class. The stage performance is as follows: visual inference stage 76.89 ms (σ=11.28) and audio inference stage 490.42 ms (σ=13.58). With both pipelines executing simultaneously, the headline end-to-end latency is 493.46 ms (σ=13.89), which is within the 500 ms real-time limit. The combined model size is 14.8 MB. Future work includes deployment on embedded hardware and optimizing audio further.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

