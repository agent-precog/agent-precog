@ARTICLE{Li2025,
	author = {Li, Xin and Hu, Mangu and Li, Binrui and Tong, Ruipeng},
	title = {OAM-YOLO: A real-time small object detection framework for PPE compliance monitoring in industrial environments},
	year = {2025},
	journal = {Process Safety and Environmental Protection},
	volume = {204},
	pages = {},
	doi = {10.1016/j.psep.2025.108058},
	url = {https://www.scopus.com/pages/publications/105020256955?origin=resultslist},
	abstract = {In high-risk industrial environments, ensuring the proper use of personal protective equipment (PPE) such as helmets, masks, and reflective vests is critical to worker safety. Traditional manual inspection is inefficient and unsuitable for real-time monitoring, while existing deep learning-based detection methods struggle in complex scenarios with small or multi-scale objects and often fail to verify correct usage. To address these limitations, this study proposes OAM-YOLO, an improved model based on YOLOv8, integrated with a cascaded detection system that combines object detection and human pose estimation for more accurate compliance assessment. OAM-YOLO incorporates three key modules: ODConv, which enhances multi-scale feature extraction through adaptive convolution kernels; Aggregated Attention, which fuses local detail and global semantics to improve small-object precision; and MSDHead, which refines multi-scale features with depthwise separable convolutions and adaptive weighting. Experiments on a custom cement aggregate workshop dataset demonstrate a mAP@0.5 of 0.934 and AP@0.5mask of 0.817, improving by 11.0 % and 16.1 % over the baseline. Moreover, OAM-YOLO achieves real-time inference at 35 FPS on an NVIDIA Jetson Nano, highlighting its suitability for edge deployment. The proposed approach provides robust and efficient support for real-time PPE compliance monitoring in industrial environments. © 2025 The Institution of Chemical Engineers},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 13}
}

@ARTICLE{Papa202244881,
	author = {Papa, Lorenzo and Alati, Edoardo and Russo, Paolo and Amerini, Irene},
	title = {SPEED: Separable Pyramidal Pooling EncodEr-Decoder for Real-Time Monocular Depth Estimation on Low-Resource Settings},
	year = {2022},
	journal = {IEEE Access},
	volume = {10},
	pages = {44881 - 44890},
	doi = {10.1109/ACCESS.2022.3170425},
	url = {https://www.scopus.com/pages/publications/85129635068?origin=resultslist},
	abstract = {The monocular depth estimation (MDE) is the task of estimating depth from a single frame. This information is an essential knowledge in many computer vision tasks such as scene understanding and visual odometry, which are key components in autonomous and robotic systems. Approaches based on the state of the art vision transformer architectures are extremely deep and complex not suitable for real-time inference operations on edge and autonomous systems equipped with low resources (i.e. robot indoor navigation and surveillance). This paper presents SPEED, a Separable Pyramidal pooling EncodEr-Decoder architecture designed to achieve real-time frequency performances on multiple hardware platforms. The proposed model is a fast-throughput deep architecture for MDE able to obtain depth estimations with high accuracy from low resolution images using minimum hardware resources (i.e. edge devices). Our encoder-decoder model exploits two depthwise separable pyramidal pooling layers, which allow to increase the inference frequency while reducing the overall computational complexity. The proposed method performs better than other fast-throughput architectures in terms of both accuracy and frame rates, achieving real-time performances over cloud CPU, TPU and the NVIDIA Jetson TX1 on two indoor benchmarks: the NYU Depth v2 and the DIML Kinect v2 datasets.  © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
