@ARTICLE{Atif20264322,
	author = {Atif, Nadeem and Mazhar, Saquib and Ameen, Mohammed and Ahamed, Shaik Rafi and Bhuyan, M.K.},
	title = {CTPNet: Achieving Real-Time Semantic Segmentation on Resource-Constrained Edge Devices for Autonomous Driving},
	year = {2026},
	journal = {IEEE Transactions on Circuits and Systems I: Regular Papers},
	volume = {73},
	number = {6},
	pages = {4322 - 4335},
	doi = {10.1109/TCSI.2025.3649392},
	url = {https://www.scopus.com/pages/publications/105028394560?origin=resultslist},
	abstract = {In vision tasks such as semantic segmentation, multi-scale context is crucial for accurate recognition. In time-critical applications like autonomous driving, real-time prediction becomes equally important. Hence, practical segmentation models must balance high segmentation quality with low computational complexity to enable real-time operation on edge devices where computational resources are limited. To address these challenges, we introduce two novel building blocks and a corresponding hardware-friendly network. Specifically, we propose the Locally Dense Context Aggregation Bottleneck (LD-CAB) to extract short-to-medium-range context with reinforcement mechanism, which refers to feature concatenation from early layers within the LD-CAB itself to enrich its output information content. Our non-residual design approach reduces the network's computational complexity while also improving the accuracy; making it particularly suitable for ultra-lightweight real-time networks. The Complementary Twin Pyramid (CTP) module, on the other hand, captures long-range context through a pair of cross-coupled spatial pyramids. One spatial pyramid is based on a bank of dilated convolutions while the other one on average pooling of features. Based on these modules, we propose CTPNet, a high-speed, ultra-lightweight network that achieves an exceptional accuracy-efficiency trade-off. With only 0.29 million parameters, CTPNet achieves 71.1% and 70.8% mIoU on the Cityscapes validation and test sets, respectively, while achieving 316.4 FPS on RTX 3090 and 34.54 FPS on Jetson Orin Nano (an embedded GPU). When deployed on Xilinx Zynq UltraScale+ MPSoC (ZCU102), an FPGA-based edge device, it achieves 31.80 FPS while only requiring 0.93 W of power. Our code is available at https://github.com/NadeemAtif-Alig/CTPNet  © 2004-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Jiang2026207,
	author = {Jiang, Xuan and Wang, Xuguo},
	title = {EdgeOpt-Sched: A Dynamic GNN and RL Scheduler for DNN Acceleration on Edge Devices},
