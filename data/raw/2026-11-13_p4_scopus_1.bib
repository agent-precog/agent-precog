	doi = {10.1002/9781394464746.ch11},
	url = {https://www.scopus.com/pages/publications/105051705409?origin=resultslist},
	abstract = {Edge and fog computing have emerged as pivotal paradigms for enabling distributed intelligence in modern decentralized systems, particularly in contexts where data privacy, low latency, and scalability are paramount. Unlike traditional cloud-centric architectures, edge and fog computing distribute computational resources and decision-making capabilities closer to data sources, such as sensors, IoT devices, and embedded systems. This chapter provides a comprehensive overview of the conceptual foundations, architectural models, and implementation strategies of edge and fog computing in the context of decentralized collaborative learning and secure artificial intelligence (AI) systems. The chapter begins by elucidating the distinction between edge and fog computing layers and their respective roles in a hierarchical computational continuum. Edge computing is characterized by ultra-localized processing directly on devices or gateways, reducing the need for raw data transfer and minimizing latency. Fog computing, positioned between edge devices and centralized clouds, introduces intermediate nodes capable of performing aggregation, filtering, and context-aware analytics. This layered approach not only optimizes bandwidth utilization but also strengthens data privacy by ensuring that sensitive information is processed closer to its origin. Building upon this architectural perspective, the chapter explores how edge and fog computing synergize with decentralized collaborative learning frameworks, such as federated learning and blockchain-based AI systems. We demonstrate how federated learning can leverage distributed compute nodes to train global models while preserving data locality, and how blockchain integration can provide trust, immutability, and auditability of model updates. The chapter also examines key enabling technologies, including lightweight containerization (e.g., Docker, Kubernetes at the edge), secure multiparty computation, differential privacy, and efficient consensus protocols tailored for resource-constrained edge and fog environments. A significant portion of the chapter is dedicated to addressing practical challenges and trade-offs. These include heterogeneous device capabilities, energy consumption constraints, orchestration complexity, and the dynamic nature of edge environments. Emerging solutions, such as adaptive workload partitioning, AI-driven resource allocation, and intent-based networking, are analyzed for their potential to enhance system resilience and scalability. Furthermore, we review security considerations specific to edge and fog computing, focusing on end-to-end encryption, intrusion detection, and zero-trust architectures that mitigate the expanded attack surface inherent in distributed systems. To illustrate real-world applicability, the chapter highlights use cases across multiple sectors. In healthcare, edge-enabled AI supports real-time patient monitoring and privacy-preserving diagnostics. In smart cities, fog nodes orchestrate heterogeneous IoT networks for intelligent traffic management and energy optimization. In industrial settings, edge and fog computing empower predictive maintenance and anomaly detection on the factory floor. Each example underscores the critical role of distributed intelligence in meeting the stringent requirements of latency-sensitive, privacy-conscious, and mission-critical applications. Finally, the chapter reflects on emerging research directions, including the convergence of edge AI with neuromorphic hardware, edge computing, and self-organizing fog architectures. We argue that edge and fog computing will be indispensable for the next generation of decentralized, trustworthy AI systems, capable of supporting large-scale collaborative learning while adhering to evolving regulatory standards. © 2026 Scrivener Publishing LLC.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Bally2026437,
	author = {Bally, Fabian and Schötz, Michael and Limbrunner, Thomas},
	title = {A Serverless Edge-Native Data Processing Architecture for Autonomous Driving Training},
