@ARTICLE{Hong2026237,
	author = {Hong, Lixin and Ding, Huafeng and Qian, Jiarui},
	title = {Robust Tunnel Crack Detection Algorithm for Inspection Robots Based on Improved YOLOv8},
	year = {2026},
	journal = {International Conference on Robotics and Automation Sciences, ICRAS},
