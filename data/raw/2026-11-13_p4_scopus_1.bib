@CONFERENCE{Sridhar20261624,
	author = {Sridhar, S.K. and Mathapati, Shreyas and Siddappa, L.H. and Swetha, B. and Shailesh, B.S. and Sathvik, G.R.},
	title = {AR-CropShield: A Lightweight Offline Mobile System for Rice Disease Detection and Confidence-Aware Treatment Guidance},
