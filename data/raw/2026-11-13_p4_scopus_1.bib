@CONFERENCE{Yu20262627,
	author = {Yu, Yang},
	title = {Research on an Intelligent Evaluation System for Basketball-Specific Physical Conditioning Training Based on Deep Learning and Multimodal Sensor Data Fusion},
	year = {2026},
	journal = {2026 9th International Conference on Advanced Algorithms and Control Engineering, ICAACE 2026},
