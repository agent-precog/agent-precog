@ARTICLE{Khemani2026,
	author = {Khemani, Kushal and Maniar, Rushil and Lokhande, Ajinkyya},
	title = {PAES: Priority-Aware Adaptive Scheduling for Multi-Model Edge AI Systems},
	year = {2026},
	journal = {IEEE Embedded Systems Letters},
	pages = {},
	doi = {10.1109/LES.2026.3731390},
	url = {https://www.scopus.com/pages/publications/105050209197?origin=resultslist},
	abstract = {Edge devices increasingly execute multiple AI inference pipelines concurrently (vision, speech, NLP, and depth estimation) competing for limited compute resources. When tasks share a single execution queue, queue wait time dominates total response time, yet most frameworks default to FIFO or static priority queues that fail to account for task importance, expected latency, and energy jointly. We present PAES, the Priority-Aware Edge Scheduler: a lightweight composite scoring heuristic that unifies priority, latency, and energy into a single runtime-adaptive min-heap score requiring no offline profiling. Evaluated against six baselines (FIFO, Round Robin, Static Priority, EDF, PQ+Deadline, and QoS) across five concurrent AI models on six physical devices, including a Raspberry Pi 5 and an NVIDIA Jetson Orin Nano (genuine embedded edge platforms), PAES reduces queue wait by 32.6% vs. FIFO on a 600-task synthetic benchmark (i7-1165G7) and by 33.7% on a realistic robot pipeline (same device), and achieves the lowest deadline miss rate at high load (17.1%). On the NVIDIA Jetson Orin Nano, PAES achieves a 28.7% synthetic reduction and 33.7% pipeline queue wait reduction. Scheduling overhead is under 1.8 μs per decision (0.001% of inference time on x86, 0.002% on ARM). © 2009-2012 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
