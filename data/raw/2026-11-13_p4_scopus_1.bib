	title = {Real-Time Attention-Enhanced Object Detection for Interactive Human-Machine Scenarios Based on YOLOv8},
	year = {2025},
	journal = {2025 7th International Conference on Frontier Technologies of Information and Computer, ICFTIC 2025},
	pages = {623 - 627},
	doi = {10.1109/ICFTIC68075.2025.11324674},
	url = {https://www.scopus.com/pages/publications/105035254161?origin=resultslist},
	abstract = {Interactive scenarios such as human-robot collaboration and smart surveillance impose a demanding blend of robustness and latency. We propose a real-time detector that augments the YOLOv8 backbone with multi-scale spatial-channel attention (MASA) and a lightweight bi-directional fusion neck. MASA strengthens salient features under dynamic backgrounds and improves small-object recovery with negligible overhead, while the neck reduces memory traffic to sustain throughput. On a 12 000-frame interactive dataset, our model reaches 92.3% mAP@0.5, +4.7 points over a plain YOLOv8-M baseline, lowers the miss rate to 3.1%, and sustains 68 FPS on an NVIDIA RTX 3090, meeting real-time needs. In an industrial human-robot cell, it localizes operators and a 6-DoF arm with ≤15 ms end-to-end latency, increasing safety margins and task efficiency. The design is simple to port, TensorRT-friendly, and remains compatible with NMS-free heads. © 2025 IEEE.},
