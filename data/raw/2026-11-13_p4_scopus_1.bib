@ARTICLE{Zhong20223980,
	author = {Zhong, Boxuan and Silva, Rafael Luiz Da and Tran, Michael and Huang, He and Lobaton, Edgar},
	title = {Efficient Environmental Context Prediction for Lower Limb Prostheses},
	year = {2022},
	journal = {IEEE Transactions on Systems, Man, and Cybernetics: Systems},
	volume = {52},
	number = {6},
	pages = {3980 - 3994},
	doi = {10.1109/TSMC.2021.3084036},
	url = {https://www.scopus.com/pages/publications/85111025519?origin=resultslist},
	abstract = {Environmental context prediction is important for wearable robotic applications, such as terrain-adaptive control. System efficiency is critical for wearable robots, in which system resources (e.g., processors and memory) are highly constrained. This article aims to address the system efficiency of real-time environmental context prediction for lower limb prostheses. First, we develop an uncertainty-aware frame selection strategy that can dynamically select frames according to lower limb motion and uncertainty captured by Bayesian neural networks (BNNs) for environment prediction. We further propose a dynamic Bayesian gated recurrent unit (D-BGRU) network to address the inconsistent frame rate which is a side effect of the dynamic frame selection. Second, we investigate the effects on the tradeoff between computational complexity and environment prediction accuracy of adding additional sensing modalities (e.g., GPS and an on-glasses camera) into the system. Finally, we implement and optimize our framework for embedded hardware, and evaluate the real-time inference accuracy and efficiency of classifying six types of terrains. The experiments show that our proposed frame selection strategy can reduce more than 90% of the computations without sacrificing environment prediction accuracy, and can be easily extended to the situation of multimodality fusion. We achieve around 93% prediction accuracy with less than one frame to be processed per second. Our model has 6.4 million 16-bit float numbers and takes 44 ms to process each frame on a lightweight embedded platform (NVIDIA Jetson TX2).  © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 32}
}

@CONFERENCE{Saidulu2025,
	author = {Saidulu, I. and Babu, Popuri Ramesh and Shalout, Imad and Bhaskar, R Vijaya and Sura, Sreekanth and Suresh Kumar, R.},
	title = {Optimized Vlsi-Based Neural Processing Units for Edge Ai in Latency-Critical Multimedia Applications},
	year = {2025},
	journal = {Proceedings of 2025 10th International Conference on Science Technology, Engineering and Mathematics, ICONSTEM 2025},
	pages = {},
	doi = {10.1109/ICONSTEM65670.2025.11374911},
	url = {https://www.scopus.com/pages/publications/105034469498?origin=resultslist},
	abstract = {High-performance and low-latency hardware architectures and designs are required to support the fast evolution of Edge Artificial Intelligence (AI) usage, enabling the use of this technology to identify images, process speech, and perform real time video analytics. Conventional neural processing systems of GPUs and CPUs, though also powerful, have high power consumption, large memory bandwidth needs, and nondeterministic latency thus are not suitable in latencycritical edge applications. To overcome these shortcomings, this study suggests an Optimized VLSIBased Neural Processing Unit (NPU) architecture that is best suited in accelerating Edge AI in multimedia workloads. The suggested NPU uses hybrid systolic array and reconfigurable processing elements, schedules of the dataflow process with optimization and near-memory computation in order to reduce the overhead of data movement. Also, quantization-aware training and adaptive precision scaling are used together to find a balance between model accuracy and computational efficiency. Clock gating and dynamic voltage-frequency scaling (DVFS) methods also help minimize power consumption. The simulation outcomes indicate a maximum of 42 percent throughput, a reduction in latency by 38 percent and 45 percent of the energy efficiency, in comparison to the conventional architectures. The suggested VLSI-optimized NPU, therefore, allows realtime and power-efficient edge deployment multimedia AI systems, potentially being used in autonomous vehicles, wearable devices, and smart surveillance. The anticipated result of this research is a Low power, scalable, and latency-optimal NPU design, which improves the Edge AI capability of next-generation multimedia applications by a substantial margin. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Kong20254208,
	author = {Kong, Lingzheng and Yang, Tingting and Li, Nan and Ota, Kaoru and Dong, Mianxiong},
	title = {TaCo: Tasks Co-Programming for Accelerating Inference in Scaling Edge Computing},
	year = {2025},
	journal = {IEEE Transactions on Services Computing},
	volume = {18},
	number = {6},
	pages = {4208 - 4220},
	doi = {10.1109/TSC.2025.3612401},
	url = {https://www.scopus.com/pages/publications/105017398777?origin=resultslist},
	abstract = {The edge computing network (ECN) accelerates edge inference by leveraging nearby resources. The method of co-programming inference tasks on edge meets the requirement of overloaded inference on resource-limited edge devices. However, making scheduling decisions in ECN and deep neural network (DNN) two different non-Euclidean spaces is a challenging problem owing to extra scheduling complexity in dynamic scaling ECN. Here we propose a learning-based framework namely tasks co-programme (TaCo), to cooperatively accelerate the edge inference by leveraging cooperative synergy among edge devices to achieve latency-efficient services. Firstly, the high-complexity network resource arrangement (NRA) problem is transformed as a tractable graph node classification (GNC) problem according to graph optimization theory. After that, a graph convolutional network (GCN) is elaborated to jointly aggregate the network condition as well as inference workload to further enacts an intelligent arrangement scheme. Guided by a reinforcement learning (RL)-based advantage actor critic (A2C) mechanism to improve the performance of the GCN. Our results show that TaCo has 2 times faster speed to converge compared to other learning-based solutions. The decrease of inference latency is 3 times smaller than learning-based solutions, approximately 10 times smaller than traditional solutions, up to 6 times smaller than the single-UE case, and significantly lower than the single-ES case, regardless of the number of nodes in the network. TaCo achieves a better energy efficiency compared to other solutions.  © 2008-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Kim201837,
	author = {Kim, Jungho and Shin, Philkyue and Noh, Soonhyun and Ham, Daesik and Hong, Seongsoo},
	title = {Reducing Memory Interference Latency of Safety-Critical Applications via Memory Request Throttling and Linux Cgroup},
	year = {2018},
	journal = {International System on Chip Conference},
	volume = {2018-September},
	pages = {37 - 42},
	doi = {10.1109/SOCC.2018.8618555},
	url = {https://www.scopus.com/pages/publications/85062219582?origin=resultslist},
	abstract = {With the advent of high-performance multicore processors that operate under a limited power budget, dedicated low-end microprocessors with different levels of criticality are rapidly consolidated into a mixed-criticality system. One of the major challenges in designing such a mixed-criticality system is to tightly control the amount of resource contention for a critical application by effectively limiting its performance interference incurred due to sharing resources with non-critical tasks. In this paper, we propose application-aware dynamic memory request throttling to reduce the memory interference latency of a critical application in a dual criticality system. Our approach carefully differentiates critical task instances from normal task instances and groups them into the critical and normal cgroup, respectively. It then predicts the occurrence of excessive memory contention under critical task execution and then throttles memory requests generated by the normal cgroup via the CPUFreq governor when necessary. We have implemented the approach on the NVIDIA Jetson TX2 with Linux kernel 4.4.38. Experimental results show that the proposed approach reduces the end-to-end latency of a critical application up to 9.49% while incurring only negligible overhead. © 2018 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7}
}

@ARTICLE{Kim2025,
	author = {Kim, Geonhee and Park, Seunghyun and Park, Hyunhee},
	title = {FedAWT: Adaptive federated learning via dynamic epoch adjustment for heterogeneous clients in ad-hoc networks},
	year = {2025},
	journal = {Internet of Things (The Netherlands)},
	volume = {34},
	pages = {},
	doi = {10.1016/j.iot.2025.101771},
	url = {https://www.scopus.com/pages/publications/105020301137?origin=resultslist},
	abstract = {Recent advancements in IoT devices have enabled on-device processing for tasks such as real-time inference and autonomous control. However, federated learning (FL) in such environments remains challenging due to limited computation resources, unstable connectivity, and severe data and system heterogeneity. To overcome these challenges, this paper proposes FedAWT (Federated learning with Adaptive Weighted Tree), a decentralized FL framework designed for ad-hoc IoT networks. A latency-aware system model is constructed to reflect communication delay, bandwidth constraints, and variations in device-level computational performance. FedAWT introduces two core mechanisms. The first is a dynamic epoch adjustment method that allocates training epochs according to local convergence status and training stability. The second is a minimum spanning tree based communication strategy that reduces model transfer latency. Experimental results confirm that FedAWT improves test accuracy by up to 33.86 % compared to baseline methods in heterogeneous environments. These results demonstrate the effectiveness of FedAWT in enhancing convergence stability and training efficiency under resource-constrained and decentralized environment. © 2025 The Author(s)},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Shrivastava2025,
	author = {Shrivastava, Anurag and Alsalami, Zaid and Saraswati, Rallabandi Venkata Santoshi and Nagini, Swetha and Sharma, Aman and Khan, Irfan and Gupta, Manish},
	title = {AI-Native 6G Networks: Adaptive Resource Allocation Through Edge-Integrated Deep Reinforcement Learning},
	year = {2025},
	journal = {International Conference on Intelligent and Innovative Practices in Engineering and Management, IIPEM 2025},
	pages = {},
	doi = {10.1109/IIPEM65914.2025.11548455},
	url = {https://www.scopus.com/pages/publications/105042428148?origin=resultslist},
	abstract = {This paper investigates AI-Native 6G networks that integrate deep reinforcement learning (DRL) agents at the network edge to achieve adaptive, low-latency, and energy-efficient resource allocation. We present a conceptual architecture - Edge-Integrated DRL (EIDRL) - that combines lightweight on-device policies, edge-hosted value models, and a hierarchical orchestration layer that mediates model updates, inference placement, and safety constraints. The proposed framework explicitly addresses 6G-era characteristics: massive heterogeneous devices, semantic and sensing-aided communications, integration of sensing/communication/computation (ISCC), and stringent reliability/latency requirements. We detail the learning formulation (state, action, reward, multi-timescale update rules), introduce techniques for sample-efficient training (model-based rollouts, transfer from foundation WLAMs, and federated/split learning hybrids), and propose mechanisms for safety, fairness, and compute-aware scheduling. Through analytical arguments and representative numerical scenarios (multi-tenant edge slices, ISAC nodes, and mobile user clusters), we demonstrate that EIDRL reduces regret relative to static baselines, lowers average latency under load, and improves spectral and energy efficiency when the edge controller coordinates inference placement and action aggregation. Finally, we identify open research directions - privacy-preserving multi-agent coordination, certifiable robustness of learned policies, semantics-aware reward design, and operational considerations for O-RAN/OAI integration - thereby providing a focused research agenda for adaptive resource allocation in AI-native 6G systems. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Zhang202393,
