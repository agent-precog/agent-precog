}

@ARTICLE{Rojas-Ordoñez2026,
	author = {Rojas-Ordoñez, Sebastian and Segura, Mikel and Yarza, Irune and Mendoza, Veronica and Zulueta, Ekaitz},
	title = {Plug-and-Play LLM Knowledge Extraction for Robot Navigation: A Fine-Tuning-Free Edge Framework},
	year = {2026},
	journal = {Machine Learning and Knowledge Extraction},
	volume = {8},
