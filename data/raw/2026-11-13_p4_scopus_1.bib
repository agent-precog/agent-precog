	year = {2026},
	journal = {Proceedings of the IEEE International Conference on Web Services, ICWS},
	number = {2026},
	pages = {1501 - 1510},
	doi = {10.1109/ICWS72778.2026.00183},
	url = {https://www.scopus.com/pages/publications/105051110413?origin=resultslist},
	abstract = {The growing adoption of LLM-based multi-agent services demands concurrent processing capabilities that singlenode edge deployments cannot sustain. Edge-cloud collaboration offers a promising path by distributing inference workloads across heterogeneous nodes, yet realizing its concurrency potential requires intelligent load balancing that can keep pace with dynamic, unpredictable agent request patterns. This paper presents EdgeLLMBalancer, a MAPE-K-based adaptive load balancing architecture specifically designed for distributed LLM inference in heterogeneous edge environments. The proposed architecture implements a complete autonomic computing loop that continuously monitors multi-dimensional performance metrics, analyzes system bottlenecks across compute, memory, queue, and tail latency dimensions, formulates adaptive routing strategies using epsilon-greedy exploration, and executes load balancing decisions in real-time. EdgeLLMBalancer was evaluated on heterogeneous testbeds of three, five, and seven edge nodes, and benchmarked against Random, Round-Robin, Least Outstanding Requests (LOR), and a sequence-length oracle baseline. Experimental results demonstrated that the proposed approach achieved up to 6× higher median throughput than LOR and approached oracle-level performance across all cluster sizes, while reducing tail latency by over 50% compared to stateless baselines under dynamic workload conditions including request hotspots and variable sequence lengths. EdgeLLMBalancer provides a practical and effective solution for autonomous load balancing in distributed edge LLM inference, enabling robust performance optimization without manual intervention. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Wang202610111,
	author = {Wang, Zhanwei and Zeng, Qunsong and Zheng, Haotian and Huang, Kaibin},
	title = {Revisiting Outage for Edge Inference Systems},
	year = {2026},
	journal = {IEEE Transactions on Communications},
	volume = {74},
	pages = {10111 - 10125},
	doi = {10.1109/TCOMM.2026.3704154},
	url = {https://www.scopus.com/pages/publications/105043081985?origin=resultslist},
	abstract = {One of the key missions of sixth-generation (6G) mobile networks is to deploy large-scale artificial intelligence (AI) models at the network edge to provide remote-inference services for edge devices. The resultant platform, known as edge inference, will support a wide range of Internet-of-Things applications, such as autonomous driving, industrial automation, and augmented reality. Given the mission-critical and time-sensitive nature of these tasks, it is essential to design edge inference systems that are both reliable and capable of meeting stringent end-to-end (E2E) latency constraints. Existing studies, which primarily focus on communication reliability as characterized by channel outage probability, may fail to guarantee E2E performance, specifically in terms of E2E inference accuracy and latency. To address this limitation, we propose a theoretical framework that introduces and mathematically characterizes the inference outage (InfOut) probability, which quantifies the likelihood that the E2E inference accuracy falls below a target threshold. Under an E2E latency constraint, this framework establishes a fundamental tradeoff between communication overhead (i.e., uploading more feature elements) and inference reliability as quantified by the InfOut probability. To find a tractable way to optimize this tradeoff, we derive accurate surrogate functions for InfOut probability by applying a Gaussian approximation to the distribution of the received discriminant gain. Experimental results demonstrate the superiority of the proposed design over conventional communication-centric approaches in terms of E2E inference reliability.  © 1972-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

@ARTICLE{Li2026408,
	author = {Li, Yu and Mao, Yufei and Rothmann, Marc and Weiss, Roland and Porrmann, Mario},
	title = {FPGA-Enabled Deep Learning for Real-Time DC Series Arc Fault Detection},
	year = {2026},
	journal = {IEEE Open Journal of Industry Applications},
	volume = {7},
	pages = {408 - 429},
	doi = {10.1109/OJIA.2026.3671845},
	url = {https://www.scopus.com/pages/publications/105032804275?origin=resultslist},
	abstract = {A direct current (DC) series arc fault is an unintended and hazardous electrical discharge in a DC circuit. It poses a safety risk as it can potentially cause fire and damage electrical components. The urgency of detecting DC series arc faults lies in their potential to escalate into hazardous situations swiftly. Rapid identification of abnormal patterns associated with DC series arc faults is essential to trigger intervention measures immediately. In recent years, the focus of studies for the detection algorithms has been shifting from conventional rule-based methods toward machine learning (ML)-based approaches, because ML-based algorithms have the advantage of adapting to different circuit dynamics. Although ML-based approaches have yielded positive results in fault identification, implementing such computationally intensive algorithms in a time-critical application remains a challenge. This article addresses this challenge through a hardware solution, proposing an embedded real-time detection system with an field-programmable gate array (FPGA)-based hardware accelerator to enhance efficiency. The proposed solution implements optimized ML-based algorithms, including fully connected neural networks and convolutional neural networks (CNNs), on an Avnet Ultra96-V2 FPGA using the STANN high-level synthesis library. The CNN implementation results in the highest accuracy; it achieves a good balance between low detection latency, high numerical accuracy after automated precision reduction, and moderate power consumption. Comparisons with the state-of-the-art demonstrate STANN's high efficiency. In addition, the performance of the FPGA solution is evaluated by comparing it to a graphics processing unit implementation on an Nvidia Jetson Xavier NX board. The FPGA version shows superior performance, with a minimum runtime of 52 μ s and total energy consumption of 146 μ J per inference, while the Jetson Xavier NX achieves a minimum runtime of 170 μ s and consumes 343 μ J per inference.  © 2020 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

@ARTICLE{Hamza2026270,
	author = {Hamza, Muhammad and Hamid, Danish and Tahir Akram, Muhammad},
	title = {Person identification from egocentric human-object interactions using 3D hand pose},
	year = {2026},
	journal = {CCF Transactions on Pervasive Computing and Interaction},
	volume = {8},
