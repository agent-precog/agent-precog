@ARTICLE{Xu2026,
	author = {Xu, Weidong and He, Yingchao and Que, Liming and Tang, Caitian and Li, Jiaheng and Zhang, Chunxu and Dong, Qirong and Sheng, Huadong and Liu, Pengpeng and Wang, Wenjun and Liu, Donghong},
	title = {RT-BFE network: A lightweight deep learning model for real-time beef freshness evaluation and edge devices deployment},
	year = {2026},
	journal = {Computers and Electronics in Agriculture},
	volume = {250},
	pages = {},
	doi = {10.1016/j.compag.2026.111905},
	url = {https://www.scopus.com/pages/publications/105039565479?origin=resultslist},
	abstract = {Real-time and non-destructive assessment of beef freshness is crucial for food safety, quality control, and waste reduction. However, routine evaluation still relies on destructive laboratory measurements or computationally heavy vision models that are difficult to deploy on consumer-level devices. Here, we develop a lightweight real-time beef freshness evaluation (RT-BFE) network that links image features to spoilage-related regions and is suitable for deployment on edge devices. First, total volatile basic nitrogen (TVB-N) and total viable counts (TVC) were measured in beef samples (420 pieces stored for 0–6 days) to define three freshness levels (fresh, accepted, and deteriorated). Second, beef images in RGB, HSV, and L*a*b* color spaces were compared to find the optimal color space for beef freshness evaluation. Third, three modules, namely efficient bottleneck (E-bneck), cascade atrous spatial pyramid pooling (CASPP), and convolutional block attention module (CBAM), were designed in the RT-BFE network to strengthen its recognition ability and reduce computational cost. Finally, the model was quantized and deployed on edge devices for practical applications. Experimental results show that the L*a*b* provides the most discriminative representation for beef freshness classification. Comparative experiments against ten image classification CNNs demonstrate that the RT-BFE model achieves a favorable trade-off between accuracy and efficiency, attaining the Accuracy and F<sub>1</sub> of 95.238% and 95.238% with only 1.106 M Parameters and 59.347 M FLOPs, and reaching 72.301 frames per second. Subsequently, the proposed RT-BFE model is successfully deployed on edge devices in FP16-quantized form for practical applications. The deployments on a smartphone and a Jetson Orin Nano platform achieve average inference times of 32 ms and 14 ms, respectively, while maintaining an accuracy of 93.33% on both devices, demonstrating real-time inference capability and confirming its potential for in-situ beef freshness monitoring in practical agri-food scenarios. © 2026 Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
