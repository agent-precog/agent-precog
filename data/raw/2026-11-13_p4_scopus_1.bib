@CONFERENCE{Saikrishna Hanumath Prasad2025,
	author = {Saikrishna Hanumath Prasad, P. and Mounica, Vanampalli and Srikanth, H.V. and Dineshbabu, N. and Neetha, Ch.},
	title = {MobileNet Version3 with Simple Feature Pyramid Network for Edge Artificial Intelligent Real-Time Object Detection in Autonomous Vehicles},
	year = {2025},
	journal = {International Conference on Software, Systems and Information Technology, SSITCON 2025},
	pages = {},
	doi = {10.1109/SSITCON66133.2025.11342232},
	url = {https://www.scopus.com/pages/publications/105033154011?origin=resultslist},
	abstract = {In recent years, object detection for Autonomous Vehicles (AV) in real-time demands high accuracy and low computational complexity to support on-device inference at the edge. However, existing You Look Only Once version-9 (YOLOv9) suffers from heavy computational complexity, high memory consumption, and inference latency, making it unsuitable for real-time Edge Artificial Intelligence (AI) deployment in AV. To address this limitation, this research proposes an optimized MobileNet Version3 - Simple Feature Pyramid Network (MobileNetV3 + Simple FPN) model, which is an efficient and lightweight method of object detection. Initially, the data is collected from the Karlsruhe Institute of Technology and Toyota Technological Institute (KITTI) which includes multi-modal data of stereo images. The preprocessing steps such as image resizing, normalization and Data Augmentation (DA) were applied to enhance model performance in various lighting and environmental conditions. Subsequently, the MobileNetV3 is used for modelling features with depth-wise separable convolutions and Squeeze-andExcitation (SE) blocks that add adaptive channel-wise recalibration. Followed by that, a Simple FPN fuses multi-scale feature representations and a single stage detection head predicts class probabilities and bounding boxes are processed Non-Maximum Suppression (NMS) respectively. Experimental results demonstrate that the MobileNetV3 + Simple FPN achieves a mean Average Precision (mAP)(92.4%), precision (98.9%), and recall (97.2%) when compared with the YOLOv9 model. © 2025 IEEE.},
	type = {Conference paper},
