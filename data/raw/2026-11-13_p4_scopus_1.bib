	doi = {10.1109/ICERCS65898.2025.11580882},
	url = {https://www.scopus.com/pages/publications/105044549286?origin=resultslist},
	abstract = {The high-duty vehicles are often used under adverse conditions like tunnels, highways and industrial areas where the low luminance and visual noise are major causes of poor object detection. Regular eyesight and sensors cannot achieve reliability in such circumstances and make collisions and circumstances of operation a greater risk. In this paper, an AI-driven low-light object detection system will be proposed to improve the visibility and safety of heavy-duty vehicles. The given system combines a deep convolutional neural network (Zero-DCE++) to improve adaptive illumination with a real-time object detector model (YOLOv11) trained on the datasets in low-light scenarios including exDark, FLIR Thermal and BDD100K. Experiments have shown that the optimized detection pipeline attains a mean Average Precision (mAP@0.5) of 0.78 and is significantly more accurate than traditional models yet retains almost real-time inference in an NVIDIA Jetson Xavier NX system. The findings demonstrate that AI-based low-light vision systems have a high potential to make night-time and tunnel driving much safer on heavy duty vehicles due to better perception, quick response, and consistent obstacle detection.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
