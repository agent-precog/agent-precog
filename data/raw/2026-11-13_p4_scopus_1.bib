@ARTICLE{Daniel2026,
	author = {Daniel, Jones and Sundarrajan, R.},
	title = {MedFuseNet: A cross-modality attention network for predicting emergencies in smart hospital beds using fog computing},
	year = {2026},
	journal = {Franklin Open},
	volume = {17},
	pages = {},
	doi = {10.1016/j.fraope.2026.100766},
	url = {https://www.scopus.com/pages/publications/105050385064?origin=resultslist},
	abstract = {Due to the increasing demand for real-time and context-aware health monitoring in eldercare, this study proposes MedFuseNet, a cross-modality attention network that fuses heterogeneous sensor signals to forecast emergencies in smart hospital beds. MedFuseNet is built on a multimodal sensor fusion platform to continuously sense and process the data from thermal cameras, load cells, hydration sensors, and visual modules to identify symptoms of illness like fevers, posture abnormalities, irregularities with IV-drips, and hydration risks, which are not detected by rule-based decision-making systems or unimodal sensing. An adaptive algorithm, called Cross Modality Adaptive Attention (CMAA) is introduced to adaptively weight the importance of each sensor input based on the temporal context, signal quality and situational urgency to avoid misleading emergency predictions in different types of signal conditions. By integrating it with a fog-computing architecture, this mechanism demonstrates low-latency on-device processing feasibility under controlled fog-hardware conditions, while also providing data privacy, offline functionality and energy savings in low-resource and home-care scenarios. MedFuseNet achieves emergency-prediction accuracy of 94.0 % (macro F1 = 0.93, AUC = 0.96) on a synthetically generated multimodal dataset, outperforming six baseline multimodal architectures including recurrent, attention-based, transformer, cross-attention and edge-AI fusion architectures (CNN-LSTM, GRU-Attention, TMMF, MulT, a deep multimodal transformer, and a fusion model based on MobileNet, with all margins confirmed through paired cross-validation significance tests (p < 0.05)). It runs at 2.3 W on an emulated fog node (NVIDIA Jetson Nano) with TensorRT-FP16 optimization, and achieves 38 % improved inference latency and 45 % reduced model size compared to the baselines. The results reported should be used only as a simulation based proof-of-concept benchmark to showcase the computation and methodological feasibility of MedFuseNet. These findings do not prove clinical reliability, diagnostic validity, safety or readiness for deployment because no real patients, clinical settings, or prospectively collected bedside sensor data were used in the present evaluation. The prospective validation, with real multimodal patient data and physical smart bed hardware is therefore necessary prior to clinical use. © 2026 The Authors.},
