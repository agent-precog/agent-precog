@ARTICLE{Shit2026,
	author = {Shit, Rathin Chandra},
	title = {Edge-enabled visual perception for autonomous driving: Architectures, optimisations, and communication-aware performance analysis},
	year = {2026},
	journal = {Computer Communications},
	volume = {258},
	pages = {},
	doi = {10.1016/j.comcom.2026.108654},
	url = {https://www.scopus.com/pages/publications/105047901502?origin=resultslist},
	abstract = {Real-time camera based perception at the network’s edge is one of the most essential technologies for safe Autonomous Vehicle (AV) deployment, but existing surveys have yet to systematically combine edge hardware constraints with a communication-aware performance analysis in the context of Vehicle-to-Everything (V2X) applications. This systematic review synthesises 137 studies, 124 of which are peer-reviewed journal and conference articles, and 13 are high impact preprints (citation snapshot: December 2025), obtained from IEEE Xplore, ACM Digital Library, ScienceDirect, Springer and arXiv, following the PRISMA guidelines. Preprints constitute a separately labelled evidence stratum throughout the manuscript.The review focuses on three fundamental computer vision tasks: semantic segmentation, object detection, and monocular depth estimation, and is performed only on devices with camera hardware, specifically automotive-grade devices from NVIDIA (Jetson AGX Xavier, Jetson Orin), Google (Coral TPU), Intel (Movidius VPU), and Xilinx (Kria FPGA). The corpus yields four high confidence quantitative takeaways. First, lightweight dual-branch convolutional networks (e.g., DDRNet-23) support real time performance on production grade edge devices with 79.4 mIoU at 50.1 FPS on 30 W automotive GPU. Second, the INT8 quantisation reduces latency by (Formula presented) –(Formula presented) consistently across all the surveyed segmentation and detection tasks with less than 1% accuracy loss, which has been validated across multiple independent studies on automotive SoCs. Third, V2X-enabled collaborative perception adds scenario-dependent end-to-end latency overheads; the typical range of values surveyed with packet-loss targets below 0.1% for urban collision avoidance is 10–50 ms for 5G NR networks. These are not universal requirements, but rather depend on Operational Design Domain (ODD), network stack and fusion strategy. Fourth, there are also critical open challenges such as environmental robustness degradation (typical surveyed range: 20–30 mIoU reduction under adverse weather conditions) and safety-validation gaps that still stand as the main obstacle for deployment. All other quantitative values presented are illustrative values of the literature surveyed and should be used as a guideline in a specific hardware, data, and operating environment. A communication-aware evaluation structure, a benchmarking protocol, and a cyber-threat taxonomy are contributed to aid in reproducible, safety-informed system design. © 2026 Elsevier B.V. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Ghantasala202623549,
	author = {Ghantasala, G. S. Pradeep and Ioannou, Iacovos I. and Kolla, Thrilok and Vidyullatha, Pellakuri and Nanjappan, Vijayalakshmi and Michalis, Savva and Vassiliou, Vasos},
	title = {A Multilayered Framework for Adaptive and Optimized Real-Time Data Processing in Edge-Fog IoT Environments},
	year = {2026},
	journal = {IEEE Internet of Things Journal},
	volume = {13},
	number = {11},
	pages = {23549 - 23575},
	doi = {10.1109/JIOT.2026.3670432},
	url = {https://www.scopus.com/pages/publications/105031951854?origin=resultslist},
	abstract = {Real-time Internet of Things (IoT) analytics in smart cities demand millisecond-scale responsiveness and energy efficiency requirements that challenge cloud-only deployments, which struggle with latency and bandwidth constraints. In brief, this article presents a unified three-layer edge-fog decision stack comprising: 1) queueing-theoretic performance modeling; 2) NSGA-II Pareto-based offline tradeoff mapping; 3) a training-free genetic-algorithm offloader (GAO) for online adaptation; 4) formal tail-latency guarantees; and 5) comprehensive validation through both simulation and a Raspberry Pi/Jetson prototype. We introduce a novel three-layer decision framework that couples a queueing-theoretic edge-fog pipeline with offline Pareto optimization and online adaptation. Our key contributions are: 1) an analytical model, validated through simulation, demonstrating edge latency of 10±2 ms and fog latency of 40 ±10 ms [processing time only, excluding network round-trip time (RTT)]; 2) NSGA-II-based offline optimization yielding Pareto-optimal configurations that reduce energy and cost by 32.6% while adding only 0.7ms of latency; 3) a novel training-free GAO for real-time adaptation, eliminating the costly training phase required by deep reinforcement learning (DRL); 4) formal tail-latency guarantees via Kingman's bounds that ensure provable service-level agreement (SLA) compliance; and 5) a comprehensive evaluation against 15 baselines, including state-of-the-art DRL and hybrid approaches. In simulation, GAO achieves 2.03-ms 99th-percentile latency [4.7× better than the strongest DRL baseline, GNN-based soft actor-critic (GNN-SAC), and 8× better than vanilla deep Q-network (DQN)], 100% SLA compliance, and 25% energy reduction. On a Raspberry Pi 5 and NVIDIA Jetson Orin Nano hardware prototype, GAO achieves 18.2-ms p99 latency and outperforms Azure IoT Edge, KubeEdge, and Eclipse ioFog by over 30% on latency and 22% on energy.  © 2014 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
