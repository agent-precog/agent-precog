@ARTICLE{Yu202626426,
	author = {Yu, Jiang and Peng, Yuxing and Li, Rongxing and Shi, Fahui and Chang, Xiangdong and Chen, Yanwu and Fang, Jun and Li, Menggang and Wei, Dong},
	title = {Framework for Degraded RGB Vision Sensor Data in Underground Mine Monorail Cranes},
	year = {2026},
	journal = {IEEE Sensors Journal},
	volume = {26},
	number = {17},
	pages = {26426 - 26447},
	doi = {10.1109/JSEN.2026.3715307},
	url = {https://www.scopus.com/pages/publications/105046130807?origin=resultslist},
	abstract = {Accurate and real-time detection of frontal obstacles and targets is essential for enabling autonomous operation of underground mine monorail cranes. However, image data acquired by front-facing RGB vision sensors is often affected by overexposure, low illumination, dust haze, occlusion, and scale variation, which lead to degraded target features and reduced detection performance. Meanwhile, the resource constraints of on-board edge devices also impose strict requirements on model lightweightness. To address these challenges, this article proposes a lightweight object detection framework for degraded RGB image data. Specifically, a lightweight feature extraction network composed of a robust feature compensation block (RFCB) and GhostConv is constructed to enhance discriminative structural representations in degraded regions while reducing redundant computation. Furthermore, a dynamic receptive-field fusion module (DRFM) is designed, and a repulsion-constrained localization loss is introduced to improve multiscale feature fusion and localization stability under occluded scenarios. An underground mine monorail crane object detection dataset containing 10 890 images is established, and the proposed method is evaluated on the self-built dataset, the CMU-Drill cross-dataset experiment, and an on-board edge inference platform. Experimental results based on five independent training runs show that the proposed method achieves an average mAP@0.5 of 93.9% and an average mAP@0.5:0.95 of 68.3% on the self-built dataset, outperforming the YOLOv8 baseline by 2.2% and 2.3%, respectively. Meanwhile, the number of parameters and computational cost are reduced to 2.3 M and 7.1 GFLOPs, corresponding to reductions of 23.3% and 13.4% compared with the baseline, respectively. Cross-dataset experiments and edge-platform inference tests further demonstrate that the proposed method exhibits favorable robustness, generalization ability, and real-time inference potential for degraded image data. This study provides an effective solution for real-time object detection based on complex RGB vision sensor data on resource-constrained edge platforms. © 2026 IEEE. All rights reserved.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Tadjine2026179,
	author = {Tadjine, Chaouki and Ouafi, Abdelkrim and Taleb-Ahmed, Abdelmalik and El Hillali, Yassin},
	title = {Enhancing Real-Time Object Detection on NVIDIA Jetson Nano via Class-Specific Dataset Splitting for YOLO Models},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {16555 LNCS},
	pages = {179 - 192},
	doi = {10.1007/978-3-032-28661-1_10},
	url = {https://www.scopus.com/pages/publications/105055496585?origin=resultslist},
	abstract = {Achieving efficient and reliable real-time object detection in resource-constrained edge devices is critical for enabling next-generation autonomous logistics systems. This study presents a modular object detection framework based on class-specific YOLOv8 models, optimized for the NVIDIA Jetson Nano and evaluated using the Logistics Objects in Context (LOCO) dataset. By decomposing detection into a model for transporting tools and another for goods-carrying tools, the system significantly reduces computational load while retaining detection accuracy. Compared to a unified five-class YOLOv8 model, this class-split architecture achieved a 30.6% to 74.4% improvement in inference time and minimized motion-induced latency, reducing the hypothetical distance covered during detection from 45.14 cm to 11.55 cm in fast-moving scenarios. To assess the scalability and robustness of this approach, the same methodology was extended to YOLOv9 and YOLOv10 architectures. While both alternatives delivered different speedup records, they incurred noticeable accuracy losses, highlighting YOLOv8 as the most balanced model for deployment on the LOCO dataset. These findings demonstrate that model specialization, when aligned with task granularity, can yield substantial gains in inference performance on embedded platforms, paving the way for practical deployment in industrial automation environments such as autonomous forklifts. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Jeon2026,
