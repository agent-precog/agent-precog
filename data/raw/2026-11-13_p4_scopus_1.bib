@ARTICLE{Zhang20262408,
	author = {Zhang, Hengwen and Li, Weibo and Li, Mengda},
	title = {Perception-Semantic Alignment and Offline Distillation for Vision-Guided Quadruped Locomotion on Complex Terrains},
	year = {2026},
	journal = {Youth Academic Annual Conference of Chinese Association of Automation, YAC},
	number = {2026},
	pages = {2408 - 2412},
	doi = {10.1109/YAC71005.2026.11615876},
	url = {https://www.scopus.com/pages/publications/105047313024?origin=resultslist},
	abstract = {Vision-guided quadruped locomotion in unstructured environments is fundamentally constrained by two interrelated challenges: (i) the visual Sim-to-Real discrepancy arising from the mismatch between idealized simulation rendering and real-world sensor noise, and (ii) the prohibitive sample complexity of end-to-end visual reinforcement learning. This paper presents a deployment-oriented framework that integrates Physically Consistent Sensor Modeling (PCSM) with a five-stage progressive distillation pipeline (Rough-Terrain-Rollout-Distillation-Visual). PCSM bridges the simulation-to-reality perception gap through explicit camera parameter matching (FOV, resolution, sensing range), calibrated hybrid noise injection, and depth normalization. The staged training pipeline progressively acquires robust locomotion skills under privileged teacher supervision, transfers the learned policy to a lightweight student network via offline knowledge distillation, and subsequently corrects residual distribution shift through low-overhead online adaptation. Experimental evaluation on the Unitree Go2 quadruped robot demonstrates that the proposed method elevates the Sim-to-Real transfer success rate on extremely challenging terrains from 15% (blind proprioception baseline) to 72%, while reducing the total visual-policy training cost to approximately 59 GPU-hours on a single RTX 4090 workstation. On the Jetson Orin NX edge platform, end-to-end inference latency is maintained within 25 ms, satisfying real-time deployment requirements. These results establish that explicit perception alignment combined with staged teacher-student supervision constitutes an effective and computationally tractable route to robust quadruped locomotion in the wild.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
