@ARTICLE{Li2027,
	author = {Li, Pengfei and Ruan, Yinghao and Liu, Peishun and Dong, Junyu and Dong, Xinghui},
	title = {Fast time series anomaly detection using an efficient periodicity-aware neural network},
	year = {2027},
