@ARTICLE{Tian2026,
	author = {Tian, Lijia and Zhao, Hongli and Zhu, Li and Jiang, Hailin and Gao, Xinjun},
	title = {Edge Intelligence-Based Rail Transit Equipment Inspection System},
	year = {2026},
