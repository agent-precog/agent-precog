@ARTICLE{Jing2025,
	author = {Jing, Qianfeng and Bai, Mingwang and Yin, Yong and Guo, Dongdong},
	title = {I-VoxICP: A Fast Point Cloud Registration Method for Unmanned Surface Vessels},
	year = {2025},
