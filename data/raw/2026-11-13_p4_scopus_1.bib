@ARTICLE{Shen2026,
	author = {Shen, Yi and Lin, Yuanchao and Li, Jie and Zhang, Zhenhua and Yuan, Mingxin},
	title = {Real-time target fine localization of the filling port for an autonomous fueling arm based on a lightweight YOLO-LCD model},
	year = {2026},
	journal = {Journal of Supercomputing},
	volume = {82},
	number = {10},
	pages = {},
	doi = {10.1007/s11227-026-08717-w},
	url = {https://www.scopus.com/pages/publications/105044702735?origin=resultslist},
	abstract = {To meet the requirements of high real-time performance, high precision, and high stability in autonomous fueling operations for oil tanker scenarios, this paper proposes a lightweight YOLO-LCD model designed for real-time edge computing deployment and achieves three-dimensional fine localization of filling port targets for an autonomous fueling arm. The fine localization process of the autonomous fueling arm involves a continuous pipeline of image acquisition, object detection, depth information processing, and coordinate transformation, imposing strict requirements on low-latency inference capability and efficient edge-side computation. First, considering the challenging operational conditions of autonomous fueling scenarios, including severe illumination variations, uncertain filling port positions, and strong background interference, the limitations of the YOLOv8n detection model in the task of filling port fine localization are analyzed. To address the issue of high model complexity and improve real-time inference performance, a Lightweight Feature Processing (LFP) module is designed to enhance detection efficiency. To mitigate missed and false detections caused by weak-feature responses of the filling port under illumination variations, a Structure-Aware Multi-Scale Context (SAMC) module is introduced to strengthen the perception and representation of key features. Furthermore, to address the large spatial variation of filling port positions and the attenuation of spatial information during deep feature propagation, a Dual-Mapping Fusion Module (DMFM) is introduced to enhance the interaction and fusion between semantic information and spatial positional information, thereby improving the model’s localization capability and feature representation ability. On this basis, a dataset is constructed using a depth camera mounted on the autonomous fueling arm, covering complex conditions such as illumination variations, filling port position variations, and layout variations. Extensive experiments are conducted, including quantitative comparison, qualitative comparison, ablation studies, generalization experiments, and edge device deployment tests. Experimental results show that, compared with 20 state-of-the-art benchmark models, the proposed YOLO-LCD model reduces Parameters, FLOPs, and Model Size by 52.61%, 55.73%, and 56.05% on average, respectively, while improving mAP50-95 by 4.93% on average. Generalization experiments further demonstrate that YOLO-LCD maintains strong detection accuracy and real-time performance on public datasets, indicating its cross-domain adaptability. Edge deployment results verify its advantages in lightweight design and real-time inference on resource-constrained platforms. Moreover, fine localization experiments show that the proposed model reduces the overall average localization error by 31.513%. These results demonstrate that YOLO-LCD can satisfy the requirements of high real-time performance, high precision, and high stability for three-dimensional fine localization of filling port targets in autonomous fueling arms, and exhibits strong potential for edge-based real-time visual deployment. © The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature 2026.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Zhang20263739,
	author = {Zhang, Bin and Feng, Qian and Ma, Tianjiao and Li, Moxiao and Liang, Yabin and Wang, Xinji and Gu, Yiting},
	title = {A lightweight and real-time deep learning approach for pipeline bolt loosening detection using active guided waves},
	year = {2026},
	journal = {Structural Health Monitoring},
	volume = {25},
	number = {6},
	pages = {3739 - 3765},
	doi = {10.1177/14759217251399083},
	url = {https://www.scopus.com/pages/publications/105026209474?origin=resultslist},
	abstract = {Loosening of bolt connections in industrial pipeline systems poses significant risks to structural integrity and operational safety. However, conventional detection methods often suffer from low efficiency and poor robustness in complex environments. To address these challenges, this study proposes a lightweight and real-time bolt loosening detection framework based on active guided waves and multi-channel piezoelectric sensing, enhanced by advanced deep learning techniques. Specifically, an eight-channel piezoelectric sensor array is used to capture guided wave responses, which are transformed into two-dimensional (2D) representations via multi-scale feature fusion and local enhancement to facilitate deep learning. A total of 34 complex loosening scenarios—including single, adjacent, diagonal, and multi-bolt combinations—are experimentally simulated under diverse noise conditions to emulate real-world disturbances. An improved ResNet18 architecture is developed by integrating a multi-head attention mechanism for capturing long-range dependencies, along with a Squeeze-and-Excitation (SE) module for adaptive channel recalibration. Experimental results show that the proposed model achieves 99% detection accuracy under noisy conditions, with inference latency ranging from 7.2 to 10.1 ms and a throughput of 114–163 FPS (frames per second), fulfilling real-time requirements. Ablation studies confirm the effectiveness of the attention and SE components. Compared with deeper models such as ResNet50 and VGG16, the proposed method significantly reduces parameter count (13.02M) while maintaining competitive performance, enabling efficient edge deployment. Furthermore, few-shot learning experiments demonstrate that over 90% accuracy can be achieved with only five training samples in previously unseen working conditions. This research provides a robust, efficient, and scalable solution for intelligent structural health monitoring of pipeline bolt assemblies and offers valuable insights for fault diagnosis under complex industrial noise environments. © The Author(s) 2025},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@CONFERENCE{Yu20261906,
	author = {Yu, Yang},
	title = {Design and Key Algorithm Optimization of an Intelligent Training Decision Support System for Basketball Teaching},
	year = {2026},
	journal = {2026 9th International Conference on Advanced Algorithms and Control Engineering, ICAACE 2026},
	pages = {1906 - 1913},
	doi = {10.1109/ICAACE69793.2026.11508763},
	url = {https://www.scopus.com/pages/publications/105041651389?origin=resultslist},
	abstract = {Basketball teaching increasingly relies on evidence-based feedback, yet most school-level training workflows still depend on subjective observation and static lesson plans. Recent progress in basketball action recognition, wearable sensing, and explainable sports analytics provides the computational foundation for real-time technique assessment and decision support in authentic classroom environments. However, a practical teaching system must jointly satisfy (i) multimodal robustness under occlusion and motion blur, (ii) low-latency edge feedback for immediate correction, (iii) privacy-preserving personalization across heterogeneous students, and (iv) pedagogically meaningful recommendations aligned with curricula and skill rubrics. To address these requirements, this paper presents an intelligent training decision support system (ITDSS) for basketball teaching and optimizes its key algorithms through an edge-cloud co-design. The proposed system integrates video and wearable signals to estimate technique quality, fatigue state, and uncertainty, and then uses a curriculum knowledge graph to constrain a reinforcement learning policy that schedules drills and feedback strategies. From the computer-technology perspective, we contribute (1) a latency-constrained multimodal transformer (LCMT) with dynamic modality gating for stable fusion, (2) an uncertainty-regularized actor-critic with curriculum graph constraints (URAC-G) for pedagogically consistent decision making, and (3) a noise-robust federated optimization pipeline that combines data-aware aggregation, structured pruning, and INT8 quantization for on-device deployment. Experiments on a multi-school dataset (video + IMU + heart rate) demonstrate that the proposed system improves technique recognition and drill recommendation quality while reducing end-to-end feedback latency, enabling an energy-efficient and privacy-aware teaching workflow.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Guo202621486,
	author = {Guo, Tianyu and Zhao, Shanwei and Zhu, Shiai and Ma, Chenguang},
	title = {SPEED-Q: Staged Processing with Enhanced Distillation Towards Efficient Low-Bit On-Device VLM Quantization},
	year = {2026},
	journal = {Proceedings of the AAAI Conference on Artificial Intelligence},
	volume = {40},
	number = {26},
	pages = {21486 - 21494},
	doi = {10.1609/aaai.v40i26.39296},
	url = {https://www.scopus.com/pages/publications/105034705844?origin=resultslist},
	abstract = {Deploying Vision-Language Models (VLMs) on edge devices (e.g., smartphones and robots) is crucial for enabling low-latency and privacy-preserving intelligent applications. Given the resource constraints of these devices, quantization offers a promising solution by improving memory efficiency and reducing bandwidth requirements, thereby facilitating the deployment of VLMs. However, existing research has rarely explored aggressive quantization on VLMs, particularly for the models ranging from 1B to 2B parameters, which are more suitable for resource-constrained edge devices. In this paper, we propose SPEED-Q, a novel Staged Processing with EnhancEd Distillation framework for VLM low-bit weight-only quantization that systematically addresses the following two critical obstacles: (1) significant discrepancies in quantization sensitivity between vision (ViT) and language (LLM) components in VLMs; (2) training instability arising from the reduced numerical precision inherent in low-bit quantization. In SPEED-Q, a staged sensitivity adaptive mechanism is introduced to effectively harmonize performance across different modalities. We further propose a distillation-enhanced quantization strategy to stabilize the training process and reduce data dependence. Together, SPEED-Q enables accurate, stable, and data-efficient quantization of complex VLMs. SPEED-Q is the first framework tailored for quantizing entire small-scale billion-parameter VLMs to low bits. Extensive experiments across multiple benchmarks demonstrate that SPEED-Q achieves up to 6× higher accuracy than existing quantization methods under 2-bit settings and consistently outperforms prior on-device VLMs under both 2-bit and 4-bit settings. © 2026, Association for the Advancement of Artificial Intelligence (www.aaai.org). All rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Chen2026,
	author = {Chen, Wenhe and Wang, Yue and Shen, Shuonan and Hua, Leer and Zheng, Caixia and Pu, Qi and Ma, Xundiao},
	title = {VIF-YOLO: A Visible-Infrared Fusion YOLO Model for Real-Time Human Detection in Dense Smoke Environments},
	year = {2026},
	journal = {Computers, Materials and Continua},
	volume = {87},
	number = {1},
	pages = {},
	doi = {10.32604/cmc.2025.074682},
	url = {https://www.scopus.com/pages/publications/105029534217?origin=resultslist},
	abstract = {In fire rescue scenarios, traditional manual operations are highly dangerous, as dense smoke, low visibility, extreme heat, and toxic gases not only hinder rescue efficiency but also endanger firefighters’ safety. Although intelligent rescue robots can enter hazardous environments in place of humans, smoke poses major challenges for human detection algorithms. These challenges include the attenuation of visible and infrared signals, complex thermal fields, and interference from background objects, all of which make it difficult to accurately identify trapped individuals. To address this problem, we propose VIF-YOLO, a visible–infrared fusion model for real-time human detection in dense smoke environments. The framework introduces a lightweight multimodal fusion (LMF) module based on learnable low-rank representation blocks to end-to-end integrate visible and infrared images, preserving fine details while enhancing salient features. In addition, an efficient multiscale attention (EMA) mechanism is incorporated into the YOLOv10n backbone to improve feature representation under low-light conditions. Extensive experiments on our newly constructed multimodal smoke human detection (MSHD) dataset demonstrate that VIF-YOLO achieves mAP50 of 99.5%, precision of 99.2%, and recall of 99.3%, outperforming YOLOv10n by a clear margin. Furthermore, when deployed on the NVIDIA Jetson Xavier NX, VIF-YOLO attains 40.6 FPS with an average inference latency of 24.6 ms, validating its real-time capability on edge-computing platforms. These results confirm that VIF-YOLO provides accurate, robust, and fast detection across complex backgrounds and diverse smoke conditions, ensuring reliable and rapid localization of individuals in need of rescue. Copyright © 2026 The Authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4; All Open Access; Gold Open Access}
}

@ARTICLE{Castro-Mejia2026,
	author = {Castro-Mejia, Percy and Atalaya-Urrutia, William and Cruzata-Martinez, Alejandro and Salazar-Montoya, Erick and Jimenez-Garcia, Alberto and Arcila-Diaz, Juan},
	title = {Enabling Quechua speech in humanoid social robots through fine-tuned neural TTS on the UBTech Walker Tienkung},
	year = {2026},
	journal = {Frontiers in Robotics and AI},
	volume = {13},
	pages = {},
	doi = {10.3389/frobt.2026.1909076},
	url = {https://www.scopus.com/pages/publications/105054891001?origin=resultslist},
	abstract = {Humanoid social robots deployed in multilingual societies—particularly in indigenous communities—face a critical linguistic gap: their speech interfaces are predominantly designed for high-resource languages, excluding hundreds of millions of indigenous language speakers from equitable human-robot interaction. This study presents the first neural text-to-speech (TTS) system for Southern Quechua—the most extensive indigenous language family of the Americas, with more than ten million active speakers—deployed on a humanoid social robot. XTTS-v2, a multilingual neural TTS model, was fine-tuned on 22, 727 validated utterances (30.5 h, 77 speakers) of the Cusco-Puno dialect, located in southern Peru, through a tokenizer adaptation that leverages the phonological overlap between Quechua and Spanish. Fine-tuning over 15 epochs on an NVIDIA A100 40 GB GPU achieved a 35.0% reduction in training cross-entropy loss (4.084 → 2.652), confirming effective adaptation to Quechua phonology and morphology with stable training dynamics across 35, 000 gradient update steps. Inference latency was evaluated on two hardware environments: the training GPU (mean latency: 2, 037 ms; Real-Time Factor (RTF) = 0.472) and the embedded SoC of the UBTech Walker Tienkung humanoid robot (Jetson AGX Orin 64 GB; mean latency: 5, 913 ms; RTF = 0.961). Both configurations achieved a mean RTF below 1.0, demonstrating real-time Quechua speech synthesis directly on the robot’s hardware without external computing infrastructure. Intelligibility evaluation using Whisper large-v3 with automatic language detection yielded a Word Error Rate of 147.4% and a Character Error Rate of 69.1%; these values reflect the absence of a native Quechua automatic speech recognition (ASR) model rather than the quality of TTS synthesis. These results establish the first quantitative benchmark for TTS in American indigenous languages on a humanoid robotic platform and provide a reproducible framework—encompassing training configuration, tokenizer adaptation, and deployment pipeline—for extending neural speech synthesis to other low-resource languages of the Americas. Copyright © 2026 Castro-Mejia, Atalaya-Urrutia, Cruzata-Martinez, Salazar-Montoya, Jimenez-Garcia and Arcila-Diaz.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
