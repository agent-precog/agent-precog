@ARTICLE{Villegas-Ch2026,
	author = {Villegas-Ch, William and Gutierrez, Rommel and Govea, Jaime and Palacios, Pablo},
	title = {Autonomous federated defense for zero-day threats in IIoT: explainable agents with real-time edge inference},
	year = {2026},
	journal = {Frontiers in Communications and Networks},
