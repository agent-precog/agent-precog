	title = {GPU-Based Parallel Computation of Multi-Set Dynamics for Articulated Robots},
	year = {2026},
	journal = {IEEE/ASME International Conference on Advanced Intelligent Mechatronics, AIM},
	pages = {},
	doi = {10.1109/AIM65483.2026.11658297},
	url = {https://www.scopus.com/pages/publications/105049188504?origin=resultslist},
	abstract = {Predictive controllers that incorporate full-body dynamics have long been constrained by a fundamental trade-off between model fidelity and computational feasibility. We present GPU-ARBML, a GPU library that evaluates articulated full-body dynamics in large batches. The library adopts an asynchronous pipeline integrating pinned memory and CUDA streams to decouple CPU-GPU communication. This architecture effectively minimizes control-loop jitter while ensuring high determinism. Benchmarks on a complex 29-DOF floating-base model show that GPU-ARBML outperforms state-of-the-art CPU libraries in multi-set computations, exhibiting sub-linear growth in iteration time as the number of rollouts increases. Integrated with an MPPI controller, GPU-ARBML is validated on 6-DOF and 7-DOF arms in both simulation and hardware, sustaining 500 Hz real-time control on embedded hardware (NVIDIA Jetson AGX Orin). Furthermore, the library's versatility is demonstrated through a simulation study of a two-wheeled legged robot's balancing control. These results support the practical deployment of floating-base models. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Ahmad2026,
	author = {Ahmad, Sarat and Hafeez, Maryam and Zaidi, Syed Ali Raza},
	title = {Vision Language Models on the Edge for Real-Time Robotic Perception},
	year = {2026},
	journal = {IEEE International Conference on Communications},
	pages = {},
	doi = {10.1109/ICC59461.2026.11587760},
	url = {https://www.scopus.com/pages/publications/105045375758?origin=resultslist},
	abstract = {Vision-Language Models (VLMs) enable multimodal reasoning for robotic perception and interaction, but their deployment in real-world systems remains constrained by latency, limited onboard resources, and privacy risks of cloud offloading. Edge intelligence within 6G, particularly Open RAN and Multi-access Edge Computing (MEC), offers a pathway to address these challenges by bringing computation closer to the data source. This work investigates the deployment of VLMs on ORAN/MEC infrastructure using the Unitree G1 humanoid robot as an embodied testbed. We design a WebRTC-based pipeline that streams multimodal data to an edge node and evaluate LLaMA-3.2-11B-Vision-Instruct deployed at the edge versus in the cloud under real-time conditions. Our results show that edge deployment preserves near-cloud accuracy while reducing end-to-end latency by 5%. We further evaluate Qwen2-VL-2BInstruct, a compact model optimized for resource-constrained environments, which achieves sub-second responsiveness, cutting latency by more than half but at the cost of accuracy. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Brahmi2026312,
	author = {Brahmi, Ihsen Ben Mbarek and Bretecher, Sandric and Hoffmeyer-Kuntz, Line and Chanvalon, Clément},
	title = {Deterministic Embedded Machine Learning for Adaptive Fighter Aircraft HUD Stabilization},
	year = {2026},
	journal = {2026 IEEE 15th International Conference on Communication Systems and Network Technologies, CSNT 2026},
	pages = {312 - 318},
	doi = {10.1109/CSNT69054.2026.11502063},
	url = {https://www.scopus.com/pages/publications/105040704448?origin=resultslist},
	abstract = {Head-Up Displays (HUDs) are mission-critical cockpit interfaces in fighter aircraft, requiring high visual stability under extreme flight dynamics including rapid rotations, structural vibrations, and aggressive maneuvering. Conventional inertial stabilization approaches rely on fixed model-based filtering techniques that lack adaptability to rapidly varying motion conditions, often resulting in residual visual jitter and increased pilot cognitive workload. This paper proposes a deterministic embedded machine learning approach for adaptive fighter aircraft HUD stabilization. The core contribution lies in integrating lightweight on-device intelligence capable of real-time inertial motion classification under strict memory and latency constraints compatible with safety-critical avionics systems. Using tri-axial gyroscope data, the system classifies four fundamental aircraft motion states-yaw, roll, pitch, and level flight-through temporal signal windows of 1536 samples (512 per axis). A comparative benchmarking study evaluates Multi-Layer Perceptron (MLP), Random Forest (RF), Support Vector Machine (SVM), SEFR, and Extreme Gradient Boosting (XGBoost) models trained on 150 motion sequences per class. Experimental results demonstrate that the MLP-based implementation achieves the optimal trade-off between classification accuracy and embedded resource usage, reaching a balanced accuracy of 97.50% and a quality index of 93.5, while requiring only 5.8 KB RAM, 24 KB Flash memory, and 3.3 ms Worst Case Execution Time (WCET) on a microcontroller-class platform. The deterministic execution behavior ensures bounded latency suitable for real-time avionics applications. Compared to conventional inertial stabilization methods, the proposed adaptive strategy enables context-aware HUD rendering with improved visual robustness and operational reliability under dynamic flight conditions. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@CONFERENCE{Nelson Francis2026320,
	author = {Nelson Francis, I.M. and Sophia, S.},
	title = {Towards Secure UAV Ecosystems: A GAN-Assisted CNN-BiLSTM Hybrid Deep Learning Framework for 6G Edge Networks},
	year = {2026},
	journal = {Proceedings of 7th International Conference on Intelligent Communication Technologies and Virtual Mobile Networks, ICICV 2026},
	pages = {320 - 327},
	doi = {10.1109/ICICV68925.2026.11554612},
	url = {https://www.scopus.com/pages/publications/105042867935?origin=resultslist},
	abstract = {Unmanned Aerial Vehicles (UAVs) are increasingly deployed in mission-critical applications, making them highly susceptible to cyber-attacks that compromise operational safety and communication reliability. This paper proposes a novel SecureUAV-6G framework to enhance UAV cybersecurity in 6G-enabled edge network environments. The framework integrates Generative Adversarial Network (GAN)-based data augmentation with a hybrid Convolutional Neural Network-Bidirectional Long Short-Term Memory (CNN-BiLSTM) model to effectively address class imbalance and capture both spatial and temporal features of UAV network traffic. Experiments are conducted on the UAVIDS-2025 dataset, where GAN augmentation is used to enrich minority attack classes and improve model generalization. The proposed approach is evaluated against both classical machine learning models and standalone deep learning architectures, demonstrating superior performance. Results show that the framework achieves an accuracy of up to 99.2%, along with improved precision, recall, and F1-score, while maintaining low latency suitable for real-time edge deployment. Additionally, the model effectively detects rare and multi-class attacks and exhibits robustness under noisy and imbalanced conditions. The scalability and deployment feasibility of the proposed framework highlight its potential for securing UAV ecosystems and enabling intelligent, autonomous defense mechanisms in future 6G edge networks. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Chen2026,
	author = {Chen, Shikun and Xiong, Songquan and Lv, Longjin and Lu, Xueqin and Li, Wenxiang and Mao, Junjie},
	title = {Height-encoded vision-language distillation for edge automotive bushing inspection},
	year = {2026},
	journal = {Journal of Visual Communication and Image Representation},
