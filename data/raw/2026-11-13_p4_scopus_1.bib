@CONFERENCE{He2026142,
	author = {He, Yuankai and Shi, Weisong},
	title = {A Faster and More Reliable Middleware for Autonomous Driving Systems},
	year = {2026},
	journal = {IEEE Intelligent Vehicles Symposium, Proceedings},
	pages = {142 - 149},
	doi = {10.1109/IV66570.2026.11624004},
	url = {https://www.scopus.com/pages/publications/105046896365?origin=resultslist},
	abstract = {Ensuring safety in high-speed autonomous vehicles depends on rapid control loops and tightly bounded delays from perception to actuation. Many open-source autonomy systems depend on ROS 2 middleware, but when multiple sensor and control nodes share a single computing unit, ROS 2 and its DDS transports introduce significant (de)serialization, data copying, and discovery overheads, eroding the available time budget. We present Sensor-in-Memory (SIM), a shared-memory transport specifically designed for intra-host pipelines in autonomous vehicles. SIM keeps sensor data in their native memory layouts (e.g., cv::Mat, PCL), uses lock-free bounded double buffers that overwrite old data to prioritize freshness, and requires only four lines of code to integrate into ROS 2 nodes. Unlike traditional middleware, SIM operates beside ROS 2 and is optimized for applications where data freshness and minimal latency outweigh guaranteed completeness. SIM incorporates sequence numbers, a writer heartbeat, and optional checksums to provide data ordering, liveness, and basic integrity. On NVIDIA Jetson Orin Nano, SIM reduces data transport latency by up to 98% compared to ROS 2 zero-copy DDS such as FastRTPS and Zenoh, lowers mean latency by about 95%, and sharply narrows p95/p99 outlier latency by around 96%. In tests on a production-ready L4 vehicle running Autoware.Universe, SIM increased localization frequency from 7.5 Hz to 9.5 Hz. When applied across all latency-critical modules, SIM cuts average perception-to-decision latency from 521.91 ms to 290.26 ms, resulting in a 13.6 ft (4.14 m) shorter emergency braking distance at 40 miles/hr (64 km/hr) on dry concrete.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Wang202623376,
	author = {Wang, Zhifeng and Zeng, Qunsong and Yuan, Renzhi and Wang, Rui and Wang, Chao and Garcia Armada, Ana},
	title = {Ultra-Low-Latency Robust Edge Inference: An Integrated Computation and Communication Design},
	year = {2026},
	journal = {IEEE Transactions on Wireless Communications},
	volume = {25},
	pages = {23376 - 23390},
	doi = {10.1109/TWC.2026.3732780},
	url = {https://www.scopus.com/pages/publications/105050238763?origin=resultslist},
	abstract = {The advent of sixth-generation (6G) mobile networks forecasts the widespread deployment of edge artificial intelligence (AI), where AI inference tasks are offloaded from resource-constrained edge devices to edge servers. This paradigm promises low latency and high-efficiency processing, yet faces critical challenges in meeting the stringent latency requirements of emerging applications such as autonomous driving and real-time robotics. Traditional ultra-reliable and low-latency communication (URLLC) paradigms fall short in the context of edge inference, where the high-dimensional nature of extracted features introduces a fundamental trade-off between reliability and latency. In this paper, we exploit the inherent robustness of AI models to channel distortions to design an ultra-low-latency edge inference framework that jointly optimizes computation and communication resources. We focus on both multi-snapshot (sequential sensing) and multi-view (distributed sensing) scenarios. For each, we derive upper bounds on inference accuracy as a function of the number of snapshots/views and their average bit error rate (BER). These bounds guide the formulation of optimization problems that minimize total system latency while satisfying accuracy constraints. The joint optimization is decomposed into subproblems involving snapshot/view selection, transmit power control, and allocation of computation and communication time. To solve this efficiently, we develop a low-complexity iterative algorithm. Experimental results on synthetic and real-world datasets validate our approach, demonstrating significant latency reductions while maintaining inference performance. Our findings provide a foundation for robust and efficient edge AI design in future 6G networks.  © 2002 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Capogrosso2026275,
	author = {Capogrosso, Luigi and Magno, Michele},
	title = {Accelerating Automotive Perception: An Outlook on Smart Sensing and Edge AI Trends},
	year = {2026},
	journal = {2026 IEEE International Workshop on Metrology for Automotive, MetroAutomotive 2026 - Proceedings},
	pages = {275 - 280},
	doi = {10.1109/MetroAutomotive69354.2026.11644634},
	url = {https://www.scopus.com/pages/publications/105048497851?origin=resultslist},
	abstract = {The transition to highly automated and autonomous driving systems is leading to an explosion in the volume of data generated by automotive sensors. Although modern vehicles are equipped with diverse cameras, radars, and LiDARs to perceive complex dynamic environments, processing this massive influx of data - exceeding 40 Gb/s of raw aggregate bandwidth - presents a significant computational challenge. The existing literature frequently surveys the hardware specifications of these sensors or the high-level algorithmic fusion strategies used for perception. This article offers a different perspective by explicitly focusing on Edge Artificial Intelligence (Edge AI) within the automotive sensing pipeline. We examine how advanced neural network architectures are adapted for deployment directly on sensor nodes or localized Electronic Control Units (ECUs) under stringent automotive constraints. These restrictions include ultra-low latency (under 100 ms end-to-end response time, with 10-30 ms for critical collision avoidance), limited power budgets (addressed by highly efficient accelerators over 100 TOPS/W), and rigorous ISO 26262 safety certifications. By reorganizing the perception taxonomy around compute location (in-sensor, zonal, and centralized) and resource-aware Machine Learning (ML) techniques like INT8/INT4 quantization and structured pruning, this article highlights the critical transition from traditional signal processing to deep learning at the edge. Furthermore, noting that current state-of-the-art techniques achieve only 40-60% of the target capabilities required for autonomous deployment, we outline open research directions in on-device continual learning, self-diagnostics, and sensor fusion, underscoring the need for hardware-software co-design in next-generation automotive perception.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@BOOK{Haroon2026270,
	author = {Haroon, Mohammad and Tripathi, Manish Madhava and Ahmad, Shish and Siddiqui, Zeeshan Ali and Ahmad, Tamim and Uprety, Deepak Chandra},
	title = {Edge computing and machine learning integration in 6G wireless network},
	year = {2026},
	journal = {Sustainable Technologies and Devices for Next-Generation Wireless Communication},
	pages = {270 - 294},
	doi = {10.1201/9781003671466-12},
	url = {https://www.scopus.com/pages/publications/105050446692?origin=resultslist},
	abstract = {The rise of sixth-generation (6G) wireless communication systems will bring about a change in connectivity by providing ultra-low latency, massive connectivity, and ultrafast data transfer rates. Achieving these goals will require synthesizing multiple technologies in a way that can push the frontiers of immaturity. The combination of edge computing and machine learning (ML) has now received considerable attention, representing the primary direction for current research and development. Edge computing processes data less at a distance and, therefore, reduces the need for provisioning for centralized cloud computing, latency in processing, and latency to the user. Additionally, edge devices can integrate with ML capabilities and have the potential to execute rapid real-time context-sensitive decisions that, when executed qualitatively, will influence overall network performance and user satisfaction. This chapter focuses upon the synergetic synthesis of the two technologies: ML and edge computing in the environment of 6G wireless communication systems. The emphasis has been on developing opportunities in edge deployment of ML models, providing applications like real-time traffic analysis, predictive module fault identification and risk mitigation, flexible spectrum allocation, and contextual user behavior modeling. In addition, it addresses important problems including the limited computational resources, data privacy requirements, and the difficulty of realizing distributed learning at the edge. The new methods introduced in the chapter include federated learning, reinforcement learning, and TinyML, and their relevance in 6G is studied. The distributed aspects of edge computing along with the learning capabilities associated with ML will be especially beneficial to the design of fully automated, resilient, and efficient 6G infrastructure. This combined approach will enable revolutionary opportunities in the development of new types of innovations including immersive holographic interaction, real-time haptic feedback systems (tactile internet), and fully autonomous services. Finally, the chapter provides a list of the challenges yet to be tackled and suggests potential future research directions to further develop this convergence of paradigmatic shifts. © 2026 selection and editorial matter, Indu Bala, Ghanshyam Singh and Suman Lata Tripathi; individual chapters, the contributors.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Meghwar2026,
	author = {Meghwar, Munesh and Heerani, SoorajGul and Malik, Ebadullah and Lal, Bharat},
	title = {Identification of Faulty Sensors and Predicting Missing Sensor Data in IoT-Enabled Smart Buildings},
	year = {2026},
	journal = {2026 1st International Conference on Innovations in Information and Communication Technologies, IICT 2026},
	pages = {},
	doi = {10.1109/IICT68374.2026.11468658},
	url = {https://www.scopus.com/pages/publications/105037540357?origin=resultslist},
	abstract = {Smart buildings rely on continuous sensor data to support energy efficiency, occupant safety, and automated control. However, faulty or missing signals not only undermine reliability in Internet of Things (IoT) environments but also weaken the operational resilience of wireless infrastructures by creating opportunities for service disruption and adversarial exploitation. This study proposes an integrated Artificial Neural Network (ANN) framework that combines Convolutional Neural Network-based fault detection with Long Short-Term Memory autoencoder-based reconstruction. Data were collected from DHT22 temperature and humidity sensors, pre-processed through cleaning, fault simulation, and sliding-window segmentation, and then used to train lightweight models suitable for real-time edge deployment. The evaluation results show that the fault detection module achieved 93.5% accuracy on test data, with strong precision-recall balance and an AUC of 0.95, ensuring reliable identification of sensor malfunctions while limiting false alarms. The reconstruction module produced accurate recovery of corrupted signals, with an overall RMSE of 0.1181 and R<sup>2</sup> = 0.9365, closely aligning reconstructed outputs with ground truth. By unifying detection and recovery in a single low-latency pipeline, this work advances the robustness, security, and continuity of wireless-enabled building management systems. The findings contribute to a practical, resource-efficient approach for enhancing the fault-tolerance and operational resilience of IoT infrastructures. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Soni2026,
	author = {Soni, Mahesh and Singh, Tanya and Wawage, Pawan and Tonde, Damini and Borkar, Pradnya and Nadaf, Jubber Salim},
	title = {Compact Edge-AI Architecture for Real-Time Decision Making in Smart Devices},
	year = {2026},
	journal = {2026 International Conference on Emerging Smart Computing and Informatics, ESCI 2026},
	pages = {},
	doi = {10.1109/ESCI68015.2026.11493408},
	url = {https://www.scopus.com/pages/publications/105040835064?origin=resultslist},
	abstract = {The present paper offers a small Edge-AI system on decision making in smart devices with strict latency, energy, and memory requirements. As Internet-of-Things endpoints, wearables, autonomous sensors, and embedded cyber-physical systems keep multiplying at a startling rate, cloud-centric intelligence is becoming ineffective because of the delays in communication, the threat of privacy, and unreliable connectivity. In order to deal with them, the suggested framework combines lightweight learning models, data pipelines optimization, and co-design ideals of hardware and software to make on-device inference fast, reliable, and available. The methodology represents the real-time decision tasks as constrained optimization problems, in which the inference latency, throughput and power consumption are optimally reduced, and the accuracy is acceptable. The efficient edge data acquisition/preprocessing pipeline is built in such a manner that it eliminates redundant transmissions and computation. The architecture of compact models is chosen, and a sequence of structured pruning, sparse weights, low-precision quantization, and knowledge distillation is used to achieve downsizing and minimize the execution cost of models with minimal performance loss. Also, a jointly developed execution stack that makes use of CPUs, GPUs, NPUs, and microcontrollers is introduced, which is backed by adaptive runtime process scheduling, and resource management techniques. Results of experimental work on small smart-workloads show significant decreases in inference time, energy usage, and memory footprint relative to baseline edge deployments, without compromising decision quality. There is a discussion of trade-offs between the model compactness and predictive performance, scalability across heterogeneous hardware platforms and practical deployment issues. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Caiza2026,
	author = {Caiza, Gustavo and Guanuche, Adriana and Villafuerte, Carlos},
	title = {Detection of Mobile Phone Use While Driving Supported by Artificial Intelligence},
	year = {2026},
	journal = {Applied Sciences (Switzerland)},
	volume = {16},
	number = {2},
	pages = {},
	doi = {10.3390/app16020675},
	url = {https://www.scopus.com/pages/publications/105028561509?origin=resultslist},
	abstract = {Driver distraction, particularly mobile phone use while driving, remains one of the leading causes of road traffic incidents worldwide. In response to this issue and leveraging recent technological advances and increased access to intelligent systems, this research presents the development of an application running on an intelligent embedded architecture for the automatic detection of mobile phone use by drivers, integrating computer vision, inertial sensing, and edge computing. The system, based on the YOLOv8n model deployed on a Jetson Xavier NX 16Gb—Nvidia, combines real-time inference with an inertial activation mechanism and cloud storage via Firebase Firestore, enabling event capture and traceability through a lightweight web-based HMI interface. The proposed solution achieved an overall accuracy of 81%, an inference rate of 12.8 FPS, and an average power consumption of 8.4 W, demonstrating a balanced trade-off between performance, energy efficiency, and thermal stability. Experimental tests under diverse driving scenarios validated the effectiveness of the system, with its best performance recorded during daytime driving—83.3% correct detections—attributed to stable illumination and enhanced edge discriminability. These results confirm the feasibility of embedded artificial intelligence systems as effective tools for preventing driver distraction and advancing intelligent road safety. © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Sekerci2026,
	author = {Sekerci, Ethem and Kucukmanisa, Ayhan},
	title = {Artificial Intelligence-Based Classification of Human Activities from mmWave Radar Point Clouds},
	year = {2026},
	journal = {Proceedings of the 18th International Conference on Electronics, Computers and Artificial Intelligence, ECAI 2026},
	pages = {},
	doi = {10.1109/ECAI69016.2026.11613841},
	url = {https://www.scopus.com/pages/publications/105046611307?origin=resultslist},
	abstract = {This paper presents a real time human activity classification system using three dimensional point clouds produced by millimeter wave radar and a PointNet based deep learning model. A Texas Instruments IWR6843ISK radar operating between 60 and 64 GHz was used to collect data from 10 subjects, including 5 female and 5 male participants, performing five distinct gestures: waist bending, arm flapping, arm swinging, forward bending, and lateral bending. Data were recorded through Robot Operating System 2, converted into sliding window segments of 500 points with a stride of 250 points, quality filtered, and normalized before being fed to a shared multilayer perceptron and global max pooling classifier. The final curated dataset contains 4,155 segments split into 3,324 training samples and 831 test samples. The model achieves 98 percent test accuracy and a macro F1 score of zero point ninety seven. In addition to a contextual comparison with literature baselines, an in house RadHAR reproduction on the same dataset reached 93 percent accuracy, confirming the advantage of direct raw point processing for this dataset. Real time inference runs at approximately 35 frames per second on Jetson Nano and approximately 25 frames per second on Raspberry Pi 4, demonstrating suitability for embedded and contactless monitoring in smart living, rehabilitation, and human machine interaction scenarios. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{John2026,
	author = {John, Merrisha and P, Arulmathi},
	title = {Decentralized energy control in IoT-enabled smart buildings with the edge-efficient learning network and ALOCO optimizer},
	year = {2026},
	journal = {Energy and Buildings},
	volume = {369},
	pages = {},
	doi = {10.1016/j.enbuild.2026.118003},
	url = {https://www.scopus.com/pages/publications/105045824377?origin=resultslist},
	abstract = {Modern smart-building systems often depend on cloud-based control, which increases latency, energy overhead, and reliance on stable connectivity. This study aims to design an adaptive edge-learning framework that reduces energy consumption in IoT-driven buildings without depending on remote servers. The research focuses on accurate energy prediction and control under constrained edge hardware and intermittent communication. To facilitate effective energy control, EELNet–ALOCO is developed by combining the Edge-Efficient Learning Network and Adaptive Localized Cooperative Optimization. EELNet uses Temporal-Context Convolution and Adaptive Attention Refinement to extract the short-term sensor trends and long-term environmental patterns from zone data. ALOCO updates the model directly at edge nodes by aligning gradient directions among neighboring devices through localized cooperation. Quantization, pruning, and distillation compress EELNet for real-time inference on Raspberry Pi 5 and Jetson Orin Nano devices. The system efficiently processes occupancy, temperature, CO₂, illumination, and power data to support adaptive HVAC and lighting control. Experimental evaluation using a 12-month multi-zone EnergyPlus–CityLearn dataset shows direct annual electricity reductions of 22.1%, 21.3%, 18.9%, and 16.4% compared with LSTM, GRU, CNN–LSTM, and RL–Controller, respectively. The normalized energy gain Γ reaches 24.2%. Ultimately, the complete control-loop latency decreases by 48.0%, from 2.77 ± 0.19 s to 1.44 ± 0.06 s. Thermal comfort remains within accepted limits for more than 96% of occupied operation. The results show that EELNet–ALOCO supports reliable, low-power, and privacy-aware energy control for IoT-enabled smart buildings. © 2026 Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Yang2026,
	author = {Yang, Kai and Jia, Qingxuan and Huang, Juxiang and Chen, Gang and Feng, Chao and Xu, Yunfeng},
	title = {Multi-source information fusion using CNN-LSTM-Attention for bone layer recognition in robotic orthopedic grinding},
	year = {2026},
	journal = {Medical and Biological Engineering and Computing},
	pages = {},
	doi = {10.1007/s11517-026-03649-2},
	url = {https://www.scopus.com/pages/publications/105046571801?origin=resultslist},
	abstract = {Epiphyseal opening requires precise localization for bony bridge resection. Traditional surgery is challenged by unclear bony bridge boundary localization and inaccurate grinding precision, while existing robot-assisted operations predominantly focus on pre-operative localization with limited intraoperative autonomous decision-making capabilities. To address this, we propose a multi-source information fusion framework using a CNN-LSTM-Attention network for real-time bone layer differentiation, specifically identifying idling, cancellous, and cortical bone states, during robotic orthopedic grinding. First, the mapping relationship between acceleration, force and acoustic signals and bone density is analyzed, serving as the basis of bone layer recognition. Second, a three-channel parallel late-feature-fusion CNN-LSTM-Attention network is established. The dataset was constructed from multiple independent grinding trials with trial-wise splitting to prevent data leakage under representative robotic grinding conditions. Over five independent runs, the proposed method achieves a test accuracy of 95.06% ± 0.53%, significantly outperforming comparison models including CNN, CNN-Attention, CNN-LSTM, and non-deep-learning baselines (Random Forest, Extra Trees, SVM, KNN). Ablation studies isolating CNN, LSTM, and Attention contributions are provided, and the learned Squeeze-and-Excitation attention weights are visualized to confirm dynamic cross-modal feature weighting. With approximately 0.32 million parameters, the model introduces an inference latency of 2.8 ms on a desktop CPU and 1.2 ms on an NVIDIA Jetson Orin, well below the 50 ms robot control cycle, confirming real-time feasibility. Additionally, we explore single-signal, dual-signal, and triple-signal fusion settings, demonstrating that tri-modal fusion achieves the best performance. © International Federation for Medical and Biological Engineering 2026.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Agarwal2026262,
	author = {Agarwal, Deepak and Dangwal, Ganesh},
	title = {A Cross-Modal Edge Intelligence Framework for Driver Drowsiness Assessment using Transformer-based Vision and In-Cabin Sensing},
	year = {2026},
	journal = {Proceedings of 6th International Conference on Expert Clouds and Applications, ICOECA 2026},
	pages = {262 - 267},
	doi = {10.1109/ICOECA68095.2026.11485506},
	url = {https://www.scopus.com/pages/publications/105038097187?origin=resultslist},
	abstract = {Driver fatigue event, which is a significant cause of road traffic safety accidents with fatal and serious victims, has already taken great number of invaluable lives over past few years; however, most existing detection methods have been confronted with challenges tensing toward singular-modal hint-based manner systems cannot accomplish practical task-worthy performance on real-time instrumented platforms as well as impracticable security assurances on the resource-constraint devices in the direction off-line running. More recently, cloud-based solutions generate obvious time lag and privacy problem, while the already developed method through CNN cannot effectively accommodate illumination variation, occlusion and even temporal driver behavior change. To tackle these problems, in this paper, we propose an Edge-Optimized Multimodal Vision-Transformer (EM-ViT) framework that integrates CNN-based spatial feature extraction with ViT-based temporal attention modeling as well as other in-cabin sensor cues such as eye-aspect ratio and infrared feedback. It is a smart vehicle real-time privacy preserving on-device computation framework. Experimental results on three publicly available datasets (i.e., NTHU-DDD, MRL Eye, UTA-RLDD) demonstrated the effectiveness of the proposed method under challenging condition of illumination variation, head pose changes and with occlusion and in drivers variability. The proposed EM-ViT always significantly outperforms both the baseline CNN and CNN-LSTM models with up to 99% accuracy, 0.99% F1-score as well as low inference latency (85ms/frame), suggesting a good potential for real-time realization. These results verify poli-fs and transformer-based temporal modeling are effective in enabling multi-modal fusion to be robust and decrease false predictions, suggesting that EM-ViT can be a potential candidate for future intelligent transportation & in-cabin safety use cases. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Lin2026,
	author = {Lin, Jianpu and Wang, Huiying and Lin, Zhixian and Lin, Shanling and Zhang, Yongai and Guo, Tailiang},
	title = {Low-Light Image Enhancement Method via 3D Lookup Table with Channel Correction and Denoising Fusion; [三 维 查 找 表 融 合 通 道 校 正 与 去 噪 的 低 照 度 图 像增 强 方 法]},
	year = {2026},
	journal = {Laser and Optoelectronics Progress},
	volume = {63},
	number = {12},
	pages = {},
	doi = {10.3788/LOP252572},
	url = {https://www.scopus.com/pages/publications/105042428392?origin=resultslist},
	abstract = {Objective Images captured in low-illumination environments often suffer from degradation such as insufficient brightness, unbalanced contrast, and heavy noise contamination, which significantly hinders the accuracy of downstream computer vision tasks such as pedestrian detection and autonomous driving. While low-light image enhancement (LLIE) has gained importance, balancing enhancement quality with computational efficiency, especially on edge devices, remains challenging. Traditional methods such as histogram equalization and Retinex frequently introduce over-exposure, artifacts, and blurred boundaries, while deep learning-based models rely heavily on large-scale datasets and generally have high parameter sizes, making them unsuitable for resource-constrained edge hardware. Although 3D lookup table (3D-LUT) techniques have emerged for their ability to cache complex nonlinear mappings and enable inference speeds, existing lightweight models like hundred-kilobyte lookup table (HKLUT) exhibit limitations, including the independent processing of RGB channels, leading to color distortion, and a lack of noise suppression mechanisms for dark regions in low-light images. To address these issues, this study proposes a lightweight 3D-LUT-based enhancement network, HKCLUTV2, which integrates channel correction and denoising mechanisms. Methods The HKCLUT-V2 framework adopted a two-stage approach consisting of offline training and online lookup. To overcome the issues of channel independence and noise sensitivity, we introduced a novel asymmetric noise-resistant architecture. This architecture split the input image into most significant bit (MSB) and least significant bit (LSB) feature streams based on the observation that noise is non-uniformly distributed. The MSB branch, responsible for recovering global semantic information and object contours, used a larger receptive field, while the LSB branch focused on texture details and noise suppression in a smaller receptive field to reduce storage overhead. A key innovation was the channel correction lookup table (C-LUT) module, which departed from traditional methods that process RGB channels independently. Instead, the C-LUT incorporated covariance matrix calculations within a local 5 × 5 window and dynamically predicted channel interaction weights and main channel retention weights using a lightweight convolutional neural network (CNN). This method corrected color shifts and enhanced saturation by leveraging the statistical correlation between spectral bands. To address sensor noise in low-intensity regions, an improved generative adversarial network (GAN) denoising module was included in the training pipeline. The generator used a lightweight U-Net with channel attention mechanisms to preserve edge details, while the discriminator employed PatchGAN to ensure local textural authenticity. The optimization was guided by a composite loss function combining mean squared error (MSE) loss for fidelity, Wasserstein adversarial loss for texture recovery, and perceptual loss for visual quality. Additionally, a weighted rotation ensemble strategy was employed to expand the receptive field without increasing pixel count or inference latency. This method rotated convolution kernels by 0°, 90°, 180°, and 270°, and fused features based on spatial importance, assigning higher weights to central pixels and lower weights to peripheral features to enhance context awareness and detail recovery. Results and Discussions Extensive experiments on the LOL, SID, SCIE datasets, and an extreme low-light synthetic dataset validated the effectiveness of the proposed method. Quantitative results showed that HKCLUT-V2 outperformed the baseline HKLUT and other state-of-the-art lightweight methods. On the LOL dataset, the model improved peak signal-to-noise ratio (PSNR) and structural similarity index measure (SSIM) by 4.9% and 11.1%, respectively, compared to HKLUT. Notably, the introduction of the C-LUT module reduced the CIELAB color difference to 6.85, outperforming methods like serial-parallel lookup table (SPLUT) (7.98) and adaptive interval 3D lookup table (AdaInt) (7.85), demonstrating that channel correlation significantly reduced color casting. In terms of noise suppression, the noise reduction rate (NRR) improved by 11.2 percentage points, showcasing the effectiveness of the GAN-based denoising module and asymmetric LSB processing. Visual ablation studies further confirmed that while baseline methods produced images with color deviation and residual noise, HKCLUT-V2 yielded images with natural white balance, sharp edges, and clean backgrounds.For computational efficiency, the model maintained a small storage footprint of under 285 KB. Inference tests on various embedded platforms (e.g., NVIDIA Jetson Nano, TX2, Xavier NX) demonstrated its practical viability. Specifically, on the Jetson Nano, the model achieved an inference speed of approximately 49.5 ms/frame (over 20 frame/s) for 480×640 resolution, meeting the real-time requirements for night vision monitoring. Power consumption was comparable to the baseline, ensuring that performance improvements did not result in excessive energy usage. Conclusions We present HKCLUT-V2, a robust, real-time low-light image enhancement solution tailored for embedded systems. By incorporating a covariance-based C-LUT and an asymmetric GAN-based denoising architecture, this method effectively addresses the limitations of traditional 3D-LUTs in terms of color distortion and noise amplification. The experimental results demonstrate that the algorithm achieves an excellent balance between restoration quality and hardware efficiency, offering high-fidelity enhancement with negligible storage costs (≤285 KB) and real-time inference (≤50 ms/frame). HKCLUT-V2 is highly suitable for edge-based computer vision applications, such as nighttime surveillance and autonomous navigation, providing high-quality visual input for downstream analysis. © 2026 Chinese Laser Press. All rights reserved.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Ng20261,
	author = {Ng, Nathan and Hanafy, Walid A. and Kadambi, Prashanthi and Sunil, Balachandra and Gupta, Ayush and Irwin, David and Simmhan, Yogesh and Shenoy, Prashant},
	title = {Collaborative Processing for Multi-Tenant Inference on Memory-Constrained Edge TPUs},
	year = {2026},
	journal = {Proceedings - 2026 22nd International Conference on Distributed Computing in Smart Systems and the Internet of Things, DCOSS-IoT 2026},
	pages = {1 - 8},
	doi = {10.1109/DCOSS-IoT69657.2026.00008},
	url = {https://www.scopus.com/pages/publications/105049708543?origin=resultslist},
	abstract = {IoT applications increasingly rely on on-device AI accelerators to ensure high performance, especially in low-connectivity and safety-critical scenarios. However, the limited on-chip memory of these accelerators forces inference runtimes to swap model segments between host and accelerator memory, incurring significant swapping overheads. While collaborative processing by partitioning model execution across CPU and accelerator resources can reduce accelerator memory pressure and execution overhead, naive partitioning may worsen end-to-end latency by either shifting excessive computation to the CPU or failing to sufficiently reduce swapping, a problem that is further exacerbated in multi-tenant and dynamic environments.To address these issues, we present SwapLess, a system for adaptive, multi-tenant TPU-CPU collaborative inference on memory-constrained Edge TPUs. SwapLess utilizes an analytic queueing model that captures partition-dependent CPU/TPU service times as well as inter- and intra-model swapping overheads across different workload mixes and request rates. Using this model, SwapLess continuously adjusts both the partition point and CPU core allocation online to minimize end-to-end response time with low decision overhead. An implementation on Edge TPU-equipped platforms demonstrates that SwapLess reduces mean latency by up to 63.8% for single-tenant workloads and up to 77.4% for multi-tenant workloads relative to the default Edge TPU compiler. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

@CONFERENCE{Paus20261290,
	author = {Paus, Adrian and Große-Kampmann, Matteo and Bök, Patrick-Benjamin},
	title = {Performance Evaluation of AI-based Live Siren Detection on Smartphones in Vehicular Scenarios},
	year = {2026},
	journal = {2026 International Wireless Communications and Mobile Computing Conference, IWCMC 2026},
	pages = {1290 - 1296},
	doi = {10.1109/IWCMC69287.2026.11580044},
	url = {https://www.scopus.com/pages/publications/105044705655?origin=resultslist},
	abstract = {This paper addresses the development and evaluation of an AI-driven system that detects siren sounds in real time in road traffic scenarios using mobile devices. Seventy-two models were systematically trained and tested across a wide range of signal-to-noise ratios (SNRs). Two audio feature extraction methods were employed and combined with multiple classifier backends. A laboratory evaluation demonstrates that the top-performing models achieve an accuracy of over 98% at an SNR of at least -5 dB, around 92% at -15 dB, and approximately 78% under the most challenging conditions at -20 dB. In real-world field tests, selected models achieved an accuracy of up to 92%, highlighting practical robustness. VGGish-based models outperformed AudioFeaturePrint models in challenging acoustic scenarios in our experimental setting, and models trained under lower SNR conditions exhibited enhanced resilience to noise. A comparative evaluation of context-specific versus universal models revealed no significant advantage from specialized environmental training. When integrated into an iOS application, the system demonstrated real-time operability with inference latencies below one second, including feature extraction and classification, indicating potential to enhance pedestrian and driver awareness and safety in traffic. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Eslami202662,
	author = {Eslami, Arshia and Ardakani, Mahsa and Roostaee, Amin and Zanganeh, Hasti and Zand, Ramtin},
	title = {Energy and Carbon Footprint of Vision-Language-Action Model Inference for Edge Robotic Systems},
	year = {2026},
	journal = {Proceedings of the 16th ACM International Green and Sustainable Computing Conference, IGSC 2026},
	pages = {62 - 67},
	doi = {10.1145/3797248.3815411},
	url = {https://www.scopus.com/pages/publications/105045211739?origin=resultslist},
	abstract = {Vision-Language-Action (VLA) models are increasingly viewed as a promising foundation for embodied intelligence, yet energy consumption and latency remain among the main bottlenecks to their deployment on robotic platforms. In this work, we analyze the practical efficiency of representative VLA models under edge deployment conditions on an NVIDIA Jetson AGX Orin. We evaluate π<sub>0.5</sub>, X-VLA, and SmolVLA using a standardized robotics pipeline and report task performance, inference latency, power consumption, energy per inference, and estimated carbon emissions. Our results show a clear trade-off between accuracy and energy consumption: X-VLA achieves the highest task performance but also the highest latency and energy usage, while SmolVLA is the most efficient model but yields lower task success. All three models satisfy basic 10 Hz control requirements, but only π<sub>0.5</sub> and SmolVLA meet 20 Hz constraints. We also observe bursty power behavior during inference, highlighting the dynamic load imposed by transformer-based robotic policies. Finally, we estimate annual operational carbon emissions under continuous deployment and find that even modest differences in inference energy translate into measurable environmental impact at scale. These findings underscore that energy-aware design is essential for deploying VLA systems in real-world, battery-constrained robotic applications. © 2026 Copyright held by the owner/author(s).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Le2026,
	author = {Le, Thanh Son and Le, Huu Sy and Le, Tan Duy and Viet Tuyen, Nguyen Tan},
	title = {Graph convolutional reinforcement learning for multi-agent coordination in smart home environments: an intelligent framework for elderly care assistance},
	year = {2026},
	journal = {Advanced Robotics},
	pages = {},
	doi = {10.1080/01691864.2026.2707053},
	url = {https://www.scopus.com/pages/publications/105046390931?origin=resultslist},
	abstract = {The rapid aging of global populations presents unprecedented challenges for elderly care systems, particularly for individuals living independently who require assistance with daily activities. This paper presents a novel Graph Convolutional Reinforcement Learning (GCRL) framework for multi-agent coordination in smart home environments. Our approach addresses five fundamental gaps in existing systems: unified relational representations for heterogeneous agents and objects, efficient learned coordination without centralized bottlenecks, embodied execution of physical assistance tasks, explicit agent-object heterogeneity modeling, and computational efficiency. The framework models the environments as dynamic heterogeneous graphs where agents and interactive objects are represented as nodes with spatial proximity defining edges, enabling relational reasoning through graph convolutional networks with attention mechanisms for implicit coordination. We employ Proximal Policy Optimization combined with experience replay to achieve stable multi-agent training, allowing agents to learn cooperative behaviors through environmental interaction without predefined communication protocols. Experiments in the AI2-THOR simulator across four elderly care scenarios demonstrate that, within this simulation-based evaluation, GCRL achieves an (Formula presented.) overall success rate (mean ± standard deviation across three seeds) with 28.35 average steps to completion, substantially outperforming baseline methods including SMART-LLM ((Formula presented.)), SYNERGY ((Formula presented.)), and LaMMA-P ((Formula presented.)), while maintaining real-time inference capabilities and memory requirements suitable for privacy-preserving edge deployment in residential environments. Real-world validation on a physical assistive platform is identified as the immediate next research step. © 2026 Informa UK Limited, trading as Taylor & Francis Group and The Robotics Society of Japan.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Park2026,
	author = {Park, Yong-Deok and Shin, Dae-Seob and Kim, Hun-Kee},
	title = {CM-FuseNet: An Attention-Augmented Hybrid EEG–EMG Cognitive–Motor Fusion Network with Soft Actor-Critic Reinforcement Learning for Adaptive Lower-Limb Exoskeleton Control},
	year = {2026},
	journal = {Applied Sciences (Switzerland)},
	volume = {16},
	number = {16},
	pages = {},
	doi = {10.3390/app16168042},
	url = {https://www.scopus.com/pages/publications/105048473550?origin=resultslist},
	abstract = {Population aging and the rising prevalence of motor disorders are driving demand for assistive lower-limb robotic systems capable of decoding user intention rather than merely providing mechanical support. We present CM-FuseNet, an attention-augmented hybrid Brain–Computer–Muscle Interface (BCMI) that simultaneously fuses cortical concentration indices extracted from electroencephalography (EEG) and lower-limb intention patterns derived from electromyography (EMG) to adaptively control a 4-DOF assistive lower-limb exoskeleton. To eliminate the burden of human-subject ethics review and to ensure reproducibility of the proposed methodology, all validation is performed exclusively on (i) permissively licensed open-access biomedical datasets, (ii) high-fidelity OpenSim 4.5 and MuJoCo 3.1 musculoskeletal–exoskeleton co-simulation, and (iii) limited self-experimentation by the corresponding author with non-invasive consumer-grade devices. Three components are introduced: (i) a log-tanh normalized concentration index CI in (0, 1) derived from the (Formula presented.) ratio; (ii) a bidirectional Cross-Modal Transformer (CMT) with eight-head self- and cross-attention; and (iii) a Soft Actor-Critic (SAC) reinforcement-learning controller that adaptively tunes four servo PID gains using a concentration-weighted state. Experiments on the PhysioNet EEGMMIDB, Ninapro DB2/DB7, HuMoD and WAY-EEG-GAL datasets (combining N = 162 trial sessions, 47,520 windows, and five-fold cross-validation) yield a gait-phase classification accuracy of 96.84 ± 1.18%, torque-tracking RMSE of 0.072 ± 0.008 N·m, information transfer rate of 38.6 bits/min, end-to-end latency of 9.4 ms, and a 27.4% reduction in simulated metabolic cost over an EMG-only PID baseline (one-way ANOVA: F(4, 75) = 47.83, p < 0.001; Tukey HSD: p < 0.01 against all baselines). Under high cognitive load, CM-FuseNet preserves accuracy with only a 4.63 percentage-point degradation versus 13.22 percentage points for the EMG-only baseline. © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@BOOK{Aliu2026503,
	author = {Aliu, Opeyemi Habeeb and Imoize, Agbotiname Lucky},
	title = {Edge AI for IoT Systems: Architectures and Applications},
	year = {2026},
	journal = {Handbook of AI in Wireless Networks: Foundations, Techniques, and Emerging Applications},
	pages = {503 - 536},
	doi = {10.1201/9781003667766-15},
	url = {https://www.scopus.com/pages/publications/105043770269?origin=resultslist},
	abstract = {The rapid growth of the Internet of Things (IoT) across healthcare, manufacturing, smart cities, and autonomous systems has created an unprecedented surge of real-time data at the network edge. Traditional cloud-centric infrastructures struggle with latency, bandwidth, scalability, and privacy, limiting their ability to support time-critical and data-intensive tasks. Edge computing addresses these issues by moving computation closer to data sources; however, deploying Artificial Intelligence (AI) in such constrained environments introduces new challenges, including limited resources, heterogeneous devices, and increased security risks. This chapter explores Edge AI for IoT systems, examining architectures, optimisation strategies, and applications. It reviews design principles and data characteristics of intelligent IoT networks, surveys AI methodologies tailored for edge deployments, and discusses privacy-preserving approaches such as federated learning and differential privacy. The chapter also evaluates energy-efficient AI techniques, including model pruning, quantisation, and TinyML, and highlights recent advances in hardware accelerators and edge frameworks. Practical case studies in healthcare, industrial automation, autonomous vehicles, and smart cities demonstrate how Edge AI enhances responsiveness, privacy, and scalability. By integrating optimised AI models, collaborative edge-cloud intelligence, and robust security measures, the chapter underscores how Edge AI enables secure, sustainable, and context-aware IoT ecosystems. These advancements promise faster response times, improved Quality of Service (QoS), and greater resilience, offering a pathway towards the next generation of intelligent IoT infrastructures. © 2027 selection and editorial matter, Agbotiname Lucky Imoize, Abdulwaheed Musa, and Yuichi Sei; individual chapters, the contributors.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Emiliani202788,
	author = {Emiliani, Federico and Costa, Daniele and Carbonari, Luca and Palmieri, Giacomo and Callegari, Massimo},
	title = {Control of Collaborative Robots via Voice Interface and On-Device Deep Learning},
	year = {2027},
	journal = {Mechanisms and Machine Science},
	volume = {220},
	pages = {88 - 95},
	doi = {10.1007/978-3-032-35974-2_10},
	url = {https://www.scopus.com/pages/publications/105053815739?origin=resultslist},
	abstract = {In Industry 4.0, collaborative robots enable safe human-robot interaction by sharing workspaces for tasks such as assembly and pick-and-place. However, proprietary interfaces restricts access, particularly for non-experts. This paper presents a modular Python framework for on-device voice control of the FANUC CRX cobots, using OpenAI’s Automatic Speech Recognition and the Remote Motion Interface protocol to support natural Italian command. The system handles real-time audio via aggressive voice activity detection, noise-optimized Whisper transcription, regex-based intent parsing, and TCP/IP RMI commands with error handling and gripper synchronization. Developed with i-Labs Industry s.c.a.r.l., it was tested in noisy pick-and-place tasks, delivering low-latency, privacy-preserving performance compliant with ISO/10218. Using consumer hardware for offline human-robot interaction, this approach simplifies cobot programming for agile production without new algorithms. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2027.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Wang2026,
	author = {Wang, Hongchao and Liu, Bowen and Wang, Shuangwang and Jiang, Jianwen and Du, Wenliao and Li, Yu and Li, Simin and Guo, ZhiQiang},
	title = {Gearbox fault diagnosis method based on dynamic temporal convolution under strong noise and limited sample operating conditions},
	year = {2026},
	journal = {Engineering Research Express},
	volume = {8},
	number = {16},
	pages = {},
	doi = {10.1088/2631-8695/ae98f7},
	url = {https://www.scopus.com/pages/publications/105048849042?origin=resultslist},
	abstract = {Intelligent gearbox fault diagnosis is crucial for ensuring the safety and reliability of rotating machinery in industrial systems, yet limited labelled samples, strong noise, and edge deployment constraints remain challenging. To address these issues, this study proposes dynamic depthwise separable temporal convolution, hierarchical residual-connected, long short-term memory, hierarchical adaptive attention (DDSC-T-HRC-LSTM-HAA), a lightweight single-branch framework integrating DDSC-T, HRC LSTM, and HAA. DDSC-T adaptively reweights temporal kernels, HRC-LSTM captures long-range dependencies, and HAA emphasizes informative channels and positions. The effectiveness of the proposed method is validated on two gearbox datasets involving bearing defects and gear tooth-root cracks. The results show that, under the limited-sample setting with only 100 training samples per class on T1, the proposed model achieves mean accuracies of 99.7 ± 0.2% on T1 and 98.3 ± 0.3% on T2. It retains 71.6% accuracy at −5 dB and remains the best-performing method at −10 dB. Edge evaluation on an NVIDIA Jetson Xavier NX demonstrates 0.31 M parameters, 9.8 ± 0.4 ms inference latency, 11.2 ± 0.4 ms end-to-end latency, and 7.2 W average power, indicating practical deployability for online gearbox monitoring. © 2026 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved. This article is available under the terms of the IOP-Standard License.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Hafez2026,
	author = {Hafez, A. H. Abdul and Alqaraleh, Saed and El Jouma, Ahmad},
	title = {Real-Time Visual Place Recognition via Cluster-Aware Hierarchical CNNs},
	year = {2026},
	journal = {2026 IEEE 5th International Conference on Computing and Machine Intelligence, ICMI 2026},
	pages = {},
	doi = {10.1109/ICMI68585.2026.11539770},
	url = {https://www.scopus.com/pages/publications/105042282347?origin=resultslist},
	abstract = {We propose a hierarchical image retrieval framework designed to enhance both accuracy and computational efficiency in large-scale visual place recognition (VPR) tasks. The architecture decomposes retrieval into two stages: a primary convolutional neural network (CNN) that predicts the image cluster, followed by a specialized sub-model for fine-grained identification within that cluster. This design reduces search complexity while preserving high recognition performance. Built on a ResNet-18 backbone trained via transfer learning on the Places365 dataset, the system achieves a response time of approximately 220 milliseconds on standard CPU hardware, outperforming several state-of-the-art methods in both speed and accuracy. Extensive experiments across multiple benchmark datasets demonstrate the robustness of the approach to variations in lighting, viewpoint, and scene structure, making it highly suitable for real-time applications in robotics and autonomous navigation. The proposed method is lightweight, scalable, and adaptable for edge deployment, enabling practical real-time VPR in constrained environments such as drones, embedded systems, or mobile robots. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Vijay202646,
	author = {Vijay, M. and Sandeep, Kotari and Aditya, Venna Pavan and Krishna, Guntamadugu Vamsi and Anitha, P. and Prasanna, Sanampudi},
	title = {Intelligent Lunar Rover Navigation using Crater Detection and Adaptive Path Planning},
	year = {2026},
	journal = {Proceedings of the 4th International Conference on Inventive Computing and Informatics, ICICI 2026},
	pages = {46 - 51},
	doi = {10.1109/ICICI68773.2026.11581062},
	url = {https://www.scopus.com/pages/publications/105044500229?origin=resultslist},
	abstract = {Lunar terrain is a major problem since it is full of craters, steep slopes, and rocks, and therefore, autonomous navigation is a challenge. The presence of such irregular natural features makes safe and efficient passage of lunar rovers significant and complicated. As the solution to this, we suggest an autonomous navigation system that is operated with the help of AI and includes real-time crater tracking, dynamic terrain modeling, and adaptive path planning. The lunar landscape can be captured by a panoramic camera that is attached to the rover, and YOLOv9 allows real-time crater detection and segmentation. The major crater features are derived including radius, depth and proximity, which are used to create a dynamic spatial map of the area. This map can be presented in the form of a graph and is modeled with Graph Neural Networks (GNNs), which allows the rover to think about the terrain connection and the risk of navigation. To make the decision, we use and compare various algorithms of reinforcement learning which are DQL, DDQN, PPO, and A3C in order to plan the most efficient paths considering both energy consumption and safety management. CNN and LSTM models are connected to terrain complexity-related RL agents in order to improve spatial and temporal awareness. This system is made to run on embedded software (e.g., NVIDIA Jetson Xavier) and real-time scenarios of simulated lunar conditions. The vision of the approach is to deploy intelligent and risk-sensitive spacecraft to the Moon by means of an integrated and scalable AI system. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@BOOK{Jeysi202681,
	author = {Jeysi, B. and Shanthini, B. and Hariharan, B. and Jayabalan, Manoj and Blessing, N.R. Wilfred},
	title = {Edge and Cloud Computing in Wearable AI Systems},
	year = {2026},
	journal = {Wearable AI - The Future of Continuous Health Monitoring in the Metaverse},
	pages = {81 - 97},
	doi = {10.1201/9781003776291-5},
	url = {https://www.scopus.com/pages/publications/105052510344?origin=resultslist},
	abstract = {The swift evolution of wearable artificial intelligence (AI) systems has significantly impacted on continuous health monitoring, personalized healthcare, and human-machine interaction. At the heart of this revolution is the complementary convergence of edge and cloud computing models, which together facilitate scalable, real-time, and intelligent processing of the massive amounts of physiological and contextual data generated by wearable devices. This chapter presents a thorough review of edge-cloud architectures for wearable AI systems, focusing on their significance in real-time health analytics, adaptive intelligence, and immersive healthcare applications in both physical and virtual spaces. Wearable devices like smartwatches, biosensor-embedded clothing, neural interfaces, and implantable sensors continuously collect multimodal data such as vital signs, activity patterns, biochemical signals, and environmental context. Cloud-based processing of this data alone is associated with latency, privacy concerns, and bandwidth issues, which are not amenable to time-critical and safety-critical applications in healthcare. Edge computing addresses these challenges by facilitating on-device or near-device intelligence, which allows real-time inference, anomaly detection, and adaptive feedback with negligible latency. In contrast, cloud computing enables massive storage, long-term analytics, model training, population-level insights, and platform portability across healthcare systems. This chapter reviews hybrid edge-cloud architectures, AI model splitting, federated learning, resource-constrained inference, security, privacy preservation, and regulatory support. New applications in digital twins, immersive telemedicine, and metaverse-based healthcare are also covered. The chapter concludes with a discussion of potential research avenues for scalable, secure, and intelligent wearable AI systems. © 2027 Balasubramaniam S and Seifedine Kadry.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Wang20261908,
	author = {Wang, Zhanwei and Kalor, Anders E. and Zhou, You and Popovski, Petar and Huang, Kaibin},
	title = {Ultra-Low-Latency Edge Inference for Distributed Sensing},
	year = {2026},
	journal = {IEEE Transactions on Wireless Communications},
	volume = {25},
	pages = {1908 - 1922},
	doi = {10.1109/TWC.2025.3593802},
	url = {https://www.scopus.com/pages/publications/105012715141?origin=resultslist},
	abstract = {There is a broad consensus that artificial intelligence (AI) will be a defining component of the sixth-generation (6G) networks. As a specific instance, AI-empowered sensing will gather and process environmental perception data at the network edge, giving rise to integrated sensing and edge AI (ISEA). Many applications, such as autonomous driving and industrial manufacturing, are latency-sensitive and require end-to-end (E2E) performance guarantees under stringent deadlines. However, the 5G-style ultra-reliable and low-latency communication (URLLC) techniques designed with communication reliability and agnostic to the data may fall short in achieving the optimal E2E performance of perceptive wireless systems. In this work, we introduce an ultra-low-latency (ultra-LoLa) inference framework for perceptive networks that facilitates the analysis of the E2E sensing accuracy in distributed sensing by jointly considering communication reliability and inference accuracy. By characterizing the tradeoff between packet length and the number of sensing observations, we derive an efficient optimization procedure that closely approximates the optimal tradeoff. We validate the accuracy of the proposed method through experimental results, and show that the proposed ultra-Lola inference framework outperforms conventional reliability-oriented protocols with respect to sensing performance under a latency constraint. © 2002-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 19; All Open Access; Green Open Access}
}

@ARTICLE{Qi2026,
	author = {Qi, Ruimin and Zhang, Guodong and Yang, Xuchao},
	title = {AppleDet: lightweight and robust apple detection in natural orchard environments via reparameterized and state space visual modeling},
	year = {2026},
	journal = {Visual Computer},
	volume = {42},
	number = {9},
	pages = {},
	doi = {10.1007/s00371-026-04567-y},
	url = {https://www.scopus.com/pages/publications/105043541789?origin=resultslist},
	abstract = {Robotic fruit harvesting requires accurate and real-time visual perception under severe occlusion, illumination variation, dense fruit clustering, and resource-constrained edge deployment. Existing lightweight detectors often suffer from unstable low-level feature extraction, limited long-range contextual reasoning, and localization jitter under blurred or partially occluded boundaries. To address these challenges, we propose AppleDet, a lightweight and robust apple detection framework built upon YOLOv11n. AppleDet integrates a reparameterized RepStem module for stable early visual encoding, a C3k2-MambaOut module for long-range contextual feature modeling, and an efficient detection head with distributional bounding-box regression for uncertainty-aware localization. On a natural orchard dataset collected from Fuji apple orchards in Aksu, Xinjiang, AppleDet achieved an mAP@0.5 of 95.81%, improving YOLOv11n by 8.2 percentage points while reducing parameters from 5.22M to 4.06M and GFLOPs from 6.48 to 4.78. Deployment experiments on the RK3588 edge platform further demonstrated the feasibility of real-time orchard perception under close-range, long-shot, backlight, and complex-background conditions. The source code, trained weights, annotation protocol, and benchmark split will be released at https://github.com/xfl-521/AppleDet. © The Author(s), under exclusive licence to Springer-Verlag GmbH Germany, part of Springer Nature 2026.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Song2026,
	author = {Song, Yuhao and Ji, Peng and Wang, Tao},
	title = {SCA-YOLO: an improved YOLO algorithm for road object detection in autonomous driving},
	year = {2026},
	journal = {Engineering Research Express},
	volume = {8},
	number = {11},
	pages = {},
	doi = {10.1088/2631-8695/ae76eb},
	url = {https://www.scopus.com/pages/publications/105041640509?origin=resultslist},
	abstract = {Road object detection in autonomous driving faces three coupled challenges: severe feature degradation of distant tiny objects under multi-scale variations, persistent background interference in complex traffic scenes, and the stringent real-time and resource constraints of in-vehicle perception systems. To address these issues, this paper proposes SCA-YOLO, a lightweight real-time detector built upon the YOLOv11 baseline. Guided by the depth-dependent properties of feature maps—the trade-off between spatial resolution and channel dimensionality, and the corresponding shift from geometric priors in shallow layers to abstract semantics in deep layers—we systematically redesign the Backbone and Neck through three coordinated modules. The Spatial-Decoupled Aggregation Block separates spatial feature extraction from channel fusion via depth-wise convolutions to preserve high-frequency geometric priors in the shallow backbone. The Semantic Channel Recalibration Attention-Cross Stage Partial module replaces the original C2PSA at the deepest stage, employing multi-subspace channel recalibration to address deep-stage channel entanglement while avoiding the cost of spatial self-attention. The Scale-Aware Neck breaks the isomorphic fusion paradigm through an asymmetric allocation strategy, in which the Channel Recalibration Aggregation Block maintains fusion purity at the P3 and P4 stages while the lightweight VoVGSCSPC module curtails the cost of the P5 stage. Experiments on the KITTI, custom private, and BDD100K datasets show that SCA-YOLO achieves statistically significant mAP@0.5 improvements of 3.0%, 3.6%, and 4.4% over the YOLOv11s baseline, while reducing the parameter count from 9.41 M to 6.62 M and the computational cost from 21.3 to 14.1 Giga floating-point operations. On-device benchmarking on the NVIDIA Jetson AGX Orin platform integrated into our experimental vehicle further confirms a 27.1% inference speed-up over the baseline at 181.3 FPS, comfortably exceeding the on-board camera frame rate and validating the practical edge-deployment efficiency of the proposed model. © 2026 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved. This article is available under the terms of the https://publishingsupport.iopscience.iop.org/iop-standard/v1.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@BOOK{Nivethitha2026339,
	author = {Nivethitha, V. and Achuth, G. and Dinesh, R. and Lakshmanan, L.},
	title = {Smart Umbrella},
	year = {2026},
	journal = {Embodied Artificial Intelligence},
	pages = {339 - 366},
	doi = {10.1002/9781394404384.ch13},
	url = {https://www.scopus.com/pages/publications/105051024180?origin=resultslist},
	abstract = {People are seldom caught unaware of sudden rain because they hardly ever carry an umbrella. Ancient weather predictions can be vague, not real-time, or specific to the user's immediate environment. Besides, these services likewise rely on internet connectivity and cloud processing, perhaps unavailable always, particularly in less-networked regions. The proposed smart umbrella system builds solutions for the above problems using self-contained weather forecasting, not relying on any external forecasting services. This blends machine learning, fog and edge computing, and embedded AI to carry out weather forecasting-device-wise with instant alerts. It continuously monitors temperature and humidity with a DHT11 sensor that does local processing with a random forest classifier. The current system predicts the possibility of rain at a probability of 85%, depending on live environmental conditions to aid decision-making by the user so planning can begin. At all points, this feature is deeply contrasted against the normal weather forecasting applications that are web-based and rely heavily on other sources of information since this is a feedback mechanism that occurs in real-time when internally processing. This umbrella assures the seamless operational integration of various interlinked components. This machine learning model equipped with the ESP32 embedded microcontroller performs on-device inference and provides the weather predictions and notifications almost in real-time. An additional module with an ESP8266 device always monitors the environmental information and transmits readings of the various sensors to the umbrella unit via Bluetooth, thus allowing its operation uninterrupted, either indoors or outdoors. Such types of wireless data transmission make reliable predictions with low power requirements. The umbrella then incorporates dual notification systems into announcing its predictions of rain: with every rain prediction is an alert generated by a now blurring buzzer and an LED indicator that lights up. In the first role, the one-half of responsibility for maintaining the umbrella project is concerned with capturing and articulating the information coming from the environment, while the other half is dealing with the construction of suitable cloud and fog solutions so as to allow lowered latency predictions to occur even in non-functional states of the umbrella, complemented by the former task in its function with needed training based on machine learning methods at work. The project therefore offers for the umbrella to adapt to conditions in real time, wherein all sensory information is continuously processed, while acting on behalf of itself. Unlike AI developed in other forms, which in proof is either in the cloud or has a central approach, this basically accounts for the entire AI implementation inasmuch toward prediction in an autonomous device manner within itself. Embodied AI directly relates to sensing, signal processing, and acting accordingly with environmental conditions in real time, while taking on the continuous feedback from the automatically directed system to change its position in a context-aware manner. In other words, the umbrella stands up to its entire disciplinary decision-making phase, just like the branch of ability towards Quality Assurance testing; therefore, it is seen as an intelligent active agent that is capable of effectively mixing a certain amount of knowledge and expertise with environment adaptation. Through such a measure, an ordinary umbrella becomes an active, decision-making device that understands the environment and reacts to it as does a normal person. Because of such intelligence-enhancement features, the umbrella helps prepare the user for uninterrupted scenarios reflected under conditions of alternative situation levels in physical surrounding conditions. It sends some data at a low latency and consumes less power via on-device learning rather than remote processing. Real-time predictions occur, while the constant updating of machine learning algorithms using real environment data occurs through its DHT11 sensor. Again, the algorithm of the ESP32 microcontroller AI random forest classifier demonstrates good capabilities, and decisions about the probabilities of precipitation, made in seconds, mainly depend on computations into the microcontroller's knowledge. Another technology is branded Fog or Edge computing; all calculations happen at the level of the environmental data definitions without incurring any latency effects since, at the instant of calculation, it sees its crippling miles away, because there cannot possibly be Internet to rely on for scientific sustenance. The key differentiating feature of great significance is autonomous offline execution, while most weather forecasting systems rely primarily on propulsion by limited online meteorological databases. This umbrella system works independently 24 hours a day in the most convenient situations, such as instantaneous predictions. This is of utmost utility for a rural dweller, an outdoor worker, or a traveler in sparsely populated regions that receive alerts on weather conditions without having the Internet available all the time. Furthermore, the efficient power specification will ensure extended battery life; thus, the smart umbrella could function for daily purposes. © 2026 Scrivener Publishing LLC.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{M. Elsheikh2027330,
	author = {M. Elsheikh, Yousif and Raiser, Adrian and Frommherz, Fabian and Daw, Zamira},
	title = {On the Timing Determinism of CUDA and Vulkan SC for Safety-Critical AI Workloads on Integrated SoC GPUs},
	year = {2027},
	journal = {Lecture Notes in Computer Science},
	volume = {16868 LNCS},
	pages = {330 - 345},
	doi = {10.1007/978-3-032-34867-8_21},
	url = {https://www.scopus.com/pages/publications/105048336823?origin=resultslist},
	abstract = {AI-enabled functions are increasingly considered for aerospace and other safety-critical systems, where predictable execution is as important as acceleration. Standard GPU programming models such as CUDA do not inherently provide the timing guarantees required for certification, since runtime jitter and limited worst-case predictability remain problematic. Vulkan SC has been proposed as a more deterministic alternative for safety-critical GPU execution. This work compares CUDA and Vulkan SC on the NVIDIA Jetson Orin Nano SoC platform with a focus on timing determinism. We apply fixed clocking, warm-up runs, and process-level optimizations. We then analyze timing contributions from memory management, data movement, and kernel execution. The evaluation covers neural-network-related synthetic primitives, composite SAXPY-ReLU chains, and a fused neural-network workload. To relate the synthetic primitives to the NN workload, we compare an operation-count-equivalent unfused primitive baseline with the measured fused implementation across input sizes. The results show that Vulkan SC provides more stable kernel execution and consistently low kernel-side jitter. The growth analysis shows that CUDA kernel time is nearly input-size independent for small and medium input sizes, while Vulkan SC shows less uniform growth. For both APIs, the unfused baseline remains above the fused NN kernel time, while the relative gap decreases with increasing input size. H2D/D2H transfer timing scales almost linearly with transferred data size for larger transfers, but remains a major source of end-to-end variability, especially for Vulkan SC. Overall, Vulkan SC improves kernel-level timing determinism, while system-level predictability remains constrained by transfer overhead and shared-memory effects. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2027.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

