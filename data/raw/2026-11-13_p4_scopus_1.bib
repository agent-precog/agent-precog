	url = {https://www.scopus.com/pages/publications/105052969441?origin=resultslist},
	abstract = {Accurate driver braking intensity (DBI) prediction is essential for enabling proactive safety interventions and preventing collisions caused by insufficient braking. Physiological-signal-based approaches, such as electroencephalography and surface electromyography (sEMG), have shown strong potential for DBI prediction. However, existing algorithms still struggle to meet real-time requirements when deployed in active safety systems due to two factors: information redundancy in sEMG signals and the computational complexity of prediction models, particularly under in-vehicle hardware constraints. This paper addresses these issues by proposing a latency-aware Transformer (LatFormer) for real-time DBI prediction. First, spatiotemporal correlation analysis under different braking conditions revealed substantial inter-channel redundancy in sEMG signals, as well as identified the tibialis anterior and soleus as the most informative muscles for characterizing DBI. Then, LatFormer was developed to predict DBI from the selected channels, with a latency-aware reward function guiding architectural evolution and explicitly considering the accuracy-latency trade-off. Finally, a Pareto-dominated search strategy was adopted to obtain a competitive set of edge-deployable architectures. Results show that the proposed LatFormer can predict DBI 200 ms in advance with an root mean square error of 0.4951 MPa, an R<sup>2</sup> of 0.9524, and runs with an inference latency of 14.4 ms on the NVIDIA Jetson TX2, confirming its feasibility and real-time capability on in-vehicle hardware. Additional subject-independent validation and multi-run evaluation further confirmed that the low-channel sensing configuration preserves cross-driver generalization while satisfying the latency requirement of real-time physiological measurement on embedded in-vehicle hardware. The findings of this study may also provide guidance for reducing information redundancy and computational complexity in the design of real-time physiological measurement systems under hardware constraints. © 2026 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved. This article is available under the terms of the IOP-Standard License.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

