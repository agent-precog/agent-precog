@CONFERENCE{Zheng2025377,
	author = {Zheng, Yuwei and Chen, Beier},
	title = {Dual-Attention and Dynamic Convolution Enhanced YOLOv10 for Robust Outdoor Small Object Detection},
	year = {2025},
	journal = {Proceedings of 2025 6th International Conference on Information Science and Education, ICISE-IE 2025},
