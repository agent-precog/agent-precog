	abstract = {Unmanned Aerial Vehicle (UAV) state estimation with high accuracy in GPS-denied environments is a core challenge for autonomous navigation. Although the traditional Unscented Kalman Filter (UKF) possesses physical interpretability, its simplified physical model often suffers from residuals that are difficult to model when facing nonlinear vibrations and complex system noise, leading to limited estimation accuracy. This paper proposes a two-stage fusion state estimation framework combining physics-driven and data-driven methods. In the first stage, a 15-dimensional state-space UKF is employed to construct the basic physical evolution model. In the second stage, by introducing a variety of artificial intelligence architectures, learning and dynamic compensation are performed on the residuals between the UKF model predictions and the actual observations. The experiment systematically evaluates the accuracy and efficiency of different models in residual learning by comparing eight mainstream architectures, including Linear Regression, Ridge Regression, Random Forest, XGBoost, LightGBM, MLP, ResNet, and RealMLP. The results show that ensemble tree-based methods can significantly reduce position estimation errors, with XGBoost achieving a 96.38% MAE reduction on the X-axis and exceeding 94% across all three axes, while maintaining a single-frame inference latency below 1 ms. After comprehensive evaluation of localization accuracy and real-time deployment latency, it is concluded that XGBoost and LightGBM offer the optimal computational efficiency ratio while ensuring centimeter-level accuracy, making them ideal solutions for robust UAV navigation in complex environments.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Shafi2024,
