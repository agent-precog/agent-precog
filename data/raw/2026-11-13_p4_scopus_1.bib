@ARTICLE{Islam2026675,
	author = {Islam, Riadul and Mulé, Joey and Challagundla, Dhandeep and Rizvi, Shahmir and Carson, Sean and Saini, Rachit},
	title = {Lightweight Autoencoder for Event-Based Vision on Low-Latency Energy-Constrained Edge Devices},
	year = {2026},
