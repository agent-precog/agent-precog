@ARTICLE{Dat2026,
	author = {Dat, Lam Quoc},
	title = {ASMAG-TRC: A safety-arbitrated runtime architecture for adaptive inference control on resource-constrained edge AI cameras},
	year = {2026},
	journal = {Journal of Systems Architecture},
	volume = {181},
	pages = {},
	doi = {10.1016/j.sysarc.2026.104058},
	url = {https://www.scopus.com/pages/publications/105054647249?origin=resultslist},
	abstract = {Real-time edge AI cameras must run deep-learning detectors locally under strict latency, compute, and energy budgets. Detecting on every frame wastes energy on redundant fixed-camera video, yet naive frame-skipping risks missing safety-critical events. This paper presents ASMAG-TRC, a runtime inference-control architecture that decouples when to run a detector from how to accelerate it, composable with accelerators like quantization and TensorRT. The architecture combines a lightweight motion-proposal layer; a controller hierarchy selecting a per-frame mode (detect, reuse, estimate, or fallback); a pure-function safety-arbitration layer whose three deterministic rule-based invariants, exhaustively checked over their finite input domain, protect event-critical frames without shared mutable state; and a persistent-motion circuit breaker that bounds worst-case energy under sustained activity. We evaluate on four datasets (CDnet2014, BMC, LASIESTA, VIRAT; 131 videos) and on an NVIDIA Jetson Orin Nano with real INA3221 power measurement under a version-pinned stack. On CDnet2014 the guarded controller attains the best accuracy-efficiency score (AE = 0.835) at 43 % activation, cutting energy per frame by 36 % while improving Event F1 from 0.669 to 0.695; on BMC it reaches Event F1 0.946, surpassing always-on detection (0.938). On the Jetson it cuts energy per frame by 47.5 % at 4.5x throughput across all 53 CDnet2014 videos; the circuit breaker holds worst-case high-motion energy below the always-on baseline (328 vs 362 mJ/frame); and with TensorRT FP16 it sustains 130.8 FPS at a 60 % energy reduction (351 to 140 mJ), a 2.5x battery-lifetime extension. A 37-hour live deployment confirms 1.62 ms gate overhead; an MIT-licensed implementation is released. © 2026 Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Xu2026963,
	author = {Xu, Jiangtao and Xu, Haitao and Xue, Tao and Zhang, Tao},
	title = {FAVLG: A Lightweight Language-Driven Grasping Model for Networked ICPS via Parameter-Efficient Edge Execution},
	year = {2026},
	journal = {IEEE Transactions on Industrial Cyber-Physical Systems},
	volume = {4},
	pages = {963 - 973},
	doi = {10.1109/TICPS.2026.3732649},
	url = {https://www.scopus.com/pages/publications/105050284957?origin=resultslist},
	abstract = {In Industrial Cyber-Physical Systems (ICPS), deploying Embodied AI for language-driven robotic grasping holds immense potential. However, relying on cloud -based heavy Vision-Language Models (VLMs) imposes severe bandwidth and latency burdens on industrial communication networks, often violating strict Quality of Service (QoS) constraints for real-time perception-action loops. To bridge the gap between robotics and communications through low-latency local edge execution, this paper proposes FAVLG, a lightweight end-to-end grasp detection framework tailored for local edge deployment. Built upon the MobileCLIP backbone, the framework introduces a vision-language joint adaptation strategy for parameter-efficient fine-tuning. This strategy effectively bridges the domain gap and achieves explicit visual-textual interaction at the early stages of feature extraction. Consequently, our method eliminates the reliance on computationally intensive late-stage cross-modal fusion modules, substantially reducing computational overhead and enabling local edge deployment without heavy cloud network dependency. Furthermore, an attention module with grid topology priors is proposed to guide the model toward fine-grained focus and geometric edge refinement on critical grasping regions. Extensive experiments on the Grasp-Anything++ and OCID-VLG datasets demonstrate that FAVLG achieves highly competitive grasping performance while updating only 0.45% of the backbone parameters. Real-world robotic experiments further validate its feasibility, demonstrating its practical potential for low-latency and responsive local execution in networked ICPS.  © 2023 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Mitrofanov2027285,
	author = {Mitrofanov, Evgenii and Blekanov, Ivan and Kruchinin, Evgenii and Akhrameev, Rodion and Arkhipov, Mikhail and Mitrofanova, Olga},
	title = {Real-Time CNN-Based Detection System for an Autonomous Agricultural Robot in Open-Field Conditions},
	year = {2027},
	journal = {Smart Innovation, Systems and Technologies},
	volume = {508 SIST},
	pages = {285 - 295},
	doi = {10.1007/978-3-032-35010-7_23},
