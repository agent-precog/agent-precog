@ARTICLE{Hou20258016,
	author = {Hou, Minghui and Lyu, Chuanhao and Wang, Gang and Ma, Baorui and Xu, Rongtao and Hu, Jue and Fan, Xiaopeng},
	title = {PolarBEVU: Multi-Camera 3D Object Detection in Polar Bird’s-Eye View via Unprojection},
	year = {2025},
	journal = {IEEE Transactions on Circuits and Systems for Video Technology},
	volume = {35},
	number = {8},
	pages = {8016 - 8030},
	doi = {10.1109/TCSVT.2025.3546767},
	url = {https://www.scopus.com/pages/publications/86000158624?origin=resultslist},
	abstract = {3D object detection from a Bird’s Eye View (BEV) has emerged as a novel perception paradigm for autonomous driving scenarios. While most current 3D object detection methods still rely on the conventional Cartesian coordinates, they fail to align with the non-aligned coordinate system inherent in image geometry. The Polar coordinates, on the other hand, better fit with the geometric shape corresponding to the perception of cameras. However, transforming between coordinate systems introduces distortions in the perception information, resulting in issues such as “Weak Adaptability to Heatmap Distribution” and “Offset in the Center Point of the Bounding Box.” To address these challenges, this paper proposes a cutting-edge 3D object detection model named PolarBEVU, which leverages the bird’s-eye view under the Polar coordinates along with multi-camera unprojection. The model introduces an innovative “Deformable Uniform Heatmap Distribution” method that adjusts heatmap computations based on box shapes, generating high-quality heatmaps and effectively resolving the issue of “Weak Adaptability to Heatmap Distribution.” Moreover, the model incorporates the concept of “Dynamic High-risk Regression Region” to enhance the accuracy and robustness of the center point regression at the bounding box, thus mitigating the issue of “Offset in the Center Point of the Bounding Box.” In extensive experiments on the nuScenes dataset, PolarBEVU achieves impressive results with 49.9% mAP and 57.4% NDS on the test set, surpassing other comparative approaches and reaching the state-of-the-art (SOTA) performance among methods utilizing Polar coordinates. This clearly demonstrates the efficacy and superiority of PolarBEVU. In addition, the model is successfully deployed on Nvidia Jetson AGX Orin, showcasing real-time inference speeds of 31.42ms. © 1991-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 13}
}

@CONFERENCE{Panda2025,
	author = {Panda, Suhani and Sanjana, B. and Rajkumar, Harsha and Palani, Saravanan},
	title = {An Integrated GCN-GAT-AE Framework for Robust Anomaly Detection in Industrial IoT Environments},
	year = {2025},
	journal = {2025 IEEE 9th International Conference on Information and Communication Technology, CICT 2025},
	pages = {},
	doi = {10.1109/CICT67193.2025.11399172},
	url = {https://www.scopus.com/pages/publications/105041744527?origin=resultslist},
	abstract = {Over the past few years, the Industrial Internet of Things (IIoT) has quickly changed long established industries by connecting large networks of smart sensors, machines, and devices to permit real-time monitoring, data driven decision making, and automation. Yet, the growing scale and complexity of IIoT environments also make them highly exposed to various cyber threats and anomalies, which can disrupt operations, cause financial losses, and create danger. Existing anomaly detection methods often struggle to accurately capture the complex spatial, temporal, and structural dependencies in IIoT data, especially in real time and under resource-constrained edge deployments.To address these issues, a seven -stage hybrid deep learning framework combining Graph Convolutional Networks (GCN), Graph Attention Networks (GAT), Autoencoders (AE), and residual connections is proposed for robust real-time anomaly detection in Industrial Internet of Things (IIoT) environments. The architecture shows spatial, temporal, and structural relationships among IIoT sensor data by transforming tabular traffic logs from the Edge-IIoTset dataset into graph representations using cosine-based KNN connectivity. This allows the model to detect subtle and complex anomalies in highly dynamic IIoT systems. By combining attention-based feature refinement with reconstruction loss, the model enhances sensitivity to rare attacks and improves robustness. The proposed approach achieves high performance on key metrics of 95.0% classification accuracy, ROC-AUC of 0.98, PR-AUC of 0.97, and an inference latency of just 8.1 milliseconds which makes it highly suitable for deployment on edge devices in real-time industrial monitoring systems. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Chauhan2025185674,
	author = {Chauhan, Shishir Singh and Singh, Juhi and Kumar Bairwa, Amit},
	title = {ST-GACN: A Lightweight Spatio Temporal Graph Attention Model With Online Adaptation for Real Time Congestion Forecasting},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {185674 - 185688},
	doi = {10.1109/ACCESS.2025.3625433},
	url = {https://www.scopus.com/pages/publications/105019985634?origin=resultslist},
	abstract = {Accurate and low latency traffic prediction is a backbone for modern adaptive signal and digital twin platforms. Yet, most deep models are either too static to handle concept drift or too heavy for roadside hardware. We present ST-GACN, a spatio-temporal Graph Attention Convolutional Network that freezes a sparse multi-head attention backbone and fine-tunes only a 3 k -parameter read-out layer online. The architecture couples local global graph attention with dilated causal convolutions, achieving wide receptive fields while remaining memory-thrifty. Evaluated on the METR-LA benchmark (207 sensors, five-minute granularity), ST-GACN attains {MAE}=0.1752 at a five-minute horizon and 0.2511 at fifteen minutes, surpassing Diffusion CNN, Graph WaveNet, and ASTGCN by 9–13%. Ablation confirms that removing either dynamic attention or online adaptation degrades accuracy by up to twenty percent. The complete forward pass, including a single EWMA weighted gradient step every thirty minutes, executes in 15 ms on an NVIDIA A100 and 62ms on a Jetson Orin, comfortably within the 100ms control Budget for field deployment. Qualitative diagnostics reveal that the model reweights upstream sensors within one interval during incidents, and spatial error maps localize residual uncertainty to stadium ramps. One factor sensitivity experiments reveal an optimal trade-off at four heads, a one-hour history window, and a thirty-minute adaptation cadence. The open source release includes Docker and Jetson flash images, paving the way for drift-aware, edge-resident congestion forecasting and future multimodal extensions. © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Nair20223659,
	author = {Nair, Saeejith and Abbasi, Saad and Wong, Alexander and Shafiee, Mohammad Javad},
	title = {MAPLE-Edge: A Runtime Latency Predictor for Edge Devices},
	year = {2022},
	journal = {IEEE Computer Society Conference on Computer Vision and Pattern Recognition Workshops},
	volume = {2022-June},
	pages = {3659 - 3667},
	doi = {10.1109/CVPRW56347.2022.00410},
	url = {https://www.scopus.com/pages/publications/85137773236?origin=resultslist},
	abstract = {Neural Architecture Search (NAS) has enabled automatic discovery of more efficient neural network architectures, especially for mobile and embedded vision applications. Although recent research has proposed ways of quickly estimating latency on unseen hardware devices with just a few samples, little focus has been given to the challenges of estimating latency on runtimes using optimized graphs, such as TensorRT and specifically for edge devices. As devices like NVIDIA's Jetsons get more popular in embedded computing and robotics, we observe a pressing need to more accurately estimate inference latency of neural network architectures on diverse runtimes, including highly optimized ones. In this work, we propose MAPLE-Edge, an edge device-oriented extension of MAPLE, the state-of-the-art latency predictor for general purpose hardware, where we train a regression network on architecture-latency pairs in conjunction with a hardware-runtime descriptor to effectively estimate latency on a diverse pool of edge devices. Compared to MAPLE, MAPLE-Edge can describe the runtime and target device platform using a much smaller set of CPU performance counters that are widely available on all Linux kernels, while still achieving up to +49.6% accuracy gains against previous state-of-the-art baseline methods on optimized edge device runtimes, using just 10 measurements from an unseen target device. We also demonstrate that unlike MAPLE which performs best when trained on a pool of devices sharing a common runtime, MAPLE-Edge can effectively generalize across runtimes by applying a trick of normalizing performance counters by the operator latency, in the measured hardware-runtime descriptor. Lastly, we show that for runtimes exhibiting lower than desired accuracy, performance can be boosted by collecting additional samples from the target device, with an extra 90 samples translating to gains of nearly +40%. © 2022 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 18}
}

@CONFERENCE{Anwar2025195,
	author = {Anwar, Mohammad Saeid and Ravi, Anuradha and Dey, Emon and Shinde, Gaurav and Ghosh, Indrajeet and Freeman, Jade and Busart, Carl and Harrison, Andre and Roy, Nirmalya},
	title = {CoOpTex: Multimodal Cooperative Perception and Task Execution in Time-Critical Distributed Autonomous System},
	year = {2025},
	journal = {Proceedings - 2025 21st International Conference on Distributed Computing in Smart Systems and the Internet of Things, DCOSS-IoT 2025},
	pages = {195 - 202},
	doi = {10.1109/DCOSS-IoT65416.2025.00033},
	url = {https://www.scopus.com/pages/publications/105013849265?origin=resultslist},
	abstract = {Integrating multimodal data such as RGB and LiDAR from multiple views significantly increases computational and communication demands, which can be challenging for resource-constrained autonomous agents while meeting the time-critical deadlines required for various mission-critical applications. To address this challenge, we propose CoOpTex, a collaborative task execution framework designed for cooperative perception in distributed autonomous systems (DAS). CoOpTex contribution is twofold: (a) CoOpTex fuses multiview RGB images to create a panoramic camera view for 2D object detection and utilizes 360° LiDAR for 3D object detection, improving accuracy with a lightweight Graph Neural Network (GNN) that integrates object coordinates from both perspectives, (b) To optimize task execution and meet the deadline, CoOpTex dynamically offloads computationally intensive image stitching tasks to auxiliary devices when available and adjusts frame capture rates for RGB frames based on device mobility and processing capabilities. We implement CoOpTex in real-time on static and mobile heterogeneous autonomous agents, which helps to significantly reduce deadline violations by 100% while improving frame rates for 2D detection by 2.2 × in stationary and 2 × in mobile conditions, demonstrating its effectiveness in enabling real-time cooperative perception. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Wang20255730,
	author = {Wang, Zhanwei and Kalør, Anders E. and Zhou, You and Popovski, Petar and Huang, Kaibin},
	title = {Ultra-Low-Latency Edge Inference for Distributed Sensing with Short Packets},
	year = {2025},
	journal = {IEEE International Conference on Communications},
	pages = {5730 - 5735},
	doi = {10.1109/ICC52391.2025.11161501},
	url = {https://www.scopus.com/pages/publications/105018451063?origin=resultslist},
	abstract = {Artificial intelligence (AI) is expected to be a defining component in sixth-generation (6G) wireless networks. One specific use is AI-empowered sensing, where sensor data will be processed at the network edge, giving rise to integrated sensing and edge AI (ISEA). Many sensing applications, such as autonomous driving and industrial manufacturing, are latencysensitive and require end-to-end (E2E) performance guarantees under stringent deadlines. However, data-agnostic ultrareliable and low-latency communication (URLLC) techniques designed for 5G fall short in achieving the optimal E2E sensing performance. In this work, we introduce an ultra-low-latency (ultra-LoLa) inference framework for perceptive networks that facilitates the analysis of E2E sensing accuracy in distributed sensing by jointly considering communication reliability and inference accuracy. By characterizing the tradeoff between packet length and the number of sensing observations, we derive an efficient optimization procedure that closely approximates the optimal balance. The experimental results show that the proposed approach outperforms conventional reliability-oriented protocols with respect to sensing performance under a latency constraint.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Prabhu2025,
	author = {Prabhu, D. and Basam, Haneesha and Siddala, Sasi Kumar Reddy and Nevuluri, Vinod Kumar},
	title = {Edge Enabled Privacy Preserving Multi Violation Detection and Behavioral Risk Scoring for Intelligent Transport Systems in India},
	year = {2025},
	journal = {2025 5th International Conference on Emerging Research in Electronics, Computer Science and Technology, ICERECT 2025},
	pages = {},
	doi = {10.1109/ICERECT65215.2025.11376005},
	url = {https://www.scopus.com/pages/publications/105034904079?origin=resultslist},
	abstract = {This paper presents a novel, low cost, edge deployed AI system for real time detection of critical two wheeler traffic violation including helmet non usage, triple riding, mobile phone use while riding, wrong side driving, and red light jumping beyond urban intersections on Indian highways and rural roads. We integrate a privacy preserving pipeline that hashes personally identifiable data to protect user privacy, and propose a behavioral risk scoring model that aggregates detected violations over time to help prioritize enforcement efforts. Our prototype, built using lightweight deep learning models on affordable edge devices, demonstrates promising results with an mAP of 91.2% and real time inference at 18 FPS, while significantly reducing bandwidth and storage requirements compared to centralized systems. This framework aims to extend Intelligent Transport Systems (ITS) into non urban contexts, enhancing road safety through proactive and privacy conscious AI enforcement. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Koluguri2025,
	author = {Koluguri, Sri Rama Rathan Reddy and Puneet, Akshat and Srivastava, Abhishek},
	title = {Edge-Based Object Classification Using mmWave Radar on Qualcomm Innovators Development Kit},
	year = {2025},
	journal = {2025 1st International Conference on Intelligent Computing and Systems at the Edge, ICEdge 2025},
	pages = {},
	doi = {10.1109/ICEDGE67252.2025.11412676},
	url = {https://www.scopus.com/pages/publications/105036658269?origin=resultslist},
	abstract = {Frequency Modulated Continuous Wave (FMCW) radars are emerging a reliable solution for object classification, having consistent performance under varying environmental conditions, unlike traditional Lidar and camera-based approaches. This paper presents an end-to-end object classification pipeline using point cloud data from an FMCW radar, deployed on the Qualcomm Innovators Development Kit (QIDK), demonstrating its suitability for embedded, Machine Learning and real-time interfaces. A PCA+SVM based classifier is used in the proposed system to enable efficient on-device inference with lower computational overhead. Experimental evaluation on a custom-made dataset containing over 11,000 samples shows an accuracy of 96.23%, with an inference latency of less than 25.9 milliseconds and a model size of 69.91 MB, demonstrating the suitability of the proposed approach for real-time, on-device object classification in smart mobility applications and intelligent sensing platforms. © 2025 IEEE.},
