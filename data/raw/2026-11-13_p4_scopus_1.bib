	doi = {10.1109/ICISE-IE68873.2025.11379786},
	url = {https://www.scopus.com/pages/publications/105035539705?origin=resultslist},
	abstract = {Existing real-time detectors for UAV imagery are constrained by the assumption of spatial stationarity in convolution kernels. Consequently, they face severe feature erosion and representation degradation when handling drastic scale variations and high-density tiny objects. To address this, this paper proposes DA-Dy-YOLOv10, an enhanced framework based on YOLOv10. First, a context-adaptive feature extraction network is constructed by introducing Dynamic Convolution (DyConv) modules to reconstruct weights in real-time based on input features, significantly enhancing geometric detail capture for weak-texture tiny objects. Second, the Convolutional Block Attention Module (CBAM) is embedded within the multi-scale fusion stage to effectively suppress high-frequency noise from complex backgrounds via joint channel-spatial recalibration. Experiments on VisDrone2019-DET demonstrate that this method significantly improves accuracy while maintaining the advSpecifically, the Average Precision for small objects (APS) increased by 3.6 percentage points to 25.1%, effectively mitigating missed detections.antages of end-to-end real-time inference. Moreover, mAP50 reached 58.4% (representing a 4.3% improvement over the baseline). Furthermore, the model outperforms Vision Transformer (ViT) architectures while reducing computational complexity by approximately 29%. The negligible marginal cost of only 0.4 GFLOPs strongly confirms its potential for edge deployment.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
