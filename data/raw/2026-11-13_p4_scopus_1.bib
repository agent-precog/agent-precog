@BOOK{Lokeshkiran2026499,
	author = {Lokeshkiran, P. and Mathankumar, C.},
	title = {Future Directions in Tiny Machine Learning: Emerging Trends and Innovations},
	year = {2026},
	journal = {Tiny Machine Learning: Next-Generation Artificial Intelligence},
	pages = {499 - 522},
	doi = {10.1002/9781394392834.ch20},
	url = {https://www.scopus.com/pages/publications/105055497863?origin=resultslist},
	abstract = {Tiny machine learning (TinyML) represents a transformative frontier in the evolution of artificial intelligence (AI), merging machine learning capabilities with ultra-low-power embedded systems to enable real-time inference at the edge. As data generation accelerates across billions of Internet of Things (IoT) devices, the need for intelligent edge computing that operates efficiently without relying on cloud infrastructure has become critical. TinyML addresses this demand by enabling localized AI processing on constrained devices with limited memory, computation, and energy resources. This chapter provides a comprehensive exploration of the cutting-edge advancements and research trends shaping the present and future landscape of TinyML. We begin by analyzing the core technological enablers of TinyML, including the rise of energy-efficient microcontrollers, specialized AI hardware accelerators, and neuromorphic computing platforms that emulate human brain-like functionality. Innovations in model compression techniques—such as pruning, quantization, and knowledge distillation—play a central role in shrinking complex deep learning models into formats suitable for resource-constrained environments. Additionally, adopting federated learning architectures allows distributed training and data privacy preservation directly on edge nodes, enabling collaborative intelligence without centralized data aggregation. The chapter also highlights the emergence of event-driven AI, which processes sensory inputs based on relevance or change detection rather than continuous sampling, thus reducing power consumption and latency. These techniques are further enhanced by software frameworks tailored for TinyML deployment, including TensorFlow Lite Micro, Edge Impulse, and TVM. Their integration enables scalable development across various application domains. Real-world implementations of TinyML are explored in depth, with practical use cases spanning healthcare, industrial IoT, agriculture, and smart cities. In healthcare, wearable biosensors powered by TinyML enable continuous physiological monitoring, early disease detection, and personalized health feedback. In industrial environments, TinyML enables predictive maintenance systems that detect anomalies in machinery before catastrophic failures occur. Additionally, autonomous drones and surveillance systems powered by on-device AI offer scalable solutions for crowd analytics, traffic monitoring, and environmental sensing in urban settings. Despite its growing potential, TinyML faces significant challenges, particularly concerning energy constraints, data privacy, and security. To address these issues, emerging solutions such as homomorphic encryption for secure inference, blockchain-based identity management for trusted edge collaboration, and hardware-rooted trust anchors for secure boot processes are examined. Furthermore, the ethical dimensions of deploying AI at the edge—such as algorithmic bias, data ownership, and transparency—are critically assessed. Looking forward, the chapter investigates future research directions and anticipated breakthroughs. The integration of TinyML with 6G-enabled IoT ecosystems is poised to enable intelligent, real-time, and ultra-reliable machine-type communication. Biomedical AI applications powered by TinyML are expected to revolutionize early diagnostics and personalized treatment using implantable or ingestible AI chips. Additionally, advances in cognitive computing and neuromorphic architectures hold promise for self-learning edge devices that adapt dynamically to contextual changes in their environments. © 2027 Scrivener Publishing LLC.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Bronze Open Access}
}

