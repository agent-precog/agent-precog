@CONFERENCE{Wang20231311,
	author = {Wang, Yushen and Yang, Yang and Deng, Jiaxi and Meng, Haitao and Chen, Gang},
	title = {FastOmniMVS: Real-time Omnidirectional Depth Estimation from Multiview Fisheye Images},
	year = {2023},
	journal = {Proceedings of the International Conference on Parallel and Distributed Systems - ICPADS},
	pages = {1311 - 1318},
	doi = {10.1109/ICPADS60453.2023.00188},
	url = {https://www.scopus.com/pages/publications/85190235866?origin=resultslist},
	abstract = {Omnidirectional depth sensing, which can build 3-D scene structure of the objects of interest in all directions without any blind regions, is essential for ensuring the safety of robotic systems in complex environments. Recent researches attempt to use end-to-end deep neural network (DNN) models for omnidirectional depth estimation from multiview fisheye images. However, most of these existing DNN-based researches cannot achieve real-time performance. In this paper, we propose, FastOmniMVS, a lightweight end-to-end deep neural network (DNN) to achieve real-time omnidirectional depth estimation. FastOmniMVS consists of three parts: a feature extraction module that extracts features from the input fisheye images, spherical sweeping that maps the features to the spherical space to form a 4D cost volume, and finally, the depth is computed by a 3D encoder-decoder. Additionally, we conduct Quantization-Aware Training (QAT) for this network and deploy the quantized model on Jetson Orin. Through extensive experiments, we demonstrate that FastOmniMVS achieves high computational efficiency while maintaining performance close to the state-of-the-art (SOTA) accuracy. It can achieve a real-time inference speed of 35 frames per second (FPS) on the Jetson Orin device. © 2023 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5}
