@CONFERENCE{Tauseef2025,
	author = {Tauseef, Md. and Kumar, Harsh and Girish, J.V. and Kamath, Nikhil Shevgoor and Karmakar, Abhishik and Kounte, Manjunath R},
	title = {Autonomous Weed Detection and Removal for Precision Agriculture Using Deep Learning},
	year = {2025},
	journal = {2025 International Conference on Circuits, Controls and Communications, CCUBE 2025},
	pages = {},
	doi = {10.1109/CCUBE66458.2025.11340480},
	url = {https://www.scopus.com/pages/publications/105033154247?origin=resultslist},
	abstract = {Weed proliferation significantly hampers agricultural productivity by competing with crops for nutrients, water, and sunlight. Conventional weed control methods, such as manual weeding and herbicide application, are labor-intensive, environmentally harmful, and economically unsustainable. This paper presents an autonomous weed detection and removal system that integrates deep learning-based computer vision, edge computing, and robotic actuation to enable eco-friendly precision agriculture. The system employs a YoloR-based object detection model, achieving 92.4% detection accuracy, 90.1% precision, and 91.3 % recall for crop-safe weed removal under diverse lighting and soil conditions. A laser-guided mechanism enables chemical-free weed elimination without damaging crops. Autonomous navigation, powered by real-time path planning, GPS, and sensor fusion, achieved a 94.7 % success rate in dynamic field environments. Optimized for low-power edge computing, the system performs real-time inference at 38 frames per second on an NVIDIA Jetson Nano while consuming only 9.5 W, ensuring energy efficiency and field deployability. Field evaluations confirm its accuracy, efficiency, and scalability. This system demonstrates a scalable, eco-friendly solution for sustainable weed management in precision agriculture. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
