@ARTICLE{Rafeeq War2026,
	author = {Rafeeq War, Muhammed and Auluck, Nitin and Kawoosa, Hadia Showkat and Hussain, Barkat},
	title = {Porcupine Detection and Mitigation in Kashmir Valley Orchards Using Edge Computing},
	year = {2026},
	journal = {Software - Practice and Experience},
	pages = {},
	doi = {10.1002/spe.70122},
	url = {https://www.scopus.com/pages/publications/105054240652?origin=resultslist},
	abstract = {Context: Roughly 20% to 28% of the GDP of the Kashmiri agricultural sector are based on high-value crops, such as apples, walnuts, saffron, and apricots. These face significant economic challenges due to crop damage caused by the Indian crested porcupine (Hystrix indica). Objective: This research aims to study and develop an effective real-time management solution for wildlife intrusion in orchards, overcoming the limitations of traditional deterrence methods. Methods: We propose a multilayered edge-IoT architecture that combines motion, acoustic, and visual sensing with edge-based machine learning and automated wildlife monitoring. The system leverages lightweight YOLOv8n models running on edge devices, secure communication frameworks, and intelligent monitoring with a user-facing application for alerts and analytics. A comprehensive wildlife detection dataset was developed by integrating multiple public datasets and converting segmentation annotations into object-detection bounding boxes. The final dataset contains 1758 images with 2249 annotated instances across three classes: porcupine, hedgehog, and others. Object detection is performed using YOLOv8n on resource-constrained edge devices for efficient real-time inference. Results: Experimental results show that YOLOv8n achieves 93.9% mAP@0.5 and 86.4% mAP@0.5:0.95 with 84.0% precision and 89.9% recall on the test dataset. The porcupine class specifically achieves 99.5% mAP@0.5 and 95.4% mAP@0.5:0.95, demonstrating highly reliable porcupine detection performance. The lightweight YOLOv8n architecture achieves approximately 4.9 ms inference time per image on the validation host, and 81 ms per frame on a Jetson Nano edge node, enabling efficient edge deployment for real-time orchard monitoring. All reported figures are obtained from real image data combined with simulated multi-sensor confidence modeling; no result derives from a deployed orchard installation, and the scope of validation is stated explicitly. Conclusion: Furthermore, the proposed framework establishes a foundation for future privacy-preserving and Agentic AI-enabled intelligent wildlife monitoring systems capable of adaptive decision-making, autonomous monitoring, and collaborative edge intelligence under dynamic environmental conditions. © 2026 John Wiley & Sons Ltd.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Ling202391,
	author = {Ling, Neiwen and Huang, Xuan and Zhao, Zhihe and Guan, Nan and Yan, Zhenyu and Xing, Guoliang},
	title = {BlastNet: Exploiting Duo-Blocks for Cross-Processor Real-Time DNN Inference},
	year = {2023},
	journal = {SenSys 2022 - Proceedings of the 20th ACM Conference on Embedded Networked Sensor Systems},
	pages = {91 - 105},
	doi = {10.1145/3560905.3568520},
	url = {https://www.scopus.com/pages/publications/85147539283?origin=resultslist},
	abstract = {In recent years, Deep Neural Network (DNN) has been increasingly adopted by a wide range of time-critical applications running on edge platforms with heterogeneous multiprocessors. To meet the stringent timing requirements of these applications, heterogeneous CPU and GPU resources must be efficiently utilized for the inference of multiple DNN models. Such a cross-processor real-time DNN inference paradigm poses major challenges due to the inherent performance imbalance among different processors and the lack of real-time support for cross-processor inference from existing deep learning frameworks. In this work, we propose a new system named BlastNet that exploits duo-block - a new model inference abstraction to support highly efficient cross-processor real-time DNN inference. Each duo-block has a dual model structure, enabling efficient fine-grained inference alternatively across different processors. BlastNet employs a novel block-level Neural Architecture Search (NAS) technique to generate duo-blocks, which accounts for computing characteristics and communication overhead. The duo-blocks are optimized at design time and then dynamically scheduled to achieve high resource utilization of heterogeneous CPU and GPU at runtime. BlastNet is implemented on an indoor autonomous driving platform and three popular edge platforms. Extensive results show that BlastNet achieves 35.07 % less deadline missing rate with a mere 1.63% of model accuracy loss.  © 2022 ACM.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 40; All Open Access; Gold Open Access}
}

@CONFERENCE{Chen2025339,
	author = {Chen, Hang and Liu, Chunlin and Shen, Hao and Luo, Guangdai and Zhang, Shuo and Chen, Xiaoting and Li, Mianjie},
	title = {Efficient Recognition of Construction Machinery Operation Behaviors Based on Knowledge Distillation and Edge Intelligence},
