	note = {Cited by: 0}
}

@ARTICLE{Srinivasan2026,
	author = {Srinivasan, R. and Dhavale, Sunita and Agrawal, Pooja},
	title = {Deep learning–based automated aero-engine blade inspection, damage tracking, and maintenance decision support},
	year = {2026},
	journal = {Aerospace Science and Technology},
	volume = {178},
	pages = {},
	doi = {10.1016/j.ast.2026.112350},
	url = {https://www.scopus.com/pages/publications/105037830935?origin=resultslist},
	abstract = {Aero-engine blade inspection is fundamental to ensuring flight safety, operational reliability, and effective engine health monitoring within condition-based maintenance frameworks. In practice, inspection is performed using borescope systems that generate extended video sequences of internal components such as compressor and turbine blades. These inspections are currently analysed manually, resulting in high labour demand, inter-inspector variability, and limited capability to capture the nonlinear and path-dependent evolution of blade damage over successive operational cycles. Existing automated approaches primarily operate on individual frames and do not preserve blade identity across inspection sequences. As a result, they are unable to associate observed defects with specific blades or relate damage progression to engine operational usage, limiting their applicability for health monitoring and maintenance decision-making. This paper presents the Video-Informed Blade Damage Assessment System (VIBDAS), an automated inspection framework that integrates frame-level defect detection with a task-specific Temporal Correlation Layer (TCL) within a YOLOv7-based architecture. The TCL establishes blade-level identity consistency through frame-to-frame association, enabling aggregation of defect observations at the level of individual blades. These observations are further indexed using operational cycles derived from event-based analysis of high-pressure spool speed (N<sub>2</sub>), providing a cycle-aligned representation of blade condition. To address nonlinear imaging artefacts inherent in borescope inspection, a physics-consistent augmentation strategy is employed. Spatially varying Gaussian noise is used to model acquisition variability, while wavelet-domain defect fusion introduces realistic defect patterns without disturbing underlying blade geometry. The system detects four service-relevant defect classes-nick, dent, chip-off, and tear and quantifies damage severity through pixel-to-physical scaling. Experimental evaluation on the AERO-ENG dataset, comprising real and synthetically augmented samples, achieves a mean Average Precision (mAP@0.5) of 81.8% with an F1-score of 81.18%. Deployment on an NVIDIA Jetson Orin platform demonstrates deterministic real-time inference, indicating suitability for field-level inspection. By combining blade-level identity tracking with cycle-based operational indexing, the proposed framework enables structured correlation between observed defects and cumulative engine usage. This provides a practical basis for aero-engine health monitoring aligned with Equivalent Low Cycle Fatigue (ELCF)–based assessment and supports maintenance decision-making. © 2026 Elsevier Masson SAS.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

