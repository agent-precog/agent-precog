@CONFERENCE{Kiasari2026,
	author = {Kiasari, Mahmoud and Aly, Hamed},
	title = {Hybrid AI-FACTS Optimization for Nova Scotia Grid: A Physics-Informed Deep Learning Approach for Real-Time Voltage Stability Enhancement},
	year = {2026},
	journal = {SysCon 2026 - The 20th Annual IEEE International Systems Conference, Conference Proceedings},
	pages = {},
	doi = {10.1109/SysCon66367.2026.11503539},
	url = {https://www.scopus.com/pages/publications/105040726006?origin=resultslist},
	abstract = {The rapid decarbonization of modern power systems coupled with the necessity to integrate large amounts of intermittent renewable energy sources (IRES) (Like wind power) into transmission grids under a reduction of synchronous inertia. This transition causes severe problems in power quality, such as voltage instability, reactive power shortage, harmonics, and short-circuit strength. This paper proposes an extensive hybrid AI - FACTS control framework specifically tuned to the Nova Scotia (NS) Power Grid, which is a representative weak grid system that experiences voltage deviation at major load centers because of variable wind production from geographically spread sites. The proposed architecture involves coupling of physics-informed neural network (PINN) and Long Short-Term Memory (LSTM) recurrent units to provide robust 15 min Ahead Voltage Magnitude Forecasting and Particle Swarm Optimization (PSO) controller for coordinated real time dispatching of Static Var Compensators (SVC) and Static Synchronous Compensators (STATCOM). Unlike traditional black box models for machine learning, PINN incorporate the fundamental laws of AC power flow (i.e., Kirchhoff's Current Law and nodal power balance) directly into the training goal, which means that the predictions inherently meet the physical constraints and safety bounds. Extensive simulations on a detailed 6-Bus reduced-order model of Nova Scotia transmission backbone, validated with actual historical data (load profiles collected from PJM Interconnection and wind speed time series collected from NREL Wind Integration Database) demonstrate that the hybrid AI-FACTS framework reduces average voltage deviation by 67.7%, decreases transmission power losses by 7.7%, and maintains the total harmonic distortion (THD) within the compliance limits of the international standards, standard 519 (IEEE-519-2014) significantly more than the original decentralized PI-based FACTS control. The system achieves a computational efficiency appropriate for edge deployment with an inference latency of less than 50 ms per control cycle on commodity hardware.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

