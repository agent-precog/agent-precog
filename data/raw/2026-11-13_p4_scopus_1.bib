@ARTICLE{Lin2027184,
	author = {Lin, Yida and Xue, Bing and Zhang, Mengjie and Green, Richard and Schofield, Sam},
	title = {From Pseudo-Ground-Truth to Edge Deployment: Benchmarking Deep Stereo Matching Networks on Real Radiata Pine Tree Images for UAV Tree Pruning},
