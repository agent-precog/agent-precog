@ARTICLE{Aljanabi202750,
	author = {Aljanabi, Yaser Issam Hamodi and Rahma, Abdul Monem S. and Salim, Darin Shafiq and Saeed, Adham Mohsen and Somkina, Tetiana},
	title = {Multimodal AI Architectures for Real-Time Decision-Making in Autonomous Systems},
	year = {2027},
	journal = {Communications in Computer and Information Science},
