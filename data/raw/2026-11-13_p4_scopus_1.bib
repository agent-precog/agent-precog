@ARTICLE{Wang2026,
	author = {Wang, Sishan and Zhao, Youqun and Fu, Xin and Si, Huachao and Wang, Wentao and Xue, Lei},
	title = {A class-imbalance-aware intrusion detection system based on spatiotemporal graph neural networks for software-defined vehicles},
	year = {2026},
