@ARTICLE{Liu2026,
	author = {Liu, Xiaohu and Pan, Hongke and Yu, Xiaogang and Xi, Jun and Peng, Yujun},
	title = {Bio-Inspired Low-Light Image Enhancement with Large Kernel Convolution and Attention},
	year = {2026},
	journal = {Biomimetics},
