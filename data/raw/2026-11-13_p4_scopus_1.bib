@CONFERENCE{Bhaskar2025,
	author = {Bhaskar, Sudharsan Vaidhun and Lakshmanan, Lakshmi Sree},
	title = {Edge AI Integration for Adaptive Control in Embedded Robotics Platforms},
	year = {2025},
	journal = {Proceedings of the 2025 1st International Conference on Advances in Engineering and Computing Technologies for Sustainable Development, AECTSD 2025},
	pages = {},
	doi = {10.1109/AECTSD65988.2025.11411051},
	url = {https://www.scopus.com/pages/publications/105036473611?origin=resultslist},
	abstract = {Robot-assisted surgery (RAS) has transformed joint and bone surgery. A major challenge in RAS is the segmentation of images to aid the surgery process, which requires huge computing and real-time analysis. The traditional applications of cloud systems might not be viable when it comes to long operations because of their increased latency and security concerns, as well as the need to have a good internet connection. Edge Artificial Intelligence (Edge AI) is a game-changing concept of robotics. Edge AI is especially suitable in situations when high processing and power consumption cannot be considered a feasible option, and low-latency response time is a must. This paper investigates edge AI image segmentation in RAS in orthopedic surgery. This paper examines how Edge AI enables the reduced reliance on external systems and minimization of the segmentation to the surgical location, and is reasonably accurate in real-time segmentation. This paper will discuss three deep learning (DL) technologies, namely, Transformer, DeepLabVe, and U-Net, that fulfill the edge design based on approaches such as quantization, trimming, and data distillation. Operative images would be best analyzed with a real-time analysis workflow that is founded on edge AI systems, including the NVIDIA Jetson Xavier and the Google Coral TPU. The findings of the study show that real-time predictions with Edge AI segmentation have a latency within 100 milliseconds and are highly accurate. The research issues explored include the generality of the systems used in working with different anatomies of patients, limitations on the hardware used, and legal adherence. Therefore, by enabling the fast, precise, and regional analysis of the image, Edge AI would enhance the quality of RAS in orthopedics. This would enhance patient outcomes and the accuracy of operations. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Alabed2025,
