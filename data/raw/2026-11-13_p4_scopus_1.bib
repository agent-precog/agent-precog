@CONFERENCE{Zhao2026381,
	author = {Zhao, Pingzhi and Di, Boning and Wang, Chaowei},
	title = {MAR-MHNet: A Shipborne Crew State Monitoring Framework Integrating Cross-Modal Reliability- Aware Attention and Adaptive Threshold},
	year = {2026},
	journal = {2026 IEEE International Conference on Power, Electronics and Green Energy, ICPEGE 2026},
