	abstract = {The pervasive deployment of Internet of Medical Things (IoMT) devices in critical-care environments creates an acute paradox: the network infrastructure enabling lifesaving telemetry simultaneously represents a high-value attack surface targeted by increasingly sophisticated adversaries. Standard perimeter-focused security architectures cannot resolve the inherent tension between clinical emergency access where milliseconds determine patient outcomes and the stringent verification requirements of Zero Trust Architecture (ZTA). This paper presents Med-ZT, a multi-tiered autonomous Zero Trust orchestrator built on a lightweight MLP Real-Time Learner, a Priority-Gated Ensemble classifier, and a contrastively hardened Digital Twin autoencoder. Evaluated on the WUSTL-EHMS 2020 benchmark (N=16,318 heterogeneous biometric-network records; no real patient data used), Med-ZT achieves 99.4% weighted accuracy, 99.0% macro-average recall on Data Alteration attacks, and a batch-normalised edge-node latency of 0.0002 ms/packet (Apple M3; ±s over 100 independent trials). Theoretical analysis confirms sub-100 ms operation on NVIDIA Jetson Nano and Raspberry Pi 4, within clinical real-time constraints. A novel BioContextual Break-the-Glass (BTG) protocol dynamically relaxes authentication friction when real-time vitals signal a clinical crisis, backed by SHAP-annotated tamper-evident audit trails. Adversarial robustness evaluation under FGSM (e=0.01-0.10) shows that Contrastive Hardening limits macro-recall degradation to <12% at the highest perturbation budget, outperforming unhardened baselines by 29.4 pp. Five-fold cross-validation confirms 99.1±0.3% accuracy. Our results formally establish that SecurityFirst priority gating is categorically superior to weighted-average ensemble fusion for life-critical IoMT deployments. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

