@CONFERENCE{Kannan2026796,
	author = {Kannan, Elumalai and Ganesan, Surendar and Esakki, Balasubramanian and Nirmal Prabhath, Ch.},
	title = {Evaluation of Computer Vision-Driven Autonomous Water Landing of Amphibious UAVs Using YOLOv8 and MATLAB},
	year = {2026},
	journal = {Proceedings of the 2026 12th International Conference on Communication and Signal Processing, ICCSP 2026},
