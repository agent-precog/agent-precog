	pages = {4147 - 4164},
	doi = {10.1177/18724981251380391},
	url = {https://www.scopus.com/pages/publications/105017491405?origin=resultslist},
	abstract = {Aiming at the core problems of insufficient dynamic fusion of multimodal time series data and difficulty in modeling individual long-term physiological adaptability in athletic injury risk prediction. This paper hypothesizes that a framework integrating biomechanical modeling with personalized adaptive learning can significantly improve the accuracy and practicality of injury risk prediction in dynamic sports scenarios. To test this, we propose a dynamic prediction framework based on Spatio-Temporal Graph Neural Networks (ST-GNN) and Federated Learning. Wearable devices are used to synchronously collect multimodal signals, including Inertial Measurement Unit (IMU), surface Electromyography (sEMG), and Photoplethysmography (PPG), which are mapped onto a dynamic human skeleton graph. The ST-GNN extracts spatio-temporal biomechanical features, while a federated learning framework with a meta-learning strategy enables personalized model adaptation for individual athletes, solving data heterogeneity and cold-start problems. The system is optimized for edge deployment through mixed precision quantization and layer fusion. Experimental results show that biomechanical feature extraction based on dynamic graph neural network reduces the mean square error of knee angle prediction to 0.82 in 50 rounds of training; the multimodal fusion injury warning AUC (Area Under the Curve) combined with adaptive attention mechanism reaches 0.89; the ACL (Anterior Cruciate Ligament) injury warning accuracy reaches 0.83 after 100 rounds of training iterations. This study provides a complete, low-latency solution from data collection to edge decision-making, advancing the application of wearable devices in medical-grade sports health management. © The Author(s) 2025},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6}
}

@CONFERENCE{Telalwar20254945,
	author = {Telalwar, Sachin},
	title = {Edge-Cloud Architectures for Distributed, Real-Time Systems in Mission-Critical Domains},
	year = {2025},
	journal = {2025 28th International Conference on Computer and Information Technology, ICCIT 2025},
	pages = {4945 - 4950},
	doi = {10.1109/ICCIT68739.2025.11491302},
	url = {https://www.scopus.com/pages/publications/105041634497?origin=resultslist},
	abstract = {Real-time systems deployed in mission-critical domains such as autonomous transportation, industrial control, and emergency response demand stringent latency, availability, and fault tolerance guarantees. Traditional cloud-centric solutions, while scalable, suffer from high latency and centralized failure risks, whereas isolated edge deployments lack global context and resilience. Despite substantial advances in distributed architectures, a consistent and unified approach balancing edge-cloud orchestration for real-time responsiveness remains a pressing gap. This paper introduces a novel edge-cloud architectural framework that leverages event-driven microservices and real-time stream processing across a multi-tier deployment. Our architecture integrates resilient fault-containment algorithms, DevSecOps pipelines, and a latency-aware scheduling model tailored to deterministic deadlines. Extensive evaluation demonstrates an average 37.2% reduction in response latency under load, a 29.5% faster recovery time after simulated failures, and a 46.8% improvement in availability compared to leading monolithic cloud deployments. These results substantiate the viability of our framework in time-sensitive, failure-intolerant scenarios. The proposed solution offers a modular foundation for future intelligent systems operating in edge-cloud environments. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
