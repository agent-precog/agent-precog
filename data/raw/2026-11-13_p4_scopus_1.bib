@CONFERENCE{Sundar2026608,
	author = {Sundar, Johanan and Francis, Michael Thomas Rex and Ganesamoorthy, Sathya Seelan and Senthil, Prabod Arjun Kumar},
	title = {A Scalable AI System for Livestock Monitoring with Real-Time Threat Detection and Alerts},
	year = {2026},
	journal = {Proceedings of 2nd International Conference on Visual Analytics and Data Visualization, ICVADV 2026},
	pages = {608 - 613},
	doi = {10.1109/ICVADV67766.2026.11470411},
	url = {https://www.scopus.com/pages/publications/105037461399?origin=resultslist},
	abstract = {The rapid adoption of data-driven technologies is transforming modern agriculture, with Precision Livestock Farming (PLF) emerging as a key enabler of sustainable and efficient practices. While advances in computer vision, deep learning, and IoT have significantly improved animal identification, body condition scoring, and lameness detection, existing systems remain constrained by species-specific designs, reliance on cloud-based processing, and limited real-time responsiveness. This paper presents the Automated Cattle Detection and Risk Mitigation System, a novel three-tier edge-cloud architecture that integrates low-power edge devices with real-time cloud synchronization and intelligent alerting. At its core, the system utilizes a quantized YOLOv11 model on a Raspberry Pi 4B with TPU acceleration, achieving an inference rate of at least 18 FPS while consuming less than 5 W of power. The model is trained explicitly for multi-species detection, covering cattle, sheep, horses, humans, and predators, with an overall accuracy exceeding 94%. An on-device threat scoring mechanism, combined with geofencing, ensures ultra-low latency alerts (<1.3 seconds), delivered via the WhatsApp API for rapid farmer response. Field trials spanning 72 hours demonstrated robust accuracy, energy efficiency, and affordability, outperforming legacy RFID and cloud-dependent solutions. By bridging AI-driven monitoring with farmer-friendly interfaces, the proposed system enhances livestock safety, welfare, and operational resilience, offering a scalable framework for next-generation smart farming. © 2026 IEEE.},
