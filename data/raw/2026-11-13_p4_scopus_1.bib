@ARTICLE{Zhao2026,
	author = {Zhao, Hui and Luan, Mingan and Ranaweera, Pasika and Liyanage, Madhusanka and Wang, Li and Chang, Zheng},
	title = {Multimodal Sensing, Aerial Communication and Edge Inference in Open RAN-empowered LEO Satellite-assisted Low-Altitude Networks},
	year = {2026},
	journal = {IEEE Internet of Things Journal},
	pages = {},
	doi = {10.1109/JIOT.2026.3726937},
	url = {https://www.scopus.com/pages/publications/105050201124?origin=resultslist},
	abstract = {This paper studies Open Radio Access Network (O-RAN)-empowered Low-Altitude Networks (LANs) that integrate multiple Unmanned Aerial Vehicles (UAVs) and a Low Earth Orbit (LEO) satellite for multimodal sensing, aerial communication, and edge inference. The combination of high-dimensional multimodal sensing data, bandwidth-limited UAV-to-satellite links, and heterogeneous computation capabilities across the UAVs and the LEO satellite makes it difficult to satisfy the heterogeneous quality of service (QoS) requirements. To tackle this problem, we formulate an O-RAN slicing-aware joint optimization problem to maximize the long-term system utility, which captures the coupled trade-offs among sensing, communication, and inference resources. Recognizing the distinct temporal granularities of frame-level slice configuration and slot-level resource scheduling, we formulate the problem as a dual-timescale decision process. We develop a unified framework that captures multimodal data sensing, uplink transmission, and hierarchical deep neural network (DNN) inference towards slice-specific QoS requirements based on network slicing. To solve the resulting problem, we propose a hierarchical scheme in which expert modules are introduced for cooperative matching-based subcarrier allocation and a hybrid First-Come, First-Served (FCFS)-Earliest Deadline First (EDF) strategy for satellite-side task scheduling, while an attention-enhanced Multi-Agent Proximal Policy Optimization (MAPPO) algorithm is employed to optimize sensing duration and DNN splitting decisions under dynamic inter-UAV coupling. Simulation results demonstrate that the proposed framework achieves higher long-term system utility, faster convergence, and stronger adaptability to dynamic network conditions than baseline schemes. © 2014 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Vittal20242287,
	author = {Vittal, Shwetha and Sarkar, Sourav and Franklin, A. Antony},
	title = {Revamping the Resilience and High Availability of 5G Core for 6G Ready Network Slices},
	year = {2024},
	journal = {IEEE Transactions on Network and Service Management},
	volume = {21},
	number = {2},
	pages = {2287 - 2302},
	doi = {10.1109/TNSM.2023.3348137},
	url = {https://www.scopus.com/pages/publications/85181555694?origin=resultslist},
	abstract = {Current advancements in the design of the service-based architecture of 5G Core (5GC) are flexible to be deployed with Network Function Virtualization (NFV) in the form of network slices. While some slices tolerate the delay and some do not, this versatility of slice services imposes challenges to Mobile Network Operators in designing a robust, scalable, and yet resilient 5GC. Therefore, in this work, we build a self-resilient 5GC that not only addresses the scheduling requirements per slice type but also yields service satisfaction. Precisely, we build it as a combination of large Integer Linear Programming based Column Generation (CG) and Artificial Intelligence based Deep Learning in a Closed Loop Automation with a Self Organizing Network paradigm. During unexpected situations of overload and failures of serving instances, the proposed CG technique in the work improves the scheduling and serving of control plane user requests by dropping 15% lesser user requests in delay-tolerant slices and 5% lesser in delay-sensitive slices, than the existing state-of-the-art solutions. With 95% learning accuracy, the Deep Learning-based Long Short Term Memory (LSTM) method predicts the availability of serving instances of the Network Functions (NFs) of the 5GC. Overall, by deriving the optimal number of serving instances for each NF of the 5GC, this blend of CG and AI in the 5GC not only contributes to efficient scaling and reconfiguration of the slices but also improves the resilience and High Availability of the 5GC. We believe that this proposed work is a highly promising solution for building Cognitive Autonomous Networks (CAN) of core side slices for upcoming Beyond 5G (B5G) and 6G in both cloud and edge deployments.  © 2004-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7}
}

@CONFERENCE{Narayanan202410326,
	author = {Narayanan, Aditya and Kasibhatla, Pranav and Choi, Minkyu and Li, Po-Han and Zhao, Ruihan and Chinchali, Sandeep},
	title = {PEERNet: An End-to-End Profiling Tool for Real-Time Networked Robotic Systems},
	year = {2024},
	journal = {IEEE International Conference on Intelligent Robots and Systems},
	pages = {10326 - 10333},
	doi = {10.1109/IROS58592.2024.10801747},
	url = {https://www.scopus.com/pages/publications/85216444627?origin=resultslist},
	abstract = {Networked robotic systems balance compute, power, and latency constraints in applications such as self-driving vehicles, drone swarms, and teleoperated surgery. A core problem in this domain is deciding when to offload a computationally expensive task to the cloud, a remote server, at the cost of communication latency. Task offloading algorithms often rely on precise knowledge of system-specific performance metrics, such as sensor data rates, network bandwidth, and machine learning model latency. While these metrics can be modeled during system design, uncertainties in connection quality, server load, and hardware conditions introduce real-time performance variations, hindering overall performance. We introduce PEERNet, an end-to-end and real-time profiling tool for cloud robotics. PEERNet enables performance monitoring on heterogeneous hardware through targeted yet adaptive profiling of system components such as sensors, networks, deep-learning pipelines, and devices. We showcase PEERNet's capabilities through networked robotics tasks, such as image-based teleoperation of a Franka Emika Panda arm and querying vision language models using an Nvidia Jetson Orin. PEERNet reveals non-intuitive behavior in robotic systems, such as asymmetric network transmission and bimodal language model output. Our evaluation underscores the effectiveness and importance of benchmarking in networked robotics, demonstrating PEERNet's adaptability. Our code is open-source and available at github.com/UTAustin-SwarmLab/PEERNet. © 2024 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Green Open Access}
}

