@CONFERENCE{Venkata Charan Kumar20261637,
	author = {Venkata Charan Kumar, B. and Ayesha Anjum, S. and Kavitha, R. and Swathi, R. and Falak Naaz, S. and Gouse Basha, M.},
	title = {TerraSense-AI: An Intelligent Road Surface Irregularity Detection Framework using Multi-Sensor Fusion and AI-based Classification},
