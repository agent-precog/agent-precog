@ARTICLE{Bachoumis2026,
	author = {Bachoumis, A. and Birbas, A. and Machairas, A. and Zacharatos, A. and Tzanis, N. and Birbas, M.},
	title = {Hierarchical inference for efficient and trustworthy automated inspection of electricity grid components},
	year = {2026},
	journal = {IEEE Access},
	pages = {},
	doi = {10.1109/ACCESS.2026.3732452},
	url = {https://www.scopus.com/pages/publications/105050236876?origin=resultslist},
	abstract = {The increasing complexity of electricity grid infrastructure and the growing demand for sustainable energy services necessitate intelligent, cost-efficient inspection systems capable of real-time operation. Traditional cloud-based solutions for automated visual inspection suffer from high latency, high bandwidth consumption, and limited trustworthiness, thereby constraining their applicability to safety-critical maintenance tasks. To address these limitations, this work proposes a Hierarchical Inference (HI) framework for trustworthy and cost- and energy-efficient inspection of grid components, leveraging collaboration across the cloud/edge/far-edge continuum. The proposed system integrates lightweight ondrone models (S-models) with high-capacity edge models (H-models), linked through a confidence-based offloading mechanism that selectively delegates uncertain samples for remote processing. The methodology combines hardware-aware hyperparameter optimization using the AUGRC metric, Flat-Minima Fusion Pretraining (FMFP) for improved calibration, and platform-specific quantization pipelines for deployment on Hailo, Coral, Orca, and STM32MP257F accelerators. Comprehensive evaluation using both analytical benchmarks and the PureEdgeSim simulator demonstrates significant reductions in latency, energy consumption, and data transmission compared to conventional edge-only approaches. Evaluated on the IDID benchmark with S-models deployed on four commercial edge accelerators and a Jetson-hosted H-model, and with system-level behaviour obtained from a simulation of up to ten drones over a 2 km urban area served by 5G base stations at their registered coordinates, with per-task latency budgets between 55 and 100 ms and offloaded frames averaging 118 KB, the results show that a 1% increase in the confidence threshold can trigger over 10% more data offloading while maintaining over 97% cooperative accuracy, confirming that the proposed HI paradigm delivers trustworthy, low-latency and energy-efficient AI-based inspection for next-generation electricity grid maintenance. © 2013 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
