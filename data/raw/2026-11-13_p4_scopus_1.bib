@CONFERENCE{Rao20251693,
	author = {Rao, Aadarsh},
	title = {Eyeris: Machine Learning Powered Glasses for the Visually Impaired},
	year = {2025},
	journal = {UbiComp Companion 2025 - Companion of the 2025 ACM International Joint Conference on Pervasive and Ubiquitous Computing},
	pages = {1693 - 1696},
