@ARTICLE{Li2026,
	author = {Li, Xuchun and Yu, Zhiwu and Yang, Deyong and Liang, Zhenwei},
	title = {From Passive Redundancy to Active Perception: A Comprehensive Review of AI-Enhanced Fault Diagnosis and Digital Twin Simulation for Combine Harvesters},
	year = {2026},
	journal = {Applied Sciences (Switzerland)},
