	abstract = {Indoor Air Quality (IAQ) in educational environments is governed by complex multi-pollutant dynamics and human-occupancy-driven factors that conventional Air Quality Index (AQI) formulations, which report only the maximum single-pollutant sub-index max(I<sub>P</sub>), are fundamentally unable to represent adequately. This paper presents AirGeniusEdu, a fully deployed, four-tier Internet of Things (IoT) system spanning a multi-sensor edge node (Tier 1: perception), wireless connectivity to a cloud database (Tier 2: network, 99.7% uplink reliability across 7,179/7,200 scheduled transmissions), on-device fuzzy inference (Tier 3: edge intelligence, <120 ms end-to-end latency per epoch), and MQTT-actuated cloud services (Tier 4: application/ actuation) that together realize a complete sense–connect– infer–actuate IoT loop for real-time, occupancy-aware Indoor Air Quality Index (IAQI) estimation. The system contributes three innovations. First, a data-driven, reproducible antecedent-selection methodology grounded in Spearman rank correlation between five pollutants (PM<sub>10</sub>, CO, NO<sub>2</sub>, CO<sub>2</sub>, VOC) and real-time occupancy (|r| > 0.41), rather than expert-defined heuristics. Second, a hybrid Mamdani–Takagi-Sugeno fuzzy inference engine, driven by real-time, privacy-preserving occupancy counts from an ondevice TensorFlow Lite camera model (47 ms/frame, no image data transmitted), and fused via a pessimistic minimum operator, IAQI<sub>Eff</sub> = min(IAQI<sub>Mamdani</sub>, IAQI<sub>Sugeno</sub>), grounded in Dubois– Prade possibility theory. Third, empirical validation over five continuous days under four controlled classroom conditions (varying AC state, ventilation, and occupant density), on 24 independent test samples, demonstrating that the minimum-fusion strategy achieves the highest classification accuracy (66.7%) and lowest false-positive rate (34.8%) among three fusion strategies tested, while preserving a perfect recall of 1.000 (zero missed hazardous events) — reducing unnecessary HVAC actuation by an estimated 33% relative to maximum fusion without compromising occupant safety. Critically, during AC-on/closed/occupied conditions, the standard CPCB AQI reported “Satisfactory” (94) while CO<sub>2</sub> simultaneously reached 4,924 ppm; AirGeniusEdu correctly classified this condition as Unhealthy/Harmful, demonstrating a safety-relevant blind spot in regulatory single-pollutant indices that occupancy-aware, edge-deployed multi-pollutant fusion directly resolves. These results establish AirGeniusEdu as a robust, interpretable, and IoT-native occupancy-aware IAQ assessment solution suitable for educational institutions and similar built environments. © 2014 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Altayeva2026,
	author = {Altayeva, Aigerim and Omarov, Nurzhan},
	title = {A lightweight CNN–transformer hybrid architecture with channel attention for real-time hazardous acoustic event detection},
	year = {2026},
