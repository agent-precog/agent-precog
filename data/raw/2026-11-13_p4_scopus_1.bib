	abstract = {Martial arts training is a high-impact activity that motivates secure, real-time Digital Twin operation within next-generation 6G healthcare networks. This article uses impact-safe martial arts training as a representative scenario and frames each athlete as a continuously updated Digital Twin whose biomechanical and vital-sign state is synchronized from multi-modal wearables and smart protective gear over ultra-reliable low-latency 6G links to nearby multi-access edge computing (MEC) nodes. Unlike conventional real-time analytics pipelines that process isolated event streams, the proposed Digital Twin maintains a persistent, stateful representation of cumulative load, modality context, and identity-bound safety envelopes, enabling longitudinal reasoning and cross-session safety validation beyond single-event inference. By distributing sensing, twin-state execution, and analytics across devices, edge servers, and the cloud/clinic layer, the system delivers millisecond-scale risk assessment and safety feedback while keeping sensitive health data as local as possible. Beyond simple on-device storage, the framework formalizes explicit trust boundaries for twin read/write operations and federated update governance, providing structured privacy assurance rather than ad hoc data locality. The article provides a tutorial walkthrough of a standards-based architecture that maps this Digital Twin workflow to IMT-2030 and 3GPP 5G–6G service capabilities, ETSI MEC platforms and APIs, secure transport and identity mechanisms, and healthcare data and device interoperability standards, with an explicit trust boundary for twin read/write operations. We further discuss privacy-preserving federated and incremental learning across multiple training centers, emphasizing security against update manipulation and leakage, and show how AI-driven resource allocation and task scheduling at the edge supports predictable latency and reliability under safety constraints. Benchmarking considerations, deployment patterns, and best practices are summarized, followed by an open standardization roadmap highlighting gaps in Digital Twin threat modeling, identity and access control, AI governance and provenance, inter-edge interoperability, privacy assurance, and safety validation for certifiable 6G Digital Twin healthcare deployments. © 2017 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Yadavalli202645,
