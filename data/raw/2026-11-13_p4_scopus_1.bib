	title = {Reinforcement-Enhanced LLM-based Intelligent Robotics Programming for Autonomous Industrial Automation Systems},
	year = {2026},
	journal = {7th International Conference on Inventive Research in Computing Applications, ICIRCA 2026 - Proceedings},
