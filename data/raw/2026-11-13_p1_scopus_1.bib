@CONFERENCE{Ricci2026,
	author = {Ricci, Marco and Accorsi, Riccardo and Battarra, Ilaria and Ferrari, Emilio and Manzini, Riccardo},
	title = {MAPF in Four-Way Shuttle-Based Storage and Retrieval Systems Subject to High Storage Density},
	year = {2026},
	journal = {Proceedings of the Summer School Francesco Turco},
	pages = {},
	url = {https://www.scopus.com/pages/publications/105055661555?origin=resultslist},
	abstract = {Four-way shuttle-based storage and retrieval systems (FSS/RS) rely on multiple shuttles that move simultaneously within dense warehouse layouts. This creates a multi-agent routing problem, where the system must assign collision-free paths while preserving operational efficiency. Multi-Agent Path Finding (MAPF) algorithms provide a suitable framework for this problem. However, most benchmark studies evaluate MAPF algorithms in open grids or simplified warehouse-like layouts, without explicitly considering important system features, such as storage density. This paper investigates the application of MAPF algorithms to FSS/RS environments under different storage density. The study adopts Conflict-Based Search (CBS) and adapts it to the industrial storage context of an FSS/RS, through a lifelong, pick-up and delivery, and inventory-aware formulation. A multi-scenario and multi-iteration analysis evaluates the impact of storage density on both operational and computational performance. A representative numerical example demonstrates the application of the proposed framework. The case study considers a realistic FSS/RS environment and evaluates five storage density levels, from 50% to 90%. The results show a clear trade-off. Higher density reduces travel distances because target positions become closer to lane entrances. However, it also increases congestion and conflicts among shuttles. This raises computational effort and eventually degrades operational performance. The analysis shows that realistic warehouse conditions strongly affect MAPF behavior and must be included when evaluating routing algorithms for industrial storage systems. © 2026, AIDI-Italian Association of Industrial Operations Professors. ALl rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

