@ARTICLE{Peykani202613163,
	author = {Peykani, Pejman and Ghanidel, Sanly and Javadi-Sisi, Iman and Snasel, Vaclav and Mirjalili, Seyedali},
	title = {A Holistic Review of Agentic AI Frameworks, Applications, and Research Trajectories},
	year = {2026},
	journal = {Archives of Computational Methods in Engineering},
