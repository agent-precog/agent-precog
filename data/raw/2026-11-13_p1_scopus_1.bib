@CONFERENCE{Li20251259,
	author = {Li, Daoheng and Zhang, Qingqi and Ma, Yue and Miao, Shu and Li, Xiang and Song, Shiji},
	title = {Multi-robot Collision Avoidance in Non-communication Deep-Sea Environments via Reinforcement Learning},
	year = {2025},
