	doi = {10.1109/TSG.2026.3698094},
	url = {https://www.scopus.com/pages/publications/105040383426?origin=resultslist},
	abstract = {Ice storms and rapidly growing EV charging demand create coupled challenges for post-disaster restoration of distribution systems (DSs). Most existing restoration schemes optimize either the time dimension (e.g., crew/task scheduling) or the load dimension (e.g., restored demand) in isolation, while rarely coordinating heterogeneous agents such as de-icing robots (DRs), repair crews (RCs), mobile charging suppliers (MCSs), mobile energy storage systems (MESSs), and mobile emergency generators (MEGs) within one recovery process. To address this gap, this paper proposes a three-stage time-load joint optimization framework that organizes de-icing, repair, EV service, and mobile power support into one coordinated recovery chain. Stage I co-schedules DRs and RCs on a time-expanded network to accelerate structural restoration under safety and energization logic. Stage II dispatches MCS fleets through a tri-objective model that balances supplier operating cost, soft time-window based EV service satisfaction, and voltage-resilience deviation. Stage III coordinates MESSs and MEGs for radial-island restoration of fixed critical loads and residual EV demand. Rather than simply concatenating multiple restoration tasks, the proposed framework explicitly links the three stages through restoration-state transfer. In this way, structural recovery, EV mobile-load restoration, and islanded load pickup are coordinated to jointly improve restoration speed and restored load level in EV-rich disaster-affected DSs.  © 2010 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Atasever202720,
	author = {Atasever, Merve and Hong, Matthew and Kulkarni, Mihir Nitin and Li, Qingpei and Deshmukh, Jyotirmoy V},
	title = {Multi-agent Path Finding via Offline RL and LLM Collaboration},
