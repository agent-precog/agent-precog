	doi = {10.1109/ACCESS.2026.3744370},
	url = {https://www.scopus.com/pages/publications/105054318962?origin=resultslist},
	abstract = {Leveraging its flexibility and scalability, decentralized reinforcement learning (RL) has been widely applied to multi-agent path finding (MAPF). However, existing methods often exhibit a decline in success rate as agent density increases. For example, agents that reach their goals early may remain there and block other agents. To maintain a high success rate as the number of agents grows, we propose Learning to Yield for Decentralized MAPF in Congested Environments (LYCO), a decentralized policy that explicitly learns localized yielding behaviors. LYCO is trained by imitation learning from Priority Inheritance with Backtracking (PIBT), a lightweight heuristic solver, and adds two components that promote yielding: (i) an observation channel encoding the estimated next positions of higher-priority neighboring agents, and (ii) a local cooperative reward that discourages waiting at a goal unless nearby agents have also reached theirs. Crucially, PIBT serves only as a source of imitation targets during training; during both RL training and inference, each agent selects actions solely from its local observations using the learned policy. LYCO thus maintains decentralized action selection without performing priority inheritance or backtracking at inference time. In grid-world settings, LYCO consistently outperformed representative decentralized RL baselines in high-density environments, achieving a success rate above 0.7 at an agent density of 0.3 on a 20 × 20 map with obstacle density 0.1 while maintaining a competitive makespan. These findings show that LYCO is an effective decentralized approach for congested MAPF. © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@BOOK{Pavan202638,
	author = {Pavan, Kumar M.R. and Cengiz, Korhan},
	title = {Mechanically Grounded Optimization Framework for Enhanced Robotic Design and Performance},
