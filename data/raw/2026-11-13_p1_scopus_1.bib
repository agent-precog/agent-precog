@ARTICLE{Hijazi2026,
	author = {Hijazi, Amer A. and Alashwal, Ali and Baghalzadeh Shishehgarkhaneh, Milad and Calheiros, Rodrigo N. and Das, Priyadarshini and Sabet, Pejman},
	title = {Agentic AI in Construction: A Systematic Review and Human-Governed Framework for Autonomous Project Delivery},
