@ARTICLE{Liu20264477,
	author = {Liu, Weiming and Wang, Guodong and Wang, Xiangyu},
	title = {Modular Formation Control for Multi-Mobile Robots with Collision Avoidance and Communication Maintenance},
	year = {2026},
	journal = {IEEE Transactions on Automation Science and Engineering},
	volume = {23},
	pages = {4477 - 4487},
	doi = {10.1109/TASE.2026.3658948},
	url = {https://www.scopus.com/pages/publications/105029053399?origin=resultslist},
	abstract = {To further improve the safety and reliability of multi-mobile robot systems, this paper investigates the formation control problem with considerations of collision avoidance, communication maintenance and robots' actuator bias faults. A novel modular formation control scheme, which consists of two modules, is established. In Module I, a formation signal generator is constructed based on graph theory, acting as a virtual multi-agent system through a network of double-integrator dynamic nodes. The outputs of the virtual multi-agent system (i.e., the generator) are designed to asymptotically form the desired formation shape while satisfying some designed specific constraints. Then, in Module II, extended-state observers (ESOs) are firstly employed to estimate and compensate for the actuator bias faults. After embedding the corresponding node within each robot and taking its outputs as formation References, some constrained ESO-based tracking controllers are designed based on backstepping method. In general, the proposed modular formation control integrates collision avoidance, connectivity maintenance and fault-tolerant functions, while realizing the desired formation shape with bounded convergence of formation errors. Simulations and experiments demonstrate the effectiveness of the proposed modular formation control scheme. Note to Practitioners - This paper is motivated by improving the safety and reliability for formation control of practical multi-mobile robot systems while simultaneously considering collision avoidance, communication maintenance and robots' actuator bias faults. Departing from the conventional approaches, this paper presents a modular concise design inspired by embedded control techniques, relatively 'decoupling' the dynamic formation process into the coordination part (i.e., formation signal generator design) and individual regulation part (i.e., robots' tracking controllers design). Firstly, a formation signal generator is designed to generate several real-time constrained formation references for all robots. The generator is manifested as a virtual double-integrator multi-agent system, which does not involve the real robots' model information. For engineers, there remains design simplicity and actual debugging convenience for them to directly deploy a virtual generator when they confront such complex multi-functional coordination control problems for multi-mobile robot systems. Secondly, some constrained ESO-based tracking controllers are designed to make each robot track its corresponding formation reference, further achieving the fault-tolerant formation function without disrupting multi-mobile robot coordination, thereby showing more flexibility and strong versatility. Under this scheme, robots can complete the formation control goals simply by applying some basic tracking controllers, which offers great practical flexibility. Combining the above design, the desired formation can be realized both collision avoidance and communication maintenance by constraining formation references of the generator and robots' tracking errors. Theoretical stability analysis, numerical simulations and experiments of proposed scheme are all given. © 2004-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

