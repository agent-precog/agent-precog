@ARTICLE{Bishnoi20267516,
	author = {Bishnoi, Tanmay and Laha, Riddhiman and Low, Tobias and Chandy, Jose Alex and Figueredo, Luis F. C. and Haddadin, Sami},
	title = {G-MAPP: GPU-Accelerated Multi-Agent Planning and Perception for Reactive Motion Generation},
	year = {2026},
	journal = {IEEE Robotics and Automation Letters},
	volume = {11},
	number = {6},
	pages = {7516 - 7523},
	doi = {10.1109/LRA.2026.3678839},
	url = {https://www.scopus.com/pages/publications/105035175956?origin=resultslist},
	abstract = {Reactive motion generation in unstructured environments remains an open challenge in robotics. Due to the computational complexity of collision-free motion generation, existing methods either generate global trajectories for static scenarios, or employ models that make conservative assumptions about the environment. This paper identifies the primary bottleneck as the runtime performance demand of planning on high-fidelity environments, and the temporal integration between the perception and planning modules. Therefore, we propose a framework that does not compromise on runtime performance and world representations for perception and planning by accelerating world modeling and vector-field based planning using the GPU. This allows us to achieve faster parallel state exploration for quasi-global trajectory planning, and tighter coupling of the perception-action loop in real-time for dynamic cluttered environments with off-the-shelf depth sensors. We quantitatively evaluate the computation-time and success rate differences for the CPU and GPU versions of our planner, and perform qualitative evaluations of our coupled framework using real-world experiments on a 7-DoF Franka Emika robot. Experimental results demonstrate that our GPU-based framework achieves up to a 5x speedup over the CPU in non-trivial scenes.  © 2026 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

@ARTICLE{Patil2026,
	author = {Patil, Rajesh and Löfstrand, Magnus},
	title = {A Safety-Constrained Multi-Objective Optimization Framework for Autonomous Mining Systems: Statistical Validation in Surface and Underground Environments},
	year = {2026},
	journal = {Technologies},
	volume = {14},
	number = {5},
	pages = {},
	doi = {10.3390/technologies14050248},
	url = {https://www.scopus.com/pages/publications/105040052199?origin=resultslist},
	abstract = {The incorporation of artificial intelligence, multi-sensor perception, and cyber-physical control into mining operations offers tremendous opportunities for increasing productivity, safety, and sustainability. However, present frameworks focus on discrete subsystems rather than providing a unified, safety-constrained optimization method that has been verified in both surface and underground environments. This paper describes a scalable, hierarchical autonomous mining architecture that incorporates sensor fusion, edge intelligence, fleet coordination, and digital twin-based decision support. It is designed to operate in GNSS-denied conditions and extreme climatic constraints common to Nordic mining environments. A mathematical modeling approach formalizes vehicle dynamics, drilling mechanics, and multi-agent fleet coordination inside a safety-constrained multi-objective optimization formulation. The framework is validated using Monte Carlo simulation with uncertainty measurement, sensitivity analysis, and statistical hypothesis testing. The preliminary results show improvements over a typical baseline, with productivity increasing by approximately 24.3% ± 3.2%, energy consumption decreasing by 12.8% ± 2.5%, and safety risk decreasing by 48.6% ± 4.1%. A sensitivity study identifies localization accuracy, communication delay, and optimization weighting as the primary system performance drivers. The suggested framework serves as a reproducible and transferable reference model for next-generation intelligent mining systems, having direct applications to both industrial deployment and future research in autonomous resource extraction. © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Mi2026,
	author = {Mi, Jian and Peng, Junzeng and Ding, Shiyao and Deng, Shejun and Wang, Jun and Long, Zhongjie and Xu, Wei},
	title = {A safe horizon path planning algorithm for multi-robot vehicles with unknown human motions},
	year = {2026},
	journal = {Knowledge-Based Systems},
	volume = {337},
	pages = {},
	doi = {10.1016/j.knosys.2026.115413},
	url = {https://www.scopus.com/pages/publications/105029371954?origin=resultslist},
	abstract = {Various approaches have been studied to solve multi-robot pathfinding problem in warehouses and automatic factories. However, it remains challenging in dynamic environments. This paper addresses the pathfinding problem for multi-robot vehicles with unknown human motions. A decentralized safe horizon path planning algorithm is proposed to generate a safe path plan without prior knowledge of human movements, in which a two-level based safe horizon Monte Carlo Tree Search (SHMCTS) algorithm is developed. The low-level is distributed on each robot vehicle to compute self-interested path candidates; the high-level is for conflict solving and optimization. SHMCTS employs a breadth-first-based full search path candidates generation mechanism for each agent producing multiple paths to enhance robustness against environmental uncertainties. Furthermore, SHMCTS introduces a novel five-phase learning framework. Unlike classic MCTS, a new tree-growing mechanism is developed for reducing computational cost by growing the search tree with a given safe horizon T. In addition, a hard-constraints based conflict solving phase is proposed to strengthen path safety. It focuses on solving conflicts at the planning level in two phases, within and beyond horizon T. We verify SHMCTS through comparative simulations involving safety investigations on T, agent number, and human number. Simulation results show the effectiveness of SHMCTS in maintaining the safety while achieving a high task success rate compared to the classic approaches. SHMCTS theoretically ensures that no conflicts occur between agents in the generated plan; and no conflicts occur between an agent and a human within safe horizon T=5. © 2026 Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Zhou2027,
	author = {Zhou, Kaiqing and Fan, Jianliang and Yu, Moduo and Yu, Jun and Fan, Qinqin},
	title = {A simplified task-assisted multi-objective genetic algorithm for large-scale maritime patrolling using multiple unmanned aerial vehicles},
	year = {2027},
	journal = {Expert Systems with Applications},
	volume = {333},
	pages = {},
	doi = {10.1016/j.eswa.2026.134253},
	url = {https://www.scopus.com/pages/publications/105049450918?origin=resultslist},
	abstract = {Maritime safety has become increasingly critical with the increasing size of transportation vessels and the growing importance of maritime trade. Unmanned aerial vehicle (UAV)-based maritime patrols have proven to be an effective method for accident prevention and anomaly detection. However, their performance remains limited in complex and large-scale task environments. To alleviate the above issue, the present study proposes a simplified task-assisted non-dominated sorting genetic algorithm II (ST-NSGA-II) to achieve the trade-off between patrol cost and efficiency for UAV fleets in designated maritime regions. In the ST-NSGA-II, the main task (i.e., the original multi-objective multi-UAV maritime patrol problem, MO-MUAV-MPP) and the simplified task (i.e., MO-MUAV-MPP without angle optimization) are considered simultaneously. For the main task optimization, the NSGA-II with a tangent-based path planning method is developed to generate high-quality patrol schemes. The simplified task is addressed via the NSGA-II combined with the deep reinforcement learning (DRL) and the large neighborhood search (LNS). Additionally, the knowledge transfer between the main task and the simplified task is implemented collaboratively to improve the search performance. Experiments are conducted on 18 simulated maritime scenarios and three geographically based case studies, with comparisons against four state-of-the-art algorithms. The achieved results demonstrate that the proposed ST-NSGA-II consistently outperforms the selected algorithms in terms of the hypervolume (HV) metric. The primary contribution of the current study is to propose an effective and efficient multi-objective UAV task planning method for providing diverse and high-quality UAV maritime patrol schemes, while improving the maritime safety. © 2026 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Kim2026,
	author = {Kim, Min-Jae},
	title = {A Pigouvian Policy Framework for Urban Logistics: Decision-Maker Alignment and Integrated Pricing-Incentive Design},
	year = {2026},
	journal = {Sustainability (Switzerland)},
	volume = {18},
	number = {13},
	pages = {},
	doi = {10.3390/su18136524},
	url = {https://www.scopus.com/pages/publications/105045228756?origin=resultslist},
	abstract = {Urban logistics supports retail, public services, healthcare, construction, and household consumption, but delivery decisions often fail to account for the social costs imposed on congested roads, curbside space, air quality, noise exposure, safety, and public-space use. This study addresses the decision-maker mismatch that arises when the vehicle operator physically generates an externality while receivers, shippers, platforms, building managers, or consumers control delivery timing, shipment fragmentation, service level, fleet choice, and receiving conditions. It develops a Pigouvian policy framework that integrates dynamic road-user charging, curbside pricing, emission-based instruments, off-hour delivery incentives, clean-vehicle support, consolidation incentives, and revenue recycling. The study combines a structured narrative synthesis, decision-maker mapping, an illustrative Korean urban logistics scenario, cost–benefit comparison, and deterministic sensitivity screening. Under the stated scenario assumptions, a carrier-only peak charge reduces monetized daily external costs by only 1.3%, whereas a combined road-and-curbside package reduces them by 12.5%, and an integrated Pigouvian package reduces them by 23.6%. Sensitivity results preserve this ranking. The paper contributes a transferable policy design architecture for internalizing urban logistics externalities while maintaining freight functionality and stakeholder acceptability. © 2026 by the author.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@CONFERENCE{Arvind20261890,
	author = {Arvind, Ananya and Narayanan, Shruthi Sathya and Narayanan, Saishriya Sathya},
	title = {Sura.ai: Multi-Agent Infrastructure Recovery with LLM-Powered Autonomous Remediation},
	year = {2026},
	journal = {International Conference on Agents and Artificial Intelligence},
	volume = {2},
	pages = {1890 - 1899},
	doi = {10.5220/0014456800004052},
	url = {https://www.scopus.com/pages/publications/105041749158?origin=resultslist},
	abstract = {Infrastructure failures like the 2024 CrowdStrike incident in July demonstrate the critical need for autonomous recovery systems that can detect, diagnose, and remediate outages without the dependency on human intervention. We present Sura.ai, a multi-agent system using four cooperating Fetch.ai uAgents orchestrated via the Agentverse Mailbox to provide autonomous infrastructure recovery. Our system integrates LLM-powered root cause analysis through Claude Sonnet 3.5, enabling intelligent decision-making beyond simple rule-based automation. We conducted comprehensive testing across four disaster scenarios including simulated faulty updates, CPU spikes, and cascading failures. Sura.ai achieved a 97.6% action success rate (41/42 incidents resolved) with intelligent alert deduplication across all tested scenarios. Our work demonstrates the feasibility of LLM-based multi-agent orchestration for critical infrastructure resilience and introduces practical patterns for AgentOps implementation in the growing agentic cybersecurity space. © 2026, Science and Technology Publications, Lda. All rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Rodríguez2027183,
	author = {Rodríguez, María Eugenia and Breuil, Fanny and Lara, Antoni and Vendrell, Míriam},
	title = {Accelerating Zero-Emission Urban Logistics Through User-Centric eLCV Innovation: The Shift2Zero Project},
	year = {2027},
	journal = {Lecture Notes in Mobility},
	volume = {Part F2764},
	pages = {183 - 190},
	doi = {10.1007/978-3-032-37207-9_22},
	url = {https://www.scopus.com/pages/publications/105055356912?origin=resultslist},
	abstract = {Urban logistics is at a critical crossroads, with decarbonisation urgently needed to meet European Union climate targets. The Shift2Zero project aims to accelerate the uptake of electric light commercial vehicles (eLCVs) by delivering six user-driven, mission-specific N1 eLCV concepts designed for diverse logistics scenarios. Building on proven IVECO e-Daily and Alkè ATX platforms, the project integrates energy-efficient technologies and leverages modularity, geofencing, and ergonomic design to meet evolving urban needs. The project’s impact is significant: through co-development with logistics operators, fleet managers, and policymakers, Shift2Zero aims to reduce CO<sub>2</sub> emissions by 1–3% at project level, decrease operational costs by 10%, and enhance safety, thus increase eLCV adoption by tackling operational and economic barriers. Each single Shift2Zero vehicle aims at replacing 3 traditional N1 vehicles. Innovative features such as multi-temperature cargo bodies, swappable transshipment units, and dual-use passenger/goods vehicles enable scalable, future-proof solutions. Validation takes place via four pilots and one macro-pilot across six European cities, covering varied urban conditions to ensure transferability. Shift2Zero delivers not just vehicles, but a replicable model for sustainable urban transport. By aligning technical innovation with real-world logistics challenges paves the way for resilient, zero-emission urban mobility, positioning Europe at the forefront of green logistics transformation. © The Author(s) 2027.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Wang2026,
	author = {Wang, Jingwen and Feofilova, Anastasia and Wang, Yadong and Jiang, Jixiao and Shao, Mengru},
	title = {Simulation-Based Safety Evaluation of Mixed Traffic with Autonomous Vehicles in Seaports},
	year = {2026},
	journal = {Journal of Marine Science and Engineering},
	volume = {14},
	number = {8},
	pages = {},
	doi = {10.3390/jmse14080739},
	url = {https://www.scopus.com/pages/publications/105037220714?origin=resultslist},
	abstract = {The increasing deployment of autonomous vehicles in port logistics requires safety assessment methods that remain valid in mixed traffic environments. This study evaluates the safety of mixed automated guided vehicle (AGV) and human-driven vehicle (HDV) traffic in a seaport terminal connected to an external urban road network. A microscopic traffic model was developed in AIMSUN Next to represent gate areas, internal roads, storage-yard access, berth interfaces, and external container-truck traffic. HDVs were modeled using a Gipps-based car-following model, whereas AGVs were represented through an Adaptive Cruise Control framework. Vehicle trajectories were exported to the Surrogate Safety Assessment Model (SSAM), where Time-to-Collision (TTC) and Post-Encroachment Time (PET) were used to detect and classify conflicts. Six staged fleet-composition scenarios were evaluated in 36 simulation runs, ranging from fully human-driven operation to full automation. Total conflicts decreased from 89 in the fully human-driven scenario to 43 in the fully automated scenario (−51.7%), while rear-end conflicts decreased from 70 to 30 (−57.1%). Crossing conflicts remained relatively stable across scenarios. At the same time, mean TTC decreased from 0.80 to 0.24 s and mean PET from 1.57 to 0.38 s, indicating tighter but more coordinated interactions under automated control. These results show that automation improves longitudinal safety performance in port traffic, but also that conventional TTC and PET thresholds calibrated for human-driven traffic may not be directly applicable to automated port operations. Automation-sensitive surrogate safety criteria are therefore needed for seaport mixed-traffic evaluation. © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Huertos2026,
	author = {Huertos, Francisco J. and Bañales, Oihane and Alvarez, Pedro and Cabanes, Itziar},
	title = {Multi-Agent Reinforcement Learning for Cooperative Manipulation in Industrial Robotics: A Systematic Review of Trends, Gaps and Research Drivers},
	year = {2026},
	journal = {Robotics},
	volume = {15},
	number = {8},
	pages = {},
	doi = {10.3390/robotics15080156},
	url = {https://www.scopus.com/pages/publications/105048583124?origin=resultslist},
	abstract = {Modern manufacturing faces increasing demands for flexibility, customization, and productivity under dynamic conditions. Multi-robot systems offer a promising solution by enabling cooperative execution of complex tasks, such as assembly and cooperative manipulation. In this context, Multi-Agent Reinforcement Learning (MARL) has emerged as a promising paradigm to enhance coordination and adaptability in industrial settings. MARL enables multiple agents to learn and interact in shared environments to achieve common goals within complex and dynamic industrial processes. In this paper, a deep analysis of MARL applied to industrial multi-robot systems based on a systematic review is presented, with particular focus on cooperative manipulation tasks. Following PRISMA guidelines, we analyze a total of 30 articles published between 2016 and 2026, selected independently by two of the authors from an initial pool of 102 records retrieved from Scopus and Web of Science. These articles were used to address five key questions regarding MARL algorithms, control architectures, industrial applications and validation practices. These research questions seek to examine gaps and trends at the research level which are important for the development of multi-agent control technologies. This review shows a clear prevalence of model-free algorithms under Centralized Training with Decentralized Execution (CTDE) architectures, with validation mainly performed in simulation. Despite promising results and high potential for impact, critical gaps remain in scalability, reproducibility, and sim-to-real transfer, limiting real deployment in manufacturing environments. To address these challenges and fill current gaps, we outline actionable research directions, such as hybrid MARL approaches, standardized industrial benchmarks, digital twin pipelines, and safety-aware deployment strategies, to accelerate MARL adoption in industrial environments. © 2026 by the authors.},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Safiullin2027930,
	author = {Safiullin, R.N. and Sorvanov, A.V. and Prysyazhnyuk, M.S. and Safiullin, R.R. and Zalyubovskiy, A.F.},
	title = {A Comprehensive Methodology for the Integrated Assessment of Road Safety of Transport and Technological Vehicles Based on Fuzzy Logic},
	year = {2027},
	journal = {International Journal of Engineering, Transactions A: Basics},
	volume = {40},
	number = {4},
	pages = {930 - 943},
	doi = {10.5829/ije.2027.40.04a.02},
	url = {https://www.scopus.com/pages/publications/105048725004?origin=resultslist},
	abstract = {In conditions of increasing complexity and intensity of transportation systems, ensuring road safety requires a transition to proactive and predictive methods of integral risk management. In this work a hierarchical model based on fuzzy logic has been developed to assess the safety of vehicle fleets by aggregating heterogeneous real-time data. To implement a comprehensive assessment, an algorithm has been proposed that performs automated multi-criteria analysis by merging key safety indicators related to technical condition, driver behavior, and operational factors. This algorithm calculates an integrated safety assessment, ranks carriers by risk level, and identifies potential violations. A method of adaptive membership functions has been applied to handle uncertainty and qualitative parameters. A verification study was conducted on theoretical cases covering a range of operational scenarios. A software solution — a Python module for fuzzy inference and visualization has also been implemented, expanding the capabilities of intelligent transportation systems. The results demonstrate that the developed system correctly ranks transport enterprises by risk level. Verification on five theoretical cases (TK1-TK5) confirmed the model's ability to generate an Integrated Safety Assessment (ISA) from 0 to 1, effectively distinguishing between exemplary compliance and systematic critical violations. For instance, a critically problematic scenario (TK4) received a low ISA of 0.34, signaling the need for immediate intervention, while a case with systematic violations (TK5) scored 0.55, near the predefined acceptability threshold of 0.5. ©2027 The author(s). This is an open access article distributed under the terms of the Creative Commons Attribution (CC BY 4.0), which permits unrestricted use, distribution, and reproduction in any medium, as long as the original authors and source are cited. No permission is required from the authors or the publishers.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Yoon2026,
	author = {Yoon, Jeonghyeon and Kim, Seungku},
	title = {Collaborative robot location error calibration using range measurements from mobile UWB anchor},
	year = {2026},
	journal = {Results in Engineering},
	volume = {30},
	pages = {},
	doi = {10.1016/j.rineng.2026.110567},
	url = {https://www.scopus.com/pages/publications/105036809156?origin=resultslist},
	abstract = {Large-scale multi-robot deployment in smart factories and logistics facilities improves coverage and throughput, but it exposes a critical cost–accuracy trade-off. Equipping every robot with high-end sensors (e.g., LiDAR/vision) can yield accurate SLAM, yet the fleet-wide cost becomes prohibitive. In contrast, low-cost robots are economically scalable, but odometry-driven localization suffers from drift due to floor friction variations, wheel slippage, and sensor noise, degrading efficiency and safety. This study proposes an infrastructure-independent UWB-based collaborative localization error calibration system that suppresses drift while preserving the cost advantage of low-cost fleets. The system adopts a master–slave architecture: a master robot with two UWB transmitters (mobile anchors) shares its pose, and a slave robot measure ranges to the transmitters, estimates its position using a baseline-constrained geometric solution, and fuses it with odometry via an Extended Kalman Filter. Hardware experiments in indoor and outdoor environments demonstrate effectiveness: the method achieved 6.8 cm RMSE indoors (LiDAR: 4.2 cm; camera: 5.6 cm) and reduced the slave error to 2.3 cm RMSE outdoors when RTK-GNSS provided the master reference. The average processing time per calibration was 12.6 ms, confirming real-time feasibility. © 2026 The Authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Ito202733,
	author = {Ito, Masao},
	title = {Anticipatory Mechanisms in Autonomous Vehicles: Architectural Integration from a Microethical Perspective},
	year = {2027},
	journal = {Communications in Computer and Information Science},
	volume = {3136 CCIS},
	pages = {33 - 49},
	doi = {10.1007/978-3-032-36813-3_3},
	url = {https://www.scopus.com/pages/publications/105050772346?origin=resultslist},
	abstract = {Autonomous vehicles (AVs) rely heavily on neural networks, which are probabilistic and cannot fully eliminate edge cases. Existing safety frame-works—ISO 26262, SOTIF (ISO 21448), ISO/IEC TR 5469, and SADRA—address hardware failures, performance limitations, and architectural redundancy, but leave a critical gap: the possibility that the designer’s intent itself may be ethically or structurally inadequate. This paper proposes an Anticipatory Mechanism (AM) as a structural remedy grounded in microethics—ethical reasoning operative in specific, concrete interactions. Placed alongside the Behavior Pre-diction (BP) module in the prediction-and-decision layer, AM interacts with BP to construct scene sets. Unlike BP, which models agent–agent interactions at O(N<sup>2</sup>) complexity, AM operates in O(N) linear time by deliberately omitting interaction modeling, enabling wider spatial coverage and early detection of hazardous multi-agent configurations. Structurally, AM corresponds to the functional safety monitor pattern (C) in the MoI–FSM framework, issuing override signals as speed, acceleration, and trajectory-region constraints compatible with RSS. Its firing conditions are formalized in Lean, which positions the AM specification as part of the independent assessment required by ISO 26262 Part 8. AM also partially fills the gap at Level 2 of Endsley’s situation awareness model. A retrospective analysis of the 2023 Cruise robotaxi incident illustrates how earlier anticipatory deceleration could plausibly have prevented the secondary collision. AM is complementary to RSS and integrable as a behavioral-layer element within safety-case frameworks such as Waymo’s. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2027.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{You20261057,
	author = {You, Ziwoo and Saito, Issei and Nagano, Masatoshi and Nakamura, Tomoaki and Taniguchi, Akira and Taniguchi, Tadahiro},
	title = {Continuous Symbol Emergence via Decentralized Bayesian Inference With Gaussian Processes},
	year = {2026},
	journal = {IEEE Transactions on Cognitive and Developmental Systems},
	volume = {18},
	number = {4},
	pages = {1057 - 1069},
	doi = {10.1109/TCDS.2026.3661019},
	url = {https://www.scopus.com/pages/publications/105029672670?origin=resultslist},
	abstract = {Real-world communicative signals—such as gestures, vocalizations, and facial expressions—are inherently continuous and subtle. Research on emergent communication has been advanced as a constructive approach to elucidate the emergence of symbol systems enabling communication among agents through interactions mediated by physical signals, namely, signs. However, research on emergent communication using decentralized Bayesian inference has predominantly relied on discrete symbolic representations, struggling to capture inherent subtleties. To address this limitation, we propose a probabilistic framework called multimodal Gaussian process (GP) emergent communication (MGPEmCom), which enables the emergence of continuous symbols among decentralized agents. This framework integrates GP latent variable models (GPLVMs) to describe multimodal sensory observations and employs the Metropolis–Hastings naming game (MHNG) for decentralized inference, allowing agents to jointly infer shared continuous signs without accessing one another’s internal states. We validate our approach with a referential game task in which a speaker uses an emergent continuous symbol to communicate a target object to a listener. Experimental results demonstrate that MGPEmCom outperforms existing methods, including Inter-MDM and VAE + REINFORCE, particularly in scenarios that require fine-grained distinctions and generalization to unknown objects. These results indicate that our method enables more expressive and generalizable symbol emergence. This work establishes a principled Bayesian approach to decentralized symbol emergence using continuous latent representations, offering a foundation for modeling communication applicable to unknown objects. © 2016 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Wang20261192,
	author = {Wang, Le and Lu, Hongrui and Wang, Tianshuo},
	title = {Research on path following of tug-barge system based on DDPG algorithm},
	year = {2026},
	journal = {Proceedings of the 5th International Conference on Computer, Artificial Intelligence and Control Engineering, CAICE 2026},
	pages = {1192 - 1198},
	doi = {10.1145/3804601.3804784},
	url = {https://www.scopus.com/pages/publications/105040190087?origin=resultslist},
	abstract = {With the continuous deepening of marine development and the steady progress of the shipping industry, the operational demand for tugboat and barge fleets in fields such as port logistics and marine engineering has significantly increased. However, during towing operations, the tug-barge system is susceptible to various factors such as environmental changes, its own nonlinear coupling characteristics, and towline tension constraints, which can lead to deviation from the predetermined route and cause drift issues. To effectively enhance the navigation safety of the tug-barge system and achieve precise path following control objectives, this paper proposes a path following control method for the tug-barge system based on reinforcement learning. Firstly, a mathematical model of the coupled motion of the tug-barge system is constructed. Secondly, combining the line-of-sight guidance algorithm for the tug-barge system, and considering its maneuvering characteristics and path following requirements, a Markov decision model for path following is established. Based on this, a course controller based on the Deep Deterministic Policy Gradient (DDPG) algorithm is designed using a hierarchical control architecture: the top layer generates the desired course command for the barge, while the bottom layer performs tracking control through the tugboat's course controller. Finally, path following control experiments are conducted on the tug-barge system in a simulation environment, and the control effect is quantitatively analyzed. The results show that the average error of the barge is 3.89 meters, and the average course error is 0.37°, verifying the effectiveness of the proposed method. © 2026 Copyright held by the owner/author(s).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Zhou20262950,
	author = {Zhou, Ning and Bode, Nikolai W.F. and Hunt, Edmund R.},
	title = {Multi-Agent Cooperative Transportation: Optimal and Efficient Task Allocation and Path Finding},
	year = {2026},
	journal = {AAMAS 2026 - Proceedings of the 25th International Conference on Autonomous Agents and Multiagent Systems},
	pages = {2950 - 2958},
	doi = {10.65109/WZSB2882},
	url = {https://www.scopus.com/pages/publications/105041462444?origin=resultslist},
	abstract = {Multi-robot systems are integral to modern logistics, but their capabilities are often limited to tasks executable by individual agents. This paper addresses a critical gap in existing frameworks like Multi-Agent Path Finding (MAPF) and Task Allocation and Path Finding (TAPF), which lack true cooperation for transporting large items that require multiple agents. To this end, we formalise the Cooperative Transportation Task Allocation and Path Finding (CT-TAPF) problem, which integrates team formation, task assignment, and collision-free pathfinding. We present an optimal solver, Cooperative Transportation Task Conflict-Based Search (CT-TCBS), which features a novel Incremental Expansion strategy to tackle the combinatorial explosion inherent in team formation. Recognising the computational cost of optimality, we also develop a family of sub-optimal solvers that employ a global, task-centric perspective, selecting the next task to assign based on a global difficulty metric (Best Task or Worst Task). Our comprehensive empirical evaluation demonstrates three key findings: (1) the incremental expansion strategy significantly outperforms the naive combinatorial approach by successfully pruning the dominant task-allocation search space; (2) we identify a task-conflict expansion dilemma, where sophisticated conflict resolvers effective for large-agent pathfinding subproblems can be detrimental in the integrated CT-TAPF setting; and (3) our proposed sub-optimal solvers establish a new, more efficient frontier on the solution quality-runtime spectrum compared to nn-, agent-centric baselines. This work provides a foundational framework and a set of effective algorithms for a new, practical class of cooperative multi-agent problems. © 2026 International Foundation for Autonomous Agents and Multiagent Systems.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

@ARTICLE{Yin2026,
	author = {Yin, Wenzhe and Zhao, Guowei and Pang, Zhibo},
	title = {A deep reinforcement learning based hierarchical obstacle crossing planner for multi-robot cooperative transportation},
