}

@CONFERENCE{Nie2025,
	author = {Nie, Rong and Zhou, Lijun and Jiang, Zhili and Li, Hongmei and Li, Yuejun and Wu, Ling},
	title = {Deep Survival Analysis for Field Failure Prediction With Reporting Delays and Uncertain Retirement},
	year = {2025},
	journal = {2025 IEEE 3rd International Conference on Big Data and Data Mining, BDDM 2025 - Proceedings},
	pages = {},
	doi = {10.1109/BDDM68348.2025.11442049},
	url = {https://www.scopus.com/pages/publications/105037467936?origin=resultslist},
	abstract = {Predicting field failures is central to industrial reliability planning but is complicated by left truncation (monitoring starts after installation), right censoring at a data-freeze point (DFP), discrete recording to a time unit (TU), unknown retirement of unfailed units, and non-negligible reporting delays. Parametric lifetime models (e.g., Weibull) are popular yet constrain the hazard shape. We propose a deep, discrete-time survival framework that: (i) replaces fixed parametric failure-time assumptions with a neural hazard; (ii) encodes, in a single discrete-time log-likelihood, interval-recorded failures (nearest-TU), a known reporting-delay PMF, the observation window (monitoring start to DFP) via an explicit indicator, and a competing retirement process via a domain-informed prior; and (iii) produces point forecasts and prediction intervals for future reports using Poisson-Binomial aggregation that combines process and parameter uncertainty. On an industrial appliance dataset, the proposed model learns a markedly decreasing early-life hazard and forecasts near-zero additional reports for the remaining fleet, whereas a Weibull baseline-under the same retirement prior-forecasts mid-teens reports. We provide batch-level calibration, uncertainty quantification, and an architectural sensitivity analysis. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

