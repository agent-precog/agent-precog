	url = {https://www.scopus.com/pages/publications/105031425325?origin=resultslist},
	abstract = {Despite rapid advances in applying machine-learning techniques to automotive predictive-maintenance and safety systems, several critical research gaps remain. First, the field still lacks standardized, publicly available benchmark datasets and common evaluation protocols, making it difficult to compare algorithms across studies and operating conditions. Second, real-time deployment is hindered by the high computational cost of deep-learning models and by incomplete solutions for fusing heterogeneous, high-volume sensor streams on resource-constrained edge hardware. Third, most current approaches provide limited model interpretability, which hampers industry adoption and regulatory approval; transparent, explainable architectures are therefore an urgent priority. Fourth, existing studies rarely address data imbalance, domain shift, and the diverse environmental scenarios that vehicles encounter in the real world, pointing to a need for robust transfer-learning and continual-learning strategies. Finally, ensuring end-to-end cyber security and functional safety for connected, over-the-air-updatable ML pipelines remains an open challenge. Addressing these gaps will unlock a wide array of high- impact applications. Improved predictive-maintenance models will reduce unplanned downtime for commercial fleets, extend electric-vehicle battery life, and optimize spare-parts logistics. In safety, enhanced perception and decision-making algorithms will bolster advanced driver-assistance functions, driver-state monitoring, and autonomous navigation, thereby lowering accident rates. Beyond the automotive domain, the same real- time fault-prediction frameworks can benefit rail and aviation maintenance, while robust, low-latency perception stacks are directly transferable to mobile robotics, smart-city traffic control, and industrial automation.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

