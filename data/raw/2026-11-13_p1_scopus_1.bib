@BOOK{Palli202570,
	author = {Palli, Srihari and Rallabandi, Sivasankara Raju and Aasa, Samson Abiodun and Praveenkumar, Seepana and Rejeti, Pavankumar and Duppala, Azad and Ibrahim, Abdulsamad},
	title = {Digital Twins in Railway Systems},
	year = {2025},
