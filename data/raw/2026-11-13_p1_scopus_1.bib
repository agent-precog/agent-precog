	title = {Environomics Framework for Sustainable Business Practices: Industrial Case Studies on True Impact Reduction and Process Optimization Through AI},
	year = {2023},
	journal = {Society of Petroleum Engineers - SPE Symposium: Leveraging Artificial Intelligence to Shape the Future of the Energy Industry, AIS 2023},
	pages = {},
