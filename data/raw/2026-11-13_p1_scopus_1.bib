@CONFERENCE{Ma2026,
	author = {Ma, Lizhi and Hu, Yi-Xiang and Ren, Yihui and Wu, Feng and Li, Xiang-Yang},
	title = {LeJOT-AutoML: LLM-Driven Feature Engineering for Job Execution Time Prediction in Databricks Cost Optimization},
	year = {2026},
	journal = {Proceedings - IEEE INFOCOM},
	pages = {},
	doi = {10.1109/INFOCOM59046.2026.11571455},
	url = {https://www.scopus.com/pages/publications/105044521458?origin=resultslist},
	abstract = {Databricks job orchestration systems (e.g., LeJOT) reduce cloud costs by selecting low-priced compute configurations while meeting latency and dependency constraints. Accurate execution-time prediction under heterogeneous instance types and non-stationary runtime conditions is therefore critical. Existing pipelines rely on static, manually engineered features that under-capture runtime effects (e.g., partition pruning, data skew, and shuffle amplification), and predictive signals are scattered across logs, metadata, and job scripts - lengthening update cycles and increasing engineering overhead. We present LeJOT-AutoML, an agent-driven AutoML framework that embeds large language model agents throughout the ML lifecycle. LeJOT-AutoML combines retrieval-augmented generation over a domain knowledge base with a Model Context Protocol toolchain (log parsers, metadata queries, and a read-only SQL sandbox) to analyze job artifacts, synthesize and validate feature-extraction code via safety gates, and train/select predictors. This design materializes runtime-derived features that are difficult to obtain through static analysis alone. On enterprise Databricks workloads, LeJOT-AutoML generates over 200 features and reduces the feature-engineering and evaluation loop from weeks to 20-30 minutes, while maintaining competitive prediction accuracy. Integrated into the LeJOT pipeline, it enables automated continuous model updates and achieves 19.01% cost savings in our deployment setting through improved orchestration. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Schlaefer20261001,
	author = {Schlaefer, Alexander},
	title = {Design and Evaluation of Small Autonomous Sailing Drones},
	year = {2026},
	journal = {IEEE Transactions on Field Robotics},
	volume = {3},
	pages = {1001 - 1016},
	doi = {10.1109/TFR.2026.3741806},
	url = {https://www.scopus.com/pages/publications/105053468041?origin=resultslist},
	abstract = {Autonomous sailing poses a number of challenges, including uncertainty regarding the wind as a means of propulsion, limitations in moving in upwind directions, or stopping. Also, a sailboat not moving through the water can no longer be controlled by its rudder. These limitations are most severe in scenarios where multiple boats have to be coordinated and where collisions with other vessels or obstacles have to be avoided. However, studying methods for autonomous sailing in real-world conditions is often difficult. Although a number of commercial sailing drones are available, they typically operate on open seas and under human supervision. These drones are often rather large, and acquiring, maintaining, and operating the drones are typically costly, making them impractical for research on machine learning or control methods, particularly when considering swarm behavior. Hence, algorithm development is often based on simpler simulations, which neglect the complexity of real wind and wave patterns, and the uncertainty in sensor readings. Obtaining real-world data in the field has also been approached with small sailing drones, typically based on model sailboats. We summarize these approaches and illustrate some limitations that led to the development of a small, fully autonomous sailing drone which is adapted to the purpose of studying a fleet of autonomous drones. The ready-to-sail mono-hull drone has a total length and weight of approximately 0.5 m and 2.3 kg, respectively. In contrast to earlier designs, the drones can carry sufficient onboard computing and a stereo camera and are largely made from 3-D printed parts to facilitate cost-efficient manufacturing of multiple drones. We describe the overall design and basic control approaches, summarize our experience with multiple iterations of drone design, and report results from field tests in different conditions. Our results indicate that the latest version of the drone design sails well in conditions typical for inland waters, i.e., 2 Bft to 4 Bft wind speed and short waves, and that onboard imaging and deep learning-based computer vision are feasible. Hence, the proposed design presents a viable alternative to obtain real-world data and to evaluate control and machine learning methods for autonomous sailing in the field.  © 2024 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

