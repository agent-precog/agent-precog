@ARTICLE{Ferone2026,
	author = {Ferone, Daniele},
	title = {The hazardous team orienteering problem},
	year = {2026},
	journal = {4OR},
	pages = {},
	doi = {10.1007/s10288-026-00625-2},
	url = {https://www.scopus.com/pages/publications/105043221380?origin=resultslist},
	abstract = {This paper presents the Hazardous Team Orienteering Problem (HTOP), an extension of the Hazardous Orienteering Problem designed for multiple vehicles. In HTOP, visiting certain customers exposes the vehicle to a time-dependent risk of catastrophic loss. Each hazardous customer has an associated exponential failure rate, meaning that if an explosion occurs, the entire profit earned from that route is lost. The goal is to maximize the total expected profit collected by a fleet of vehicles while adhering to time constraints and ensuring customer exclusivity. We introduce two solution approaches. First, we develop an exact Branch-and-Price algorithm based on a set-partitioning reformulation, where each column corresponds to a feasible hazardous route valued by its expected profit. Second, we create an Adaptive Large Neighborhood Search (ALNS) metaheuristic tailored to the nonlinear expected-profit structure of the problem. Computational experiments on benchmark instances derived from the existing literature on the Hazardous Orienteering Problem demonstrate that the pricing phase is the main computational bottleneck of the exact approach. Nevertheless, our method successfully solves small and medium-sized instances to optimality. The ALNS consistently generates high-quality solutions in a short amount of time and matches the optimal solutions for single-vehicle benchmarks while showing strong scalability in multi-vehicle scenarios. © The Author(s) 2026.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Şenyürek202668,
	author = {Şenyürek, Levent Hakkı and Çilden, Erkin and Çetintaş, İsmail Çağlar and Büyükgüzel, Batuhan and Demirok, Denizcan and Yeşilbağ, Yaşar Yücel and Sezer, Ahmet and Oğuztüzün, Halit},
	title = {Visual Mission Scripting for Multi-Agent-Based Simulation of Autonomous Platforms},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {15761 LNCS},
	pages = {68 - 81},
	doi = {10.1007/978-3-031-99732-7_5},
	url = {https://www.scopus.com/pages/publications/105019045617?origin=resultslist},
	abstract = {In closed-loop simulations, scripting the missions of autonomous agents before scenario execution is challenging. This is partly because of emergent multi-agent behavior, especially for scenarios of long-duration. Moreover, the users of simulation software are usually non-programmers. This makes traditional scripting a difficult tool for programming multiple agents. Existing solutions -such as scripting languages and visual scripting- mainly stem from the game industry where popular game engines provide tools for programming agent behavior for game developers. Closed-loop simulation autonomy requirements differ in the sense that, a certain autonomy alongside a long or complicated scenario should be defined, which requires a higher-level on top of low-level agent autonomy. Reactive and inherently short-sighted agent programming tools based on state-based automata, such as behavior trees and finite state machines, can fall short for the definition of long-term plans. Moreover, these methods require some learning and adaptation effort for non-programmer users or operators. This paper presents a visual agent planning solution based on Business Process Model and Notation (BPMN). Most end-users are relatively familiar with the proposed visual notations in general. Therefore, the method provides human-readable and easy-to-comprehend conditional agent planning capability. The proposed mission programming approach guides the user to build concurrent and synchronized mission plans for implementing tactical behavior. We also discuss some details about the method and argue that the proposed approach can be promising for autonomous platform programming at the mission level. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Green Open Access}
}

@ARTICLE{Wang2026,
	author = {Wang, Dan and Xu, Gangyan and Wu, Zhizhou and Leng, Junqiang},
	title = {Energy-efficient coordination of mixed truck platoons using multi-agent reinforcement learning},
	year = {2026},
	journal = {Transportation Research Part E: Logistics and Transportation Review},
	pages = {},
	doi = {10.1016/j.tre.2026.105364},
	url = {https://www.scopus.com/pages/publications/105055417358?origin=resultslist},
	abstract = {Energy-efficient truck platooning is an important pathway toward lower-carbon freight transport, yet practical deployment will likely proceed through mixed platoons in which automated trucks operate alongside human-driven trucks. An energy-efficient decentralized multi-agent reinforcement learning framework is developed for coordinating such mixed truck platoons under human-driving uncertainty. The framework integrates freight-truck propulsion energy into the coordination objective, allowing energy reduction to be considered with stable spacing control, speed regulation, smooth motion, and safety preservation. To support cooperation in mixed platoons, a heterogeneity-aware quantized V2V communication scheme is introduced, where cooperative information exchange is organized among connected automated trucks while human-driven trucks remain part of the physical platoon dynamics. Numerical experiments are conducted in catch-up and slowdown scenarios that represent coordination recovery and speed-disturbance response in freight operations. The evaluation further examines how performance changes with automation penetration, automated-truck placement, human-driving behavior, and reaction delay. Results show that the proposed framework improves mixed-platoon coordination and reduces average platoon power with reductions of approximately 20.7% and 20.5% in the two scenarios. The uncertainty analysis indicates that fleet composition, vehicle placement, and human-response quality all shape the operational benefits of mixed platooning, providing guidance for staged automation deployment and mixed-platoon organization. Copyright © 2026. Published by Elsevier Ltd.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Ardizzoni2025,
