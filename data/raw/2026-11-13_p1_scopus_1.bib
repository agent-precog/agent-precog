@ARTICLE{Khoee2026,
	author = {Khoee, Arsham Gholamzadeh and Wang, Shuai and Feldt, Robert and Parthasarathy, Dhasarathy and Yu, Yinan},
	title = {GateLens: A reasoning-enhanced LLM agent for automotive software release analytics},
	year = {2026},
