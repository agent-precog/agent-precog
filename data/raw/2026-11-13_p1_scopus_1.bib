@ARTICLE{Parooei2024401,
	author = {Parooei, Marzie and Tale Masouleh, Mehdi and Kalhor, Ahmad},
	title = {MAP3F: a decentralized approach to multi-agent pathfinding and collision avoidance with scalable 1D, 2D, and 3D feature fusion},
