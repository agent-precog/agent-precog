@CONFERENCE{Santhirasegaram202692,
	author = {Santhirasegaram, Puvikaran and Van Peet, Henrik and Mogensen, Mads Beyer and Bacci, Giovanni and Merritt, Timothy Robert and Albano, Michele},
	title = {Distributed Multi-UAV Partition-Based Patrolling with Fault Tolerance: A Study on Meeting-Based Coordination Strategies},
	year = {2026},
