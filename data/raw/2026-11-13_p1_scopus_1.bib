	pages = {884 - 889},
	doi = {10.1145/3813822.3813966},
	url = {https://www.scopus.com/pages/publications/105050155242?origin=resultslist},
	abstract = {Effective supply chain management under demand and lead-time uncertainties remains a critical challenge for modern enterprises seeking to balance customer service levels with operational costs. Existing approaches suffer from three fundamental limitations: (1) inability to interpret complex natural language planning objectives and orchestrate multi-modal analytical workflows, (2) reliance on deterministic inventory models that inadequately capture stochastic supply-demand dynamics, and (3) lack of integrated frameworks bridging strategic decision-making with operational execution. To address these challenges, we propose LLM-SIO (LLM-Stochastic Inventory Optimization), a comprehensive AI-driven framework that synergistically combines large language model-based intelligent agents with simulation-based stochastic optimization. Our key innovations include: (1) a memory-augmented LLM agent architecture with retrieval-augmented generation for intent-driven task orchestration, (2) a two-stage stochastic programming formulation with Monte Carlo simulation for robust safety stock optimization under dual uncertainties, and (3) a closed-loop validation mechanism integrating offline policy search with online MRP execution. Extensive experiments on a real-world dataset of 127 SKUs demonstrate that LLM-SIO achieves 94.2% service level with 18% cost reduction compared to baseline methods, validating its effectiveness for intelligent supply chain planning. © 2026 Copyright held by the owner/author(s).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

