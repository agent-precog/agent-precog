	pages = {},
	doi = {10.1109/SYNCHROINFO70145.2026.11613420},
	url = {https://www.scopus.com/pages/publications/105046463895?origin=resultslist},
	abstract = {This work addresses the computational limitations of large language model (LLM) agents - specifically static weights and finite context windows - by advancing the hypothesis that LLM agents operating in social networks may exploit graph topology as distributed external memory, with human participants unknowingly functioning as stochastic oracles within emergent optimization processes. The hypothesis is formalized using hypergraph models and information theory and evaluated through systematic Monte Carlo simulations across three algorithms (Particle Swarm Optimization, Genetic Algorithm, Simulated Annealing) and four benchmark functions (Rastrigin, Rosenbrock, Ackley, Sphere), totaling 4, 800 trials (200 per configuration). Low-noise (human-like) feedback consistently outperforms high-noise (LLM-like) feedback: mean improvements range from 38% to 52%, with variance reductions of 68-79% (all p < 0.001, Cohen's d > 1.2). Sensitivity analysis across noise levels sigma in {10, 50, 100} confirms monotonic performance degradation. This work presents a novel reframing of synthetic social networks as distributed computational substrates, in which social graphs function as external memory and human responses serve as stochastic oracles for boundedlyrational agents - a paradigm orthogonal to existing influenceoperation and retrieval-augmented generation literature. This initial stage establishes a baseline for computational dynamics; future work will incorporate explicit network topology, multiagent interactions, and empirical validation, with the potential to shift discourse from how bots influence humans to how bots compute with humans. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Bakhat202644021,
