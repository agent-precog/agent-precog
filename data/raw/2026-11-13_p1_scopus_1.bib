@ARTICLE{Mestres20246760,
	author = {Mestres, Pol and Nieto-Granda, Carlos and Cortes, Jorge},
	title = {Distributed Safe Navigation of Multi-Agent Systems Using Control Barrier Function-Based Controllers},
