	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Raka2025346,
	author = {Raka, Lauda Dhia and Muslim Lhaksmana, Kemas},
	title = {Jury, Judge, and Executioner: Using LLMs to Steer Gamified Multi-Agent Decision-Making},
