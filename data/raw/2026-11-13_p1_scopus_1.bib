	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 37}
}

@CONFERENCE{Emanuelsson20233027,
	author = {Emanuelsson, William and Riveiros, Alejandro Penacho and Li, Yuchao and Johansson, Karl H. and Mårtensson, Jonas},
