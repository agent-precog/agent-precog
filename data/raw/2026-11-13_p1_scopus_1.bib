@CONFERENCE{Terán Espinoza2018,
	author = {Terán Espinoza, Antonio and Sanchez, William D. and Roascio, Danilo},
	title = {Sensor fusion for multi-agent spacecraft proximity operations via factor graphs},
	year = {2018},
	journal = {2018 AIAA SPACE and Astronautics Forum and Exposition},
	pages = {},
	doi = {10.2514/6.2018-5354},
	url = {https://www.scopus.com/pages/publications/85056154634?origin=resultslist},
	abstract = {Many future space exploration and space-based business enterprise models, such as on-orbit servicing, assembly, and debris removal, would be facilitated by the utilization of fully autonomous multi-satellite systems capable of precise and robust execution of proximity operations. Assurance of the protection of high value space assets from collisions between the autonomous agents, as well as success in achieving mission objectives will largely depend on the development of precise and consistently accurate relative-state estimates between the cooperating agents. While filtering based frameworks have reliably been used to solve spacecraft estimation problems for decades, they do not provide an inherent solution to dealing with multiple sensors that may be asynchronous, become inoperable, or provide delayed measurements. While workarounds exist, they quickly become unwieldy as the number of interacting autonomous agents grow. This paper seeks to model and implement the multi-satellite relative-state estimation problem using a graph-based approach. Instead of filtering, a factor graph is formed representing the joint probability distribution of the entire state and measurement history of all participating satellites. Probabilistic inference is performed to determine the maximum a posteriori (MAP) state history through optimization techniques on the graph via the open source GTSAM library. It will be shown that this method more naturally frames the multi-satellite relative-state estimation problem, providing inherent solutions to many of the filtering framework’s limitations. The proposed factor graph based estimator is demonstrated via the Synchronized Position Hold Engage Reorient Experimental Satellite (SPHERES) testbed through the simplest case scenario of relative navigation between two active, cooperative satellites. © 2018, American Institute of Aeronautics and Astronautics Inc, AIAA. All rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7}
}

