@ARTICLE{Melnyk2024491,
	author = {Melnyk, Oleksiy and Onyshchenko, Svitlana and Rudenko, Sergey and Pavlova, Nataliia and Arsen Muradian},
	title = {Embracing Integrated Optimization Strategies for Cost-Effective Port Operations in Marine Logistics},
