@ARTICLE{Aminiranjbar2025138795,
	author = {Aminiranjbar, Zahra and Tang, Jianan and Wang, Qiudan and Pant, Shubha and Viswanathan, Mahesh},
	title = {DAWN: Designing Distributed Agents in a Worldwide Network},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
