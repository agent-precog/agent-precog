@ARTICLE{Song2026,
	author = {Song, Yutong and Zeng, Tianyi and Zhang, Yao and Tezdogan, Tahsin},
	title = {Proactive multi-USV maritime search and rescue in stochastic wave environments: A hierarchical, non-causal reinforcement learning framework},
