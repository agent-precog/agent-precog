@CONFERENCE{Wang2025454,
	author = {Wang, Haopeng and Tang, Denglin and Zhao, Yu and Liu, Yongfang},
	title = {Task Allocation and Online Planning for Multi-Agent Systems with Safe-Return Constraints under Temporal Logic Specifications},
	year = {2025},
