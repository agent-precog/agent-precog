}

@ARTICLE{Kumar202612388,
	author = {Kumar, Yalla Ananda and Munusamy, Hemantharaj and Singh, Sharad Kumar},
	title = {Battery Management for Lifelong Operation of Warehouse Robots Under Dynamic Demand},
	year = {2026},
	journal = {IEEE Transactions on Automation Science and Engineering},
	volume = {23},
