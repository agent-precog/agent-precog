@ARTICLE{Zhang2026,
	author = {Zhang, Jiazhao and Dai, Shuai and Zhao, Dan and Sovetbekov, Bolotbek and Guo, Yanyong},
	title = {DKD-MARL: a data-knowledge dual-driven multi-agent reinforcement learning framework for traffic crash severity prediction},
	year = {2026},
