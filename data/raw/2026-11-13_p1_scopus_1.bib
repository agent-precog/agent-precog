@ARTICLE{Zhu202357,
	author = {Zhu, Kai and Li, Bin and Zhe, Wenming and Zhang, Tao},
	title = {Collision Avoidance Among Dense Heterogeneous Agents Using Deep Reinforcement Learning},
	year = {2023},
	journal = {IEEE Robotics and Automation Letters},
	volume = {8},
