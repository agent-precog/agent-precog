	title = {A new recourse algorithm for school bus routing with overlapped routes and process flexibility},
	year = {2026},
	journal = {Journal of Intelligent Transportation Systems: Technology, Planning, and Operations},
	volume = {30},
	number = {3},
	pages = {673 - 695},
	doi = {10.1080/15472450.2025.2487808},
	url = {https://www.scopus.com/pages/publications/105004275502?origin=resultslist},
	abstract = {Optimizing school bus routes is essential for improving student travel efficiency and safety, yet it presents significant challenges due to the stochastic nature of student demand. Traditional approaches often struggle to fully utilize bus capacity while adapting to daily fluctuations in demand. In response to these challenges, this paper provides a new algorithm for the school bus routing problem with stochastic demand, incorporating industrial process flexibility. Firstly, an open chain k-overlapped-route network is presented, allowing for route overlaps to fully utilize bus capacity. Secondly, a new recourse algorithm is developed, which introduces partial overlaps in bus fleet routes and employs recourse actions to determine the start and end depots for each bus. This algorithm can adapt to daily fluctuations in student demand, while ensuring that school buses operate normally on familiar routes. Finally, numerical and empirical studies validate the feasibility and applicability of the proposed algorithm, demonstrating its superiority in optimizing both the number of school buses used and the total travel distance. © 2025 Taylor & Francis Group, LLC.},
