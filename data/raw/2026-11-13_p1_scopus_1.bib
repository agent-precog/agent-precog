@CONFERENCE{Chandrasekaran20261359,
	author = {Chandrasekaran, K. and Venkateshwaran, K. and Manogar, K. and Vignesh, P. and Kumar, R. Ashok and Prasanna, M.},
	title = {Adaptive Multi-Agent AI Framework with Safety Consensus and Lockout Readiness Index for Smart Lockout/Tagout Decision Support},
	year = {2026},
	journal = {2026 International Conference on Secure Information Systems and Technologies, ICSIST 2026},
	pages = {1359 - 1366},
	doi = {10.1109/ICSIST70215.2026.11705861},
	url = {https://www.scopus.com/pages/publications/105055048051?origin=resultslist},
	abstract = {Industrial Lockout/Tagout (LOTO) procedures play a vital role in preventing accidents resulting from the misfortune of a hazardous energy being released unexpectedly during any maintenance work. Traditional LOTO methods, however, can involve manual processes which are prone to human error, non-compliance and slow response times within complex industrial settings. This paper suggests an Adaptive Multi-Agent Artificial Intelligence (AI) Framework for LOTO decision support with an intelligent system that combines distributed safety assessment, collaborative reasoning, and Explainable Artificial Intelligence (XAI). The framework is designed to be implemented through five autonomous agents which independently assess energy isolation, hazard severity, procedure compliance, worker authorization and equipment health. A novel SCE combines the results of these agents using confidence-based consensus reasoning to produce safe lockout decisions. Moreover, a Lockout Readiness Index (LRI) is presented to quantify the system readiness and to categorize maintenance operations in safe, verification-required and unsafe conditions. With the explanations of the decisions given by the XAI techniques, the SCE understand what each safety factor has contributed to the final recommendation, making it a transparent decision. Experimental testing proves that the proposed framework provides higher accuracy and reliability in decision-making than traditional machine learning methods, and its interpretability and real-time industrial safety management are enhanced. The proposed framework provides an intelligent and scalable decision support solution for the smart manufacturing environment, and plays a role in the safe, transparent, and adaptive maintenance in the manufacturing industry. Furthermore, this work supports the United Nations Sustainable Development Goal (SDG) 8: Decent Work and Economic Growth by improving workplace safety through smarter and more reliable lockout/tagout decision-making in industrial environments. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
