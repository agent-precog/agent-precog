}

@ARTICLE{Żywiołek2027,
	author = {Żywiołek, Justyna and Szymonik, Artur and Szymonik, Jacek},
	title = {Cybersecurity risk assessment in autonomous transport systems: A semi-quantitative framework incorporating logistics disruption propagation},
	year = {2027},
	journal = {Reliability Engineering and System Safety},
	volume = {278},
	pages = {},
	doi = {10.1016/j.ress.2026.113669},
	url = {https://www.scopus.com/pages/publications/105054344437?origin=resultslist},
	abstract = {The increasing reliance of autonomous transport systems on vehicle-to-infrastructure communication, fleet-management platforms, positioning services, and warehouse coordination creates cybersecurity risks that may extend beyond an individual vehicle and affect logistics continuity. This study develops a scenario-based, semi-quantitative framework for the comparative assessment of cybersecurity risks in an SAE Level 4 autonomous freight corridor. The framework adapts the threat-analysis logic of ISO/SAE 21434 and combines attack feasibility with four consequence dimensions: safety impact, financial impact, operational disruption, and disruption propagation. Seven standardised cyber threat scenarios were evaluated using author-assigned ratings based on an operational five-point scoring rubric. Criterion weights were specified as structured case-study assumptions through a pairwise-comparison procedure, and the resulting risk scores were examined using five alternative weighting configurations, ablation of the disruption-propagation criterion, one-at-a-time input perturbations, Spearman rank correlations, and sensitivity analysis of the risk-classification thresholds. Under the baseline assumptions, V2I/ETA falsification obtained the highest risk score (R = 16.80) and was classified as Critical, while denial-of-service affecting telematics and fleet-management systems ranked second (R = 15.20) and was classified as High. These two scenarios retained their positions under all weighting configurations. Removing the disruption-propagation criterion did not change the ordinal ranking of the seven scenarios, but it changed the magnitude of the risk scores, particularly for scenarios affecting shared communication and coordination processes. The framework is designed as an exploratory semi-quantitative prioritisation tool. Dynamic network propagation, node-to-node transition probabilities, time-dependent cascade trajectories, and recovery processes fall outside the analytical scope of the study. The framework instead supports transparent comparison of cyber threat scenarios and links baseline risk, propagation-related consequences, proposed controls, and illustrative residual risk under explicitly stated case-study assumptions. © 2026 The Authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
