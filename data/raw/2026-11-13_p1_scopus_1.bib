}

@CONFERENCE{Qi2026228,
	author = {Qi, Yijiashun and Xu, Xiang and Li, Yuxuan},
	title = {When Not to Write Memory: Governing False Promotion from Correlated Agent Traces},
	year = {2026},
	journal = {2026 6th International Conference on Machine Learning and Intelligent Systems Engineering, MLISE 2026},
