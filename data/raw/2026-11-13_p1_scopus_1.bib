@CONFERENCE{Ko20252726,
	author = {Ko, Joseph and Stiles, Jaydine and Alanazi, Ahmed and Miller, Luke and Ho, Duy and Lee, Yugyung},
	title = {Resilient Multi-Agent Task Allocation Through Trust-Aware Quantum-Inspired Optimization},
	year = {2025},
	journal = {IEEE International Conference on Data Mining Workshops, ICDMW},
	pages = {2726 - 2735},
	doi = {10.1109/ICDMW69685.2025.00349},
	url = {https://www.scopus.com/pages/publications/105035385134?origin=resultslist},
	abstract = {Safety-critical environments such as hospital disaster-response facilities demand rapid, reliable coordination of heterogeneous robotic teams under evolving hazards, partial observability, and uncertain trust. We introduce a trust-aware, event-driven digital twin framework that integrates urgency, hazard exposure, and robot reliability into a binary quadratic model (BQM/QUBO), solved with classical annealing heuristics under strict per-cycle budgets and benchmarked against a Hungarian baseline. The twin maintains a spatio-temporal knowledge graph of the facility, continuously updated through multimodal sensing, and re-optimizes only when trigger thresholds are exceeded. Routing is performed with A∗ under global knowledge and D*/D∗ Lite under partial knowledge, with Hybrid A∗ and RRT∗ extensions for cluttered or non-holonomic settings. Experiments on a six-floor hospital twin reveal three key insights: (i) hazardaware routing introduces a predictable 15-30% overhead, quantifying the safety-distance trade-off; (ii) fleet efficiency peaks near 12 robots with 8 sensors, performing within 3-5 rescues of the 16/16 maximum while reducing hardware burden; and (iii) event-driven reallocation significantly improves responsiveness, with QUBO adapting faster under bursty task updates while Hungarian remains efficient for stable snapshots. Together, these results demonstrate that embedding trust and hazards into global optimization yields greater resilience and responsiveness than static or purely local approaches, providing actionable guidelines for fleet sizing, routing, and reallocation policies in safety-critical coordination. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

