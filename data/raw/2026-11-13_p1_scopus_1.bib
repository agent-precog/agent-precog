@CONFERENCE{Liu20226770,
	author = {Liu, Jiaming and Zheng, Zhi},
	title = {A Path Planning Method Based on Collaborative Learning for Multi-Robot with Connectivity and Obstacle Avoidance Constraints},
	year = {2022},
	journal = {Proceedings - 2022 Chinese Automation Congress, CAC 2022},
	volume = {2022-January},
