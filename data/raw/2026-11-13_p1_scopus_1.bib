	doi = {10.1109/ICNWC68145.2026.11517933},
	url = {https://www.scopus.com/pages/publications/105041856859?origin=resultslist},
	abstract = {In the rapidly evolving retail landscape, the deployment of autonomous service robots faces significant hur- dies in cluttered and dynamic environments. Traditional vision- based navigation systems frequently fail due to variable lighting conditions, narrow supermarket aisles, and the high density of moving obstacles. These limitations significantly compound the inaccuracies of existing single-sensor or shallow localization approaches. We propose and evaluate SmartAssist, a novel AI-Driven Thermal-LiDAR Fusion architecture that exploits LiDAR's high-precision structural mapping alongside the thermal sensor's ability to detect human presence in low-light or occluded scenarios. This integrates a React-based front-end-featuring an embedded simulation view from the robot's perspective, a real-time 2D map of the shopping area, and a chat interface for user commands-with a Node.js backend utilizing WebSockets for real-time bidirectional communication. User commands are translated to navigation coordinates and integrated with the autonomous control logic powered by ROS2, where thermal and LiDAR sensors enable the system to locate users and avoid dynamic obstacles in low-light conditions. Experiments run in a high-fidelity Gazebo simulation of a complex supermarket store aisle feature show that the system can navigate accurately over 95% to the product requested. The hybrid approach maintains obstacle avoidance in dynamic, multiagent environments and addresses the unsolved key issues of agility and safety robustness in current indoor navigation robotics systems. To the best of our knowledge, this is the first implemented hybrid Thermal-LiDAR fusion system optimized for complete autonomous retail escort with a WebSocket-enabled ROS2 integration, ready to outperform manual or vision-only smart shopping carts. This paper also discusses ethical considerations like user safety, data privacy, and algorithmic reliability in public spaces. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Dacunha2026236,
	author = {Dacunha, Carlo and Giardini, Guilherme and Turqueti, Marcos},
	title = {LLM-based Reinforcement Learning for Controlling Robot Swarms},
	year = {2026},
	journal = {2026 7th International Conference on Artificial Intelligence, Robotics, and Control, AIRC 2026},
	pages = {236 - 241},
	doi = {10.1109/AIRC69745.2026.11631479},
	url = {https://www.scopus.com/pages/publications/105047332767?origin=resultslist},
	abstract = {Coordinating robot swarms is challenging due to the complexity of the system and the lack of systematic design methods. Existing approaches trade interpretability for performance: hand-designed controllers are transparent but don't generalize, while learning methods require millions of samples and produce black-box policies. We propose an LLM-in-the-loop reinforcement learning framework where large language models iteratively design controllers using performance metrics as reward signals. We compare four LLMs (Grok, Claude, Gemini, ChatGPT) on cohesive motion control using an extended Vicsek model. Grok achieves 94% of the theoretical maximum in one iteration; Claude converges in 9 iterations. However, ChatGPT's performance collapses after iteration 6, revealing refinement failure modes. Our complexity analysis shows dynamical richness strongly correlates with performance (71%) while logical complexity does not (18%), suggesting effective swarm control requires continuous laws over discrete switching. Results demonstrate LLMs can accelerate controller design while maintaining interpretability, but demand rigorous validation for safety-critical applications.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Raza202671,
	author = {Raza, Shaina and Sapkota, Ranjan and Karkee, Manoj and Emmanouilidis, Christos},
	title = {TRiSM for Agentic AI: A review of Trust, Risk, and Security Management in LLM-based Agentic Multi-Agent Systems},
	year = {2026},
	journal = {AI Open},
	volume = {7},
	pages = {71 - 95},
	doi = {10.1016/j.aiopen.2026.02.006},
	url = {https://www.scopus.com/pages/publications/105033887156?origin=resultslist},
	abstract = {Agentic AI systems, built upon large language models (LLMs) and deployed in multi-agent configurations, are redefining intelligence, autonomy, collaboration, and decision-making across enterprise and societal domains. This review presents a structured analysis of Trust, Risk, and Security Management (TRiSM) in the context of LLM-based Agentic Multi-Agent Systems (AMAS). We begin by examining the conceptual foundations of Agentic AI and highlight its architectural distinctions from traditional AI agents. We then adapt and extend the AI TRiSM framework for Agentic AI, structured around key pillars: Explainability, ModelOps, Security, Privacy and their Lifecycle Governance, each contextualized to the challenges of AMAS. A risk taxonomy is proposed to capture the unique threats and vulnerabilities of Agentic AI, ranging from coordination failures to prompt-based adversarial manipulation. To make coordination and tool use measurable in practice, we propose two metrics: the Component Synergy Score (CSS), which captures inter-agent enablement, and the Tool Utilization Efficacy (TUE), which evaluates whether tools are invoked correctly and efficiently. We further discuss strategies for improving explainability in Agentic AI, as well as approaches to enhancing security and privacy through encryption, adversarial robustness, and regulatory compliance. The review concludes with a research roadmap for the responsible development and deployment of Agentic AI, highlighting key directions to align emerging systems with TRiSM principles-ensuring safety, transparency, and accountability in their operation. © 2026 The Authors. Publishing services by Elsevier B.V. on behalf of KeAi Communications Co. Ltd. This is an open access article under the CC BY-NC-ND license. http://creativecommons.org/licenses/by-nc-nd/4.0/},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
