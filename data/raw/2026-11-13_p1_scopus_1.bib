@ARTICLE{Shoura2026,
	author = {Shoura, Ahmed Ali and Awad, Mohammed Ibrahim and Maged, Shady A. and Fattah, Diaa Emad Abdel},
	title = {A comprehensive review of reinforcement learning approaches in peg-in-hole insertion for robotic assembly tasks},
	year = {2026},
