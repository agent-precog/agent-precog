}

@ARTICLE{Ponticelli2025199932,
	author = {Ponticelli, Lorenzo and Farroni, Flavio and Genovese, Andrea and Dell'Annunziata, Guido Napolitano and Timpone, Francesco and Sakhnevych, Aleksandr},
	title = {Vehicle State-Based Control for Modern Automotive Platforms: Bridging Research and Industrial Applications},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
