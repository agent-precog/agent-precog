	title = {Decentralized Path Planning in Lunar Robot Swarms: Local Optimization for Collision Avoidance Under Constrained Perception},
	year = {2026},
	journal = {IEEE Transactions on Aerospace and Electronic Systems},
	volume = {62},
	pages = {1293 - 1308},
	doi = {10.1109/TAES.2025.3628327},
	url = {https://www.scopus.com/pages/publications/105020943506?origin=resultslist},
	abstract = {This article investigates decentralized safe path planning for lunar robot systems in dynamic environments with limited perception and communication capabilities and proposes a decentralized planning–control framework based on local path replanning. For clarity, we first define system models for complex dynamic scenarios and multirobot systems. Then, the decentralized framework is systematically developed through two complementary parts: 1) ensuring feasible path replanning under collision conditions and 2) preventing secondary collisions caused by path tracking control. Concretely, path reachability analysis is applied to derive quantifiable replanning criteria based on discrete sampling intervals, supported by a reachable set algorithm that theoretically guarantees replanning feasibility. Path relevance constraints are extended through an analysis of collision-prone waypoints, effectively eliminating the risks in continuous trajectory. To enhance practical robustness, bounded uncertainties from tracking control and environment are taken into consideration in the actual application. On this basis, a comprehensive numerical synthesis is proposed. Finally, lunar base construction simulations validate the proposed decentralized planning–control framework, demonstrating its effectiveness in safe path planning and its scalability in large-scale multirobot deployments. © 1965-2011 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@CONFERENCE{Das2026,
