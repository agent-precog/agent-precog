@ARTICLE{Kimmel2012137,
	author = {Kimmel, Andrew and Dobson, Andrew and Littlefield, Zakary and Krontiris, Athanasios and Marble, James and Bekris, Kostas E.},
	title = {PRACSYS: An extensible architecture for composing motion controllers and planners},
