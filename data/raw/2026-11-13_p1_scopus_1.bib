@CONFERENCE{Chandrasekaran2026577,
	author = {Chandrasekaran, K. and Vasanth, V.K. and Manogar, K. and Kavinkumar, P.},
	title = {Industrial Accidents and Safety for Worker Welfare: Controlling and Monitoring},
	year = {2026},
	journal = {7th International Conference on Inventive Research in Computing Applications, ICIRCA 2026 - Proceedings},
	pages = {577 - 584},
	doi = {10.1109/ICIRCA69024.2026.11570470},
	url = {https://www.scopus.com/pages/publications/105044204327?origin=resultslist},
	abstract = {Industrial safety remains a critical concern across manufacturing and hazardous sectors, where worker welfare depends on timely detection and mitigation of risks. This paper presents a novel Hybrid Neuro-Symbolic Safety Intelligence Framework (HyNeSSI) designed to proactively monitor, predict, and control industrial accidents using situational, real-time intelligence. The proposed framework integrates that the system uses a self-supervised visual encoding pipeline multi-modal sensor data provided by Smart PPE, visual risk mapping through self-supervised learning, emotion-aware behavioral profiling with the Capsule Networks and temporal causality modeling through graph neural networks. Violations of safety are detected through vision language alignment and zero-shot capability and adaptive safety feedback through multi-agent deep reinforcement learning. Extensive experiments conducted across 10 industrial scenarios demonstrated that HyNeSSI was superior to traditional CNN and rule-based systems regarding the average violation detection accuracy (95.3%), behavioral risk classification F1-score (93.1%), and causal prediction accuracy (90.4%). The latency of the response to alerts was minimized (by 27.5) relative to baseline models. In addition, SHAP and LIME-based interpretability enhanced the trust of safety officers more than 40 %. HyNeSSI is a scalable and intelligent yet interpretable solution to safety monitoring fit to be deployed in real time. The extensions in the future can be federated implementation of the distributed industrial locations, as well as implementation of predictive maintenance modules in a way of avoiding the risk at the machinery level. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Han2026,
	author = {Han, Juhyeong and Kim, Hyunbum},
	title = {MARL-Driven Decentralized Crowdsourcing Logistics for Time-Critical Multi-UAV Networks},
	year = {2026},
	journal = {Electronics (Switzerland)},
	volume = {15},
	number = {2},
	pages = {},
	doi = {10.3390/electronics15020331},
	url = {https://www.scopus.com/pages/publications/105028658580?origin=resultslist},
	abstract = {Centralized UAV logistics controllers can achieve strong navigation performance in controlled settings, but they do not capture key deployment factors in crowdsourcing-enabled emergency logistics, where heterogeneous UAV owners participate with unreliability and dropout, and incentive expenditure and fairness must be accounted for. This paper presents a decentralized crowdsourcing multi-UAV emergency logistics framework on an edge-orchestrated architecture that (i) performs urgency-aware dispatch under distance/energy/payload constraints, (ii) tracks reliability and participation dynamics under stress (unreliable agents and dropout), and (iii) quantifies incentive feasibility via total payment and payment inequality (Gini). We adopt a hybrid decision design in which PPO/DQN policies provide real-time navigation/control, while GA/ACO act as planning-level route refinement modules (not reinforcement learning) to improve global candidate quality under safety constraints. We evaluate the framework in a controlled grid-world simulator and explicitly report stress-matched re-evaluation results under matched stress settings, where applicable. In the nominal comparison, centralized DQN attains high navigation-centric success (e.g., 0.970 ± 0.095) with short reach steps, but it omits incentives by construction, whereas the proposed crowdsourcing method reports measurable payment and fairness outcomes (e.g., payment and Gini) and remains evaluable under unreliability and dropout sweeps. We further provide a utility decomposition that attributes negative-utility regimes primarily to collision-related costs and secondarily to incentive expenditure, clarifying the operational trade-off between mission value, safety risk, and incentive cost. Overall, the results indicate that navigation-only baselines can appear strong when participation economics are ignored, while a deployable crowdsourcing system must explicitly expose incentive/fairness and robustness characteristics under stress. © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Gold Open Access}
}

