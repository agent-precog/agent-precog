	title = {Artificial Intelligence for Unmanned Control Systems: A Concise Review from a Control-Loop-Centered Perspective},
	year = {2026},
	journal = {2026 2nd International Conference on Unmanned Systems and Technology, UST 2026},
	pages = {53 - 58},
	doi = {10.1109/UST70584.2026.11663736},
	url = {https://www.scopus.com/pages/publications/105049596754?origin=resultslist},
	abstract = {Unmanned control systems, such as unmanned aerial vehicles, unmanned ground vehicles, unmanned surface vehicles, and related robotic platforms, increasingly rely on artificial intelligence (AI) to improve autonomy in dynamic and uncertain environments. However, existing survey literature is often organized around specific platforms, tasks, or model families, making it difficult to obtain a compact system-level understanding of how AI contributes to different stages of the autonomy loop of unmanned systems. In this paper, we provide a concise review of AI-enabled unmanned control systems from a control-loop-centered perspective. Specifically, we organize the literature into four tightly connected aspects: perception and scene understanding; estimation, prediction, and planning; learning-enhanced control and collaboration; and safety and trustworthiness. Rather than aiming for exhaustive coverage, this review highlights the functional role of AI across the autonomy pipeline and summarizes key design trade-offs under practical constraints such as real-time computation, domain shift, and deployment reliability. We further discuss major challenges and promising research directions, including hybrid AI-control integration, trustworthy autonomy, and scalable multi-agent intelligence. This paper provides a compact reference for understanding how AI is reshaping unmanned control systems from isolated intelligent modules to integrated autonomous decision-making loops.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Schoitsch2026127,
	author = {Schoitsch, Erwin},
	title = {RE-THINKING AUTOMATION: INTENSIVE HUMAN-MACHINE COLLABORATION},
	year = {2026},
	journal = {IDIMT 2026 - Resilience: ICT, Business and Society: 34th Interdisciplinary Information Management Talks},
	pages = {127 - 134},
	doi = {10.35011/IDIMT-2026-127},
	url = {https://www.scopus.com/pages/publications/105052041010?origin=resultslist},
	abstract = {This paper provides an overview of an upcoming trend with respect to industrial automation: In the past, even in context of “Smart manufacturing”, Artificial Intelligence and robotics, automation mainly considered the machine/plant part. Humans of course are involved, but rather as operators, in logistics, planning and control. At the shopfloor, humans had to be protected against harm caused by machines, in most cases by “fences” or other protective mechanisms. With autonomy of robots and machines, a new generation of “intelligent” mobile machines and robots allows a concept of more intensive collaboration of humans and machines on a partner/team level. This could change our attitude to AI-based systems of all kinds (“machines” are the “AI” in e.g., robotic systems, but also business, financial, healthcare, mobility or administrative systems. This changes also the perspective of functional safety, since the human becomes part of the so-called “collaborative safety”, changing also the perspective of risk management. This approach is at the AI-side driven primarily by experts, e.g., in AI-Standardization (ISO/IEC JTC1 SC42 WG4), and just recently also by IEC TC65, Industrial Automation and Control standards (IEC SC65A WG24, Human-machine collaboration; IEC TC65 WG31 Industrial Agent and Multi-Agent Systems). AI driven autonomous systems raise specific ethical as well as safety and security issues. Trustworthiness is a difficult property to prove. This is also part of the Horizon Europe project RobustifAI (GA no. 101212818) which strives for development of a methodology tailored for reliable, robust and trustworthy GenAI. © IDIMT 2026. All right reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

