@CONFERENCE{Xie2026975,
	author = {Xie, Chengcheng},
	title = {Efficient Collision Detection and Path Optimization for Multi-Node Systems Using Vector Cross Product and Neural Regression},
	year = {2026},
	journal = {Proceedings of 2026 6th International Conference on Applied Mathematics, Modelling and Intelligent Computing, CAMMIC 2026},
	pages = {975 - 981},
