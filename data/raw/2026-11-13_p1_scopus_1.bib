}

@ARTICLE{Roszkowska2023425,
	author = {Roszkowska, Elzbieta and Makowski-Czerski, Piotr and Janiec, Lukasz},
	title = {Multi-level control for multiple mobile robot systems},
	year = {2023},
	journal = {Discrete Event Dynamic Systems: Theory and Applications},
	volume = {33},
