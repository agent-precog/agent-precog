@CONFERENCE{Pelegrin2026180,
	author = {Pelegrin, Lorena and Sharma, Akshat and Jose, Jimmy and Chen, Zhi and Sebastian, Soumya},
	title = {An adaptive digital experience platform for multimodal enterprise knowledge systems},
	year = {2026},
	journal = {Procedia Computer Science},
	volume = {288},
	pages = {180 - 189},
	doi = {10.1016/j.procs.2026.08.197},
	url = {https://www.scopus.com/pages/publications/105052741977?origin=resultslist},
	abstract = {Modern enterprises generate vast volumes of information across heterogeneous modalities, including scanned documents, PDFs, images, audio recordings, videos, and structured data sources. While individually valuable, these artifacts remain siloed and underutilized due to fragmentation and limited semantic understanding. This paper presents the Iron Mountain Digital Experience Platform (DXP) as a complex adaptive system designed to ingest, structure, and continuously learn from enterprise information at scale. The platform implements a multimodal ingestion pipeline that performs optical character recognition (OCR), document layout and table understanding, semantic embedding generation, classification, and information extraction using a combination of cloud services, custom machine-learning (ML) models, and large language models (LLMs). Extracted knowledge is organized into an ontology-driven knowledge graph, capturing entities, relationships, and contextual dependencies across all data modalities. This graph serves as a dynamic substrate for reasoning and adaptation rather than a static representation. On top of this substrate, the system hosts multiple autonomous agents capable of acting on the knowledge graph to execute tasks, answer queries, and automate workflows. These agents are not statically programmed; instead, they adapt over time through feedback-driven learning loops derived from user interactions and internally generated evaluation signals. Learning occurs at both the individual agent level and the system level, enabling the emergence of shared strategies, abstraction of successful behaviors, and gradual consolidation of knowledge. Periodic evaluation mechanisms monitor agent performance and system-level outcomes, supporting controlled adaptation and preventing degradation. Viewed through the lens of complex adaptive systems, the platform exhibits key properties such as distributed intelligence, local learning with global effects, emergence of higher-level abstractions, and continual co-evolution of agents and their environment. This work aims to demonstrate how enterprise information systems can move beyond static pipelines toward adaptive, self-improving architectures that better reflect the complexity of real-world information ecosystems. © 2026 Elsevier B.V.. All rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

