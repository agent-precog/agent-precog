	year = {2024},
	journal = {Conference Record - IAS Annual Meeting (IEEE Industry Applications Society)},
	pages = {},
	doi = {10.1109/IAS55788.2024.11023822},
	url = {https://www.scopus.com/pages/publications/105008665226?origin=resultslist},
	abstract = {Electrical vehicle (EV) fleets signify a pivotal shift in sustainable transportation, promising reduced emissions, and energy diversification. However, the substantial and rapid growth in EV adoption brings forth complex challenges to the distribution grid. This paper explores the negative impacts of EVs charging on the distribution grid and remedial measures to enhance grid resiliency and stability. As EVs draw significant power, the grid faces strains, particularly during peak hours, that could lead to local overloads, increase peak demand, and voltage fluctuations. Moreover, areas with a high concentration of EVs may experience local grid congestion, which can strain transformers and distribution lines, potentially leading to equipment failures or reliability and safety issues of the power grid. Therefore, addressing these negative impacts and investigating remedial measures are beneficial to support widespread EV charging and enhance grid support. Various methods such as smart charging and bidirectional charging methods can be implemented to cater for these negative impacts. This paper reviews various techniques to identify the smooth integration strategies of EVs into the distribution network while maximizing the benefits of EV charging. Finally, an EV charger with grid forming (GFM) inverter-based system is designed and implemented in the MATLAB/Simscape environment. The simulation outcomes illustrate effectiveness of EV charging system and have ride-through capabilities in providing voltage and frequency assistance in both steady-state and transient conditions. © 2024 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Okumura202311655,
