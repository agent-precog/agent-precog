@CONFERENCE{Jiang20261050,
	author = {Jiang, Tiantian and Zhou, Xinglin and Li, Ang and Zhou, Dexiang and Zhang, Zhiyu and Ma, Ming},
	title = {Quality-Aware Potential-Based Reward Shaping for Fixed-Wing UAV Formation Navigation},
	year = {2026},
