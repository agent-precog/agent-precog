@ARTICLE{Joon2025124,
	author = {Joon, Arpit and Kowalczyk, Wojciech and Goyal, Shivam},
	title = {An Orbital Approach to Deadlock Resolution in Multi-Agent Coordination},
	year = {2025},
	journal = {International Conference on Methods and Models in Automation and Robotics, MMAR},
	number = {2025},
	pages = {124 - 129},
	doi = {10.1109/MMAR65820.2025.11150850},
	url = {https://www.scopus.com/pages/publications/105030850912?origin=resultslist},
	abstract = {The paper presents a novel approach to resolving deadlock situations in multi-agent systems. The approach involves establishing a virtual orbital path over robots involved in a deadlock situation. Robots involved in a deadlock situation are directed towards the circumference of the virtual circle, the direction to move clockwise or counterclockwise is decided on the cost function. Upon reaching a point where robots form a tangent from the virtual circle to the goal point, the robot exits the orbit. The paper presents two controllers, a trajectory tracking controller and a set point controller. A trajectory tracking controller is activated when the robot follows the circumference of the virtual circle, and a set point controller is activated when the robot leaves the circle from the tangential point towards their original goals. Simulation results, conducted in a Gazebo environment using a Robot Operating System (ROS), illustrate the algorithm's capability to effectively resolve the deadlock situations.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@ARTICLE{Jakab2025121,
	author = {Jakab, Olivér and Varga, László Z.},
	title = {Options to Speed-Up Search in Lifelong Multi-Agent Pathfinding},
	year = {2025},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics) },
	volume = {15157 LNAI},
	pages = {121 - 133},
	doi = {10.1007/978-3-031-70415-4_11},
	url = {https://www.scopus.com/pages/publications/85210318046?origin=resultslist},
	abstract = {A well-studied abstract model for navigating agents in a distributed environment without collisions is known as Multi-Agent Path Finding (MAPF). MAPF has two interrelated aspects: one is to find the paths for the agents without collisions, and the other is to optimize the conflict resolutions between the paths. We focus on the first aspect, and we investigate three options: map reduction with waypoints, prioritized search and one-way restrictions. To our knowledge, our map reduction technique is a novelty in MAPF. We evaluate the three speed-up options on the scenarios of the League of Robot Runners competition. The results show that the improvement greatly depends on the size, style and layout of the maps. Prioritized search does not have big impact. The usage of one-way restriction rules is only worthwhile in specific maps. Map reduction on larger, complex maps drastically improves performance. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@CONFERENCE{Udayavani2025,
	author = {Udayavani, V. and Reshma Soman, N. and Rs, Lakshya and Ramesh, Preethi and Shobika, M. and Muthuramanathan, Subhadra},
	title = {TaskBotFusion: A Multi-Agent Framework for Coordinating Robotic Task Distribution in Dynamic Environments},
	year = {2025},
	journal = {2025 7th International Symposium on Advanced Electrical and Communication Technologies, ISAECT 2025},
	pages = {},
	doi = {10.1109/ISAECT68904.2025.11318779},
	url = {https://www.scopus.com/pages/publications/105032675941?origin=resultslist},
	abstract = {The rise in robots working together in different settings leads to the need for frameworks that are strong, easy to adjust and not centralized. The study presents TaskBotFusion which is a unique way to program multi-agent robotics and improve task assignment in unpredictable environments. Instead of relying on a single approach, TaskBotFusion uses a hybrid model that uses Multi-Agent Reinforcement Learning (MARL) and Swarm Intelligence (ACO), particularly Ant Colony Optimization, to help robots share and reallocate tasks in real time. It has modules for generating virtual environments, planning by fuzzy logic, organizing negotiations without a central authority, setting flexible routes and showing results instantly. Benchmark scenarios and datasets full of instructions, obstacles and various ways agents are organized were used to check the performance of the simulation-based approaches. TaskBotFusion finished most tasks with a 98.5% success rate, much better than Centralized-DQN (94.2%) and Swarm-RL (92.8%). Furthermore, it showed reduced average delay (2.1 seconds), almost no collisions (0.4%) on the network, great power efficiency at 92.7% and the lowest rate of task changes amongst the group (1.5%). The outcomes support that TaskBotFusion excels at coordinating many agents under practical challenges. This architecture is effective because it improves service capacity, makes the system adaptable and lowers unneeded repeats and obstacles. Creating an intelligent and flexible system for managing robot fleets in logistics, the manufacturing sector, agriculture and disaster management is a key contribution of this work. Future systems will examine deployment outside the lab, how edge-AI can be added and perform well under constrained networks. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Li2025329,
	author = {Li, Yonghao and Zhou, Sunyao and Lyu, Muzhen and Li, Dongze and Zou, Zhuo and Liu, Lizheng},
	title = {Homogeneous Decision Networks for Multi-Agent Formation Control via Distributed Reinforcement Learning},
	year = {2025},
	journal = {Procedia Computer Science},
	volume = {271},
	pages = {329 - 335},
	doi = {10.1016/j.procs.2025.10.151},
	url = {https://www.scopus.com/pages/publications/105023473683?origin=resultslist},
	abstract = {Aiming at the problem of balancing formation maintenance, obstacle avoidance and dynamic navigation in multi-robot cooperative formation control in complex environments, this study proposes a homogeneous decision network framework based on distributed reinforcement learning. The framework adopts parameter-shared homogeneous policy networks, where all robots have identical decision networks, and decision differences only arise from local observation states such as relative positions, obstacle perception, and target directions. Improved PPO and A3C algorithms are used to handle multiple tasks, with the gradient aggregation mechanism of A3C to synchronize policy parameters, and a dual-critic network is constructed to dynamically balance the weights of individual and global rewards. A dynamic Leader-Follower architecture is adopted to elect Leaders based on proximity to target points and design differentiated reward functions, with all logics integrated into a single homogeneous network, enabling agents to autonomously assume different roles and adjust formations according to real-time states. Simulation experiments verify the effectiveness of the algorithm through a three-stage progressive training scheme. © 2025 The Authors.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@CONFERENCE{Hua202598517,
	author = {Hua, Yun and Chen, Haosheng and Wang, Shiqin and Li, Wenhao and Wang, Xiangfeng and Luo, Jun},
	title = {Shapley-Coop: Credit Assignment for Emergent Cooperation in Self-Interested LLM Agents},
	year = {2025},
	journal = {Advances in Neural Information Processing Systems},
	volume = {38},
	pages = {98517 - 98544},
	url = {https://www.scopus.com/pages/publications/105048536568?origin=resultslist},
	abstract = {Large Language Models (LLMs) show strong collaborative performance in multi-agent systems with predefined roles and workflows. However, in open-ended environments lacking coordination rules, agents tend to act in self-interested ways. The central challenge in achieving coordination lies in credit assignment-fairly evaluating each agent's contribution and designing pricing mechanisms that align their heterogeneous goals. This problem is critical as LLMs increasingly participate in complex human-AI collaborations, where fair compensation and accountability rely on effective pricing mechanisms. Inspired by how human societies address similar coordination challenges (e.g., via temporary collaborations like employment or subcontracting), a cooperative workflow Shapley-Coop is proposed. ShapleyCoop integrates Shapley Chain-of-Thought-leveraging marginal contributions as a principled basis for pricing-with structured negotiation protocols for effective price matching, enabling LLM agents to coordinate through rational task-time pricing and post-task reward redistribution. This approach aligns agent incentives, fosters cooperation, and maintains autonomy. We evaluate Shapley-Coop across two multi-agent games and a software engineering simulation, demonstrating that it consistently enhances LLM agent collaboration and facilitates equitable credit assignment. These results highlight the effectiveness of Shapley-Coop's pricing mechanisms in accurately reflecting individual contributions during task execution. © 2025 Neural information processing systems foundation. All rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Ren20257590,
	author = {Ren, Zhongqiang and Rathinam, Sivakumar and Choset, Howie},
	title = {A Bounded Sub-Optimal Approach for Multi-Agent Combinatorial Path Finding},
	year = {2025},
	journal = {IEEE Transactions on Automation Science and Engineering},
	volume = {22},
	pages = {7590 - 7605},
	doi = {10.1109/TASE.2024.3466183},
	url = {https://www.scopus.com/pages/publications/105001207972?origin=resultslist},
	abstract = {Multi-Agent Path Finding (MAPF) seeks collision-free paths for multiple agents from start to goal locations. This paper considers a generalization of MAPF called Multi-Agent Combinatorial Path Finding (MCPF) where agents must collectively visit a set of intermediate target locations before reaching their goals. MCPF is challenging as it involves both planning collision-free paths for multiple agents and target sequencing, i.e., assigning targets to and computing the visiting order for each agent. A recent method Conflict-Based Steiner Search (CBSS) is developed to solve MCPF to optimality, which, however, does not scale well when the number of agents or targets is large (e.g. 50 targets). While MAPF research has developed methods to plan bounded sub-optimality paths for many agents, it remains unknown how to find bounded sub-optimal solutions in the presence of many targets. This paper fills this gap by developing a method AK<sup>∗</sup> for target sequencing (A for Approximation and K<sup>∗</sup> for K-best), which leverages approximation algorithms for traveling salesman problems. A<sup>K∗</sup> is motivated by MCPF, but is a standalone method that can solve K-best routing problems in general. We prove that AK<sup>∗</sup> has worst-case polynomial runtime complexity and finds bounded sub-optimal solutions. With AK<sup>∗</sup>, we develop two CBSS variants that find bounded sub-optimal paths for MCPF. Our results verify the fast running speeds of our methods with up to 200 targets.  © 2004-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7}
}

