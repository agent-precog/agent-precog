	pages = {85 - 89},
	doi = {10.1109/LMIAT70705.2026.11682229},
	url = {https://www.scopus.com/pages/publications/105051527959?origin=resultslist},
	abstract = {Large language model (LLM) agents increasingly operate not in isolation but as teams that share a common pool of stateful tools - databases, code executors, file systems, external services, and one another's memory. When several agents act on the same tool concurrently, the classical hazards of distributed computing reappear: lost updates, dirty reads, duplicated side effects, and divergent views of shared state. Yet the mature machinery of distributed systems - two-phase locking, optimistic concurrency control, snapshot isolation, and consensus - assumes deterministic, low-latency, structured operations, whereas LLM agent actions are non-deterministic, natural-language-driven, high-latency, and monetarily costly. This survey organizes the emerging literature on multi-agent tool sharing along three axes that the classical field has kept separate but that agent systems must solve jointly: task allocation, concurrent access coordination, and consistency guarantees. We propose a taxonomy that additionally stratifies methods by side-effect reversibility, map each classical concurrency mechanism onto its agent-era counterpart while flagging which assumptions break, survey how current frameworks (AutoGen, MetaGPT, CAMEL, ChatDev, AgentVerse) implicitly handle - or ignore - these problems, and close with an agenda of open problems, including semantic conflict detection, transactional models for irreversible actions, and the absence of concurrency-aware benchmarks.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Divi2026604,
	author = {Divi, Veera Ravindra and Gullapalli, Sneha and Brahmandam, Balajee Asish},
	title = {Containing the Cascade: A Benchmark and Reference Mediator for Failure Propagation in Tool-Using LLM Multi-Agent Systems},
	year = {2026},
	journal = {Proceedings - 2026 5th ICERA 2026: The International Conference on Electronics Representation and Algorithm},
	pages = {604 - 609},
	doi = {10.1109/ICERA72709.2026.11666599},
	url = {https://www.scopus.com/pages/publications/105050630429?origin=resultslist},
	abstract = {Large language model (LLM) multi-agent systems (MAS) increasingly automate multi-step, tool-using workflows, yet they fail far more often than their single-agent counterparts. Recent diagnostic studies attribute these failures to cascades: a single agent's hallucination, malformed tool call, or role drift propagates through the agent graph and corrupts the final output. The community has so far concentrated on diagnosing such failures after the fact; there is no standard, reproducible benchmark for measuring whether a system can contain a cascade as it unfolds. We address this gap with three contributions. First, we introduce a taxonomy of six recurring cascading-failure modes and a suite of containment metrics-containment rate, cascade depth, blast radius, and mean time-to-detection-that quantify propagation rather than only end-task success. Second, we present CASCADE-BENCH, a controlled fault-injection testbed of 1080 scenarios across six task domains, instantiated on a discrete-event simulation of agent message passing that is calibrated to reported MAS failure statistics. Third, we propose SENTINEL, a lightweight reference mediator that combines typed inter-agent message contracts, a semantic anomaly gate, a circuit breaker, and checkpoint-based recovery. Across 48 system configurations and over 590 000 simulated task executions, SENTINEL raises task success from 31.3 % to 83.7 % and containment from 46.2 % to 99.4 %, while holding cascade depth nearly constant as the system scales from 3 to 12 agents-where the unguarded depth nearly doubles. An ablation cleanly separates a fail-safe role (the circuit breaker, which governs containment) from a fail-operational role (checkpoint rollback, which governs task completion). We release CASCADE-BENCH and SENTINEL as an open baseline for reliability research on tool-using MAS. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

