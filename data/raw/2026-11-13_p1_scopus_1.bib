@CONFERENCE{Rao2026,
	author = {Rao, Challa Krishna and Sahoo, Sarat Kumar and Rani, Gandam Deepika and Jahnavi, Ilupothi and Lahari, Konchada and Manikantha, Bora and Kumar, Boddepalli Manmadha and Srinivasarao, B. and Menda, V V Appalanaidu},
