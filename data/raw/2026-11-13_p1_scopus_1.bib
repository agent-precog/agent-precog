@CONFERENCE{Tan2026577,
	author = {Tan, Yayun and Kurfess, Franz and Delgado, Emmanuel and Young, Christopher and Bloom, Gary},
	title = {Post-Hoc Knowledge Grounding for Verifiable Multi-Agent Search and Rescue Decision Support},
