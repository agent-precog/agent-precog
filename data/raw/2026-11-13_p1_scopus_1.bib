@ARTICLE{Hu2025680,
	author = {Hu, Jian and Yang, Shiyao and Yang, Yun and Xu, Xinhao and Zhang, Xiaoqiang},
	title = {Identifying Truck Activity from Global Positioning System Data Based on Satellite Imagery},
