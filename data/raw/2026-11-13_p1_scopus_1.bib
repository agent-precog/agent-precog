@ARTICLE{Mahale2025,
	author = {Mahale, Yashashree and Kolhar, Shrikrishna and More, Anjali S.},
	title = {Enhancing predictive maintenance in automotive industry: addressing class imbalance using advanced machine learning techniques},
	year = {2025},
