	doi = {10.1007/s42044-025-00306-z},
	url = {https://www.scopus.com/pages/publications/105010765577?origin=resultslist},
	abstract = {This paper introduces a novel hybrid framework that integrates quantum computing and neuromorphic computing to enhance the safety, reliability, and explainability of Multi-Agent Reinforcement Learning (MARL) in autonomous robotic systems. The proposed architecture employs quantum variational circuits for high-level policy exploration and spiking neural networks for energy-efficient, low-latency motor control. Adopting a centralized training and decentralized execution paradigm, the framework enables agents to optimize joint policies that combine quantum planning with neuromorphic execution under partial observability and safety constraints. We evaluate the framework in a simulated environment featuring ten UAV agents navigating dynamic forest terrain with limited visibility and obstacle avoidance requirements. Empirical results demonstrate that the hybrid system significantly reduces safety violations while maintaining entropy-based exploration and interpretable spike-based decision traces. KL divergence metrics confirm the convergence of quantum policies toward safe priors, while spike entropy analysis reveals temporal diversity in control signals. The key contributions of this work include: (i) a modular quantum-neuromorphic MARL architecture, (ii) a hybrid training framework incorporating safety-aware coordination, and (iii) empirical validation through both visual diagnostics and formal metrics. This research establishes a foundation for next-generation embodied AI systems that unify the optimization capabilities of quantum computing with the biological plausibility of neuromorphic control. © The Author(s), under exclusive licence to Springer Nature Switzerland AG 2025.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 10; All Open Access; Green Open Access}
}

@ARTICLE{Bhore202623,
	author = {Bhore, Smita and N. A, Natraj and Bhuvaneswari, M.},
	title = {Adaptive Learning in Multi-robot Systems: Evolving Intelligence on the Fly},
	year = {2026},
	journal = {Studies in Systems, Decision and Control},
	volume = {669},
	pages = {23 - 58},
	doi = {10.1007/978-3-032-21150-7_2},
	url = {https://www.scopus.com/pages/publications/105049490953?origin=resultslist},
	abstract = {In this chapter, we will explore how adaptive learning transforms robot teams, which were initially inflexible, pre-programmed machines, into flexible systems that continually improve over time. Conventional systems fail in actual unpredictable conditions, and here the emphasis is on how robots may be able to learn as they go and work in a more coordinated and efficient manner, and remain robust without direct human intervention. It addresses the fundamental issues in the learning of multi-robots, such as changing environments, credit, communication constraints, and exploration safety. There are major learning techniques described in an easy, understandable manner, such as Multi-Agent Reinforcement Learning, imitation and transfer learning, evolutionary and swarm, meta-learning to adapt quickly, and federated learning to share intelligence without privacy loss. Practical strategies adopted in actual deployments are also pointed out in the chapter: combining pre-trained models with online learning, responding with high-level strategy and low-level control, curriculum learning to presented tasks gradually, and simulation-to-reality techniques to ensure robots trained in virtual environments perform without problems in real environments. There are real-life instances of how the ideas are already assisting or coming to pass in either warehouse logistics, collaborative manufacturing, agriculture, or search-and-rescue scenarios. Safety is considered, and stable learning, intervention mechanisms, and verification methods make it safe. Lastly, the chapter gives a future perspective of lifelong learning, explainable behaviors, distributed computing between edge and cloud systems, and transfer of knowledge between robot generations. All in all, it gives a concise and straightforward roadmap for the future of adaptive multi-robot systems. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Chen2025,
	author = {Chen, Zhengyi and Adel, Arash},
	title = {Advancing robotic assembly in construction: Innovations, challenges, and opportunities},
	year = {2025},
	journal = {Automation in Construction},
	volume = {178},
	pages = {},
	doi = {10.1016/j.autcon.2025.106370},
	url = {https://www.scopus.com/pages/publications/105011156192?origin=resultslist},
	abstract = {Robotic assembly in construction (RAC) offers promising solutions to persistent industry challenges, including labor shortages, low productivity, and safety risks, while enabling novel expressive architectures, effective mass customization of building components, and low-waste construction practices. Despite this potential, comprehensive research on the evolving landscape of RAC remains limited. This paper addresses that gap through a systematic review and bibliometric analysis, structured around the [hu]man, machine, material, method, and environment (4M1E) framework. Recent advancements in RAC are synthesized, including innovations in equipment, and human–robot and multi-robot collaborative assembly. Drawing on these insights, a “Design-Sense-Plan-Act-Evaluate” workflow is proposed to articulate RAC's operational logic. Furthermore, major challenges are identified, and future research directions are outlined, including enhancing multi-agent collaboration, exploring multi-material assemblies, integrating artificial intelligence into RAC, and expanding on-site evaluations. This research aims to inform and guide future innovations in RAC. © 2025 Elsevier B.V.},
