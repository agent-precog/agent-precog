}

@ARTICLE{Panda20251763,
	author = {Panda, Niharika and Supriya, M. and Elsts, Atis},
	title = {Prioritized and Multi-Agent Reinforcement Learning-Based TSCH Schedulers},
	year = {2025},
	journal = {IEEE Open Journal of the Computer Society},
