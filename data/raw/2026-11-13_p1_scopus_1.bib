@ARTICLE{Ebrahimi2027100,
	author = {Ebrahimi, Dariush and Sable, Meet and Dai, Qing and Ahuja, Yash and Ajibola, Michael},
	title = {An Integrated Congestion-Aware Framework for Task Allocation and Path Planning in Multi-Agent Pickup and Delivery},
	year = {2027},
	journal = {Lecture Notes in Computer Science},
	volume = {16769 LNCS},
	pages = {100 - 115},
	doi = {10.1007/978-3-032-30494-0_7},
	url = {https://www.scopus.com/pages/publications/105046344804?origin=resultslist},
	abstract = {Large-scale Multi-Agent Pickup and Delivery (MAPD) systems operate in dynamic environments where agents must continuously allocate tasks and plan collision-free paths under strict real-time constraints. As system scale increases, congestion and agent interference become primary bottlenecks, significantly degrading throughput and increasing idle time. This paper presents a scalable lifelong MAPD framework that tightly integrates congestion-aware task allocation with priority-based path planning. Tasks are assigned using heuristic cost estimates that capture both spatial distance and congestion tendencies, reducing the likelihood of bottlenecks before planning occurs. For motion coordination, we extend Priority Inheritance with Backtracking (PIBT) with congestion-aware guidance and deviation refinement, enabling efficient local conflict resolution without global replanning. Extensive experiments in a realistic warehouse benchmark demonstrate that the proposed approach substantially improves task throughput, reduces agent idle time, and remains stable under extreme congestion. The framework scales effectively to scenarios with up to 3,000 agents while consistently meeting real-time execution limits, highlighting its suitability for large-scale robotic logistics systems. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2027.},
