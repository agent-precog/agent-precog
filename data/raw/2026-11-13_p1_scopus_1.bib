	doi = {10.1109/TASE.2026.3677676},
	url = {https://www.scopus.com/pages/publications/105034186122?origin=resultslist},
	abstract = {Recent advancements in Intelligent Connected Vehicle (ICV) systems highlight the critical importance of cybersecurity within these complex networks, yet they still face challenges such as difficulties in precise modeling and poor adaptability to dynamic environments. This paper introduces an innovative control approach by integrating an event-triggered Intermittent Control (IC) strategy within a Zero-Trust Framework (ZTF). This methodology selectively triggers events for vehicle identities and data that meet a predefined trust threshold during each control interval, significantly enhancing the dynamic response capability of the platoon control system. By optimizing resource allocation, this strategy ensures secure and reliable signal transmission and effectively safeguards the platoon against potential malicious node attacks. Consequently, this research offers a novel solution for achieving both security and efficiency in ICV platoon control.Note to Practitioners - This paper is motivated by the increasing security vulnerabilities in Intelligent Connected Vehicle (ICV) systems, where reliable communication is essential for safe platooning. As vehicles become more connected, they face greater risks of cyber-attacks such as data tampering and identity spoofing, which traditional control models struggle to handle in dynamic environments. This work addresses these challenges by introducing a 'Zero-Trust' control framework combined with an event-triggered mechanism. Unlike conventional methods that may implicitly trust network participants, our approach assumes no entity is safe by default and selectively verifies vehicle identities and data integrity. To make this high-security process practical without overloading the communication network, the system uses an 'intermittent' transmission strategy - sending data only when specific trust and safety thresholds are met, rather than continuously. This significantly reduces bandwidth consumption while ensuring the platoon remains stable and secure, even under active attacks. This technology is primarily applicable to autonomous logistics fleets and smart transportation systems. While the current validation is based on numerical simulations and scaled prototypes, future implementation will focus on integrating this protocol with commercial automotive controllers and addressing large-scale network delays.  © 2026 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

