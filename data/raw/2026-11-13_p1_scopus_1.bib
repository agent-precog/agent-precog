@CONFERENCE{Al-Hazaimeh2023,
	author = {Al-Hazaimeh, Obaida M. and Al-Smadi, Ma'moun A.},
	title = {Vehicle To Vehicle and Vehicle To Ground Communication - Speech Encryption Algorithm},
	year = {2023},
	journal = {International Conference on Electrical, Computer, Communications and Mechatronics Engineering, ICECCME 2023},
	pages = {},
	doi = {10.1109/ICECCME57830.2023.10252814},
	url = {https://www.scopus.com/pages/publications/85174001560?origin=resultslist},
	abstract = {Vehicle to vehicle (V2V) communication has many applications in intelligent transportation system (ITS) like smart grid systems, fleet management and traffic light control. It aims to interconnect several components like road infrastructures, wireless networks, sensors, and vehicles. Therefore, it can be utilized to reduce congestion, accidents and fuel consumption. This paper propose a speech encryption system based on a one-dimensional logistic map for vehicle to vehicle communication (V2V) communication in intelligent transportation systems (ITS) to improve road safety and efficiency, where encryption and security play a major role. This study employs a symmetric key cryptography technique for chaotic ciphering. In this approach, a random key table lookup criterion was paired with a one-dimensional chaotic map in order to encrypt speech samples with a high level of security and acceptable speed. XOR encryption and speech row shuffling are used in the proposed technique. Using the difference between the old and new row locations, a combination of variable rotation and inversion was performed to each shuffled row in order to increase the level of security. As a consequence of the testing, the proposed approach was shown to be both efficient and usable. Combining key table and logistic map illustrates the advantages of both high-level security and large random key space. The encrypted speech produced is suitable for practical usage especially in vehicle to vehicle and vehicle to base transmission.  © 2023 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 8}
}

