@ARTICLE{Kerimov2026371,
	author = {Kerimov, Nuraddin and Onegin, Aleksandr and Yakovlev, Konstantin},
	title = {SI-RRT and ST-RRT* for Prioritized Multi-Manipulator Planning: Empirical Evaluation},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {16304 LNAI},
	pages = {371 - 384},
