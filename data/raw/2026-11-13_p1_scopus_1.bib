	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{He2026,
	author = {He, Yao and Xing, Zhitong},
	title = {HGAT-MAPPO: Heterogeneous Graph Attention Multi-Agent PPO for decentralized cooperative navigation of mobile robots in pedestrian-rich dynamic environments},
	year = {2026},
	journal = {Journal of King Saud University - Computer and Information Sciences},
	volume = {38},
	number = {6},
	pages = {},
	doi = {10.1007/s44443-026-01073-y},
	url = {https://www.scopus.com/pages/publications/105047451195?origin=resultslist},
	abstract = {Cooperative navigation of multiple mobile robots in pedestrian-rich dynamic environments remains challenging: each robot must simultaneously avoid moving pedestrians, coordinate implicitly with peer robots, and adapt to varying team and crowd sizes at deployment time. Existing learning-based methods either focus on single-robot scenarios that ignore robot-to-robot non-stationarity, or rely on homogeneous attention mechanisms that fail to model heterogeneous interactions explicitly. This paper proposes Heterogeneous Graph Attention Multi-Agent Proximal Policy Optimization (HGAT-MAPPO), a decentralized cooperative navigation framework combining a heterogeneous graph attention encoder with multi-agent proximal policy optimization under the centralized training and decentralized execution paradigm. The encoder constructs a per-robot heterogeneous interaction graph in which pedestrians and peer robots are treated as distinct node types with type-specific edge functions, enabling each robot to selectively attend to safety-critical neighbors. A risk-sensitive cooperative reward couples a time-to-collision penalty with an individual goal-reaching term and a peer courtesy bonus, encouraging deadlock-free coordination without explicit communication. We further provide theoretical analysis establishing permutation invariance of the encoder, computational cost bounded independently of crowd size, and almost-everywhere Lipschitz continuity of the reward, which together yield stable policy-gradient estimates. Unlike prior heterogeneous graph neural network methods for multi-agent navigation that model pair-wise relation types but lack an explicit safety-aware reward, HGAT-MAPPO is the first framework to unify type-aware graph attention, a continuously differentiable time-to-collision penalty, and a peer courtesy mechanism within a single CTDE actor–critic architecture. Experiments across five Gazebo worlds with up to 55 pedestrians and 2 to 8 robots show that HGAT-MAPPO consistently outperforms single-robot DRL and multi-agent baselines, improving team success rate by up to 9 percentage points and reducing inter-robot collisions by over 60 percent. All results are reported with mean and standard deviation over four independent random seeds, with statistical significance confirmed via paired bootstrap tests. Sim-to-real transfer on TurtleBot3 platforms confirms that the policy generalizes without retraining to indoor and semi-structured outdoor environments. © The Author(s) 2026.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

@ARTICLE{Sanabria2026,
	author = {Sanabria, Dan},
	title = {OpenAI single-agent LLM architecture reduces computational overhead relative to multi-agent orchestration in a simulated mars rover decision-support benchmark},
