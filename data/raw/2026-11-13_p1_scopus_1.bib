	url = {https://www.scopus.com/pages/publications/105049606889?origin=resultslist},
	abstract = {This study evaluates and prioritizes green transportation strategies in the European road freight transport industry. A hybrid multi-criteria decision-making (MCDM) approach consisting of Fuzzy WENSLO (Weights by Envelope and Slope) and Fuzzy SWAS (Schweizer–Sklar Weighted Assessment System) methods was developed to address the relevant decision-making problem, and the PESTEL (Political, Economic, Social, Technological, Environmental, and Legal) approach was integrated into the model to establish the alternatives and criteria discussed in the study on a solid basis and to structure the decision problem correctly. The results show that the "Social Impact" criterion (denoted C12, with a normalized priority weight of approximately 0.162; throughout the paper the label Cn identifies the n-th evaluation criterion and the accompanying value is its dimensionless normalized weight, while the codes used for strategy alternatives, e.g., EC-3, denote the corresponding PESTEL-based green-transport options) is the most effective. This finding shows that to manage green transformation processes and achieve sustainability goals successfully, the impact of strategies on society must be addressed, depending on the potential of the sector to create jobs, protect the safety and health of workers, and reduce its positive effects on local and national economies, environmental impacts, and external costs. Secondly, Regulatory Compliance (C4) and Public Perception and Brand Value (C9) were noted as effective criteria that followed. Regarding strategy alternatives, the EC-3 Financial support mechanisms for green transportation strategy were determined as the top priority alternative. These mechanisms stood out as the most critical element that would ensure high-cost fleet transformation in the first place. In this context, the high initial costs required by investments in electric and hydrogen trucks and infrastructure can be overcome thanks to subsidies, grants, tax exemptions and EU funds. In this context, the valuable insights and policy recommendations highlighted emphasize prioritizing awareness campaigns, financial incentives, and net-zero emission targets while strengthening economic tools to reduce road dependency. These findings and insights provide policymakers with a systematic, analytical, and data-based decision-making tool to accelerate freight transportation's green transformation. This mathematical model can be an extremely valuable and reliable roadmap for practitioners in the green transformation process. Finally, the analysis results obtained through the robustness checks confirmed the validity and consistency of the proposed model and the results obtained. © 2026 Elsevier Ltd.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Kim20266859,
