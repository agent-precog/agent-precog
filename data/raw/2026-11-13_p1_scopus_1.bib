@ARTICLE{Liu20269128,
	author = {Liu, Fang and Zhu, Erchao and Tan, Jiedan and Tong, Jingwen and Wang, Taotao and Zhang, Shengli},
	title = {An LLM-Agent-Based Framework for Age of Information Optimization in Heterogeneous Multiple Access Networks},
	year = {2026},
