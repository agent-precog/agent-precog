@CONFERENCE{Saxena2026169,
	author = {Saxena, Gaurav and Mohanty, Niladri Bihari},
	title = {A Polyglot OpenTelemetry Framework for Cloud-Native Reliability and Performance Engineering in Connected-Vehicle Platforms},
	year = {2026},
	journal = {Proceedings - 2026 56th Annual IEEE/IFIP International Conference on Dependable Systems and Networks - Supplemental Volume, DSN-S 2026},
	pages = {169 - 175},
	doi = {10.1109/DSN-S70715.2026.00040},
	url = {https://www.scopus.com/pages/publications/105050745979?origin=resultslist},
	abstract = {The automotive industry's shift to software-defined connected vehicles has created enterprise-scale distributed systems where reliability directly impacts customer safety. Large automotive engineering organizations run dozens of cloud microservices-built by independent teams in Java, Go, and Python-that must jointly serve safety-sensitive commands, fleet-wide over-the-air (OTA) updates, and millions of simultaneous user journeys. We present a polyglot observability framework built on the Open-Telemetry (OTel) standard that unifies distributed tracing, custom metrics, and structured logging across heterogeneous microservices on a shared Kubernetes platform. The framework eliminates per-team instrumentation overhead through opinionated SDK wrappers, W3C context propagation, and an in-process mock collector for CI signal verification, while a Crossplane CRD layer auto-provisions dashboards, alerts, and incident-routing from a team-authored YAML, reducing time-to-observability from days to a single code review. Evaluated through concrete automotive use cases, the framework demonstrates less than 2 ms median added latency from instrumentation, a 63% reduction in mean time to detect (MTTD), and continuous DevOps Research and Assessment (DORA) metric collection via Apache DevLake complemented by CI/CD pipeline traces for span-level root-cause diagnosis.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

