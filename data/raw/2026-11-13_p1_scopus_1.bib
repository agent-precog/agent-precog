@CONFERENCE{Kim2024230,
	author = {Kim, Heeyeon and Hong, Minji and Lee, Jaeho and Choi, Han-Lim},
	title = {GNN-based Task Assignment in Combat System},
	year = {2024},
	journal = {15th Asia-Pacific International Symposium on Aerospace Technology, APISAT 2024},
	volume = {1},
	pages = {230 - 239},
	url = {https://www.scopus.com/pages/publications/105014918866?origin=resultslist},
	abstract = {The coordination of heterogeneous multi-robot systems in combat environments presents significant challenges, particularly in efficiently allocating tasks that match each robot's unique capabilities. Successful execution of complex battlefield missions, which often involve diverse tasks such as surveillance, reconnaissance, and rescue operations, depends on the ability to adapt to high levels of unpredictability, especially when faced with sudden, emergent events. Traditional approaches that rely solely on assigning the nearest available robot to an urgent task can result in suboptimal resource allocation and negatively impact the overall mission outcomes. This is because such methods do not consider the broader context, including the progress of ongoing missions, the sequence of upcoming tasks, and the overall strategic objectives. Therefore, there is a critical need for flexible and intelligent algorithms that can dynamically reallocate tasks in response to unexpected events while minimizing disruption to the mission's structure and enhancing the robustness of the entire system. In this paper, we introduce a novel replan algorithm that leverages Graph Neural Networks (GNNs) to address these challenges in multi-agent systems. GNNs have emerged as a powerful tool for modeling and analyzing complex relational data, making them particularly well-suited for environments where the relationships between entities, such as robots and missions, are as crucial as the entities themselves. Our GNN-based algorithm is specifically designed to capture and represent the complex spatio-temporal relationships between agents, missions, and the interactions between them. This enables the algorithm to make more informed decisions about task reallocation in the face of unexpected events, going beyond simple proximity-based approaches.Through extensive simulation experiments, we demonstrate that our GNN-based replan algorithm effectively manages task reallocation not only by considering the simplest approach of assigning the nearest available robots to urgent tasks but also by intelligently evaluating other critical factors, such as the progress of ongoing missions and the sequence of upcoming tasks. Our findings reveal that proximity alone does not always lead to optimal outcomes. In certain scenarios, particularly where the status of an ongoing mission is critical or where future task sequences must be preserved, the algorithm strategically opts for support from more distant robots. This approach ensures that overall mission objectives are met with greater efficiency and effectiveness, reducing the likelihood of resource misallocation and improving the system's ability to adapt to dynamic combat environments. The adaptability and intelligence of the proposed GNN-based replan algorithm have significant implications for real-world applications beyond military operations. This approach is highly applicable to other multi-agent coordination scenarios, such as disaster response and autonomous exploration, where dynamic and intelligent task allocation is crucial. Looking forward, future research could focus on enhancing the model's ability to predict and preemptively adjust to potential mission failures by incorporating more sophisticated machine learning techniques. Additionally, exploring the scalability of the algorithm to accommodate larger and more diverse agent systems could further validate its robustness and utility in a wider range of operational contexts. Ultimately, this study contributes to the development of advanced, real-time decision-making systems capable of handling the complexities of dynamic, multi-agent environments. © 2024 15th Asia-Pacific International Symposium on Aerospace Technology, APISAT 2024. All rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Wang2024,
	author = {Wang, Zheyu and Dong, Chengju and Qian, Jie and Duan, Chaoqun and Sheng, Bo and Wang, Yuanhang},
	title = {Structural topic modeling-based systematic review for service robots’ fault diagnosis: content, popularity and regional differences},
