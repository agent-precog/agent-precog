@CONFERENCE{Huang2025,
	author = {Huang, Bingling and Haaga, Maximillian and Ji, Hao},
	title = {EMERGENT ROLE SPECIALIZATION IN SELF-ORGANIZED SYSTEMS VIA K-MEANS-BASED BEHAVIORAL ANALYSIS},
	year = {2025},
