	url = {https://www.scopus.com/pages/publications/105042152956?origin=resultslist},
	abstract = {Autonomous large language model (LLM) agent systems are increasingly used for complex, long-horizon tasks involving planning, tool invocation, memory updates, and inter-agent collaboration. While these systems offer significant capability gains, they also introduce critical reliability and trust challenges due to stochastic generation, semantic drift, and error propagation during execution. Existing approaches to LLM reliability primarily rely on offline evaluation, prompt engineering, or post-hoc filtering, which are insufficient for detecting failures that emerge dynamically at runtime.In this paper, we propose Trust-Aware Runtime Verification (TARV), a model-agnostic framework for continuously monitoring and validating autonomous LLM agent behavior during execution. TARV operates as a non-intrusive middleware that intercepts observable agent actions, memory transitions, and inter-agent communication through a runtime instrumentation layer. Specialized verification agents compute multi-dimensional trust signals capturing action validity, constraint adherence, memory consistency, and communication coherence, which are aggregated into continuous trust scores for real-time monitoring.We implement TARV in a multi-agent LLM execution environment and evaluate its effectiveness across tool-oriented, collaborative, and long-horizon task scenarios. Experimental results demonstrate that TARV detects runtime trust violations with high precision while maintaining a low false positive rate. Moreover, TARV introduces a small and stable execution overhead on a single NVIDIA A4000 GPU and significantly reduces cascading failures, leading to higher task success rates, particularly in collaborative and long-horizon workflows.These findings indicate that trust-aware runtime verification provides a practical and effective mechanism for improving the reliability and robustness of autonomous LLM agent systems. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

