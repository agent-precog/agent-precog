	abstract = {As space exploration moves farther from Earth, robotics will play an ever-increasing role in NASA’s upcoming missions. Farther scenarios present new challenges, such as the absence or a very limited presence of human supervision for long periods of time. Spacecraft will have to be more dependent on automation and robotic agents to perform maintenance and repair tasks. Rather than having robots work side by side with humans, robots will have to work side by side with each other. In response to these needs, this paper presents PLUMMRS (A Collection of Plan Ledgers and Unified Maps for Multi-Robot Safety), a software framework that facilitates sharing of environmental and internal state information to enable safe, efficient navigation and manipulation tasks by heterogeneous robot teams working in a shared workspace. The goal of PLUMMRS is to provide simple APIs for existing single-agent planning and execution systems to leverage. This will allow previously individualistic robots to be used safely in multi-agent contexts. This paper introduces a prototype version of PLUMMRS. Our proposed design consisted of 3 modules: (1) A Unified Representation Map, which collects the individual robots information in a unique message, (2) A Robot Arbiter, which makes sure that robots intended motions do not collide with each other, assuring a safe, collision-free operation under ideal operations, and (3) A Safety Monitor, a module that constantly oversees the robots motions and alerts all the agents when operation does not go as expected and might endanger other supposedly safe motions. PLUMMRS represent an improvement over state-of-the-art robot monitoring frameworks that are currently deployed in NASA operations and elsewhere. We present these modules, built on top of CRAFTSMAN [1], our existing robot-control framework, and a number of proof-of-concept demonstrations showcasing the utility of PLUMMRS in scenarios such as the ISS with a small team of robots involving 2 Astrobees and a Robonaut, performing both independent (colocated) tasks and collaborative tasks. Copyright © 2021 by TRACLabs, Inc. All rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Mannucci2021257,
