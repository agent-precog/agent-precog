}

@CONFERENCE{Bampi2026177,
	author = {Bampi, Matheus Dussin and Pereira, Pedro Henrique Morgan and De Freitas, Edison Pignaton},
	title = {AAS-Driven Architecture for Semantic Interoperability in UAV Communication Networks},
	year = {2026},
	journal = {Proceedings of the 2026 IEEE International Conference on Industry 4.0, Artificial Intelligence, and Communications Technology, IAICT 2026},
	pages = {177 - 184},
	doi = {10.1109/IAICT71158.2026.11620906},
	url = {https://www.scopus.com/pages/publications/105046957725?origin=resultslist},
	abstract = {The increasing deployment of Unmanned Aerial Vehicles (UAVs) in collaborative applications, such as precision agriculture and logistics, creates a critical need for reliable, high-quality communication. This is often hindered in heterogeneous fleets by a lack of semantic interoperability, where disparate data models and proprietary protocols hinder safety-critical, coordinated tasks. This paper proposes an Industry 4.0-based Digital Twin-driven architecture using the Asset Administration Shell (AAS) to establish a standardized semantic layer for multi-UAV systems, enabling reliable, protocol-agnostic interoperability. This proposal introduces a multi-UAV architecture that establishes four key communication layers, explicitly modeling the interactions among UAVs, their digital twins, and the Ground Control Station (GCS) to enable standardized, interoperable data exchange across all system domains. A core contribution is the design of a formal UAV Submodel, which acts as a "common language"by standardizing critical data elements, units, identifiers, and semantic references for flight performance, navigation, system health, and communication QoS. The model integrates a semantic gateway concept to bridge common UAV protocols (e.g., MAVLink, ROS) to the AAS. The model and discussion illustrate that the AAS-driven approach provides a feasible semantic layer for runtime multi-UAV systems, while the final communication quality remains dependent on the underlying wireless network. Numerical validation on edge hardware demonstrates the architecture's feasibility, achieving an average internal translation latency of 0.006 ms and a total end-to-end latency of 8.34 ms with minimal CPU overhead (< 0.8%). The architecture is presented as a robust framework for supporting key application challenges, including decentralized collision avoidance, adaptive QoS-aware networking, and dynamic plug-and-operate fleet management. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Reddy2026,
	author = {Reddy, B Sivakumar and Harisha, S.K. and Ranganayakulu, Jinka and Krishna, M.},
	title = {Reinforcement Learning-Based AI Framework for Decision-Making and Path Optimization in Swarm Robots},
	year = {2026},
	journal = {Journal of The Institution of Engineers (India): Series C},
	pages = {},
	doi = {10.1007/s40032-026-01471-1},
	url = {https://www.scopus.com/pages/publications/105053977656?origin=resultslist},
	abstract = {This study proposes a decentralized multi-agent reinforcement learning (MARL) framework for decision-making and path optimization in swarm robotic systems operating in dynamic environments. The proposed framework integrates Deep Q-Network (DQN) and actor–critic learning mechanisms to combine value-based local action selection with policy-based cooperative refinement. DQN is employed for local navigation and obstacle avoidance, while the actor–critic mechanism refines the navigation policy using long-term reward feedback and interactions among neighboring robots. Each robot operates as an autonomous agent and constructs its state representation from LiDAR, IMU, odometry, and neighboring-agent information without relying on a centralized controller. The framework was implemented in a physics-based Robot Operating System (ROS)–Gazebo simulation environment using differential-drive mobile robots and was evaluated under dynamic obstacle conditions for different swarm sizes. Performance was assessed using task completion time, collision rate, energy efficiency, and scalability, with the proposed method compared against the A* algorithm and the Potential Field method. Simulation results show that the proposed RL framework achieved a task completion time of 77 s, a collision rate of 7%, and an energy efficiency of 88%, compared with 100 s, 15%, and 76%, respectively, for the A* algorithm. The results show a 23.0% reduction in time for task completion, a 53.3% reduction in collision rate, and a 15.8% improvement in energy efficiency compared to A*. The framework also showed effective navigation performance when the swarm size increased from 5 to 50 robots. Results demonstrate the potential of the proposed hybrid MARL architecture for decentralized swarm coordination, adaptive navigation, collision avoidance, and energy-efficient path optimization in dynamic robotic environments. © The Institution of Engineers (India) 2026.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Reji2026276,
	author = {Reji, Jeevan and Seye, Sokhna},
	title = {Opti-Shield: Multi Agent Path Planning in Presence of Adversarial Agents},
	year = {2026},
	journal = {IEEE International Conference on Electro Information Technology},
	pages = {276 - 280},
	doi = {10.1109/eIT68936.2026.11670438},
	url = {https://www.scopus.com/pages/publications/105050758893?origin=resultslist},
	abstract = {The Artificial Bee Colony (ABC) Algorithm is a prominent example of Swarm Intelligence that has been widely utilized in applications such as multi-agent search and rescue operations, distributed environmental monitoring, and resource gathering. However, in real-world scenarios, cooperative agents often encounter dynamic threats, including adversarial robots, malicious actors, or unpredictable environmental hazards. If these adversaries successfully penetrate critical, vulnerable areas-such as supply depots, charging stations, or human-occupied zones-the consequences can be disastrous. To address this challenge, we propose Opti-Shield, a decentralized algorithm capable of simultaneously gathering goal states and defending protected areas from risk-averse adversaries. Opti-Shield dynamically allocates agents to intercept and herd adversaries away using a StringNet geometric formation. Adversaries are encircled by defender robots and actively steered away from protected zones toward designated safe zones. By combining the highly efficient, decentralized collection strategy of the Multi-Agent Artificial Bee Colony (M-ABC) algorithm with the robust defensive capabilities of StringNet, our approach enables a heterogeneous swarm of robots to effectively multitask. This dynamic roleswitching eliminates the need to maintain a separate, dedicated set of defensive agents, significantly reducing idle time and optimizing the swarm's overall makespan. Experimental results across sparse, clustered, and dense configurations demonstrate substantial improvements in completion rates and operational efficiency compared to static baselines. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

