	author = {Zhou, Minghao and Zhou, Huilong and Lai, Jingang and Li, Junhua and Wang, Dong and Chi, Ying},
	title = {Anti-Skid Control of Distributed Drive Electric Vehicle Drive Based on Terminal Sliding Mode},
	year = {2025},
	journal = {Youth Academic Annual Conference of Chinese Association of Automation, YAC},
