@CONFERENCE{Vallverdu2025777,
	author = {Vallverdu, Jordi and Xu, Ange},
	title = {Ethical Proof-Carrying Causal Answers on CLadder},
	year = {2025},
	journal = {Proceedings - 2025 IEEE/WIC International Conference on Web Intelligence and Intelligent Agent Technology, WI-IAT 2025},
	pages = {777 - 782},
	doi = {10.1109/WI-IAT67162.2025.00124},
	url = {https://www.scopus.com/pages/publications/105051501059?origin=resultslist},
	abstract = {Ethical, inclusive, and human-centered AI requires not only accurate models but also methods that are reproducible, resource-conscious, and accountable to the people affected by their outputs. In causal reasoning, multi-agent collaboration has been promoted as a route to reliability; however, its ethical profile is unclear once we account for cost, transparency, and the risk of over-claiming. We revisit the CLadder [21] benchmark proposed to test whether LLMs causal reasoning capability and make two contributions aligned with the aims of EthicAI 2025 (privacy, fairness, sustainability, unlearning, and domain ethics). First, we provide a paired, cost-aware comparison of five prompting strategies vanilla, simple Chain-of-Thought (CoT), guided CoT, Self-consistency [22], and a multi-agent system evaluated on a test set. With phi-4, CoT reaches 78.20% (95% CI: 74.37 81.60%), while multi-agent variants achieve 76.80% (72.90 80.29%) and 77.56% (73.74 81.04%) with 0.83 and 10.35 slower latency; These results indicate that, on this task, multi-agent collaboration adds compute and latency without commensurate benefit a sustainability and inclusivity concern for groups with limited resources. Second, we introduce Proof-Carrying Causal Answers (PCCA), a Fast/Slow scheduler that attaches verifiable certificates to answers (backdoor/frontdoor checks; minimal twin/SWIG for counterfactuals) and invokes a bounded falsifier when confidence is low. PCCA is designed to improve the Certified-Answer Rate while constraining cost, and it produces auditable evidence that supports privacy-conscious workflows and targeted unlearning: certificates and logs allow specific items to be re-run and re-certified without repeating full experiments. We discuss ethical implications for decision-making in safety-critical domains (robotics, wearables, healthcare), where unverifiable causal claims can impose realworld harms. By linking causal identification to verifiable computation, PCCA turns moral principles sustainability, accountability, and epistemic responsibility into measurable engineering constraints. Overall, our findings argue for responsible causal AI by default: start simple, measure cost, certify or falsify claims, and escalate orchestration only when evidence justifies the added burden.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

