@ARTICLE{Ibrahim2026107177,
	author = {Ibrahim, Abdalrahman and Machot, Fadi A.L. and Kyamakya, Kyandoghere},
	title = {Cyber-Physical GraphRAG: Safe, Real-Time, and Scalable Orchestration of Large-Scale Autonomous Fleets},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {107177 - 107195},
	doi = {10.1109/ACCESS.2026.3706610},
	url = {https://www.scopus.com/pages/publications/105042769550?origin=resultslist},
	abstract = {Large-scale autonomous fleet orchestration requires both geometric reasoning for path planning and semantic reasoning for task allocation and policy compliance. Existing approaches either inject full robot state into Large Language Model (LLM) context windows, incurring prohibitive latency and token costs that scale linearly with fleet size, or rely on static Retrieval-Augmented Generation (RAG) pipelines that lack temporal awareness and cannot distinguish current state from stale history. Recent Temporal Graph-based RAG (GraphRAG) frameworks address temporal ambiguity for document retrieval but operate on discrete calendar-based time models unsuitable for the sub-second dynamics of cyber-physical systems. This paper introduces the paradigm of Cyber-Physical GraphRAG, a category of retrieval-augmented generation designed for real-time, safety-critical orchestration, and presents Hybrid State-Knowledge GraphRAG (HSK-GraphRAG) as its first realization. The framework contributes three innovations: (1) a Signal-Weighted Semantic Decay function that models physical freshness using continuous exponential decay incorporating wireless signal quality; (2) a Topological Safety Firewall that deterministically prevents invalid, stale, or non-compliant agents from reaching the LLM reasoning layer; and (3) stale-history-insensitive retrieval via validity-tier indexing, where query cost scales only with active agents. Experimental validation demonstrates sub-10 ms graph-query latency (excluding LLM inference), complete safety constraint compliance within the defined graph-based logical safety model, zero ghost-agent selection, and robustness under hardware-in-the-loop dataset replay with realistic sensor noise. These results establish Cyber-Physical GraphRAG as a viable foundation for deploying LLM-based reasoning in high-frequency autonomous fleet control. © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@BOOK{Ashraf2026343,
	author = {Ashraf, Gazala Yasmin and Siddiqui, Imran Nadeem and Sivarethinamohan, R.},
	title = {Real-World Deployment of Reinforcement Learning in Robotics: Lessons from Industry},
	year = {2026},
	journal = {Reinforcement Learning: Autonomous Systems, Ethical AI, Robotics},
	pages = {343 - 359},
	doi = {10.1515/9783111633909-014},
	url = {https://www.scopus.com/pages/publications/105049451008?origin=resultslist},
	abstract = {Reinforcement learning (RL) in robotics is a learning process, where robotic agents learn to perform tasks by trial and error through interactions with their environment, receiving feedback in the form of rewards or penalties so that their performance can be improved over time. A framework helps to understand RL’s role in robotic operation and decision-making with the aim of achieving long-term goals by maximizing cumulative rewards, without requiring overt programming for every situation, including uncertainty. This allows autonomous agents to adapt to complex and dynamic environments. Behaviors are developed in robots through these techniques for applications like navigation, locomotion, manipulation etc., where lack of environmental consistency fails to provide pre-programmed rules. This chapter explores how RL in robotics is transforming theoretical concepts into real-world industrial deployments. After integrating deep learning with RL approaches like DQN (deep Q-networks) and PPO (proximal policy optimization), robotic perceptions are significantly enhanced, enabling high-level environments policy learning. Industrial sectors that have incorporated RL to enable robots to learn control policies through environmental interaction are basically from manufacturing (FANUC), logistics (Amazon Robotics), healthcare (Stanford’s adaptive exoskeletons), and autonomous navigation (Waymo). This chapter analyzes key case studies from these domains, explaining how RL has been implemented to solve problems such as real-time adaptive control, object manipulation, and dynamic path planning. The discussion also explains major implementation challenges like the simulation-to-reality (sim2real) gap [4], sample inefficiency, safety in exploration, and the black-box nature of deep RL models. The chapter outlines best practices with the help of practical lessons from industry, such as hybrid learning methods and the use of digital twins, for overcoming these challenges. Finally, the chapter explores future research directions, including few-shot learning, explainable RL, and federated learning frameworks, which aim to expand the scalability and trustworthiness of RL-based robotic systems in safety-critical applications. © 2026 Walter de Gruyter GmbH, Genthiner Straße 13, 10785 Berlin, Germany.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Gavrilă20263,
	author = {Gavrilă, Mihaela and Bărbuță, Delia-Elena and Ambrozie, Roxana-Emanuela and Murariu, Mădălina-Giorgiana and Fotache, Marin and Tărniceriu, Daniela},
