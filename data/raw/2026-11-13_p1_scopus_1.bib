	doi = {10.1016/j.comnet.2026.112837},
	url = {https://www.scopus.com/pages/publications/105052972316?origin=resultslist},
	abstract = {The Industrial Internet of Things (IIoT) leverages 5G to enhance automation efficiency, reduce operational costs, and improve safety. However, IIoT systems face several challenges, including dynamic network conditions, limited spectrum resources, stringent latency requirements, energy consumption, and high-security demands. This study investigates IIoT resource allocation by proposing deep reinforcement learning-based algorithms for secure short-packet communication, uplink power and channel allocation in full-duplex networks, and edge computing task offloading. The study formulates an optimization problem for joint power and bandwidth allocation in secure short-packet communication, considering minimum secure transmission capacity, limited total bandwidth, energy consumption, and security constraints. A bandwidth and power allocation algorithm based on the Double Deep Q-Network (DDQN) and Proximal Policy Optimization (PPO) enables adaptive resource allocation while satisfying the communication and security constraints considered. For IIoT uplink communication, we formulate a joint channel and power allocation problem to maximize total secure throughput while satisfying throughput, security, and latency requirements. We employ a DDQN-based sub-channel allocation network and a PPO-based power allocation network to improve the IIoT system's overall throughput compared with the evaluated learning-based approaches. Lastly, the study proposes task offloading and device association algorithms based on optimized single-agent and multi-agent deep reinforcement learning. The proposed framework employs a DDPG-based power allocation network and a DDQN-based device association network to coordinate communication and computation resource allocation. Simulation results demonstrate that the proposed algorithms improve secure resource allocation and effectively reduce the maximum total task delay of the IIoT system. © 2026 Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

