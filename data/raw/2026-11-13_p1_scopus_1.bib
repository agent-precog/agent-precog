@ARTICLE{Saraswat2026,
	author = {Saraswat, Shelesh Krishna and Zneid, Basem Abu and Mohammad, Hessan and Sollapur, Shrishail B. and Mohapatra, Tapas Kumar and Anand, T. and Kaur, Gaganjot and Bisht, Yashwant Singh},
	title = {Robust Decentralized Control and Dynamic Modeling of Cooperative Quadrotor Formations for Slung Rigid-Plate Transportation Under 3D Impact Loads},
	year = {2026},
