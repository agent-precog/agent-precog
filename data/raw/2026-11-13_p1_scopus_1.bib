@ARTICLE{Andreychuk202029,
	author = {Andreychuk, Anton},
	title = {Multi-agent path finding with kinematic constraints via conflict based search},
	year = {2020},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {12412 LNAI},
