	author = {Popoola, Damilola and Bhattacharya, Souradeep and Hahn, Adam and Govindarasu, Manimaran},
	title = {AI-Enabled Security Operations Center (SOC) for Modern Power Grids: Bridging the Gap Between the Cybersecurity and Grid Operations},
	year = {2026},
	journal = {IEEE Power and Energy Magazine},
	volume = {24},
