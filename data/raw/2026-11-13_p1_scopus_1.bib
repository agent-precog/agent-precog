	doi = {10.1201/9781003663461-3},
	url = {https://www.scopus.com/pages/publications/105037572597?origin=resultslist},
	abstract = {Human response time, constrained maneuverability in dynamic battlefield environments, and high communication latency in GPS-denied or jammed environments are the main drawbacks of conventional defense systems that are highly reliant on human observation and remotely operated robots. During the critical course of operations, such vulnerabilities compromise personnel safety alongside operational efficiency. To address such issues, we introduce ARMSec, an Autonomous Robotic Monitoring System comprising a Vision-based Threat Assessment Module (VTAM) and a Multi-Agent Reinforcement Learning (MARL) framework to enable autonomous navigation and real-time decision-making in adversarial and unstructured environments. ARMSec deploys a swarm of heterogeneous robotic agents with LIDAR, infrared cameras, and encrypted communication modules. Distributed attention mechanism and Proximal Policy Optimization (PPO) are utilized in training the system so that the system is enabled to detect suspect behavior, allocate dynamic patrol, and activate countermeasures independently. Relative to earlier semi-autonomous systems, experimental deployment in a simulated urban warfare scenario (constructed with Gazebo and ROS) had a 94.8% mission success rate, a 67.4% decrease in threat response time, and a 91.3% decrease in undetected incursions. Moreover, ARMSec demonstrated consistent performance under signal jamming and bad weather, affirming its robustness. The suggested framework makes integration with national defense communication networks easy and can be fully integrated on commercially sold autonomous platforms. ARMSec is an efficient and secure alternative for the next generation defense systems since it offers a radical enhancement in autonomous battlefield intelligence as well as perimeter defense. © 2026 Saurav Mallik, Sandeep Kumar Mathivanan, Basu Dev Shivahare.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Stodt2025,
	author = {Stodt, Fatemeh and Stodt, Jan and Alshawki, Mohammed and Salimi Sratakhti, Javad and Reich, Christoph},
	title = {Catch Me If You Can: Rogue AI Detection and Correction at Scale},
	year = {2025},
	journal = {Electronics (Switzerland)},
	volume = {14},
	number = {20},
	pages = {},
	doi = {10.3390/electronics14204122},
	url = {https://www.scopus.com/pages/publications/105020904291?origin=resultslist},
	abstract = {Modern AI systems can strategically misreport information when incentives diverge from truthfulness, posing risks for oversight and deployment. Prior studies often examine this behavior within a single paradigm; systematic, cross-architecture evidence under a unified protocol has been limited. We introduce the Strategy Elicitation Battery (SEB), a standardized probe suite for measuring deceptive reporting across large language models (LLMs), reinforcement-learning agents, vision-only classifiers, multimodal encoders, state-space models, and diffusion models. SEB uses Bayesian inference tasks with persona-controlled instructions, schema-constrained outputs, deterministic decoding where supported, and a probe mix (near-threshold, repeats, neutralized, cross-checks). Estimates use clustered bootstrap intervals, and significance is assessed with a logistic regression by architecture; a mixed-effects analysis is planned once the per-round agent/episode traces are exported. On the latest pre-correction runs, SEB shows a consistent cross-architecture pattern in deception rates: ViT (Formula presented.), CLIP (Formula presented.), Mamba (Formula presented.), RL agents (Formula presented.), Stable Diffusion (Formula presented.), and LLMs (Formula presented.) (20 scenarios/architecture). A logistic regression on per-scenario flags finds a significant overall architecture effect (likelihood-ratio test vs. intercept-only: (Formula presented.), (Formula presented.)). Holm-adjusted contrasts indicate ViT is significantly higher than all other architectures in this snapshot; the remaining pairs are not significant. Post-correction acceptance decisions are evaluated separately using residual deception and override rates under SEB-Correct. Latency varies by architecture (sub-second to minutes), enabling pre-deployment screening broadly and real-time auditing for low-latency classes. Results indicate that SEB-Detect deception flags are not confined to any one paradigm, that distinct architectures can converge to similar levels under a common interface, and that reporting interfaces and incentive framing are central levers for mitigation. We operationalize “deception” as reward-sensitive misreport flags, and we separate detection from intervention via a correction wrapper (SEB-Correct), supporting principled acceptance decisions for deployment. © 2025 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Zhang2025,
	author = {Zhang, Wanying and Wang, Jing and Qin, Geng and Kuntal, Satpathi and Gong, Fuzhong and Yan, Ran},
