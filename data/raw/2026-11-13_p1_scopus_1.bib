@CONFERENCE{Chandrasekaran2026,
	author = {Chandrasekaran, Muthukumarapandian},
	title = {A Supervisor-Coordinated Multi-Agent Architecture with ReAct Reasoning and FHIR Integration, Achieving 41% Diagnostic Time Reduction in Telemedicine Workflows},
	year = {2026},
	journal = {2026 Middle East and North Africa Communications Conference, MENACOMM 2026},
	pages = {},
