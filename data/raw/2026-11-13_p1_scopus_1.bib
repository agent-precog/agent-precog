	doi = {10.1109/CCSSTA69471.2026.11635209},
	url = {https://www.scopus.com/pages/publications/105049047597?origin=resultslist},
	abstract = {Multi-ship collision avoidance is a safety-critical problem for autonomous maritime navigation because each vessel must balance goal reaching, interaction risk, and time constraints. Rule-based controllers are interpretable but often conservative, whereas standard multi-agent reinforcement learning (MARL) can improve task progress but may generate unsafe actions when pairwise risk is not explicitly represented. This paper proposes a Risk-Graph Enhanced Multi-Agent Proximal Policy Optimization(MAPPO) framework with a decoupled Default Safety Shield. Pairwise encounter risks are constructed from distance, distance at closest point of approach (DCPA), and time to closest point of approach (TCPA), and a risk-aware graph actor aggregates information from high-risk neighbors. During execution, the shield supervises the learned action and applies soft or hard correction according to the current risk level. In a simplified 4-ship mixed scenario, the proposed method reduces the collision rate from 0.370 to 0.067 compared with MAPPO-MLP and improves the success rate from 0.113 to 0.220 compared with a rule-based controller. Additional safety-level and random-scenario analyses show that the method improves extreme close-range safety, but medium-range near-miss reduction and time-constrained convergence remain challenging. The results indicate that risk-aware graph modeling and shielded execution provide a practical safety-efficiency compromise in simplified multi-ship collision-avoidance simulation. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
