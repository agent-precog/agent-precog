@ARTICLE{Alsaleh2022,
	author = {Alsaleh, Rushdi and Sayed, Tarek},
	title = {Do road users play Nash Equilibrium? A comparison between Nash and Logistic stochastic Equilibriums for multiagent modeling of road user interactions in shared spaces},
