	volume = {31},
	number = {5},
	pages = {5112 - 5124},
	doi = {10.1109/TMECH.2026.3651393},
	url = {https://www.scopus.com/pages/publications/105028582917?origin=resultslist},
	abstract = {Generating high-quality, collision-free trajectories in real time for multiagent systems is challenging due to uncertainties arising from robot localization, network disturbances, and sensor errors. Existing approaches typically address this problem either deterministically, relying on reliable and consistent communication networks, or through approximations that often lead to overly conservative trajectories. In this article, we propose a method for generating trajectories by accounting for collision probabilities involving uncertain neighboring agents and obstacles, which is designed for multiple ground vehicles operating in a communication-free environment with limited detection ranges and Gaussian noise. A receding horizon framework is developed and formulated as a joint spatial-temporal chance-constrained optimization problem using nonlinear model predictive control (JSTC-MPC). To ensure the reliability and computational efficiency of the trajectories, an analytical and tighter approximation of joint spatial-temporal collision probabilities is introduced, effectively handling constraints from neighboring vehicles and obstacles at different JSTC-MPC stages. Furthermore, we propose a real-time replanning strategy that leverages chance-constrained, time-aware Voronoi spaces to address safety concerns in the presence of infeasible solutions. The effectiveness of the proposed method is validated through simulations and real-world experiments.  © 1996-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
