@ARTICLE{Khaddour2026,
	author = {Khaddour, Sulieman and Abu-Abed, Fares and Bogatikov, Valery},
	title = {A Novel Security Index for Assessing Information Systems in Industrial Organizations Using Web Technologies and Fuzzy Logic †},
	year = {2026},
