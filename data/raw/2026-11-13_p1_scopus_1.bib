@ARTICLE{Tian2025326,
	author = {Tian, Haoran and Yang, Yang and Meng, Jin and Wang, Shifeng and Xing, Songqi and Cong, Haifang},
	title = {A CBAM-ResNet Based PPO Framework for Safe Navigation in Dynamic Pedestrian Environments},
	year = {2025},
