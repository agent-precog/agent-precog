@ARTICLE{Hirayama202612072,
	author = {Hirayama, Taisei and Yoshida, Kohei and Sakaji, Hiroki and Noda, Itsuki},
	title = {Detour-Delta Task Assignment for Reservation-Based Online MAPD},
