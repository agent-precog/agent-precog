@ARTICLE{Rusli2026118,
	author = {Rusli, Leonard Priyatna and Jonathan, Michael and Rusyadi, Rusman},
	title = {Multi-LiDAR SLAM and intelligent navigation for autonomous logistic robots in ROS2 environments},
	year = {2026},
	journal = {Journal of Mechatronics, Electrical Power, and Vehicular Technology},
	volume = {17},
