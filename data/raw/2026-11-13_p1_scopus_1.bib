	year = {2025},
	journal = {IEEE International Conference on Robotics and Biomimetics, ROBIO},
	pages = {377 - 382},
	doi = {10.1109/ROBIO66223.2025.11378438},
	url = {https://www.scopus.com/pages/publications/105034740850?origin=resultslist},
	abstract = {To address the challenges of learning capture tasks in complex obstacle environments and the reliance on manually defined strategy switching, this paper proposes a Hierarchical Deep Reinforcement Learning (HDRL) method based on autonomous sub-strategy switching. The method divides the overall task into three lower-level sub-strategy modules (navigation obstacle avoidance, navigation collision avoidance, and navigation capture) and a higher-level sub-strategy switching module, using a modular design to reduce task complexity and enhance generalisation capabilities. The lower-level modules are trained using the Multi-Agent Dual Delay Deep Deterministic Policy Gradient (MATD3) algorithm, while the higher-level switching module employs a Deep Double Q-Network (DDQN) to achieve autonomous scheduling of sub-strategies. Experimental results demonstrate that compared to traditional non-hierarchical methods (such as MADDPG and MATD3), the proposed method achieves superior performance in key metrics such as capture success rate, collision rate, and timeout rate, validating its effectiveness and practicality in enabling efficient multi-agent collaboration and dynamic decision-making.  © 2025 IEEE.},
