@CONFERENCE{Xue20261180,
	author = {Xue, Zhangchi and He, Xu},
	title = {A Multi-Agent Framework for Step-Level Tool-Call Safety Evaluation in Industrial Control Systems},
	year = {2026},
	journal = {2026 6th International Conference on Artificial Intelligence and Industrial Technology Applications, AIITA 2026},
	pages = {1180 - 1189},
	doi = {10.1109/AIITA69518.2026.11567230},
	url = {https://www.scopus.com/pages/publications/105043748459?origin=resultslist},
	abstract = {Large language model (LLM) agents are increasingly deployed to operate industrial systems through structured tool calls to Programmable Logic Controllers (PLCs) and Supervisory Control and Data Acquisition (SCADA) systems interfaces. However, unsafe tool-call behaviors - arising from reasoning errors, contextual prompt injection, or explicit malicious requests - can directly lead to physical damage and safety incidents. Despite recent progress in agent safety, standardized benchmarks for evaluating step-level tool-call safety in industrial environments remain lacking. In this work, we present a guardrail-oriented dataset and benchmark for industrial LLM agents. We propose a three-mode safety taxonomy that distinguishes benign, injected-benign, and malicious requests, capturing both explicit attacks and covert contextual manipulations that induce unsafe behaviors in otherwise legitimate tasks. Based on this taxonomy, we construct a step-level dataset using a fully automated multi-agent pipeline that (i) generates industrial environments and tasks, (ii) injects structured contextual manipulations, (iii) samples tool-call trajectories, and (iv) assigns deterministic safety labels grounded in PLC constraints and industrial safety specifications. We further design a challenging cross-domain benchmark spanning six industrial domains, including water treatment, semiconductor manufacturing, pharmaceutical fermentation, oil refining, nuclear cooling, and food processing. The benchmark enforces domain-specific entity naming, realistic numeric values, and constraint mismatches where physical safety limits are stricter than PLC register bounds, enabling systematic evaluation of guardrail generalization under distribution shift. Experimental results show that strong instruction-tuned LLMs, while effective at handling explicitly malicious requests, struggle to detect unsafe behaviors induced by contextual prompt injection, revealing a critical blind spot in existing safety mechanisms. In contrast, a guardrail model fine-tuned on our dataset demonstrates substantially improved sensitivity to step-level safety violations, particularly in injected-benign scenarios, while maintaining robust performance against explicit attacks. These findings highlight the necessity of step-level supervision and the effectiveness of the proposed benchmark for developing reliable industrial agent guardrails. Our dataset and benchmark provide a standardized testbed for step-level tool-call safety in industrial LLM agents and establish a foundation for future research on safe and reliable autonomous industrial systems. © 2026 IEEE.},
