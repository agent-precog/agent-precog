@ARTICLE{Zhang2026,
	author = {Zhang, Liangbin and Chang, Jing and Chen, Weisheng},
	title = {A Distributed Task Allocation Algorithm for UAV Swarms in Dynamic Disaster Perception},
	year = {2026},
	journal = {IEEE Internet of Things Journal},
	pages = {},
	doi = {10.1109/JIOT.2026.3729931},
	url = {https://www.scopus.com/pages/publications/105050152085?origin=resultslist},
	abstract = {To address the distributed task allocation challenge for UAV swarms undertaking closed-loop search-and-extinguish missions in dynamic forest fire environments, this paper presents a situation-aware distributed algorithm for search-and-suppression task allocation (DA-SSTA) based on the consensus alternating direction method of multipliers (ADMM). DASSTA achieves decision consistency under non-fully connected topologies, multi-objective cost-coupling conflicts, and real-time dynamic reallocation requirements. A normalized multi-objective framework integrating navigation and fire-extinguishing costs is developed, with a Logistic-based adaptive weight mechanism to adjust mission priorities dynamically. The original mixed-integer problem is converted to convex quadratic programming via variable relaxation and constraint affinization, and the non-negative slack variables handle path-fire task coupling constraints to satisfy the Slater condition for strong duality. A multiparameter adaptive penalty selection (MpAPS) mechanism is proposed to update penalties via spectral radius minimization dynamically, and a damping factor is introduced to suppress oscillations, thereby boosting convergence speed and numerical stability. Simulations show that DA-SSTA achieves markedly higher UAV survival and mission completion rates with control-lable growth in navigation cost than four representative baselines, including consensus ADMM and the multi-agent proximal policy optimization algorithm (MAPPO). As such, it performs robustly in scenarios with a high density of fire points. MpAPS cuts algorithm iterations by 60%, while mitigating penalty-parameter oscillations. The proposed method offers a robust, scalable solution for distributed task allocation for resource-constrained UAV swarms in dynamic disaster scenarios, contributing to autonomous collaborations like search and rescue. © 2014 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@BOOK{Rekha202631,
	author = {Rekha, M. and Ravi, Chitra and AlZadjali, Najiba Said Hamed},
	title = {Architecture of Agentic AI Depicting the Core Components Involved},
	year = {2026},
	journal = {Agentic Artificial Intelligence: Engineering AI Agents for Autonomous AI Systems},
	pages = {31 - 55},
	doi = {10.1515/9783112223062-002},
	url = {https://www.scopus.com/pages/publications/105050565348?origin=resultslist},
	abstract = {Due to the rapid and fast growth of agentic AI, AI has stepped into a dynamic and evolving phase marking a pivotal stage of progress. Agentic AI systems are very smart intelligent systems that can make its own decisions, make ahead plannings, and adapt dynamically to new environments and situations. This chapter very carefully examines the core concepts, working methodologies, and practical applications of agentic AI across various sectors. After performing a comparison between traditional AI models and agentic AI, traditional AI models perform narrowly defined tasks while relying on explicit instructions, whereas agentic AI is an expert in setting its own goals and can realize the different paths to achieve the goals. Agentic AI performs constant learning while engaging the humans and their environment intelligently. The chapter steps into the definition of agentic AI and slowly progresses into its evolution from the old rule-based systems till today’s advanced generative and interactive agents. This chapter also distinguishes agentic AI from conventional AI systems in terms of the core principles such as autonomy, goal orientation, adaptability, and multi-agent collaboration as these traits not only enable higher degrees of flexibility and robustness but also introduce new challenges in alignment, ethics, and safety. Then slowly the chapter moves toward the introduction of technologies that power agentic AI, which also includes large language models, multimodal learning systems, reinforcement learning algorithms, memory-augmented networks, and advanced planning frameworks. Aggregating all these technologies together allows agentic systems to understand complex information, invoke its thought process aiming futuristic needs, render those actions benefitting the requirements of situation. The chapter also discusses upon perception, cognition, and action components to support real-time, goal-focused tasks. A major part of the chapter is dedicated to understanding the use cases in industries to highlight the practical beneficiaries of agentic AI, along with real-world implementations. Agentic systems are playing a crucial role starting from manufacturing of autonomous robots until performing the role of intelligent clinical assistants in healthcare. In these areas, agentic systems are used to reshape industry operations while focusing on cost reduction, increase in production and to gain personalized user experiences. The use of agentic systems in financial institutions is very beneficial as they detect frauds and perform predictive analytics and personalized tutoring in educational organizations. The chapter also focusses upon detailed case studies. Although there are several advancements in agentic AI, there are also challenges in the form of model interpretability, data privacy, ethical concerns, computational costs, and regulatory compliance which needs to be studied deeply. Other limitations of current systems are challenges in handling open-ended tasks, maintaining long-term memory, and providing safety use of these systems in unpredictable environments. The chapter provides conclusions while enlightening the future research areas related to agentic AI where humans can work alongside in different fields such as edge and IoT devices. The key technologies, principles, applications, and challenges are covered in order to make the real-world impact of agentic AI clear and encourage further study in this fast-growing field. © 2026 Walter de Gruyter GmbH, Genthiner Straße 13, 10785 Berlin, Germany.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Yousef2025128,
	author = {Yousef, Sufian},
	title = {A Metacognitive and Modular Approach to Self-Organizer AI in Open-Ended, Dynamic Environments},
	year = {2025},
	journal = {Babylonian Journal of Artificial Intelligence},
	volume = {2025},
	pages = {128 - 139},
	doi = {10.58496/BJAI/2025/012},
	url = {https://www.scopus.com/pages/publications/105026460049?origin=resultslist},
	abstract = {This paper introduces a practical and flexible self-organizing artificial intelligence (AI) architecture that can be effectively employed in dynamic, non-contextual environments (lacking clear labels, fixed goals, or stable features). Supervised learning, rule-based systems, and classical reinforcement learning are the traditional models that typically require predesigned rewards and a fixed environment structure, which reduce the diversity of these models. On the contrary, the proposed framework stresses on meta-cognitive regulation and cognitive metonymy, allowing agents to self-organize their internal behaviors and strategies under variable inputs. The architecture is component-based multiagent with perception– feedback loops, decentralized communication protocols and dynamic heuristics. Together, these components enable emergent adaptability, where agents can build goal hierarchies on the fly, monitor their learning, and collaborate in the absence of central control. Unlike static models, this approach supports dynamic goal selection and rapid re-planning through internal monitoring and feedback. The framework was evaluated in simulation experiments on two complex tasks: autonomous navigation in unknown terrains and unsupervised anomaly detection in non-stationary data streams. Results demonstrate superior performance compared to conventional models, achieving higher average goal completion rates (87.4% vs. 65–78%), faster reaction times (43 ms vs. 62–94 ms), and greater resilience to disturbances. These observations serve to illustrate the promise of the self-organizing AI paradigm for open-ended, uncertain domains, like robotics, IoT and autonomous systems. In summary, our work questions conventional wisdoms and beliefs in AI design arguing in favor of naturally adaptive on cognition and continuous self-evolution in realistic worlds. © 2025, Mesopotamian Academic Press. All rights reserved.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4; All Open Access; Gold Open Access}
}

