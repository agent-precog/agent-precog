@ARTICLE{Zuo20268722,
	author = {Zuo, Tian-Yu and Li, Pan and Di, Kai and Jiang, Yichuan and Wang, Yuangan and Lim, Boon Han},
	title = {Self-Organized Team Formation via Multi-Task Hedonic Games for Capability-Heterogeneous Human-Machine Agents},
	year = {2026},
	journal = {IEEE Transactions on Automation Science and Engineering},
	volume = {23},
	pages = {8722 - 8735},
	doi = {10.1109/TASE.2026.3687096},
	url = {https://www.scopus.com/pages/publications/105037117901?origin=resultslist},
	abstract = {Partitioning a pool of capability-heterogeneous human and machine agents into effective teams for multiple concurrent tasks is a fundamental challenge in hybrid human-machine collaboration. We formalize this problem as a Multi-Task Additively Separable Hedonic Game (MT-ASHG), in which every agent is a self-interested player whose utility combines (i) a task-specific proficiency score measuring how well the agent's skill vector aligns with task requirements, and (ii) an inter-agent compatibility score capturing synergistic or conflicting partnerships. Building on this formulation, we design an Iterative Best Response (IBR) algorithm that lets agents autonomously migrate between task groups to improve their individual payoffs. We prove that the IBR dynamics converge in a finite number of steps to an individually stable partition, in which no agent can unilaterally improve its utility by switching teams, and analyze the computational complexity of the convergence process. To bridge theory and practice, we further introduce an empirical profiling method that extracts capability and compatibility vectors from historical agent interactions, addressing the cold-start problem in newly formed human-machine teams. Extensive experiments on synthetic benchmarks and the Overcooked-AI cooperative environment demonstrate that MT-ASHG consistently outperforms centralized assignment baselines and existing coalition-formation methods in terms of global task completion rate, fairness, and scalability. Note to Practitioners - This paper targets a common deployment problem in hybrid production systems: assigning capability-heterogeneous human and machine agents to multiple concurrent tasks when skill coverage and teammate compatibility must both be considered. In practice, assignment methods based only on capability scores often create hidden conflicts, blocking behaviors, and unstable reassignments. Our method offers a decentralized team-formation process that jointly optimizes task-skill matching and interpersonal compatibility. Instead of requiring a central planner to enumerate all team combinations, agents iteratively perform local switch and swap decisions until a stable partition is reached. This design is suitable for workshop, warehouse, and service scenarios where agent availability and task load change over time.The current framework assumes capability vectors and pairwise compatibility scores can be estimated with acceptable quality before online allocation. Performance may decline when these profiles are sparse, outdated, or noisy, and the present implementation does not explicitly handle communication disruptions during reconfiguration. For deployment, practitioners should combine periodic profile recalibration with conservative update intervals. Future extensions should incorporate online profile learning, uncertainty-aware utility estimation, and safety-aware constraints for latency-critical or high-risk operations.  © 2004-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 10}
}

@ARTICLE{Chen2025,
