@BOOK{Keller201177,
	author = {Keller, Kirby and Poblete, James},
	title = {The Business Case for SHM},
	year = {2011},
	journal = {System Health Management: With Aerospace Applications},
	pages = {77 - 91},
	doi = {10.1002/9781119994053.ch5},
	url = {https://www.scopus.com/pages/publications/84879158038?origin=resultslist},
	abstract = {In general a business case analysis is a set of techniques to determine the attractiveness of a business opportunity, which often takes the form of a change in process, an addition to capacity, the introduction of new technology, or the restructuring of an enterprise. The fundamental element of building a business case is the prediction of the proposed changes' impacts. As stated by Professor John Michel of the Information Resources Management College: a business case is a defined deliverable that describes an investment opportunity. Its main goal is to help management decide, in a rational way, the true business value of a potential investment, and whether or not to proceed. It both justifies the investment and guides the subsequent work. In short, it drives results (not just promises them) because it's used to ensure the project and expected benefits are delivered. (Michel, 2004) For system health management (SHM), business opportunities take a number of forms. One opportunity can be a potential improvement in the organization's ability to detect and isolate faults in target equipment. This equipment may perform a business operation or produce a product. Detecting failures and isolating faults can reduce maintenance costs and improve maintenance efficiency by reducing the time and support equipment involved in troubleshooting faults and making the repairs. This efficiency gain might also be realized in avoiding incorrect repairs or avoiding occurrences where the failure conditions could not be duplicated and no repair is made for lack evidence to locate the fault. These failure conditions typically reappear until the fault becomes more obvious and easier to diagnose. Making the maintenance process more efficient will typically also reduce the machine's downtime, or the time when that machine or system is out of production. Another opportunity for SHM can be implementing "lifing" or prognostic capabilities on a component or failure to enable its removal or repair prior to failure. The value here is reducing unanticipated downtime, thus increasing the dependability of the subject machine or system. Predicted failures can be addressed in slack time or at least bundled with other inspections or repairs to reduce total downtime. The overall impact of SHM includes reduced maintenance cost and an increase in the system's effective reliability, possibly guaranteeing periods of maintenance-free operation. Business case analysis is a means to describe and evaluate such potential improvements which ultimately roll up and impact some top-level measure of effectiveness such as profit, customer satisfaction, or safety. Many guidelines to performing a business case analysis are in the literature, including recent guidelines by industry and government agencies to drive decisions related to support system strategies (Johnston, 2008). In the following, processes and tools are described to generate a business case for the introduction or expansion of SHM technology into an enterprise. However, as noted in earlier chapters, success in performing such an analysis using these processes and tools is highly dependent on enterprise knowledge of the subject system and effectiveness of communicating this knowledge among the parties involved in the analysis. SHM affects many aspects of the enterprise, including the current accepted approach to production operations and the costs associated with equipment maintenance, spares ordering, warehousing, maintenance training, customer satisfaction, and customer warranties. Detailed knowledge of all these enterprise aspects is required to populate the tools and perform a business case analysis. The process of generating a business case is one of reducing selected aspects of very complex business, technical, and social environments into an analytical model that can be used to provide quantitative insight into possible alternatives and their resulting costs and benefits. That said, the stakeholders must realize that such an analytical model will fall far short of capturing all the intricacies of the enterprise. Rather, a business case model will provide analytical insights to a group of knowledgeable stakeholders. Stakeholders consistently want to understand the assumptions and fidelity of the model to gage its applicability to usually a very complex problem. History is full of cases where technology was introduced only to achieve less than desirable and, on occasion, the exact opposite results than were anticipated. A prime example would be to roll out diagnostic tools to reduce maintenance time and costs without the cooperation of the maintenance personnel. The threat of a reduction in staff or work hours can obviate the technical advantages of the technology. © 2011 John Wiley & Sons, Ltd.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5}
}

