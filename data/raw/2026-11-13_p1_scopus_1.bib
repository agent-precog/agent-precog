	title = {Prioritization of green transport strategies for the European road freight transport industry: A fuzzy multi-criteria decision-making framework based on political, economic, social, technological, environmental, and legal analysis},
	year = {2026},
	journal = {Engineering Applications of Artificial Intelligence},
