@ARTICLE{Song2026,
	author = {Song, Yubo and Chen, Weiwei and Sun, Xin and Qin, Zhongyuan and Dai, Hua and Wang, Kanghui and Lv, Bang and Chen, Jiaqi},
	title = {OmniFuzz: A Multi-agent Reinforcement Learning Framework for Protocol-Aware Fuzzing in Power IoT Devices},
	year = {2026},
