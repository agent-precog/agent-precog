	doi = {10.1080/15472450.2025.2497503},
	url = {https://www.scopus.com/pages/publications/105004467652?origin=resultslist},
	abstract = {The rapid deployment of autonomous vehicle technologies, particularly robotaxis, offers numerous benefits such as improved mobility and traffic efficiency. However, these innovations also present unique challenges for traffic management and law enforcement. This study conducted an online survey specifically targeting traffic law enforcement officers in Chinese cities with operational robotaxi fleets, such as Luobo Kuaipao, which provide on-demand ride-hailing services across more than 10 major cities, including Beijing, Shanghai, Wuhan, Guangzhou, Shenzhen, and Chongqing. The survey received over 4,000 responses from officers in these cities, gathering essential data on their perceptions of robotaxi deployment, attitudes toward its integration, and concerns related to safety, compliance, and day-to-day operations. Results show that surveyed officers generally held favorable views toward robotaxis, with many believing that robotaxis improve safety compared to traditional taxis and enhance traffic efficiency. However, significant concerns remain regarding safety, rule compliance, and cybersecurity vulnerabilities. Fisher’s exact tests and statistical models were employed to examine the relationships between these perceptions and various factors, identifying key influences such as officers’ familiarity with automation technology, prior experience with robotaxis, and perceptions of robotaxi driving behavior. Officers who were more familiar with automation technology, had prior experience with robotaxis, and rated robotaxi driving behavior positively were more likely to support their operations. The findings provide valuable insights into the perspectives of those on the frontline of traffic management and offer recommendations for policymakers to better support the integration of self-driving vehicles into urban transportation systems. © 2025 Taylor & Francis Group, LLC.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7}
}

@CONFERENCE{Zhao2026398,
	author = {Zhao, Jiaxuan and Fang, Ziqi},
	title = {A Cascading Efficiency Framework for Robustness Assessment of Hybrid Earth-Moon Transportation Systems},
	year = {2026},
	journal = {2026 5th International Symposium on Aerospace Engineering and Systems, ISAES 2026},
	pages = {398 - 404},
	doi = {10.1109/ISAES70982.2026.11669583},
	url = {https://www.scopus.com/pages/publications/105050617774?origin=resultslist},
	abstract = {Large-scale cislunar cargo transport is a cornerstone engineering challenge for sustained lunar colonization. While hybrid architectures combining space elevators with chemical rockets have been proposed as feasible pathways, to our knowledge, no unified quantitative framework has been proposed for cascading efficiency losses under coupled multi-physics failure modes. This paper introduces the Cascading Efficiency Framework (CEF), which decomposes the capacity degradation of a Galactic Harbour-class space elevator into four hierarchical physical layers: interface mechanics, structural dynamics, environmental resilience, and orbital logistics. Each layer is analytically modeled and parameterized from published physical data. A 10,000-run Monte Carlo simulation is applied to a hybrid system comprising three Galactic Harbour elevators (179,000 tonnes per year each) and a chemical rocket fleet (125-tonne payload, 98.5 percent mission success probability), demonstrating that an optimal elevator fraction of 0.88 constrains mission completion time within 147 to 150 years at the 95 percent confidence level. The total cascading efficiency loss is quantified at 43.7 percent, with structural dynamics and environmental resilience identified as dominant uncertainty drivers.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Allada20261707,
