@ARTICLE{Turnwald2019151,
	author = {Turnwald, Annemarie and Wollherr, Dirk},
	title = {Human-Like Motion Planning Based on Game Theoretic Decision Making},
	year = {2019},
	journal = {International Journal of Social Robotics},
