	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Deligkas2025584,
	author = {Deligkas, Argyrios and Eiben, Eduard and Ganian, Robert and Kanj, Iyad and Ramanujan, M.S.},
	title = {Parameterized Algorithms for Multiagent Pathfinding on Trees},
	year = {2025},
	journal = {Proceedings of the International Joint Conference on Autonomous Agents and Multiagent Systems, AAMAS},
	pages = {584 - 592},
	url = {https://www.scopus.com/pages/publications/105009763377?origin=resultslist},
	abstract = {The classical Multiagent Pathfinding problem has been extensively studied not only within the artificial intelligence research community, but also by scholars in the areas of theoretical computer science and computational geometry. The problem asks for a minimum-makespan schedule that routes k agents (or robots) from their starting points to their destinations in a graph, while avoiding collisions, and is known to be NP-hard even on the fundamental class of trees. In this article we present two fixed parameter algorithms parameterized by k: the first yields a collision-free schedule on trees whose makespan deviates from the optimum by at most an additive polynomial function of k, and the second solves Multiagent Pathfinding optimally on the class of irreducible trees, i.e., trees with no vertices of degree 2. Both results rely on novel tools and insights into the properties of optimal schedules. © 2025 International Foundation for Autonomous Agents and Multiagent Systems (www.ifaamas.org).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7}
}

@CONFERENCE{Sundaramurthy2025,
	author = {Sundaramurthy, Arivoli and Karunanithi, Bavithra and Karthikeyan, B.},
	title = {IoT-Based Predictive Maintenance in Smart Electric Vehicles for Enhanced Reliability and Sustainability},
	year = {2025},
	journal = {2025 2nd International Conference on Intelligent Technologies for Sustainable Electric and Communications Systems, iTech SECOM 2025},
	pages = {},
	doi = {10.1109/iTechSECOM64750.2025.11307451},
	url = {https://www.scopus.com/pages/publications/105032503478?origin=resultslist},
	abstract = {With the rapid rise of electric vehicle (EV) adoption in 2024-2025, ensuring reliability and serviceability is a major challenge. Traditional reactive or scheduled maintenance cannot adequately prevent sudden subsystem failures in batteries, motors, or power electronics, which cause downtime, safety risks, and higher costs. This study presents an Internet of Things (IoT)-based predictive maintenance framework for smart EVs, emphasizing real-time fault prediction and anomaly detection. The framework integrates sensor networks, cloud analytics, and machine learning models to anticipate failures before escalation. Key components include: (i) monitoring of the Battery Management System (BMS), traction motor, and thermal modules; (ii) a machine learning pipeline using Long Short-Term Memory (LSTM) for time-series forecasting and Random Forest for fault classification; and (iii) a scalable, cloud-enabled architecture for fleet-wide reliability. A prototype drivetrain instrumented with voltage, current, temperature, and vibration sensors transmitted data via a Raspberry Pi gateway over MQTT. The LSTM achieved above 92% accuracy in thermal forecasting, while the Random Forest reached up to 96% accuracy and balanced precision-recall above 92% with cross-validation. Results demonstrated a 30% reduction in unplanned service events and up to 8% efficiency gain, confirming IoT-driven predictive maintenance as a viable strategy for smart EVs.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Naufaldo20251514,
	author = {Naufaldo and Wu, Hsiu-Ming and Zaman, Muhammad Qomaruz},
	title = {Dynamic Goal-Shifting and Sinusoidal Altitude Modulation for Flight Control of a Swarm of Quadcopters with Flocking Dynamics},
