@ARTICLE{Li20269367,
	author = {Li, Yichen and Zhang, Xuebo and Wang, Runhua and Hu, Zhijie and Wang, Yaonan},
	title = {Any-Angle and Arbitrary-Geometry SIPP: Multi-Agent Path Finding with Polygonal Shapes},
