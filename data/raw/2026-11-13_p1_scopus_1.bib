	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Sammartino2027629,
	author = {Sammartino, Vincenzo and Denis, Nathanaël and Ibrahim, Omar and Di Pietro, Roberto},
