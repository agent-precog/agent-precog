@ARTICLE{Bonilla2026,
	author = {Bonilla, Lander and Diaz-de-Arcaya, Josu and Aguirre-Usandizaga, Jon and Almeida, Aitor},
	title = {AI-driven self-healing across the edge–cloud continuum: A systematic literature review},
	year = {2026},
