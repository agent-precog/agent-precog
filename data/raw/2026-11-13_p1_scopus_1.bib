@CONFERENCE{Zhao2026918,
	author = {Zhao, Xuyao},
	title = {Intelligent Optimization Model for Autonomous Systems Integrating Reinforcement Learning},
	year = {2026},
	journal = {2026 2nd International Conference on Electrical Automation and Artificial Intelligence, ICEAAI 2026},
