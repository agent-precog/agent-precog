@ARTICLE{Gao20261,
	author = {Gao, Shan and Zhao, Zelong and Zhang, Shiyou and Wang, Fengkai and Zhang, Yubo and Mi, Xiaodong},
	title = {SafeFlow: Attribution-Driven Adaptive Security Defense for Large Language Model Agents},
