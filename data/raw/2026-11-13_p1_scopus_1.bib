@CONFERENCE{Wagner2017577,
	author = {Wagner, Glenn and Choset, Howie},
	title = {Path planning for multiple agents under uncertainty},
	year = {2017},
	journal = {Proceedings International Conference on Automated Planning and Scheduling, ICAPS},
	volume = {0},
	pages = {577 - 585},
	doi = {10.1609/icaps.v27i1.13866},
	url = {https://www.scopus.com/pages/publications/85030535871?origin=resultslist},
	abstract = {Multi-agent systems in cluttered environments require path planning that not only prevents collisions with static obstacles, but also safely coordinates the motion of many agents. The challenge of multi-agent path finding becomes even more difficult when the agents experience uncertainty in their pose. In this work, we develop a multi-agent path planner that considers uncertainty, called uncertainty M<sup>∗</sup> (UM<sup>∗</sup>), which is based on a prior multi-agent path approach called M<sup>∗</sup>. UM<sup>∗</sup> plans a path through the belief space for each individual agent and then uses a strategy similar to M<sup>∗</sup> that coordinates only agents that are "likely" to collide. This approach has the same scalability advantages as M<sup>∗</sup>. We then introduce an extension called Permuted UM<sup>∗</sup> (PUM<sup>∗</sup>) that uses randomized restarts to enhance performance. We finish by presenting a belief space representation appropriate for multi-agent path planning with uncertainty and validate the performance of UM<sup>∗</sup> and PUM<sup>∗</sup> in simulation and mixed-reality experiments. Copyright © 2017, Association for the Advancement of Artificial Intelligence (www.aaai.org).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 50; All Open Access; Gold Open Access}
}

@BOOK{Panagou20201450,
	author = {Panagou, Dimitra and Stipanović, Dušan M. and Voulgaris, Petros G.},
