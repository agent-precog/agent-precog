@ARTICLE{Clavijo2025,
	author = {Clavijo, Maria Valentina and Guevara Carazas, Fernando and Arango Castrillón, Juan David and Patino-Rodriguez, Carmen Elena},
	title = {Uncertainty-Driven Reliability Analysis Using Importance Measures and Risk Priority Numbers},
