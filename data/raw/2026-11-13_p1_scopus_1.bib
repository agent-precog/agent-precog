@CONFERENCE{Garvey2011,
	author = {Garvey, Jared M. and Kehoe, Benjamin and Basso, Brandon and Godwin, Mark F. and Wood, Jared and Love, Joshua and Liu, Shih-Yuan and Kim, Zu and Jackson, Stephen and Fallah, Yaser and Fu, Tony and Sengupta, Raja and Karl Hedrick, J.},
	title = {An autonomous unmanned aerial vehicle system for sensing and tracking},
	year = {2011},
	journal = {AIAA Infotech at Aerospace Conference and Exhibit 2011},
	pages = {},
	doi = {10.2514/6.2011-1509},
	url = {https://www.scopus.com/pages/publications/85086490991?origin=resultslist},
	abstract = {Cooperative unmanned aerial vehicle (UAV) teams can be used to accomplish many tasks such as surveillance and tracking without many of the normal risks associated with using manned vehicles. We present a software and hardware platform for a single user to interact with a UAV fleet. A component-based software architecture built on a Linux platform is used to separate functionality. A bottom-to-top modularization is used in order to achieve the requirements of the system. This architecture makes adding functionality simple, while being flexible enough to deal with hardware changes and robust enough to meet the demands of a mobile robotic system. A single user is able to interact with the system using a graphical user interface. Users are able to see the current status of aircraft and can input different types of tasks depending on the capabilities of the aircraft. Decentralized task allocation is done by the fleet with onboard computing and the use of ad-hoc wireless communication. The tasks are allocated based on the user specified task requirements, aircraft capabilities, and a cost function which minimizes time to completion for each task. A gimbal is used to point any mounted sensors in the desired location. Video can be streamed to users interacting with the system and also recorded for later analysis. Vision-based algorithms allow for the probabilistic based tracking of pedestrians. Algorithms have been developed to give an optimized path for the UAV to follow based on a given state and the current target estimate probability distribution. The system was demonstrated in August 2010 using a fleet of two heterogeneous UAVs. A single user inputted a series of visit-point tasks, and the two UAVs successfully visited and sent back images of the points. The system was then given the task of monitoring a tent for any pedestrians leaving. The planes would then circle the tent, monitoring for any pedistrians. In the event that a pedestrian was detected leaving the tent, a new task to track the pedestrian would be generated. One of the planes would then attempt to track the pedestrian while the other would continue to monitor the tent for any other pedestrians. The fleet was able detect, track, and transmit video of the pedestrian while continuing to monitor the tent. © 2011 by the American Institute of Aeronautics and Astronautics, Inc. All rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 8}
}

