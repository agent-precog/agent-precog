@CONFERENCE{Zhang202653,
	author = {Zhang, Huanhuan and Zhang, Runmin and Li, Yan and Zhao, Kewei and Song, Yizhuo and Song, Ziwei and Liu, Guanzi},
	title = {A2A—A Mechanism Driven Framework for Interaction Based Agent Evaluation},
