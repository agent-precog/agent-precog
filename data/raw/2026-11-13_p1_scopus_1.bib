@ARTICLE{Su20251,
	author = {Su, Chang and Deng, Jun and Li, Xiaoyang and Ma, Jiayi and He, Wangbo and Wang, Xinping and Wang, Caiping},
	title = {The mechanism of blockchain technology in safety risk monitoring},
	year = {2025},
	journal = {Engineering, Construction and Architectural Management},
