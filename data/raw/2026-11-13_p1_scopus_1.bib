@ARTICLE{Chen20265572,
	author = {Chen, Zhi and Liu, Yimeng and Yu, Zhiwen and Guo, Bin},
	title = {CogCoor: A Cognition-Driven Heterogeneous Coordination Framework for Urban Multi-Target Tracking},
	year = {2026},
	journal = {IEEE Transactions on Networking},
	volume = {34},
	pages = {5572 - 5587},
	doi = {10.1109/TON.2026.3700387},
	url = {https://www.scopus.com/pages/publications/105041369007?origin=resultslist},
	abstract = {With the rapid growth of smart cities, low-altitude airspace opening, and crowd and mobile computing, robust air-ground integrated perception systems are essential for urban safety. Traditional multi-target tracking and capture methods suffer from perceptual blind spots limiting observability, constrained maneuverability hindering proactive target restriction, and unstable coordination under partial observability in multi-agent systems. To address these challenges, we propose CogCoor, a cognition-driven collaborative heterogeneous coordination framework that unifies perception, reasoning, and action through a closed-loop architecture, incorporating heterogeneous crowd computing to extend observability and enable proactive coordination. Specifically, we introduce: 1) an Active-Passive Heterogeneous Collaboration (APHC) model with a Collaborative Voting-based Block Mechanism (CVBM), enabling Uncrewed Aerial Vehicles (UAVs) to trigger ground roadblocks to mitigate perceptual blind spots and constrain target motion; 2) a Cognition-driven Bayesian Collaborative Reward Mechanism (CBCR) that stabilizes multi-agent coordination under partial and heterogeneous observations by adjusting collaboration benefits based on agent reliability; and 3) a Cognition-driven Perception-Scheduling Integration Mechanism (CPSI) that integrates UAV motion control and blocking decisions into a single multi-agent reinforcement learning policy, allowing perception-driven actions to actively constrain target maneuverability. Experiments on real urban road data simulations show that CogCoor outperforms baseline methods, increasing target captures by 8.06% and reducing energy consumption by 7.62% on average in resource-constrained environments. In high coordination demand scenarios, target captures improve by 5.98% on average while energy consumption decreases by 5.91%, confirming its effectiveness in complex urban settings.  © 2026 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Chang2025,
