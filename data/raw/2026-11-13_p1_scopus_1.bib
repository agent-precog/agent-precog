@ARTICLE{Nguyen-Thi Mai2027249,
	author = {Nguyen-Thi Mai, Anh and Nguyen-Thi Van, Anh and Doan-Quoc, Bao and Tran-Duc, Minh and Tran, Hung and Voznak, Miroslav and Ho, Tu Dac and Van, Vo Nhan and Chatzinotas, Symeon and Tran, Dinh-Hieu},
