}

@ARTICLE{Hinsen2023117,
	author = {Hinsen, Patrick and Wiedemann, Thomas and Shutin, Dmitriy},
	title = {Potential Field Based Swarm Exploration of Processes Governed by Partial Differential Equations},
	year = {2023},
	journal = {Lecture Notes in Networks and Systems},
	volume = {590 LNNS},
