@ARTICLE{Kautsar20251648,
	author = {Kautsar, Syamsiar and Aisjah, Aulia Siti and Arifin, Syamsul and Syai’in, Mat},
	title = {Q-RCR: A Modular Framework for Collision-Free Multi-Package Transfer on Four-Wheeled Omnidirectional Conveyor Systems},
	year = {2025},
	journal = {Journal of Robotics and Control (JRC)},
	volume = {6},
	number = {4},
