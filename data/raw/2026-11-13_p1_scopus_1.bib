	author = {Shen, Jiajun and Yu, Xiaolong and Zhu, Lingfen and Liu, Yuxiao and Wang, Wei and Yan, Jiaqi},
	title = {Triggered Adaptive Safety-Critical Cooperative Control and Application to Multiple Mecanum Wheel Robots},
	year = {2026},
	journal = {38th Chinese Control and Decision Conference, CCDC 2026},
	pages = {1363 - 1368},
	doi = {10.1109/CCDC69976.2026.11559965},
	url = {https://www.scopus.com/pages/publications/105043925140?origin=resultslist},
	abstract = {This paper presents an adaptive safety-critical cooperative control scheme for multi-agent systems. For each safety constraint, a Control Barrier Function (CBF) is developed to quantify the degree of safety. To implement decentralization, the CBF constraint is decomposed into several sub-CBF constraints. For each agent, a batch identifier is designed to update the parameter estimates before any one of its relevant safety constraints is violated. By integrating the reference inputs, sub-CBF constraints and batch identifiers, we construct a decentralized safety-triggered adaptive quadratic programming controller. It is demonstrated that the effects of uncertainties are eliminated after a finite number of updates and the safety constraints are rigorously ensured. The proposed control scheme is applied to cooperative transportation of multiple Mecanum wheel robots. © 2026 IEEE.},
