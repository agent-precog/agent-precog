@ARTICLE{Khan2026,
	author = {Khan, Malak Abid Ali and Luo, Senlin and Mirani, Imran Khan and Hamza, Muhammad and Rehman, Zia Ur and Khan, Sohrab},
	title = {LoRaWAN-based federated learning for the internet of vehicles: a comprehensive survey of architectures, algorithms, and open challenges},
	year = {2026},
	journal = {Computer Networks},
	volume = {290},
	pages = {},
	doi = {10.1016/j.comnet.2026.112833},
	url = {https://www.scopus.com/pages/publications/105052591692?origin=resultslist},
	abstract = {The integration of federated learning (FL) with the Internet of Vehicles (IoV) enables distributed intelligence across vehicles, roadside units (RSUs), gateways, edge servers, and cloud infrastructure without centralizing sensitive operational data. LoRaWAN protocol, operating over the LoRa physical layer, offers long-range, low-power connectivity for distributed and resource-constrained IoV devices. However, its limited payload size and data rate, duty-cycle constraints, asymmetric traffic, limited downlink capacity, and intermittent connectivity pose significant challenges for efficiently deploying conventional FL in IoV environments. Unlike existing surveys that examine LoRaWAN networking, FL communication efficiency, and vehicular applications largely as separate research streams, this paper presents a network-centric review focused on communication–learning co-design. A structured three-stage literature-selection process covers studies published from January 2016 to May 2026 across major scholarly databases (Scopus, IEEE Xplore, ACM Digital Library, Web of Science, ScienceDirect, and arXiv), with reported, calculated, synthesized, illustrative, and author-derived results explicitly distinguished throughout. The selected studies are organized into five deployment patterns and analyzed across gateway-assisted and hierarchical aggregation, asynchronous coordination, mobility and heterogeneity awareness, communication-efficient compression and distillation, semantic update and prototype exchange, security and privacy co-design, and hybrid multi-radio architectures. The review shows that task re-scoping, compact models, reduced update frequency, and communication-aware aggregation can improve FL feasibility under LoRaWAN constraints. Predictive maintenance, cold-chain monitoring, roadside sensing, fleet telemetry, parking, and logistics tracking emerge as promising applications, while safety-critical and latency-sensitive services remain challenging. Key research gaps include mobility, scalability, security, communication efficiency, benchmarking, co-simulation, and field-scale validation. A prioritized ten-point research agenda is developed, highlighting protocol-aware FL, intelligent gateway coordination, semantic compression, hybrid multi-radio architectures, and open reproducible benchmarks as critical directions toward practical, scalable, and communication-efficient LoRaWAN-enabled FL for IoV. © 2026 Elsevier B.V.},
