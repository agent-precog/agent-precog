@ARTICLE{Gao2024,
	author = {Gao, Jiaxu and Wang, Guoxian and Xiao, Jinhua and Zheng, Pai and Pei, Eujin},
	title = {Partially observable deep reinforcement learning for multi-agent strategy optimization of human-robot collaborative disassembly: A case of retired electric vehicle battery},
	year = {2024},
