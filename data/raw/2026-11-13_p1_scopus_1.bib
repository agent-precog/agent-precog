	doi = {10.23919/CCC63176.2024.10662049},
	url = {https://www.scopus.com/pages/publications/85205495939?origin=resultslist},
	abstract = {Collaborative hunting, also known as Multi-Agent Pursuit Evasion (MAPE), is a crucial aspect of swarm intelligence. The main obstacles in MAPE research involve making real-time decisions in dynamic environments, efficient task allocation, collision avoidance among multiple agents, planning and tracking prey in unknown environments, and information sharing under communication constraints. This paper presents the Dual-Layer Collaborative Hunting Algorithm Using Virtual Wolf Pack (DLCH-VWP), which utilizes biomimetic principles, specifically leveraging the advantages and hunting strategies of wolf packs, to enhance collaborative efficiency and adaptability in complex environments within MAPE. The algorithm employs a two-tier strategy, with the strategy planning center using biomimetic wolf pack algorithm to manage environment perception, state assessment, prey movement prediction, and inter-robot communication. The local response center treats each wolf as an independently operating sub-pack, utilizing a combination of Grey Wolf Optimizer (GWO) and the local A-star algorithm to provide each wolf with individual autonomy. This allows for efficient dynamic path planning by determining the path for each wolf based on joint decision-making of the group and individual. Simulation experiments have confirmed the effectiveness and feasibility of this algorithm for collaborative hunting in multi-agent systems, presenting a novel strategy for addressing MAPE challenges. © 2024 Technical Committee on Control Theory, Chinese Association of Automation.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Hu20238122,
	author = {Hu, Haimin and Nakamura, Kensuke and Hsu, Kai-Chieh and Leonard, Naomi Ehrich and Fisac, Jaime Fernández},
	title = {Emergent Coordination Through Game-Induced Nonlinear Opinion Dynamics},
	year = {2023},
	journal = {Proceedings of the IEEE Conference on Decision and Control},
	pages = {8122 - 8129},
	doi = {10.1109/CDC49753.2023.10383660},
	url = {https://www.scopus.com/pages/publications/85180312016?origin=resultslist},
	abstract = {We present a multi-agent decision-making framework for the emergent coordination of autonomous agents whose intents are initially undecided. Dynamic non-cooperative games have been used to encode multi-agent interaction, but ambiguity arising from factors such as goal preference or the presence of multiple equilibria may lead to coordination issues, ranging from the 'freezing robot' problem to unsafe behavior in safety-critical events. The recently developed nonlinear opinion dynamics (NOD) [1] provide guarantees for breaking deadlocks. However, choosing the appropriate model parameters automatically in general multi-agent settings remains a challenge. In this paper, we first propose a novel and principled procedure for synthesizing NOD based on the value functions of dynamic games conditioned on agents' intents. In particular, we provide for the two-player two-option case precise stability conditions for equilibria of the game-induced NOD based on the mismatch between agents' opinions and their game values. We then propose an optimization-based trajectory optimization algorithm that computes agents' policies guided by the evolution of opinions. The efficacy of our method is illustrated with a simulated toll station coordination example.  © 2023 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 19; All Open Access; Green Open Access}
}

