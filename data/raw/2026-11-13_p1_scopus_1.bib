@ARTICLE{Pradhan2021,
	author = {Pradhan, Buddhadeb and Hui, Nirmal Baran and Roy, Diptendu Sinha and Srivastava, Gautam and Lin, Jerry Chun-Wei},
	title = {Game-Theoretic Strategic Coordination and Navigation of Multiple Wheeled Robots},
