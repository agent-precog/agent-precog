@ARTICLE{Ersoy2026139,
	author = {Ersoy, Pınar and Erşahin, Mustafa},
	title = {Protocol-Driven Agentic Integration of LLMs: A Multi-tool Use Case},
	year = {2026},
	journal = {Communications in Computer and Information Science},
	volume = {2827 CCIS},
