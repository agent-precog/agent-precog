@ARTICLE{Zhenxiang2026693,
	author = {Zhenxiang, Li and Alnfiai, Mrim M. and Jung, Low Tang and Alotaibi, Nouf Nawar and Bajuri, Mohd Yazid and Alnefaie, Salma Mohsen M. and Ghoneim, Mohamed E.},
	title = {Mobile Robot Control Using Pursuit–Evasion Differential Game Strategy for Double Integrator Dynamic Control with Deep Reinforcement Learning},
	year = {2026},
	journal = {Dynamic Games and Applications},
	volume = {16},
