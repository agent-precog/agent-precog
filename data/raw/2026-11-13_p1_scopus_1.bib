@CONFERENCE{Jarabo-Penas202557,
	author = {Jarabo-Penas, Alejandro and Bravo-Arrabal, Juan and Lin-Yang, Da-Hui and Pastor, Francisco and Ladig, Robert and Fernandez-Lozano, Juan Jesus and Lyhne Christensen, Anders and Garcia-Cerezo, Alfonso},
	title = {Real-World Deployment of an LLM-Enabled Voice-Commanded UGV for Logistics in SAR Missions},
	year = {2025},
