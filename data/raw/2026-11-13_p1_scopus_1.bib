	pages = {1531 - 1544},
	doi = {10.1142/S2301385025410067},
	url = {https://www.scopus.com/pages/publications/105009293896?origin=resultslist},
	abstract = {The automated guided vehicle (AGV) has been widely used in the realm of intelligent logistics, and path planning has become a key challenge in AGV research. In large and complex dynamic environments, multi-AGV unmanned systems have the problems of low search efficiency, slow convergence speed, and even impossible convergence. To accelerate the convergence of AGVs during the learning process, a new deep reinforcement learning method heuristic soft action-multi-agent twin delayed deep deterministic policy gradient (HA-MATD3) algorithm is proposed in this paper. Specifically, a dynamic reward function utilizing an artificial potential field method is introduced to score the actions of the AGVs, and the heuristic soft action and reward network are introduced to optimize the multi-agent twin delayed deep deterministic policy gradient (MATD3) algorithm. First, the AGV generates the ideal heuristic soft action through its state and target information, and the AGV can effectively solve the problem of low search efficiency through heuristic soft action learning. Furthermore, the reward network is used to judge the reward value of the action taken by the AGV, ensuring that the generated path is efficient, collision-free and safer. These improvements enrich the decision-making process and improve the adaptability and responsiveness of AGVs to various environmental conditions. Finally, experimental results demonstrate that the proposed HA-MATD3 algorithm is effective in solving the multi-AGV path planning problem in complex environments. This research contributes to the development of unmanned systems, especially in the multi-AGV path planning problem.  © 2025 World Scientific Publishing Company.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5}
}

@ARTICLE{Yan2026,
	author = {Yan, Shuaiming and Shi, Lei and Bu, Xuhui and Zhu, Panpan and Zhou, Yi},
	title = {Data-Driven Safety-Critical Flocking Control for Multi-Agent Systems With Unknown Dynamics Under Uncertain Environments},
	year = {2026},
	journal = {IEEE Transactions on Consumer Electronics},
	pages = {},
	doi = {10.1109/TCE.2026.3691844},
	url = {https://www.scopus.com/pages/publications/105039257167?origin=resultslist},
	abstract = {The rapid development of consumer electronics, including consumer drones, smart home robots, and Internet of Things (IoT) sensor networks, has spurred the deployment of multi-agent systems (MASs) in increasingly complex and uncertain real-world environments. A critical challenge in these applications is to ensure safe and coordinated operation when the system dynamics are unavailable and the environmental conditions are unknown a priori. This paper proposes a data-driven learning control barrier function (DDLCBF) framework to address the safety-critical flocking control problem for MASs with unknown nonlinear dynamics operating in uncertain environments. First, a distributed flocking controller is constructed using pseudo partial derivatives (PPD) that relies exclusively on input-output (I/O) data, eliminating the requirement of an explicit system model. The controller is further extended to cooperative-competitive networks on signed directed graphs, where bipartite flocking convergence is guaranteed under a structural balance condition via gauge transformation. Second, a Gaussian process (GP) regression-based learning scheme is developed to approximate stochastic control barrier functions (CBFs) from real-time sensor measurements, thereby enabling probabilistic safety guarantees without prior environmental knowledge. Third, the DDLCBF scheme is formulated by integrating the PPD-based data model into the CBF constraints, yielding a quadratic programming (QP) controller that simultaneously ensures safety and low environmental uncertainty. Rigorous theoretical analyses are provided, including convergence guarantees for the PPD estimator and probabilistic safety bounds. The effectiveness and practicality of the proposed approach are validated through numerical simulations and physical experiments on an indoor multi-unmanned aerial vehicle (UAV) platform equipped with a motion capture system. © 1975-2011 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Karthik20262260,
