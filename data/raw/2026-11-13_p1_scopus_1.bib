@ARTICLE{Yoo2026123,
	author = {Yoo, Seo Hyun and Im, SeongTaek and Kang, HyoJae and Jeong, ChanHee and Han, DaeHee and Kang, Min-Sung},
	title = {A Study on Improving Multi-agent Path Finding in Congested Environments Using Agent Merging and Splitting; [에이전트 병합 및 분할을 활용한 혼잡 환경에서의 다중 에이전트 경로 탐색 성능 향상에 관한 연구]},
	year = {2026},
