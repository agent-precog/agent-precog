@ARTICLE{Zhao2025,
	author = {Zhao, Yiqi and Yu, Xinyi and Hoxha, Bardh and Fainekos, Georgios and Deshmukh, Jyotirmoy and Lindemann, Lars},
	title = {STL-GO: Spatio-Temporal Logic with Graph Operators for Distributed Systems with Multiple Network Topologies},
	year = {2025},
