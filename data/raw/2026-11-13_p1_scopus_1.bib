@ARTICLE{Zhao2026,
	author = {Zhao, Xiaoming and He, Jun and Yang, Yong and Yu, Jing and Hong, Sunyan},
	title = {LogiFusion: a semantic-kinetic-dynamic expert system for closed-loop intralogistics decision intelligence},
	year = {2026},
	journal = {Expert Systems with Applications},
	volume = {308},
	pages = {},
	doi = {10.1016/j.eswa.2026.131147},
	url = {https://www.scopus.com/pages/publications/105028337237?origin=resultslist},
	abstract = {Despite the proliferation of multimodal data in Industry 5.0 intralogistics, which span visual feeds, IoT streams, and task logs, current expert systems remain ”rearview mirrors,” capable only of retrospective dashboarding rather than proactive orchestration. Traditional rule-based systems lack the flexibility to handle unstructured ultimodal inputs, whereas modern deep learning models function as ”black boxes” that classify discrete actions without understanding the underlying business context or enabling actionable interventions.To bridge this gap between passive perception and active control, we propose LogiFusion, a novel neuro-symbolic expert system architecture grounded in a Semantic-Kinetic-Dynamic (S-K-D) framework. First, in the Semantic Layer, LogiFusion utilizes cross-modal contrastive learning to align heterogeneous sensor data (IMU, OMoCap) from the LARa dataset into a shared semantic space, instantiating a live, object-centric Knowl-edge Graph (Digital Twin) that explicitly models entities and their interactions. Second, the Kinetic Layer deploys a team of collaborative AI agents powered by Large Language Models (LLMs). By grounding reasoning in standard process models (BPMN), these agents detect complex context deviations (e.g., er-gonomic risks, procedural violations) and generate executable business actions. Third, the Dynamic Layer implements a ”Decision Capture” mechanism where agent interventions are simulated and iteratively refined via multi-agent rein-forcement learning to maximize operational efficiency and safety. Validated on the large-scale LARa benchmark, LogiFusion significantly out-performs state-of-the-art baselines (tCNN, vLSTM), achieving a Macro F1-Score of 92.4 % and a Logic Compliance of 92.8 %. Crucially, in a human-in-the-loop evaluation, 92 % of the system’s decisions were rated as operationally actionable by domain experts. This work advances the field of expert systems by providing a deployable blueprint for converting raw sensor noise into transparent, intelligent logistics orchestration. © 2026 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
