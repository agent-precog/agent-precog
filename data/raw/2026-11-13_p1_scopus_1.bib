	doi = {10.1109/CAIBDA70336.2026.11621865},
	url = {https://www.scopus.com/pages/publications/105047063710?origin=resultslist},
	abstract = {Coordinated AGV scheduling in RMFS strictly requires balancing collision-free navigation with low computational latency. While expert-planning ensures safety but suffers severe delays, standard MARL enables fast inference but lacks low-level safety guarantees and struggles with early convergence. To address this, we propose AG-MAPPO, an expert-guided multi-agent framework. During training, a Virtual Serial A∗ (VSP-A*) algorithm serves as an expert to generate safe path demonstrations via hybrid action sampling. This mitigates the cold-start problem without extensive parameter tuning and significantly accelerates convergence. At runtime, our system adopts stepwise planning. This eliminates the prohibitive cost of planning complete paths for all robots upfront, decomposing the problem into simple single-step local decisions. By dynamically updating robot decision order at each step, the method prevents deadlocks and maintains per-step latency of only a few milliseconds. Our work presents a practical distributed scheduling approach that balances training ease, fast response, and safety guarantees. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Lv2026359,
	author = {Lv, Zhitao and Xiang, Liuyu and Wang, Dianyun and Wu, Huijia and Wang, Zhenyu and He, Zhaofeng},
	title = {SafeHierarchy: Benchmarking and Mitigating Hierarchy-Induced Harmful Compliance in LLM Multi-Agent Systems},
	year = {2026},
	journal = {2026 5th International Conference on Artificial Intelligence, Internet of Things and Cloud Computing Technology, AIoTC 2026},
	pages = {359 - 365},
	doi = {10.1109/AIoTC71250.2026.11688714},
	url = {https://www.scopus.com/pages/publications/105052977720?origin=resultslist},
	abstract = {As LLM agents are increasingly deployed in hierarchical multi-agent systems (MAS), a critical safety question emerges: do hierarchical topologies themselves systematically amplify harmful compliance? Existing alignment research remains confined to the single-agent level, leaving this structural risk unmeasured. To fill this gap, we introduce SafeHierarchy1K, a 1,000-instance benchmark that orthogonally varies agent communication topologies against six French-Raven social power types, enabling controlled quantification of hierarchy-driven safety failures. Experiments on a stratified 300-case subset reveal that harmful compliance escalates significantly with hierarchical depth and exhibits strong heterogeneity across power types; scaling analysis on the Qwen3 family further shows that increasing model parameters alone cannot resolve this vulnerability. Mechanistic analysis attributes this risk to legitimacy packaging: intermediate nodes rewrite malicious intent into implicit rolebased constraints reinforced by authoritative discourse, rendering static endpoint defenses unable to distinguish adversarial pressure from normal collaboration. To address this, we propose H-CIRCUIT, a training-free inference-time framework that constructs counterfactual probes by stripping authoritybearing expressions and triggers adaptive interventions only when causal dependency on hierarchical pressure is detected. Cross-model evaluations confirm that H-CIRCUIT substantially reduces attack success rates while preserving benign task utility, establishing that hierarchy-induced vulnerabilities are both measurable and mitigable through pathway-aware, causally grounded defense.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Fekete2026,
	author = {Fekete, Sándor P. and Kosfeld, Ramin and Kramer, Peter and Neutzner, Jonas and Rieck, Christian and Scheffer, Christian},
	title = {Coordinated motion planning: Multi-agent path finding in a densely packed, bounded domain},
	year = {2026},
	journal = {Autonomous Agents and Multi-Agent Systems},
	volume = {40},
	number = {2},
	pages = {},
	doi = {10.1007/s10458-026-09766-4},
	url = {https://www.scopus.com/pages/publications/105049159082?origin=resultslist},
	abstract = {We study Multi-Agent Path Finding for arrangements of labeled agents in the interior of a simply connected domain: Given a unique start and target position for each agent, the goal is to find a sequence of parallel, collision-free agent motions that minimizes the overall time (the makespan) until all agents have reached their respective targets. A natural case is that of a simply connected polygonal domain with axis-parallel boundaries and integer coordinates, i.e., a simple polyomino, which amounts to a simply connected union of lattice unit squares or cells. We focus on the particularly challenging setting of densely packed agents, i.e., one per cell, which strongly restricts the mobility of agents, and requires intricate coordination of motion. We provide a variety of novel results for this problem, including (1) a characterization of polyominoes in which a reconfiguration plan is guaranteed to exist; (2) a characterization of shape parameters that induce worst-case bounds on the makespan; (3) a suite of algorithms to achieve asymptotically worst-case optimal performance with respect to the achievable stretch for cases with severely limited maneuverability. This corresponds to bounding the ratio between obtained makespan and the lower bound provided by the max-min distance between the start and target position of any agent and our shape parameters. Our results extend findings by Demaine et al. [18, 19] who investigated the problem for solid rectangular domains, and in the closely related field of Permutation Routing, as presented by Alpert et al. [10] for convex pieces of grid graphs. © The Author(s) 2026.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Wang2026,
	author = {Wang, Zhenzhen and Yang, Nannan and Dong, Baoyang},
	title = {Dynamic obstacle avoidance method for 3D animation group based on multi-agent reinforcement learning},
	year = {2026},
	journal = {Discover Artificial Intelligence},
	volume = {6},
	number = {1},
	pages = {},
	doi = {10.1007/s44163-026-02052-y},
	url = {https://www.scopus.com/pages/publications/105049620579?origin=resultslist},
	abstract = {At the forefront of 3D animation, virtual reality and robotics, it is difficult to realistically and efficiently simulate the group behavior of a large number of people and objects. Previously, traditional rule-based or optimization-based methods often encountered critical problems such as local collisions, unnatural trajectories, or the inability to escape deadlocks—especially in complex, high-density, and dynamic environments. In addition, these old methods also have limitations in overall coordination and flexibility, as they typically rely on local optimal calculations that fail to account for global group dynamics, inevitably leading to deadlocks in high-density continuous control scenarios. To tackle these specific limitations, our proposed approach integrates a localized attention mechanism. By supplying the transformer encoding into a policy network, each “agent” effectively collects and filters information about nearby agents and dynamic obstacles, proactively anticipating collision threats to maintain global coordination. It is noteworthy that the proposed method utilizes a comprehensive reward function that balances obstacle avoidance, movement efficiency, and path fluency. We have fully tested this method called Attention-MAPPO for populations with low/high density, static/dynamic barriers in the Unity 3D modeling environment. The experimental results show that the average obstacle avoidance success rate of this method in all tasks is 92.6%, and the average movement time is 12.4 s. Compared with the baseline standard MAPPO, its success rate has increased by an average of 4.4%, and the average movement time has been shortened by 6.8%, showing significant performance improvement. Furthermore, ablation studies on the attention mechanism clearly demonstrate its crucial role in achieving optimal performance in highly complex dynamic environments. This study provides a powerful and scalable solution for a real, effective team simulation that has a big impact on interactive virtual environments, game development and intelligent robots. © The Author(s) 2026.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

