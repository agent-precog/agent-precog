@CONFERENCE{Ravikumar2025,
	author = {Ravikumar, Shyam Sundar and Ganesamoorthi, Mahesh},
	title = {Leveraging Predictive Maintenance and Machine Learning using FOMAX Data Streams},
	year = {2025},
	journal = {International Conference on Computer and Applications, ICCA 2025 - Proceedings},
	pages = {},
	doi = {10.1109/ICCA66035.2025.11430901},
	url = {https://www.scopus.com/pages/publications/105036949375?origin=resultslist},
	abstract = {Modern commercial aircraft continuously generate high-volume operational and diagnostic data through onboard sensors, fault logs, and system status messages. Leveraging this untapped data stream, we present a real-time predictive maintenance system developed for Airbus A330 aircraft using FOMAX data acquisition systems. The pipeline integrates the ELK stack (Elasticsearch, Logstash, Kibana) for scalable data processing, coupled with a hybrid ensemble learning architecture consisting of an Isolation Forest for unsupervised anomaly detection, a Random Forest classifier for supervised risk scoring, and an LSTM network with Bahdanau attention to model multi-flight temporal dependencies. The system was validated on over 150,000 FOMAX fault messages from 25 aircraft across three commercial airlines over an 18-month operational window, encompassing 328 labeled failure events across 95 ATA codes. Our proposed approach achieved an AUC of 0.84, precision of 0.73, and recall of 0.71, with an average prediction lead time of 8.2 hours, outperforming traditional baselines such as logistic regression and PCA-based anomaly detection. Subsystem-level analysis demonstrated especially strong results in hydraulics and flight control systems. Economic analysis indicates potential annual savings of $1.2 million per aircraft, driven by a 34% reduction in unscheduled maintenance events, 61% reduction in average delay times, and a 2.9% increase in fleet availability. The system supports regulatory compliance with FAA AC 20-115D and EASA AMC 145.A.42, providing interpretable predictions, audit trails, and integration with existing airline quality frameworks. This work addresses core challenges in aviation maintenance, including sparse labeling, fault interdependence, and compliance needs, offering a deployable, scalable, and safety-compliant solution with demonstrable impact. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Jammal2025,
	author = {Jammal, Patsy and Pinon Fischer, Olivia J. and Mavris, Dimitri N. and Wagner, Gregory},
	title = {Predictive Maintenance of Aircraft Braking Systems: A Machine Learning Approach to Clustering Brake Wear Patterns},
	year = {2025},
	journal = {AIAA Science and Technology Forum and Exposition, AIAA SciTech Forum 2025},
	pages = {},
	doi = {10.2514/6.2025-0710},
	url = {https://www.scopus.com/pages/publications/85216132547?origin=resultslist},
	abstract = {The operational integrity and performance of aircraft braking systems are paramount to commercial aircraft safety and maintenance planning efficiency. Operational integrity refers to the reliability of the braking systems under various conditions, including the ability to withstand high temperatures and resist wear. High operational integrity means fewer unexpected failures, which leads to improved overall aircraft safety and reduced unplanned maintenance. Brake performance includes the effectiveness of braking during landing and taxiing as well as the system's responsiveness to pilot inputs. This study presents a thorough approach to understanding carbon brake pad degradation by benchmarking a suite of unsupervised Machine Learning (ML) clustering algorithms. The objective is to uncover distinct wear patterns and identify salient features differentiating varying degrees of wear. This effort leverages data that includes aircraft-specific parameters (such as aircraft weight), operational conditions (such as flight duration), and environmental factors (such as static air temperature) along with airport characteristics (such as runway length) observed across an airline's fleet of widebody aircraft variants. A Random Forest classifier is implemented to determine the most influential predictors of wear levels, providing a robust feature importance analysis. Methods including Principal Component Analysis (PCA) and an autoencoder are then leveraged to further reduce the dimensionality of the dataset. Various clustering techniques, including K-Means and Agglomerative Clustering, are considered and benchmarked with varying hyperparameter settings. These methods are applied without the knowledge of pre-assigned wear labels, ensuring an unbiased grouping based on intrinsic data characteristics. The performance of these algorithms is then quantitatively assessed using unsupervised evaluation metrics (e.g., Silhouette score) and supervised metrics (e.g., Rand Index) to gain insights from wear labels derived from the available wear pin parameter from the aircraft data. Categorical labels (i.e., High, Medium, or Low wear) are created by interpolating the wear pin signal and categorizing the degradation per flight into quantiles. The top features identified by Random Forest are then analyzed for differences across clusters. This iterative clustering process helps explain the data's intrinsic structure, revealing the foremost features indicative of brake wear. The findings have the potential to contribute to predictive maintenance strategies by enhancing the understanding of how various operating and environmental conditions impact carbon brake pad degradation. © 2025 Collins Aerospace.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

@CONFERENCE{Dergachev202512456,
