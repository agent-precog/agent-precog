	note = {Cited by: 21; All Open Access; Green Open Access}
}

@ARTICLE{Vilca20191416,
	author = {Vilca, Jose and Adouane, Lounis and Mezouar, Youcef},
	title = {Stable and Flexible Multi-Vehicle Navigation Based on Dynamic Inter-Target Distance Matrix},
	year = {2019},
