	journal = {IEEE Transactions on Medical Robotics and Bionics},
	pages = {},
	doi = {10.1109/TMRB.2026.3745169},
	url = {https://www.scopus.com/pages/publications/105054451635?origin=resultslist},
	abstract = {Haptic shared control in surgical robotics combines human-side and robot-side forces at a shared end effector while preserving operator involvement. However, the effects of geometric safety choices on task execution and force coordination remain unclear. We model the interaction as a two-agent cooperative Markov game under centralized training and decentralized execution, comparing learned human control with a task-tuned fixed-impedance baseline. This model-free multi-agent reinforcement learning framework supports joint policy adaptation without requiring a complete analytical interaction model. It compares MADDPG and rMAPPO with an epigraph-constrained approach under common geometric task definitions. In simulation, rMAPPO generally achieved the highest return and tracking performance, whereas the epigraph approach produced more conservative motions and lower geometric exposure, including no observed collision or dangerous-region exposure after geometry transfer. With real operator input, fixed-impedance-trained policies were faster and successful in all recorded trials. Policies trained with a learned partner exhibited greater command opposition, while the fixed epigraph condition produced the most aligned commands. This work provides a benchmark for studying human-control representation and constraint-handling trade-offs in haptic shared control. © 2019 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

@ARTICLE{Jasra2025,
	author = {Jasra, Sameer Kumar and Valentino, Gianluca and Muscat, Alan and Camilleri, Robert},
	title = {A Comparative Study of Unsupervised Deep Learning Methods for Anomaly Detection in Flight Data},
	year = {2025},
	journal = {Aerospace},
	volume = {12},
	number = {7},
	pages = {},
	doi = {10.3390/aerospace12070645},
	url = {https://www.scopus.com/pages/publications/105011609044?origin=resultslist},
	abstract = {This paper provides a comparative study of unsupervised Deep Learning (DL) methods for anomaly detection in Flight Data Monitoring (FDM). The paper applies Long Short-Term Memory (LSTM), Gated Recurrent Units (GRUs), Convolutional Neural Network (CNN), classic Transformer architecture, and LSTM combined with a self-attention mechanism to real-world flight data and compares the results to the current state-of-the-art flight data analysis techniques applied in the industry. The paper finds that LSTM, when integrated with a self-attention mechanism, offers notable benefits over other deep learning methods as it effectively handles lengthy time series like those present in flight data, establishes a generalized model applicable across various airports and facilitates the detection of trends across the entire fleet. The results were validated by industrial experts. The paper additionally investigates a range of methods for feeding flight data (lengthy time series) to a neural network. The innovation of this paper involves utilizing Transformer architecture and LSTM with self-attention mechanism for the first time in the realm of aviation data, exploring the optimal method for inputting flight data into a model and evaluating all deep learning techniques for anomaly detection against the ground truth determined by human experts. The paper puts forth a compelling case for shifting from the existing method, which relies on examining events through threshold exceedances, to a deep learning-based approach that offers a more proactive style of data analysis. This not only enhances the generalization of the FDM process but also has the potential to improve air transport safety and optimize aviation operations. © 2025 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 10; All Open Access; Gold Open Access; Green Open Access}
}

@BOOK{Gorak2026110,
	author = {Gorak, Tanusha and Anisha, P.R. and Reddy, C. Kishor Kumar and Sadaf, Rimsha and Paranthaman, Jothi},
	title = {Decentralized control and distributed intelligence for high-density UAV logistics networks supporting smart-city transportation and delivery services},
	year = {2026},
	journal = {Sustainable UAV Ecosystems: Integrating Blockchain, Quantum, and AI for Smart Mobility and SDG Innovation},
	pages = {110 - 133},
	doi = {10.1201/9781003731580-6},
	url = {https://www.scopus.com/pages/publications/105048932802?origin=resultslist},
	abstract = {Autonomous drone fleets and decentralized unmanned aerial vehicle (UAV) systems are becoming essential to the logistics of smart cities in the future. These systems use shared intelligence rather than a single central controller to enable drones to collaborate effectively, scale readily, and adjust to shifting urban surroundings. Several drones work together in a decentralized UAV logistics system by coordinating their movements in real time. They assign their work to one another by exchanging information between the drones, network-edge devices, and cloud systems. Drones may make fast decisions on their own using edge computing by maintaining the battery life, avoiding collisions, and selecting routes. Processing of large-scale data, long-term planning, and general system optimization are handled by the cloud. Therefore, edge and cloud computing are combined to provide a versatile system. These systems can manage a variety of applications, such as monitoring the city, delivery of medical emergencies, and last-stage product shipping. The difficulties associated with decentralized UAV logistics in smart cities concern privacy, noise, and safety when drones fly overhead. Clear rules and regulations must be established by governments for low-altitude airspace. Moreover, drones should be able to communicate with other drones from different companies without facing any problems. Decentralized UAV systems have the potential to transform urban logistics, despite all the challenges. So, they can reduce traffic on the roads, speed up delivery, and simplify transit. With innovations like edge computing, blockchain, and artificial intelligence, future smart city drone networks will be safer, more efficient, and easier to use. This chapter introduces decentralized UAV logistics and discusses its objectives and possible uses. Next discussed are decentralized control, coordination, and routing strategies, as well as the integration of UAVs with smart city logistics. Later on, it discusses legal, security, and safety concerns. It then examines infrastructure requirements, performance measurement, and simulation tools. Real-world case studies, a conclusion, and the scope of future research are included at the end. © 2027 selection and editorial matter, Hemant Kumar Saini, Yassine Maleh, Sita Rani, Surbhi Bhatia Khan; individual chapters, the contributors.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
