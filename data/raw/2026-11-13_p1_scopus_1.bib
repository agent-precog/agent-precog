@CONFERENCE{Berlowitz2025,
	author = {Berlowitz, Ilan},
	title = {Comparative Analysis of Aircraft Freighter Conversion Strategies},
	year = {2025},
	journal = {IACAS 2025 - 64th Israel Annual Conference on Aerospace Sciences},
