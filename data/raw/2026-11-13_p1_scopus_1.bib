@CONFERENCE{Moore2009,
	author = {Moore, Dennis},
	title = {Reliability Centered Maintenance support tools},
	year = {2009},
	journal = {Failure Prevention: Implementation, Success Stories and Lessons Learned - Proceedings of the 2009 Conference of the Society for Machinery Failure Prevention Technology},
	pages = {},
	url = {https://www.scopus.com/pages/publications/84870548927?origin=resultslist},
	abstract = {Ever since the birth of industry, mechanical, electrical and electromechanical system reliability has had a direct correlation to the profitability of an organization. Down time due to unscheduled failures within expensive production or transportation equipment means that labor is no longer optimized and/or non existent. In addition, the ratio of fixed costs to production output is adversely affected. Because of this negative impact, organizations stand to benefit from the creation of a preventative maintenance strategy to help avoid unforeseen equipment breakdowns. Within the scope of this strategy, equipment is routinely inspected and serviced in an effort to prevent unscheduled breakdowns from occurring. Reliability Centered Maintenance (RCM) is an industrial improvement program focused on providing input to a preventative maintenance strategy that addresses operations, maintenance and capital improvement processes. RCM focuses on system reliability and maximization of the Mean Time Between Failures (MTBF: The average amount of operationally available time for a group of systems or fleet) by maximizing the Mean Time To Fail (MTTF: The time in which statistically 50% or more of similarly aged systems in a statistical sample fail) for individual systems. RCM maintenance support systems, as developed by RJ LeeGroup, Inc. and their development partners, can minimize the cost of maintenance and extend the MTBF for systems. Savings are created by minimizing unscheduled outages/failures, maximizing operational maintenance activities. As a secondary value added feature, the information captured provides meaningful information about the reliability of systems for budgetary, financial or capital improvement efforts. At the core of RCM is the concept of system reliability. Simply put, reliability is the statistical probability of either an individual component or the product of components contributing to an overall operational system successfully achieving an operational threshold. The maintenance support systems described for this conference provide for: • Improved maintenance strategies for systems • Selective application of predictive and preventative maintenance tasks • Determine critical parts/assemblies and appropriately stock spares related to the critical impact of parts & assemblies • Provide strategies for improved system reliability • Reduced long term maintenance costs related to cost per activity cycle • Reduction in health, safety and environmental incidents caused by random failures Given RJ LeeGroup's background through United States Air Force contract initiatives, RJ LeeGroup has the proven capability to lead these process engineering efforts as well as the capability to reuse applications developed for the Air Force to provide value added feedback to assist in the implementation of reliability centered maintenance support systems.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

