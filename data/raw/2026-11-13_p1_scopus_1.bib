@ARTICLE{Lee2026,
	author = {Lee, Mengjie and Hu, Yujiao and Zhu, Yining and Han, Fanghao and Liu, Yi and Ran, Chuncheng and Zhou, Xingshe and Li, Zhigang and Pan, Yan and Chen, Jinchao and Yao, Yuan},
