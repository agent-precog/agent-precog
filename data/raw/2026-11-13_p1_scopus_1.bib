	year = {2008},
	journal = {SPACE APPLI 2008 - Space Applications Days},
	pages = {},
	url = {https://www.scopus.com/pages/publications/85116949618?origin=resultslist},
	abstract = {There are now many geolocation and data collection applications benefiting most sectors of the economy. The humanitarian aid sector, as represented by United Nations agencies and NGOs, is beginning to appreciate the advantages provided by these technologies, which mostly depend on combining field-based electronic devices (GPS receiver and satellite communication modem) with a web-based application allowing all the data collected remotely to be consulted and exploited in real time. There are several applications currently in use in the field:-The World Food Programme (UNWFP): managing the aircraft that drop food consignments in order to optimise airborne missions anywhere in Africa;-The Food and Agriculture Organisation (FAO): no fewer then 250 agents posted across the African continent are monitoring the development of locust populations, using Inmarsat D+ terminals to send in their reports entered on state-of-the-art touch screens provided and connected by Novacom Services; by calling up crop-spraying aircraft quickly and accurately they have already saved many harvests;-The UN High Commission for Refugees (UNHCR): always in the front line, the HCR is the UN organisation most frequently confronted with the inherent dangers of regional conflicts; guaranteeing the protection of its own personnel has become a priority. For this reason, most convoys are now equipped with geolocation terminals fitted with 'SOS buttons' that can send instant distress calls, relayed by Novacom Services to field outposts as well as the HCR headquarters in Europe. Other agencies like the Red Cross (ICRC) and NGOs like Doctors Without Borders (Mèdecins Sans Frontières) are currently examining their use. The available satellite technologies, combined with peripherals such as screens or SOS buttons, provide an excellent answer to the needs of humanitarian aid professionals. However, any solution must take account of the fact that these users belong to large institutions and must also address the many different problems they face: for this purpose, Novacom Services joined forces with UNOSAT and the Fleet Forum in Geneva to promote and implement a geolocation service designed specially for players in the world of humanitarian aid. UNOSAT is a United Nations initiative launched in 2001 whose brief is to provide the agencies and member states of the United Nations with satellite-based solutions for humanitarian aid, post-crisis rehabilitation and development planning. Software management of the collected data remains the responsibility of the Novacom centre in Toulouse, while interfacing with users is the task of UNOSAT, providing the added-value of its professional experience. The Fleet Forum will provide an interface for humanitarian organisations possessing a fleet of vehicles and will publicise the service within this community. The NAV4ALL project duplicates the model that worked successfully for UNOSAT, making satellite imagery and maps available to UN agencies, particularly in the event of natural disasters. In conclusion, we found that the needs of humanitarian organisations fall into two categories: those related to the safety of personnel and those concerning vehicle fleet management. The latter issue remains a major objective for organisations that sometimes have thousands of vehicles deployed around the world. Not only can maintenance costs be reduced but also CO<sub>2</sub> emissions, thus fully justifying the investment cost of implementing a geolocation system.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Riddell20051712,
	author = {Riddell, Niall and Jackson, Mark and Harman, Nick and Page, Graham},
	title = {Modelling of Andreeva Bay SNF transportation},
	year = {2005},
	journal = {Proceedings - 10th International Conference on Environmental Remediation and Radioactive Waste Management, ICEM'05},
	volume = {2005},
	pages = {1712 - 1717},
	url = {https://www.scopus.com/pages/publications/33646566838?origin=resultslist},
	abstract = {Spent nuclear fuel (SNF), arising from the operations of the Former Soviet Union's Northern Fleet, has been stored at the Andreeva Bay Costal Technical Base in North-West Russia since the 1960s. There are currently approximately 20,000 spent fuel assemblies stored within three 'dry' storage tanks. The condition of the storage tanks is poor with inadequate roofing and this has allowed water ingress to the tanks. Inspection of the cells has indicated very high activity levels in the interstitial water. The UK Government's Former Soviet Union Nuclear Legacy Programme has been supporting a project concerned with SNF management at Andreeva Bay since 2002. RWE NUKEM is the programme management consultant to the Department of Trade and Industry (DTI) for this project. The primary objective of this work is to improve safety and security at Andreeva Bay. Russian government organisations have proposed a number of strategies for tackling the SNF management problems. The possible transportation of the SNF away from Andreeva Bay is one of the issues under consideration. As part of the evaluation of the proposed transport methods, a computer simulation program has been developed to model the various SNF transport strategy options. The modeling of the SNF transport logistics is based on information contained in the Russian proposals and estimates based on comparable transport activities. The transport strategies include the use of both sea and rail transport, interim / buffer storage of SNF at selected locations, and the use of different forms of packaging. The simulation model allow users to vary all key parameters relating to the proposed activities including frequency of vehicle transfers, the rate of package loading, storage capacity and availability of facilities. The simulation model also allows the users to factor in climatic limitations associated with working in North-West Russia, delays in the availability of equipment/storage facilities and the influence of other concurrent SNF transportation activities. The primary output of each simulation is the elapsed time for the transportation of a given amount of SNF. The simulation is also useful for identifying potential bottlenecks and understanding the influence of different transport elements. The simulations are being used to assist with many of the decision making processes, such as to review proposed purchases and work packages, explain the problems of SNF transportation to non-technical personnel and plan future activities relating to recovery and repackaging of the SNF. Copyright © 2005 by ASME.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

