@ARTICLE{Arulkumar2026,
	author = {Arulkumar, Diana and K, Kartheeban},
	title = {Metastack-aptnet: An ensemble deep learning framework for advanced persistent threat detection and mitigation in cyber-physical systems using blockchain technology},
	year = {2026},
	journal = {Computers and Electrical Engineering},
	volume = {130},
	pages = {},
	doi = {10.1016/j.compeleceng.2025.110838},
	url = {https://www.scopus.com/pages/publications/105024418971?origin=resultslist},
	abstract = {Advanced Persistent Threats (APTs) are increasingly targeting Cyber-Physical Systems (CPS) that drive the automation of industries, healthcare IoT, and smart grids. These are multi-stage stealthy attacks that circumvent the old systems of intrusion detection posing serious threats to the continuity and safety of operations. To solve this problem, this paper introduces MetaStack-APTNet, a new ensemble deep learning model, which is capable of not only identifying APTs with high accuracy but also scoring and mitigating them in real time. In comparison with the current models, MetaStack-APTNet is a hybrid optimization (Dynamic Addax-Flood Optimization) coupled with adaptive multi-agent decision-making and blockchain-based secure storage to provide an end-to-end defense pipeline. Experiments on real-world CPS data prove to more accurate (98.92) and resilient, with a detection time of 200 ms and mitigation time of 700 ms, which is better than the state-of-the-art baselines. Besides, SHapley Additive Explanations (SHAP) interpretability is transparent to allow practical implementation. The work contributes to the development of CPS security considerably because it offers a strong, explainable, and scalable mechanism of defense against dynamic APT campaigns and is applicable to a wide range of industrial and critical infrastructure sectors. The implementation is available at: https://github.com/diana2347a34-cell/METASTACK-APTNET-AN-ENSEMBLE-DEEP-LEARNING-FRAME-FOR-APT-DETECTION-AND-MITIGATION-USING-Blockchain . Copyright © 2025. Published by Elsevier Ltd.},
