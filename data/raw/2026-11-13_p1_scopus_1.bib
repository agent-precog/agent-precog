	url = {https://www.scopus.com/pages/publications/105043692683?origin=resultslist},
	abstract = {Global manufacturing supply chains are increasingly vulnerable to unforeseen disruptions caused by events such as canal blockages, financial market shocks, and sudden trade tariff fluctuations. Proactive identification of such hazards is critical, yet most current approaches remain reactive, rely on narrow data sources, and provide limited decision support once impact materialises. To address this gap, this work introduces a four-layer multi-agent architecture that fuses heterogeneous data streams with supply-network context, a reinforcement-learning evidence-acquisition policy that actively reduces uncertainty under a bounded probing budget, and a schema-constrained LLM reasoning that grounds disruption hypotheses to supply-chain entities with confidence and provenance. The introduced multi-agent framework continuously monitors heterogeneous structured and unstructured streams, including global news, social media, shipping and logistics records, sensor feeds, and financial indicators. Reinforcement Learning (RL) agents guide evidence acquisition across sources, while schema-constrained Large Language Model (LLM) agents synthesize weak signals into disruption hypotheses grounded in supply-network entities and flows. Coordination agents aggregate evidence into risk assessments and generate early warnings with confidence and provenance to support operational workflows. By facilitating continuous, evidence-linked early warning with confidence and provenance, the proposed system addresses the limitations of single-source and after-the-fact analyses found in existing solutions.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
