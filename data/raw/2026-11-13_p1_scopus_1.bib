@ARTICLE{Li2026411,
	author = {Li, Peihan and Menon, Vishnu and Gudiguntla, Bhavanaraj and Ting, Daniel and Zhou, Lifeng},
	title = {Challenges Faced by Large Language Models in Solving Multi-agent Flocking},
	year = {2026},
	journal = {Springer Proceedings in Advanced Robotics},
	volume = {34},
	pages = {411 - 424},
	doi = {10.1007/978-3-032-04584-3_28},
	url = {https://www.scopus.com/pages/publications/105021937445?origin=resultslist},
	abstract = {Flocking is a behavior where multiple agents in a system attempt to stay close to each other while avoiding collision and maintaining a desired formation. This is observed in the natural world and has applications in robotics, including search and rescue, wild animal tracking, and perimeter surveillance. Recently, large language models (LLMs) have displayed an impressive ability to solve various collaboration tasks as individual decision-makers. Solving multi-agent flocking with LLMs would demonstrate their usefulness in situations requiring spatial and decentralized decision-making. Yet, when LLM-powered agents are tasked with implementing multi-agent flocking, they fall short of the desired behavior. After extensive testing, we find that agents with LLMs as individual decision-makers typically opt to converge on the average of their initial positions or diverge from each other. After breaking the problem down, we discover that LLMs cannot understand maintaining a shape or keeping a distance in a meaningful way. Solving multi-agent flocking with LLMs would enhance their ability to understand collaborative spatial reasoning and lay a foundation for addressing more complex multi-agent tasks. This paper discusses the challenges LLMs face in multi-agent flocking and suggests areas for future improvement and research. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Green Open Access}
}

@CONFERENCE{Zhang20259,
	author = {Zhang, Feng and Lin, Rui and Hu, Jian and Wu, Qichao},
	title = {Efficient deep reinforcement learning-based multirobot path planning},
	year = {2025},
	journal = {ACM International Conference Proceeding Series},
	pages = {9 - 16},
	doi = {10.1145/3728985.3728988},
	url = {https://www.scopus.com/pages/publications/105010465254?origin=resultslist},
	abstract = {The investigation of autonomous path planning for multiple robots in complex environments is both challenging and essential. In this work, we propose an efficient reinforcement learning-based path planning policy for multi-robot systems using distributed multi-agent deep deterministic policy gradients (MADDPG), termed multi-robot deterministic policy (MR-MADDPG). Our approach enhances the observation function to incorporate information from other robots and nearby obstacles, improves the action function by adding acceleration, and introduces a distance function to the reward system to expedite pathfinding. We also propose a time reward and trajectory evaluation function to optimize trajectories in cases of poor performance. Furthermore, we introduce the TEM-MRDDPG algorithm, which builds on MR-MADDPG by integrating trajectory optimization and centralized training with distributed execution, leading to improved adaptability and efficiency. Our method leverages neural networks for faster multi-robot path planning, enabling systems to adapt to complex environments and develop effective obstacle avoidance strategies. Experimental results demonstrate that MR-MADDPG and TEM-MRDDPG outperform previous reinforcement learning approaches in success rate, endpoint time, and trajectory smoothness, effectively handling obstacles in complex scenarios.  Copyright © 2024 held by the owner/author(s). Publication rights licensed to ACM.},
