	year = {2026},
	journal = {Springer Proceedings in Complexity},
	pages = {521 - 531},
	doi = {10.1007/978-3-032-21524-6_41},
	url = {https://www.scopus.com/pages/publications/105046294256?origin=resultslist},
	abstract = {The integration of large language models (LLMs) into mission-critical embedded and cyber-physical systems raises urgent concerns about safety, reliability, and adversarial robustness. In domains such as autonomous vehicles, drones, and industrial control, conventional safeguards are not sufficient to prevent harmful, biased, or manipulated outputs. This paper introduces an LLM trustworthiness controller, a layered runtime system that inspects inputs and outputs, applies semantic and contextual filters, scores uncertainty, bounds memorization, and enforces deterministic timing. By embedding these functions, the controller prevents unsafe behavior, ensures compliance with trust policies, and secures digital sovereignty over critical infrastructures. We present FORT (Filters for Output Reliability and Trustworthiness) our implementation with quantized models deployable on Edge hardware, and show how model-aware specializations adapt to GPT, Claude, and Mistral. Mapping major attack surfaces to defense capabilities, the work demonstrates how trustworthiness can be operationalized as a certifiable, real-time controller, supporting the accelerated and sovereign deployment of LLMs under the EU AI Act. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Wang20266299,
	author = {Wang, Jiashuai and Li, Ke and Wang, Xiaoyu and Li, Guanglin and Li, Zong-Ming and Zhang, Na and Liu, Mengqi and Wei, Na},
	title = {Humanoid Five-Digit Robotic Grasping via Multi-Agent Reinforcement Learning With Potential-Guided Optimization and Weight Scheduling},
	year = {2026},
	journal = {IEEE Transactions on Automation Science and Engineering},
	volume = {23},
	pages = {6299 - 6314},
	doi = {10.1109/TASE.2026.3672621},
	url = {https://www.scopus.com/pages/publications/105032781603?origin=resultslist},
	abstract = {Dexterous multi-finger robotic grasping faces two primary limitations: 1) traditional demonstration-based learning requires a separate trajectory to be trained for each object type, resulting in limited generalization across different objects; and 2) single-agent reinforcement learning struggles to coordinate the asynchronous motions of the thumb and fingers with heterogeneous joints, leading to inefficient exploration and slow convergence. To overcome these limitations, this study proposed two core innovations, including 1) a dynamic modulation kernel movement primitive (DM-KMP) algorithm, which combines dynamic movement primitives with kernel-based movement primitives to preserve trajectory topology and local probabilistic modulation characteristics; and 2) a novel potential-guided weight scheduling multi-agent deep deterministic policy gradient method (PWS-MADDPG), in which the thumb and fingers are modeled as independent agents. This enables the generation of grasping trajectories for diverse object categories using only a limited number of demonstrations. By leveraging a potential field model to optimize action selection, this method accelerates model convergence. Moreover, a multi-modal reward function with weight scheduling was designed to facilitate a seamless transition from individual optimization to coordinated team behavior. Experiment results demonstrated that the proposed PWS-MADDPG achieved a grasping success rate of 85.48% on a dexterous hand grasping across 11 object categories, outperforming the existing approaches - with a 40.31% improvement over the DDPG algorithm and a 20.05% improvement over the MADDPG algorithm. Furthermore, to verify the grasping stability and adaptability of the system in real-world scenarios, a grip-force validation experiment was designed using a custom cylindrical apparatus embedded with five six-axis sensors. These results demonstrate that the robotic hand using this novel method can maintain stable grasping and adaptively regulate grip and load forces in response to incremental external loads, based on a control policy that is trained in both simulation and real-world environments. These findings suggest that this method has strong Sim-to-Real transferability, biological plausibility in force adjustment, and robustness to environmental disturbances, enhancing both the training efficiency and generalization in simulation, and demonstrating high grasping robustness and successful rates in the real-world tasks. The proposed method holds strong potential for high-precision, safety-critical applications, including intelligent manufacturing, prosthetic control, and living assistance. Note to Practitioners - Dexterous robotic grasping is one of the most important demands in industrial manufacturing and home-based services. Traditional robotic grasping methods rely on predefined rules and precisely modeled objects with only two or three digits, thereby being confined in structured environments with well-described grasping objects and standardized grasping programs. It is still a challenging issue to control a robotic hand (unless otherwise specified, the terms humanoid five-digit robotic hand and robotic hand refer to the same platform) with humanoid five digits for dexterous grasping in unstructured environment where the physical characteristics of objects, including shape, weight, and material, as well as the grasping parameters such as joint angles, finger positions, and applied forces, are unknown or difficult to model in advance. This study aimed to propose a novel control method enabling a humanoid five-digit robotic hand to grasp diverse objects with high grasping accuracy and adaptability. This novel method features two key innovations: first, it incorporates a learning-from-demonstration mechanism that allows generalization from a small set of expert demonstrations to a broader range of object types; second, it enhances the autonomous learning process of the robotic hand by improving the coordination of multiple fingers, thereby enabling more stable and adaptive grasps in the presence of external disturbances. In practice, this novel method would play a role in control of humanoid five-digit robotic hand with appropriate kinematic (e.g. the attitude and position of each digit) and kinetic (e.g. the force applied by each digit) parameters for grasping a previously unseen object whose physical properties are unknown. This novel method has strong environmental adaptability and autonomous learning, and could be potentially applied in multiple industrial and home-based scenarios.  © 2026 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Zhang2026,
	author = {Zhang, Zihao and Handwerker, Karl and Varga, Balint},
