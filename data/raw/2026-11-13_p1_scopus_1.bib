@ARTICLE{Guan2025,
	author = {Guan, Cong and Jiang, Tao and Li, Yi-Chen and Zhang, Zongzhang and Yuan, Lei and Yu, Yang},
	title = {Constraining an Unconstrained Multi-agent Policy with offline data},
	year = {2025},
