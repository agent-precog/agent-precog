@ARTICLE{González-Potes2026,
	author = {González-Potes, Apolinar and Martínez-Castro, Diego and Paredes, Carlos M. and Ochoa-Brust, Alberto and Mena, Luis J. and Martínez-Peláez, Rafael and Félix, Vanessa G. and Félix-Cuadras, Ramón A.},
	title = {Hybrid AI and LLM-Enabled Agent-Based Real-Time Decision Support Architecture for Industrial Batch Processes: A Clean-in-Place Case Study},
	year = {2026},
