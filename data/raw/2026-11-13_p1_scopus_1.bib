@CONFERENCE{Zhang2025241,
	author = {Zhang, Zhenyu and Wu, Qiyou and Zhang, Xiaoyu and Yuan, Zimo and Wang, Chaoshi and Hong, Qiman},
	title = {MADQN: A Decentralized and Lightweight Multi-AGV Coordination Framework with Hybrid Arbitration for Warehouse Automation},
	year = {2025},
	journal = {2025 5th International Conference on Digital Society and Intelligent Systems, DSInS 2025},
	pages = {241 - 247},
	doi = {10.1109/DSInS68311.2025.11329861},
	url = {https://www.scopus.com/pages/publications/105033158608?origin=resultslist},
	abstract = {The coordination of large-scale Automated Guided Vehicle (AGV) fleets is a fundamental challenge in industrial automation, perpetually trapped between the poor scalability of centralized planners and the instability of decentralized multi-agent reinforcement learning (MARL). This paper introduces MADQN, a novel decentralized framework that transcends this fundamental tradeoff through a hybrid arbitration mechanism. Grounded in a minimalist design philosophy, each AGV operates as an autonomous agent, making decisions based solely on a local 3x3 grid observation and the shared intentions of immediate neighbors. This design ensures constant per-agent computational complexity, which is the foundation for true scalability. The core innovation is a bi-level architecture that decouples long-term optimization via a Deep Q-Network (DQN) from immediate, rule-based safety guarantees, thereby enabling stable policy learning while ensuring operational safety from the outset. Extensive evaluations conducted in grid-world environments of varying complexity demonstrate the framework's superiority. Compared to a pure learning-based baseline (Pure MADQN), our hybrid framework achieves a dramatic reduction in immediate collisions and a improvement in task completion efficiency. Furthermore, the framework exhibits remarkable scalability, with performance metrics degrading sub-linearly as the environment complexity and AGV density increase. MADQN establishes a robust, scalable, and practical foundation for the reliable deployment of large-scale AGV systems in real-world industrial settings.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Fabian2025166,
	author = {Fabian, Stefan and Schmidt, Aljoscha and Süß, Jonas and Dishant and Oza, Aum and Von Stryk, Oskar},
	title = {Athena: An Autonomous Open-Hardware Tracked Rescue Robot Platform},
	year = {2025},
	journal = {2025 IEEE International Symposium on Safety, Security, and Rescue Robotics, SSRR 2025},
	pages = {166 - 171},
	doi = {10.1109/SSRR68451.2025.11391264},
	url = {https://www.scopus.com/pages/publications/105035827122?origin=resultslist},
	abstract = {In disaster response and situation assessment, robots have great potential in reducing the risks to the safety and health of first responders. As the situations encountered and the required capabilities of the robots deployed in such missions differ wildly and are often not known in advance, heterogeneous fleets of robots are needed to cover a wide range of mission requirements. While UAVs can quickly survey the mission environment, their ability to carry heavy payloads such as sensors and manipulators is limited. UGVs can carry required payloads to assess and manipulate the mission environment, but need to be able to deal with difficult and unstructured terrain such as rubble and stairs. The ability of tracked platforms with articulated arms (flippers) to reconfigure their geometry makes them particularly effective for navigating challenging terrain. In this paper, we present Athena, an open-hardware rescue ground robot research platform with four individually reconfigurable flippers and a reliable low-cost remote emergency stop (E-Stop) solution. A novel mounting solution using an industrial PU belt and tooth inserts allows the replacement and testing of different track profiles. The manipulator with a maximum reach of 1.54m can be used to operate doors, valves, and other objects of interest. Full CAD & PCB files, as well as all low-level software, are released as open-source contributions. © 2025 IEEE.},
