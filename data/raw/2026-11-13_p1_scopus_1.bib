	url = {https://www.scopus.com/pages/publications/85112402113?origin=resultslist},
	abstract = {The problem of finding pure strategy Nash equilibria in multiagent concurrent games with finite-horizon temporal goals has received some recent attention. Earlier work solved this problem through the use of Rabin automata. In this work, we take advantage of the finite-horizon nature of the agents’ goals and show that checking for and finding pure strategy Nash equilibria can be done using a combination of safety games and lasso testing in Büchi automata. To separate strategic reasoning from temporal reasoning, we model agents’ goals by deterministic finite-word automata (DFAs), since finite-horizon logics such as LTL<sub>f</sub> and LDL<sub>f</sub> are reasoned about through conversion to equivalent DFAs. This allow us characterize the complexity of the problem as PSPACE complete. © 2021 International Foundation for Autonomous Agents and Multiagent Systems (www.ifaamas.org). All rights reserved.},
