@ARTICLE{Shabur2026,
	author = {Shabur, Md. Abdus},
	title = {Autonomous AI Agents in Industrial Operations: A Systematic Review of Production Scheduling, Predictive Maintenance and Supply Chain Optimisation},
	year = {2026},
	journal = {IET Collaborative Intelligent Manufacturing},
	volume = {8},
	number = {1},
	pages = {},
	doi = {10.1049/cim2.70083},
	url = {https://www.scopus.com/pages/publications/105052949104?origin=resultslist},
	abstract = {The transition from Industry 4.0 to the value-driven human-centric Industry 5.0 paradigm increasingly relies on autonomous AI agents for complex decision-making. However, existing research remains fragmented within isolated operational silos. This systematic review aims to unify this landscape by analysing the deployment of agentic architectures encompassing classical multiagent systems, deep reinforcement learning and large language models (LLMs) across production scheduling, maintenance management and supply chain optimisation. Following PRISMA 2020 guidelines, we systematically analysed 118 peer-reviewed studies published between 2015 and 2026. The findings reveal a critical maturity asymmetry: although agentic methods are highly advanced in diagnostic monitoring and localised execution, a structural ‘deployment gap’ persists at the real-time prescriptive decision-making step across all three domains. This bottleneck is primarily driven by unresolved vulnerabilities in algorithmic explainability, safety verification and cybersecurity. As a central novelty, this review introduces a cross-domain taxonomy that categorises agent architectures and synthesises their shared cyber-physical dependencies, including digital twins, edge-distributed computing and semantic interoperability standards. By evaluating these traditionally isolated literature together, we expose performance discrepancies where identical architectures yield markedly different outcomes depending on the operational context. Finally, we propose a comprehensive research roadmap to bridge the deployment gap, emphasising the need for robust explainable AI (XAI), federated learning for cross-organisational data governance and sociotechnical frameworks that ensure genuine human–agent collaboration. Ultimately, closing this gap is essential for realising the fully self-organising resilient industrial networks envisioned by Industry 5.0. © 2026 The Author(s). IET Collaborative Intelligent Manufacturing published by John Wiley & Sons Ltd on behalf of The Institution of Engineering and Technology.},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@CONFERENCE{Xing202650,
	author = {Xing, Yuan and Verma, Abhishek and Liu, Cheng and Pan, Haowen and Ding, David and Qian, Haoyu and Bao, Yida and Yao, Wei and Feddersen, Colter and Dean, Connor},
	title = {HiMAP: Hierarchical Human-in-the-Loop Multi-Agent Reinforcement Learning for Collaborative Path Planning},
	year = {2026},
	journal = {2026 IEEE World AI IoT Congress, AIIoT 2026},
	pages = {50 - 56},
	doi = {10.1109/AIIoT68874.2026.11569612},
	url = {https://www.scopus.com/pages/publications/105044259384?origin=resultslist},
	abstract = {This paper introduces HiMAP, a hierarchical framework for multi-robot path planning that integrates human-in-the-loop guidance with multi-agent reinforcement learning and classical planning. Decision-making is split into three layers: high-level task prioritization with human hints, mid-level assignment and coordination, and low-level motion planning using A* and DWA with conflict checks. Tasks arrive continuously via a Poisson process and require coordinated teams to reach goals within short time windows, modeling realistic collaborative missions. Priority dynamics, travel-time penalties, and confidence-based hints steer selection, while shared rewards encourage cooperation in learning baselines. The hierarchy reduces the joint action space, improves safety, and supports scalability through clear interfaces between layers. We evaluate HiMAP in a grid-world simulator with dynamic task streams and compare against DQN, PPO, DDPG, and tabular Q-learning. Results across baseline comparisons, training curves, agent scaling, and environment variations show that HiMAP achieves higher task throughput and substantially lower collision rates under comparable computational budgets. By separating ranking, assignment, and motion, it supports modular upgrades and tuning of safety and efficiency for diverse environments and mission profiles. This improves interpretability and simplifies integration with operators. The design also enables targeted debugging, facilitates transfer to new maps, and eases integration with operational constraints and mission policies. It also supports incremental deployment, enabling operators to adjust policies safely while preserving throughput under evolving mission requirements and realistic conditions. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@BOOK{Balasundaram2026759,
