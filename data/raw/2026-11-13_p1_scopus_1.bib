@ARTICLE{Rekabi Bana2024,
	author = {Rekabi Bana, Fatemeh and Krajník, Tomáš and Arvin, Farshad},
	title = {Evolutionary optimization for risk-aware heterogeneous multi-agent path planning in uncertain environments},
	year = {2024},
	journal = {Frontiers in Robotics and AI},
