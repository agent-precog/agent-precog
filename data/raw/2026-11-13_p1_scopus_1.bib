	title = {Path Coordination for Robust, Fast, and Scalable Multi-Agent Path Finding Under Unforeseen Delays},
	year = {2025},
	journal = {IEEE Transactions on Automation Science and Engineering},
	volume = {22},
	pages = {22396 - 22409},
	doi = {10.1109/TASE.2025.3615989},
	url = {https://www.scopus.com/pages/publications/105018090780?origin=resultslist},
	abstract = {Multi-agent path finding (MAPF), i.e., finding collision-free paths for multiple agents on graphs, is widely applied to domains such as warehouse automation, robotic manufacturing, and autonomous vehicle coordination. One major challenge that hinders MAPF algorithm deployments is that, agents often suffer from unforeseen delays without prior knowledge during path execution because of exogenous disturbances (e.g., blocked by humans, uncontrollable or third-party vehicles in the workspace). Existing approaches can hardly achieve robustness, computational efficiency and scalability simultaneously. To address this issue, we propose a novel approach based on the classical decoupled path coordination, which firstly plans paths for each agent in space domain, and then schedules paths in time-space domain to avoid collisions or deadlocks. To guarantee liveness and improve computational efficiency, it incorporates deadlock alleviation, prevention, and repair mechanisms utilizing several graph structures. Theoretically, necessary conditions are provided and formally proved for the safety and liveness in the presence of unforeseen delays. Empirically, the proposed approach is shown to be robust, fast and scalable. It also significantly outperforms state-of-the-art MAPF robust execution approaches on success rate, runtime, and solution quality. © 2004-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

