	url = {https://www.scopus.com/pages/publications/105038115049?origin=resultslist},
	abstract = {Accurate pedestrian trajectory prediction is critical for ensuring the safety of autonomous driving and robotic navigation in complex urban environments. However, existing methods often struggle to jointly model environmental context, motion dynamics, and multi-agent interactions, which limits their ability to infer pedestrians' latent movement intentions in highly dynamic scenes. In this paper, we propose Interactive and Intent-aware Multimodal Trajectory Prediction (I2MTP), a unified framework that incorporates neighborhood encoding, interaction-aware heterogeneous graphs, and gaze-driven attention to jointly model pedestrian interactions and motion intentions in a spatiotemporal manner. A hierarchical attention mechanism is employed to capture both local neighborhood dependencies and long-range temporal dynamics, and the model is trained end-to-end using a multi-level loss. Extensive experiments on the CREATTIVE3D dataset demonstrate that I2MTP outperforms existing methods in terms of ADE and FDE, achieving particularly significant improvements in challenging, interaction-rich environments. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
