	title = {Self-Navigation in Non-Adversarial Crowds: An Invariant Set-Based Approach},
	year = {2026},
	journal = {IEEE Transactions on Control Systems Technology},
	volume = {34},
	number = {5},
	pages = {2260 - 2275},
	doi = {10.1109/TCST.2026.3695111},
	url = {https://www.scopus.com/pages/publications/105041046817?origin=resultslist},
	abstract = {Self-navigation in noncoordinating crowded environments is a challenging task within multiagent systems consisting of nonholonomic robots operating through local sensing. Here, self-navigation refers to complete autonomy without relying on any external systems for navigation. In this setting, our primary objective is the development of a fast, novel, sensor-driven controller that directly computes control commands to enable safe maneuvering while coexisting with other agents. We propose an input-constrained feedback controller for nonholonomic mobile robots and characterize the associated invariant sets. These invariant sets are the key to maintaining stability and safety amidst noncooperating agents. We then introduce a planning strategy that steers the generation of invariant sets toward the agent's intended target, enabling robots to compute provably safe control inputs without preplanned paths or trajectories when navigating crowded multiagent environments. The practicality of our technique is demonstrated through hardware experiments, and we provide a comparison with existing navigation strategies where each robot makes independent sensing and decisions. The proposed approach is well-suited to scenarios that demand rapid, on-the-fly control computations based solely on real-time perceived safety bounds.  © 1993-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

