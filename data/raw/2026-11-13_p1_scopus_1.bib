}

@CONFERENCE{Monnin2012107,
	author = {Monnin, Maxime and Leger, Jean-Baptiste and Morel, David},
	title = {Proactive fleet monitoring and management facilities: KASEM® e-maintenance platform},
	year = {2012},
	journal = {11th International Probabilistic Safety Assessment and Management Conference and the Annual European Safety and Reliability Conference 2012, PSAM11 ESREL 2012},
	volume = {1},
	pages = {107 - 116},
	url = {https://www.scopus.com/pages/publications/84873107485?origin=resultslist},
	abstract = {Many approaches and tools are now available during engineering for investment forecasting, logistic support scaling and maintenance strategies definition. When systems are in operation phase, manager and operators have to face with many constraints in order to ensure system performance. In many cases, fleet or plant operation is optimized (in terms of production or mission and maintenance planning), making system availability a primary day to day concern. Thus, maintenance plays a first order role to ensure system performance and move from "fail and fix" maintenance practices to "predict and prevent" strategies. Enabling such proactive fleet maintenance strategies implies to address fleet-wide monitoring and management issues. It is thus necessary to manage relevant corresponding knowledge arising both from modelling and monitoring of the fleet, in order to provide managers and engineers with a relevant synthesis of information and keep it updated regarding both the global health of the fleet and the current status of their maintenance efforts. In this paper the main approaches of fleet-wide maintenance strategies are discussed and an original approach supported by the KASEM platform is proposed. KASEM delivers a "hub of technologies" in an interoperable and integrated framework by including technologies and methods through a workflow tracking and following problem solving process. The platform is compliant with industry standards and based on an open Service Oriented Architecture (SOA) framework. The underlying methods, modelling and tools that improve the key processes of are presented and illustrate how to take a next step towards fleet-wide monitoring and management. Copyright © (2012) by IAPSAM & ESRA.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Zelazo2013473,
