@CONFERENCE{Lefranc202658,
	author = {Lefranc, G. and Gatica, G. and Vasquez, E. and Osorio-Comparán, R.},
	title = {Explainable AI (XAI) for Agentic Cobots},
	year = {2026},
	journal = {Procedia Computer Science},
