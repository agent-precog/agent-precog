}

@CONFERENCE{Zhang2026145,
	author = {Zhang, Xinyi and Hu, Di},
	title = {Learning to Debate: Optimal Stopping Strategies for Multi-Agent LLM Deliberation},
	year = {2026},
	journal = {2026 International Conference on Generative Artificial Intelligence and Information Security, GAIIS 2026},
	pages = {145 - 152},
	doi = {10.1109/GAIIS69281.2026.11519273},
	url = {https://www.scopus.com/pages/publications/105041680064?origin=resultslist},
	abstract = {Multi-agent debate has emerged as a promising paradigm for improving the reasoning capabilities of large language models (LLMs). However, the relationship between debate duration and output quality remains poorly understood. In this paper, we introduce the debate fatigue hypothesis: the notion that debate quality follows a non-monotonic trajectory, initially improving with additional rounds before eventually degrading. We propose a scaling law that models debate quality as a function of rounds: Q(T) = a • log(T + c) - b • T, where the fatigue coefficient b> 0 captures diminishing returns. Through extensive experiments with GPT-4o across 108+ debates spanning five task categories (Mathematics, Code, Logic, Science, and Finance), we validate this hypothesis with 100% confirmation rate. We further develop an adaptive stopping strategy that achieves 98.7% of oracle performance while reducing computational costs by up to 50%. Additionally, our security evaluation demonstrates that multi-agent debate reduces hallucination indicators by 61.6% and corrects 50.6% of single-agent errors, providing significant safety improvements for LLM deployment. Our findings provide both theoretical foundations and practical guidelines for deploying multi-agent debate systems efficiently in industrial applications. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Rochpuang2025,
	author = {Rochpuang, Chutithep and Chen, Junghui},
	title = {Optimizing organic Rankine cycle systems: a hierarchical reinforcement learning approach to design and control},
	year = {2025},
	journal = {Applied Thermal Engineering},
	volume = {278},
	pages = {},
	doi = {10.1016/j.applthermaleng.2025.127337},
	url = {https://www.scopus.com/pages/publications/105009896158?origin=resultslist},
	abstract = {To improve energy efficiency and minimize waste heat emissions, the Organic Rankine Cycle (ORC) is a reliable technology for industrial waste heat recovery, effectively transforming low-grade waste heat into usable energy. However, traditional optimization methods struggle to maintain efficiency under fluctuating heat conditions, requiring frequent adjustments. Similarly, conventional PID controllers face challenges due to system nonlinearities and inter-controller interactions, leading to the need for continuous parameter recalibration. To address these limitations, a cutting-edge Hierarchical Reinforcement Learning (HRL) framework for dynamic power optimization and adaptive local control is proposed. The HRL model integrates two levels: a high-level agent that optimizes power output with safety constraints and sets ideal setpoints, and a low-level agent leveraging Multi-Agent Reinforcement Learning (MARL) to fine-tune PID parameters, ensuring rapid adaptation to changing conditions. By employing a centralized critic with decentralized actors, the MARL framework effectively captures controller interactions and directly optimizes Q-values. The results show a remarkable 17.19 % improvement in energy recovery compared to conventional methods, achieving a total energy saving of 63,066.27 kJ, highlighting the potential of this HRL-based approach for more efficient and adaptive ORC operation. © 2025 Elsevier Ltd},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@CONFERENCE{Kirubhakaran2025,
	author = {Kirubhakaran, M. and Sundarrajan, M. and Gowtham, T. and Agila, D. and Akshya, J. and Sundarrajan, M. and Choudhry, Mani Deepak and Manochitra, M.},
	title = {Self-Supervised Learning with Variational Autoencoders for Anomaly Detection in Autonomous Drone Fleets},
	year = {2025},
	journal = {Proceedings - 4th International Conference on Smart Technologies, Communication and Robotics 2025, STCR 2025},
	pages = {},
	doi = {10.1109/STCR62650.2025.11019136},
	url = {https://www.scopus.com/pages/publications/105008424786?origin=resultslist},
	abstract = {However, Unmanned Aerial Vehicles (UAVs) are increasingly being employed for different applications such as surveillance, logistics, disaster response, and smart city management, and thereby, the requirement for robust detection of anomalies and path optimization techniques has arisen. Existing traditional UAV monitoring systems typically depend on anomaly detection based on a rule or an unsupervised clustering method, i.e., DBSCAN and One-Class SVM, balancing high false positives and slow response time, correction, and suboptimal trajectory. To tackle these issues, we develop an AI-powered UAV anomaly detection and adaptive navigation framework where Isolation forests and MDPs are used to predict UAV trajectory, and DQNs are used for adaptive navigation. Experimental results in a simulated smart city arena with a multi-UAV fleet show that our proposed framework achieves 94% accuracy, 92% precision, and 91% recall, which are much superior to the existing approaches, such as One Class SVM (87% accuracy) and DBSCAN (80% accuracy). Additionally, the system compensates for false positives by 30%, improves energy efficiency by 15%, and reduces UAV collision risks by 20%, with high compatibility with real-time UAV fleet management. In the future, the scalability and the adaptability of the UAV-based smart city operation will be furthered through federated learning-based decentralised UAV coordination, reinforcement learning for autonomous swarm intelligence, and hybrid optimisation techniques for improving energy efficiency. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

