@CONFERENCE{Dhar2026947,
	author = {Dhar, Anubhav and Nyati, Pranav and Prasad, Tanishq and Hota, Ashlesha and Kolay, Sudeshna},
	title = {Universal Solvability for Robot Motion Planning on Graphs},
	year = {2026},
	journal = {Proceedings of the International Joint Conference on Autonomous Agents and Multiagent Systems, AAMAS},
	volume = {2},
	pages = {947 - 955},
	doi = {10.65109/VEXW9837},
	url = {https://www.scopus.com/pages/publications/105052498376?origin=resultslist},
	abstract = {Autonomous multi-robot systems in modern warehouses often need robots to be rearranged for efficient task execution. A key question is whether the underlying layout allows transformation between any two configurations without collisions. We model the layout as a graph G(V, E), with vertices as locations and edges as paths, and study the Universal Solvability of Robot Motion Planning on Graphs (USolR) problem: given G and p robots, does G allow any configuration to be transformed into any other via valid moves? For this, we design a linear-time randomized algorithm with one-sided error that always correctly identifies universally solvable graphs and may fail only on non-universally solvable instances; derandomization incurs a factor-p overhead, giving deterministic running times of O(P(|V | + |E|)) for sparse and O(|V | + |E|) for dense graphs. Finally, we consider the Graph Edge Augmentation for Universal Solvability (EAUS) problem: given a connected graph G not universally solvable for p robots, can at most β edges be added to make it universally solvable? We show an upper bound of P−2 on β for general graphs and give examples requiring Θ(p) edge additions. We then study Graph Vertex and Edge Augmentation for Universal Solvability (VEAUS), where α vertices and β edges may be added, and provide lower bounds on these parameters. © 2026 International Foundation for Autonomous Agents and Multiagent Systems.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

