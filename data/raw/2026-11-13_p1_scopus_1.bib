	title = {Fleet sizing based on reliability modelling under a life cycle cost scope},
	year = {2020},
	journal = {Proceedings of the 30th European Safety and Reliability Conference and the 15th Probabilistic Safety Assessment and Management Conference},
	pages = {2366 - 2372},
	doi = {10.3850/978-981-14-8593-0_4698-cd},
	url = {https://www.scopus.com/pages/publications/85107308224?origin=resultslist},
	abstract = {Fleet sizing is a key activity in strategic decision making to guarantee appropriate operation of a production process at an optimal investment level. The behavior of trucks in a fleet can be modeled through a complex logical configuration: load sharing with overcapacity. This model, along with Life Cycle Cost analysis, can be used to properly assess fleet size. Life Cycle Cost analysis for determining the optimal fleet size can demand a large amount of computational resources. In fact, if the number of possible vehicles (fleet size) is n, there are 2<sup>n</sup> acquisition combinations. However, considering the fleet availability, each alternative must be evaluated with Event Space Method, generating 2<sup>n</sup> states. Most of these types of problems are limited by the number of vehicles and because these tend to be analyzed as families, using average values instead of considering their individual characteristics. To address these issues, we propose a Montecarlo simulation-based model with practical application potential in industries such as mining, logistics, transportation and retail, supporting an efficient decision-making process. The model determines fleet size based on acquisition cost, expected elements (based on design definition), capacity and availability. © ESREL 2020-PSAM15 Organizers. Published by Research Publishing, Singapore.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Zenkevich202073,
	author = {Zenkevich, Stanislav L. and Nazarova, Anaid V. and Huo, Jianwen},
	title = {Dynamic Switching of Multi-agent Formation in Unknown Obstacle Environment},
	year = {2020},
	journal = {Studies in Systems, Decision and Control},
	volume = {261},
	pages = {73 - 87},
	doi = {10.1007/978-3-030-32710-1_6},
	url = {https://www.scopus.com/pages/publications/85075035326?origin=resultslist},
	abstract = {Problem statement: In the smart electromechanical system (SEMS), formation control of multi-agent system is a typical group coordination problem, which has broad application prospects in the fields of geographic survey, environmental investigation, security rescue, mine clearance and target defense. In the case of performing a certain task, multi-agent system need to transform its formation to avoid obstacles according to environmental constraints in real time. This paper introduces a method of dynamic switching formation structure of multi-agent system under unknown obstacle conditions. For example, multi-agent system which is currently in the form of a triangle formation need to change its formation into a straight line as it pass through a narrow, long passage. Purpose of research: This paper proposes a strategy for dynamic switching formation of multi-agent system in unknown environment. In this strategy, the Polya enumeration theorem is used to build the set of multi-agent system formation, and controlling the switch of formation with different obstacles conditions is based on the finite state machine theory. In the case of formation switching, the collision avoidance strategy between different agents is considered when the motion trajectory intersects. In addition, the target point assignment problem of one agent switching from the current formation structure to the target one is solved by the minimum distance method in this paper. Results: A formation switching control system of multi-agent system was developed, which includes a network of interacting finite-state machines and a set of formation topologies, and an underlying control strategy. In order to verify the correctness and operability of the proposed method, simulation and real experiments were carried out. The results show that the multi-agent system can switch from one topology to another according to the shape of the obstacle during the movement, and avoid collision with each other during the formation switching. Practical significance: According to the proposed solution, the respond ability of group robots to changing environments in performing tasks is improved. © Springer Nature Switzerland AG 2020.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

