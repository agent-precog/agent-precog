@CONFERENCE{Gupta2026238,
	author = {Gupta, Anish and Kalyana, N. and Rajashri, C. and Tamilkodi, R. and Kumar, K. Sriram and Sailaja, Y.},
	title = {Adaptive Fault-Tolerant Control Logic for Autonomous Electric Drive Systems Using Redundant Predictive Switching},
	year = {2026},
	journal = {2026 International Conference on Sustainable Computing and Integrated Communication in Changing Landscape of Al, ICSCAI 2026},
	pages = {238 - 243},
	doi = {10.1109/ICSCAI68849.2026.11649445},
	url = {https://www.scopus.com/pages/publications/105048661770?origin=resultslist},
	abstract = {Electric drive systems (AEDS) are already introduced in future mobility solutions and their reliability is one of the most critical issues because they are very sensitive to sensor failures, actuator, and control-logic errors. Vehicle safety, as well as performance levels can be disrupted by such faults when they are either not detected correctly or addressed computationally and at the same time systems can crash completely when several faults occur at the same time or in dynamic driving situations. Conventional fault tolerant control strategies are frequently based on catch up redundancy or static redundancy or observer based fault detection or delayed reconfiguration strategies that cannot handle real-time adaptability aspects or proactive recovery. In a bid to surmount these short comings, this paper suggests ResilientDrive, an original design of a novel control architecture which combines a Redundant Predictive Switching Logic (RPSL) and Multi-Agent Diagnostic Network (MADN). The RPSL can predict the faults using a hybrid faultprediction technique (e.g., model-based estimation coupled with light neural networks) to predict the faults and transfer the control to the redundant modules before the faults occur interrupting the system continuity. In parallel, MADN supports the distributed and collaborative failure diagnosis with lightweight agents exchanging messages via the vehicle control network, which allows fault isolation and its prioritization in a very short time. This two component model guarantees real-time flexibility, limits number of false positives, and greatly decreases latency period of response. Simulations with a digital twin of a four-wheel autonomous electric vehicle show that ResilientDrive increases the accuracy of fault detection by 14.4 percent, reduces recovery time by 28.6 percent and increases the precision of torque control by 15.2 percent in comparison to the traditional systems. The given system guarantees a very successful way of creating faulttolerant autonomous electric mobility platforms due to its ability to offer seamless control continuity, intelligent recovery, and decentralized diagnosis, not to mention the great benefit that can be achieved by the quality and reliability of autonomous electric mobility. © 2026 IEEE.},
