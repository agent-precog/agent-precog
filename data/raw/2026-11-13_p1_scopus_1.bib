}

@ARTICLE{Diao2026,
	author = {Diao, Xingrong and Sun, Zhirui and Peng, Jianwei and Zhu, Bi-Ke and Jia, Baozhi and Wang, Jiankun},
	title = {LSTP-Nav: Lightweight Spatiotemporal Policy for Map-free Multi-agent Navigation with LiDAR},
	year = {2026},
