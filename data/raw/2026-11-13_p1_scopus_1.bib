}

@ARTICLE{Nie20246410,
	author = {Nie, Zixiang and Chen, Kwang-Cheng},
	title = {Predictive Path Coordination of Collaborative Transportation Multirobot System in a Smart Factory},
	year = {2024},
	journal = {IEEE Transactions on Systems, Man, and Cybernetics: Systems},
	volume = {54},
	number = {10},
	pages = {6410 - 6423},
	doi = {10.1109/TSMC.2024.3431222},
	url = {https://www.scopus.com/pages/publications/85204716632?origin=resultslist},
	abstract = {Smart factories employ intelligent transportaton systems such as autonomous mobile robots (AMRs) to support real-time adjusted production flows for agile and flexible production. While decentralized transportation task execution provides a scalable multirobot system (MRS) for a smart factory, new coordination challenges arise in implementing such a system. Transportation-MRS collaborates with production-MRS to accommodate just-in-time (JIT) production, leading to nonstationary transportation tasks that transportation-MRS must learn and adapt to. Also, decentralized operation on a shared shop floor means that one robot cannot factor in peer robots' task execution planning, leading to competitive collisions. Meanwhile, predictive coordination with communication among multiple learning and adapting intelligent robots is still an open problem. On top of identifying the aforementioned challenges, this article first proposes a multifloor transportation graph model to discretize transportation task execution and allow real-time adjustment of transportation paths toward collision-free. We introduce a unique collaborative multi-intelligent robot system approach taking each robot as a cyber-physical agent with automated artificial intelligence (AI) workflow. First, it includes a novel multiagent reinforcement learning (MARL) algorithm, where each robot predictively plans collision-avoidant paths. Second, we introduce a token-passing mechanism to resolve inevitable competitive collisions due to nonstationary tasks. The proposed approach innovatively uses the multifloor model as a domain model for planning. By allowing competitive collision to occur and resolve, a robot only needs to learn and adapt to uncertain parts of the environment - nonstationary tasks and peer robots' paths. Computational experiments show that our approach is both sample-efficient and computationally efficient. The transportation-MRS quickly reaches near-optimal performance levels, which are empirically shown to scale with the number of robots involved.  © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 12}
}

@ARTICLE{Zhang2024770,
	author = {Zhang, Huiwen and Gao, Qing and Leng, Yuquan},
	title = {CVN: A Collision Value Network for Crowd Navigation},
	year = {2024},
	journal = {IEEE International Conference on Robotics and Biomimetics, ROBIO},
	number = {2024},
	pages = {770 - 777},
	doi = {10.1109/ROBIO64047.2024.10907558},
	url = {https://www.scopus.com/pages/publications/105001494126?origin=resultslist},
	abstract = {Dense crowd scenes are highly dynamic and un-certain, posing significant challenges to robot navigation. Recent studies have begun to utilize deep neural networks to encode interaction behaviors among agents, followed by reinforcement learning to develop obstacle avoidance strategies. However, accurately encoding the status of complex crowds remains a significant challenge, often leading to frequent interference with agents during navigation, and greatly reduces the experience of traffic participants. To this end, this paper proposes the collision value network (CVN). CVN leverages the multi-head attention mechanism in the transformer to encode the interaction behaviors among different agents, and then addresses the crowd navigation problem with reinforcement learning. Based on the designed reward function, the value iteration method is used to obtain the approximate value function and obstacle avoidance policy. Experiments show that the proposed method can enable the robot to make reasonable obstacle avoidance decisions quickly and accurately in complex scenarios. Across 500 rounds of random navigation tests, the navigation success rate reaches 98 %, the collision probability is 2 %, and the navigation time is 10.21s, showcasing superior performance compared to existing methods. © 2024 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Qu20235756,
