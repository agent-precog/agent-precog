@ARTICLE{Tong20265112,
	author = {Tong, Chuan and Xiao, Dengyu and Zeng, Zhenyang and Pu, Huayan and Luo, Jun},
	title = {Networkless Collision Avoidance for Multiple Vehicles Using Joint Spatial-Temporal Chance-Constrained Optimization},
	year = {2026},
