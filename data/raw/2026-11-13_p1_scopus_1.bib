	url = {https://www.scopus.com/pages/publications/105042978616?origin=resultslist},
	abstract = {Aerial swarm coordination in complex missions requires task-routing decisions that remain consistent with downstream physical execution. Although planning-level methods can incorporate kinodynamic, safety, and physics-based approximations, these models may still deviate from execution-level behavior induced by continuous control, local safety corrections, and aerodynamic interactions among agents. To address this issue, this paper proposes an Aerodynamic-Aware Bi-level Co-Optimization (BASC) framework for aerial swarm robotics. BASC couples upper-level multiobjective route search with lower-level safety-embedded multi-agent control through segment-level physical execution evaluation, allowing execution-level feedback to directly reshape planning-level search. A physics-guided upper-level search mechanism steers evolution toward strictly feasible and physically effective regions, while a safety-embedded lower-level controller provides execution feasibility together with physically meaningful feedback on energy consumption, risk, and stability. Experimental results from systematic mechanistic and system-level evaluations show that BASC improves the discovery and preservation of strictly feasible Pareto solutions, achieves more physically consistent search behavior than representative generic MOEAs and recent domain-relevant methods under a shared evaluator, and maintains encouraging robustness and scalability in larger-scale scenarios. These results indicate that the proposed framework provides an effective cross-layer paradigm for unifying task organization, physical execution, and aerodynamic-aware execution feedback in aerial swarm systems. © 2026 Elsevier Inc.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Lin2026,
