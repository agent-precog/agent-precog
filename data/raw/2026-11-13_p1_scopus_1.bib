	title = {Fleet sizing based on reliability modelling under a life cycle cost scope},
	year = {2020},
	journal = {30th European Safety and Reliability Conference, ESREL 2020 and 15th Probabilistic Safety Assessment and Management Conference, PSAM 2020},
	pages = {2366 - 2372},
	url = {https://www.scopus.com/pages/publications/85110261799?origin=resultslist},
	abstract = {Fleet sizing is a key activity in strategic decision making to guarantee appropriate operation of a production process at an optimal investment level. The behavior of trucks in a fleet can be modeled through a complex logical configuration: load sharing with overcapacity. This model, along with Life Cycle Cost analysis, can be used to properly assess fleet size. Life Cycle Cost analysis for determining the optimal fleet size can demand a large amount of computational resources. In fact, if the number of possible vehicles (fleet size) is n, there are 2<sup>n</sup> acquisition combinations. However, considering the fleet availability, each alternative must be evaluated with Event Space Method, generating 2<sup>n</sup> states. Most of these types of problems are limited by the number of vehicles and because these tend to be analyzed as families, using average values instead of considering their individual characteristics. To address these issues, we propose a Montecarlo simulation-based model with practical application potential in industries such as mining, logistics, transportation and retail, supporting an efficient decision-making process. The model determines fleet size based on acquisition cost, expected elements (based on design definition), capacity and availability. © ESREL2020-PSAM15 Organizers.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Ma2018939,
	author = {Ma, Xiaobai and Jiao, Ziyuan and Wang, Zhenkai and Panagou, Dimitra},
	title = {3-D Decentralized Prioritized Motion Planning and Coordination for High-Density Operations of Micro Aerial Vehicles},
	year = {2018},
	journal = {IEEE Transactions on Control Systems Technology},
	volume = {26},
	number = {3},
	pages = {939 - 953},
	doi = {10.1109/TCST.2017.2699165},
	url = {https://www.scopus.com/pages/publications/85019873304?origin=resultslist},
	abstract = {This paper presents a decentralized motion planning method for multiple aerial vehicles moving among 3-D polygonal obstacles resembling an urbanlike environment. The algorithm combines a prioritized A∗ algorithm for high-level planning, along with a coordination method based on barrier functions for low-level trajectory generation and vehicle control. To this end, we extend the barrier functions method developed in our earlier work so that it treats 2-D and 3-D polygonal obstacles, and generates collision-free trajectories for the multiagent system. We furthermore augment the low-level trajectory generation and control with a prioritized A∗ path planning algorithm, in order to compute waypoints and paths that force the agents of lower priority to avoid the paths of the agents of higher priority, reducing thus congestion. This feature enhances further the performance of the barrier-based coordination, and results in shorter paths and time to the goal destinations. We finally extend the proposed control design to the agents of constrained double-integrator dynamics, compared with the single-integrator case in our earlier work. We assume that the obstacles are known to the agents, and that each agent knows the state of other agents lying in its sensing area. Simulation results in 2-D and 3-D polygonal environments, as well as experimental results with micro aerial vehicles (quadrotors) in an indoor lab environment demonstrate the efficacy of the proposed approach. © 2017 IEEE.},
	type = {Article},
	publication_stage = {Final},
