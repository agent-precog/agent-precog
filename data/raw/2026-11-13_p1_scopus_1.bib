@CONFERENCE{Park2024,
	author = {Park, Jinhyuk and Shim, Junki and Lee, Gwonyeol and Choi, Seongim},
	title = {Deep Reinforcement Learning based Real-Time Path Planning and Flight Validation of small UAS Application},
