	pages = {},
	doi = {10.1109/WCNCW67598.2026.11555077},
	url = {https://www.scopus.com/pages/publications/105043323833?origin=resultslist},
	abstract = {Unmanned Aerial Vehicles (UAVs) and Unmanned Surface Vehicles (USVs) are increasingly deployed for wide-area and persistent maritime target perception in applications such as search and rescue, environmental surveillance, and navigation safety. However, such systems face significant challenges due to dynamic ocean conditions, unstable communication links, and stringent on-board energy constraints, which limit their operational endurance and perception integrity. To address these issues, this paper focuses on the cooperative perception of partially submerged maritime targets using a UAV-USV team and tackles the joint problem of trajectory planning and communication resource allocation under realistic ocean current disturbances. We develop a system model that incorporates target and platform mobility influenced by currents and formulate an energy-efficient optimization framework that ensures a minimum perception quality. A Multi-Agent Deep Deterministic Policy Gradient (MADDPG)-based solution is designed to enable decentralized coordination and adaptive decision-making. Simulation results demonstrate that the proposed approach reduces total system energy consumption by 15% - 20% compared to a baseline method while maintaining reliable target perception performance in dynamic maritime settings. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

