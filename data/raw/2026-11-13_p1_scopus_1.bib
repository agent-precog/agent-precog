@CONFERENCE{Ragupathy2026,
	author = {Ragupathy, Viswapriyan},
	title = {Architectural Resilience in AI-Driven Decision Systems under Adversarial Conditions},
	year = {2026},
	journal = {2026 IEEE 5th International Conference on AI in Cybersecurity, ICAIC 2026},
	pages = {},
	doi = {10.1109/ICAIC67076.2026.11395749},
	url = {https://www.scopus.com/pages/publications/105041766922?origin=resultslist},
	abstract = {The Self-Healing AI Architecture shows that resilient cognitive layers improve multi-agent AI systems' stability, autonomy and dependability. The method decreases recovery latency, cross-agent failure propagation and accuracy retention across failure scenarios with minimal operating overhead. Structured recovery patterns such as Semantic Checkpointing, Cognitive Rollback, Quarantine Isolation and Adaptive Consensus Reset enable systematic reasoning-level degradations, and empirical validation across 20 cooperative agents proves the architecture's scalability and enterprise suitability. These findings emphasise cognitive-layer robustness for reliable agentic AI. Several architectural upgrades are planned. In predictive fault models, time-series analysis and anomaly detection may enable proactive recovery before reasoning fails. Reinforcement learning-based optimisation may choose experience-based recovery approaches under changing situations. Vision, reinforcement learning, and symbolic agents enhance application beyond LLM-based agents. Cognitive-layer, infrastructure-level resilience, and formal verification may improve large-scale deployment accuracy and safety.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Wu2025,
	author = {Wu, Xingyu and Tian, Yunzhe and Chen, Yuanwan and Ye, Ping and Cui, Xiaoshu and Jia, Jingqi and Li, Shouyang and Liu, Jiqiang and Niu, Wenjia},
	title = {CurriculumPT: LLM-Based Multi-Agent Autonomous Penetration Testing with Curriculum-Guided Task Scheduling},
	year = {2025},
	journal = {Applied Sciences (Switzerland)},
	volume = {15},
	number = {16},
	pages = {},
	doi = {10.3390/app15169096},
	url = {https://www.scopus.com/pages/publications/105014410854?origin=resultslist},
	abstract = {While autonomous driving systems and intelligent transportation infrastructures become increasingly software-defined and network-connected, ensuring their cybersecurity has become a critical component of traffic safety. Large language models (LLMs) have recently shown promise in automating aspects of penetration testing, yet most existing approaches remain limited to simple, single-step exploits. They struggle to handle complex, multi-stage vulnerabilities that demand precise coordination, contextual reasoning, and knowledge reuse. This is particularly problematic in safety-critical domains, such as autonomous vehicles, where subtle software flaws can cascade across interdependent subsystems. In this work, we present CurriculumPT, a novel LLM-based penetration testing framework specifically designed for the security of intelligent systems. CurriculumPT combines curriculum learning and a multi-agent system to enable LLM agents to progressively acquire and apply exploitation skills across common vulnerabilities and exposures-based tasks. Through a structured progression from simple to complex vulnerabilities, agents build and refine an experience knowledge base that supports generalization to new attack surfaces without requiring model fine-tuning. We evaluate CurriculumPT on 15 real-world vulnerabilities scenarios and demonstrate that it outperforms three state-of-the-art baselines by up to 18 percentage points in exploit success rate, while achieving superior efficiency in execution time and resource usage. Our results confirm that CurriculumPT is capable of autonomous, scalable penetration testing and knowledge transfer, laying the groundwork for intelligent security auditing of modern autonomous driving systems and other cyberphysical transportation platforms. © 2025 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 16; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Xu202618192,
	author = {Xu, Shuo and Jin, Xiaozheng and Yang, Ming and Wu, Xiaoming},
	title = {Dynamic Event-Triggered Secure Fault-Tolerant Privacy-Preserving Consensus Tracking for Multi-Agent Systems Under Markov Switching Topologies and DoS Attacks},
	year = {2026},
	journal = {IEEE Transactions on Automation Science and Engineering},
	volume = {23},
	pages = {18192 - 18209},
	doi = {10.1109/TASE.2026.3741121},
	url = {https://www.scopus.com/pages/publications/105052920071?origin=resultslist},
	abstract = {This article investigates the secure fault-tolerant (FT) privacy-preserving consensus tracking problem for nonlinear multi-agent systems (MASs) under dynamic event-triggered communications, where physical-layer uncertainties and information-layer challenges are simultaneously considered. The former include external disturbances and actuator faults, while the latter involve Markov switching topologies, denial-of-service (DoS) attacks, passive eavesdropping threats, and communication-resource constraints. Different from most existing results that mainly address cyber security or physical safety separately, this work develops a unified distributed control framework integrating privacy preservation, secure communication, and FT coordination. Specifically, a masked virtual reference system is introduced to generate exchanged communication signals, thereby separating network transmissions from the real faulty dynamics and reducing the direct exposure of real-layer information. Based on this system, a distributed dynamic event-triggered mechanism (DETM) is designed to guarantee secure leader-follower tracking under stochastic topology switching and DoS-induced communication interruptions while reducing communication burden. Meanwhile, an adaptive FT anti-disturbance controller is constructed for the real faulty system to compensate for actuator faults, bias faults, external disturbances, and uncertainties. Moreover, a piecewise Lyapunov method is developed to establish closed-loop boundedness, practical tracking convergence, and exclusion of Zeno behavior. The non-identifiability property of the masked virtual communication protocol is further analyzed under internal honest-but-curious and external passive eavesdropper models. Finally, simulation results on a multiple damped oscillator system are provided to verify the effectiveness of the proposed method. Note to Practitioners—In real-world MASs, physical-layer uncertainties and information-layer challenges often coexist. Actuator faults and external disturbances may degrade the local dynamics, while Markov switching topologies, DoS attacks, passive eavesdropping threats, and limited communication resources may affect inter-agent coordination. These factors require distributed control schemes that can jointly address secure communication, privacy protection, and FT tracking. This paper proposes a hierarchical distributed framework for MASs under Markov switching topologies and DoS attacks. A dynamic event-triggered communication strategy is used to reduce unnecessary transmissions, and a masked virtual reference layer is employed to separate network transmissions from the real faulty states and reduce the direct exposure of real-layer information. Meanwhile, an adaptive FT anti-disturbance controller is constructed to compensate for actuator faults and external disturbances. The proposed approach is applicable to distributed automation systems such as robotic networks, autonomous aerial vehicle formations, and intelligent transportation systems, where secure, private, and reliable coordination is required under switching network conditions. © 2004 IEEE.},
	type = {Article},
