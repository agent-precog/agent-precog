@ARTICLE{Gharbi2026,
	author = {Gharbi, Atef and Alshammari, Ahmad and Ben Halima, Nadhir},
	title = {Entropy-Regularized Hierarchical MARL for Resilient Moving Target Defense in Cyber–Physical Systems},
	year = {2026},
	journal = {Entropy},
