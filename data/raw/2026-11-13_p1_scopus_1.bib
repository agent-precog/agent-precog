@CONFERENCE{Gaber Gendy2025,
	author = {Gaber Gendy, Maggie Ezzat and Shadman, Shafqat Haque and Yuce, Mehmet Rasit},
	title = {Optimal Route Selection in Fleet Management Using Predictive Air Quality Data via a Smart Modular IoT-Enabled Sensing Platform},
