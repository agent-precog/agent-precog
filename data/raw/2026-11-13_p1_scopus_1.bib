@ARTICLE{Javid2026,
	author = {Javid, Negar Jahanbakhsh and Srinivas, Sharan},
	title = {Electric truck–drone routing problem with flight-sensitive zones and partial truck recharging: A multi-objective optimization framework},
	year = {2026},
	journal = {Transportation Research Part E: Logistics and Transportation Review},
	volume = {216},
	pages = {},
	doi = {10.1016/j.tre.2026.105149},
	url = {https://www.scopus.com/pages/publications/105047591145?origin=resultslist},
	abstract = {Efficient and sustainable last-mile logistics has become increasingly important as delivery networks expand amid rising environmental regulations and evolving airspace safety requirements. Collaborative electric truck–drone systems offer a promising alternative to conventional delivery but introduce new planning challenges when drones traverse flight-sensitive zones (FSZs). These zones are legally accessible airspaces where connectivity may weaken or additional monitoring is required (e.g., congested urban corridors, areas near hospitals or schools, or regions with high-rise buildings), resulting in measurable exposure rather than unsafe flight conditions. Despite extensive research on truck–drone coordination, existing studies typically assume unrestricted airspace and overlook the trade-offs that emerge when exposure within FSZs must be managed alongside delivery efficiency. This study introduces the Multi-Objective Electric Vehicle Routing Problem with Drones and Flight-Sensitive Zones (MO-EVRPD-FSZ), which integrates synchronized truck–drone operations while accounting for partial recharging of electric trucks. A mixed integer linear programming model (MILP) is proposed to balance delivery completion time and cumulative drone exposure to FSZs. The formulation is further strengthened with valid inequalities and lower bounds to improve computational tractability. To solve large-scale instances, a Multi-Objective Adaptive Large Neighborhood Search (MOALNS) and its restart-enhanced variant (MOALNS-RP) are developed and benchmarked against Non-dominated Sorting Genetic Algorithm II (NSGA-II). Computational experiments show that MOALNS-RP approximates the exact ε-constraint solutions with over a 99% reduction in CPU time on small instances and yields stronger Pareto-front coverage and solution-set density than NSGA-II on the large-instance benchmark set. Sensitivity analyses show that fleet size, drone endurance, and truck energy use jointly shape the efficiency–exposure trade-off. The results provide planning insights for fleet configuration and risk-aware operation of hybrid truck–drone systems. © 2026 Elsevier Ltd.},
