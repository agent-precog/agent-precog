@ARTICLE{Więckowski2025281,
	author = {Więckowski, Dariusz},
	title = {Using logistic mapping to determine the size of the set of autonomous vehicles in the monitored area; [Wykorzystanie mapowania logistycznego do określenia wielkości zestawu pojazdów autonomicznych na monitorowanym obszarze]},
