}

@ARTICLE{Fakher2027534,
	author = {Fakher, Laya and Bauer, André},
	title = {Robust Mental Health Detection via Structured LLM Inference: A Study of LangGraph and Chain-of-Verification},
	year = {2027},
	journal = {Lecture Notes in Computer Science},
	volume = {16941 LNAI},
	pages = {534 - 550},
	doi = {10.1007/978-3-032-37654-1_31},
	url = {https://www.scopus.com/pages/publications/105050266906?origin=resultslist},
	abstract = {Large language models (LLMs) show promising performance for detecting mental health risks from social media text, but their use in safety-critical settings is limited by unreliable output formatting, inconsistent instruction following, and weak failure handling. Existing approaches often rely on single-shot prompting or self-verification strategies, which provide limited guarantees when model outputs are malformed or uncertain. In this work, we study structured inference as a system-level approach to robust mental health detection with LLMs. Rather than proposing a new model or learning algorithm, we design a LangGraph-based inference framework that models classification as a stateful process with explicit validation, repair, retry, and abstention mechanisms, and use it as an evaluation instrument to reveal failure behaviors that standard metrics do not capture. We compare this framework with Chain-of-Verification (CoVe), a self-verification method in which the model evaluates and optionally revises its own prediction. We evaluate GPT-4o, LLaMA-4, Claude 3.5 Sonnet, Mistral-Nemo, Qwen, and DeepSeek v3.2 on two tasks: early anorexia risk detection (eRisk 2024) and depression detection (eRisk 2017) from longitudinal social media data. Results show that CoVe frequently triggers revision following verification disagreement, but these revisions rarely correspond to true recovery from initially invalid outputs. In contrast, LangGraph enforces output validity through external parsing and bounded repair retries, enabling reliable coverage and explicit abstention when recovery fails. Across both tasks, robustness behavior varies substantially across models and cannot be inferred from accuracy alone. Additional analysis of revision and repair behavior highlights verifier instability and formatting-related failure modes that are not captured by standard classification metrics. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2027.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Vysocan2026509,
	author = {Vysocan, Jakub and Bubenkova, Lenka and Pietrikova, Emilia},
	title = {Detection of AI-Generated Source Code in Programming Assignments},
	year = {2026},
