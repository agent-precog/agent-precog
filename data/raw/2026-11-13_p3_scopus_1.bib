@ARTICLE{Kuang2026,
	author = {Kuang, Wenyi},
	title = {Cost-sensitive architecture auditing for llm-based tabular prediction: Evidence from freight cancellation management},
	year = {2026},
	journal = {Machine Learning with Applications},
	volume = {25},
	pages = {},
	doi = {10.1016/j.mlwa.2026.100997},
	url = {https://www.scopus.com/pages/publications/105050228462?origin=resultslist},
	abstract = {Large language models are increasingly used to make predictions from structured business data, but good prediction scores do not always translate to better decisions. We study this gap in freight cancellation management, where a retailer decides which shipments to intervene on, and where releasing a shipment that later gets canceled costs far more than an unnecessary intervention. We introduce a cost-sensitive architecture audit that evaluates a whole system, not a model in isolation. The audit asks four questions: what information the system uses, whether its predicted probabilities cross the firm’s cost-implied decision threshold, how those probabilities are converted into actions, and whether the prediction cost is justified. We apply the audit to a 354,565 freight-shipment panel, comparing GPT-4o (with a bounded Claude Sonnet 4.6 robustness check) and calibrated tabular models, logistic regression, and a simple fallback rule. Prompted GPT-4o ranks shipment cancellation probability competitively (AUC 0.810, against 0.808 for XGBoost and 0.832 for logistic regression), but its predicted probabilities are above the focal firm’s cost-implied decision threshold p<sup>*</sup>=0.091. The LLM’s deployed policy therefore intervenes on every shipment while adding cost without providing new actions relative to an always-intervene rule. On the within-time evaluation fold, several simpler tabular models instead act selectively and save cost against the always-intervene baseline, with logistic regression saving the most and the LLM saving none. Post-hoc calibration and out-of-time validation confirm that the central issue is not ranking quality but whether predictions change decisions. The study offers a reusable evaluation template for machine-learning systems in cost-sensitive operational settings. © 2026 The Author.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Ueda2026223,
	author = {Ueda, Patricia S. M. and Valeriano, Maria Gabriela and Mangussi, Arthur D. and Prudêncio, Ricardo B. C. and Lorena, Ana C.},
	title = {Classification with Reject Option: Building Meta-models to Predict Classification Error},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {16179 LNAI},
	pages = {223 - 238},
	doi = {10.1007/978-3-032-15987-8_15},
	url = {https://www.scopus.com/pages/publications/105029379530?origin=resultslist},
	abstract = {Instance Hardness Measures (IHMs) have been adopted in literature to evaluate and understand the difficulty in classifying specific instances within a dataset. Based on this information, the quality of a dataset can be improved at training time (e.g., by instance filtering), thereby refining the learned Machine Learning (ML) models. In this work, we take a different direction, which is to leverage IHMs at deployment time to decide whether the predictions of an ML model are reliable enough to be accepted. In the proposed solution, initially, a set of IHMs adapted in such a way that the actual labels of the query instances are not needed is extracted. This is relevant to estimate the difficulty of instances at testing time, as they are not labeled. Then, we train meta-models to identify whether an instance will be misclassified by the ML model based on the IHM values. A prediction for a test instance is rejected if the meta-model indicates that the instance will be misclassified. To evaluate the viability of the proposal, we perform experiments with two synthetic and two real-world healthcare datasets. This rejection approach improved the reliability of the ML models by increasing the accuracy for the accepted instances. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Schönwälder20264127,
	author = {Schönwälder, Erik and Hartmann, Claudio and Lehner, Wolfgang},
	title = {Rejectors in the Wild: Deployment Barriers for LLM Rejectors},
	year = {2026},
	journal = {Proceedings of the ACM SIGKDD International Conference on Knowledge Discovery and Data Mining},
	volume = {2-B},
	pages = {4127 - 4138},
	doi = {10.1145/3770855.3817850},
	url = {https://www.scopus.com/pages/publications/105051103757?origin=resultslist},
	abstract = {Despite strong benchmark performance, LLM hallucinations hinder reliable deployment in high-risk domains like medicine. Selective prediction can mitigate this by abstaining when an answer is likely incorrect. In black-box, closed-weight API settings or under tight cost constraints, this is naturally implemented via separated rejectors. In this setup, a lightweight rejector filters inputs, calling the black-box LLM only for accepted queries and abstaining otherwise. Yet even this practical design has important limitations, which we study and overcome through three contributions: (I) a human-annotation study showing that the way we define ''correct'' can drastically change which rejector appears reliable, (II) a large-scale 95×95 cross-model transfer analysis revealing structured redundancies between rejectors across LLMs, and (III) a shift from abstention to selective execution. By exploiting redundancies between LLMs, we propose two pruning strategies that build a compact, diversity-preserving LLM pool and a router that selects the most reliable model per query, outperforming common routing baselines. © 2026 Owner/Author.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Sowmyadevi2026513,
	author = {Sowmyadevi, S. and Deepika, B. and Deekshitha, S. and Kumar, M.Akash and Charansaireddy, K. and Anandaraj, B.},
	title = {A Multi-Modal Ensemble Framework for Imbalanced Dermoscopy: Metadata Fusion and Energy-Based Routing},
	year = {2026},
	journal = {Proceedings of the 6th International Conference on Trends in Material Science and Inventive Materials, ICTMIM 2026},
	pages = {513 - 521},
	doi = {10.1109/ICTMIM68190.2026.11506777},
	url = {https://www.scopus.com/pages/publications/105041369799?origin=resultslist},
	abstract = {Automatic skin-lesion classification from dermoscopic images remains difficult because public benchmarks are strongly imbalanced, several disease categories are visually similar, and clinical metadata can be missing or inconsistent in practice. This research proposes a calibrated multimodal ensemble that combines EfficientNet and ConvNeXt image encoders with a lightweight metadata-fusion branch to improve discrimination while preserving deployment-oriented reliability. The training pipeline uses class-balanced focal loss, standard geometric and photometric augmentation, and MixUp regularization to improve minority-class sensitivity. Experiments are reported on the publicly available ISIC 2019 and HAM10000 datasets using patient-wise train/validation/test splits to reduce information leakage. A post-hoc temperaturescaling layer is used to improve probability calibration, and an energy-based routing score is used to flag uncertain or out-ofdistribution cases for abstention rather than forcing overconfident closed-set predictions. On ISIC 2019, the proposed framework achieves 91.4% accuracy and a macro AUC of 0.95 with a log loss of 0.31; on HAM10000, it achieves 93.7% accuracy and a macro AUC of 0.97 with a log loss of 0.27. The revision further clarifies reproducibility, computational complexity, recent literature baselines, metadata robustness design, and the practical implications of calibrated uncertaintyaware routing for clinical decision support. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

