	pages = {55 - 67},
	doi = {10.1007/978-3-032-27927-9_6},
	url = {https://www.scopus.com/pages/publications/105042262840?origin=resultslist},
	abstract = {Automatic detection of epileptic activity in scalp EEG can reach high accuracy, yet many neural models remain opaque and provide limited guidance on when predictions should be trusted. We introduce a simple, model-agnostic index of explanation consistency, E<sub>cons</sub>, for EEG-based epilepsy classification. Using the BEED dataset (8,000 twenty-second segments; four conditions; 16 features), we train three architectures: an MLP, a 1D CNN, and an LSTM. For each test sample and predicted class, we compute two attribution profiles: intrinsic saliency via gradient×input and post-hoc Integrated Gradients (IG) over multiple baselines. E<sub>cons</sub> combines these signals by measuring rank alignment and penalising baseline-induced variance of IG attributions, so higher scores indicate explanations that are both consistent and stable. We evaluate E<sub>cons</sub> through calibration diagnostics and selective prediction, comparing consistency-based selection with confidence-based selection. On BEED, the MLP achieves around 91% test accuracy and serves as the main case study. Higher E<sub>cons</sub> is associated with more coherent explanations, slightly improved local accuracy and better confidence–reliability behaviour, while thresholding on E<sub>cons</sub> yields selective regimes with increased accuracy. Similar trends are observed for the CNN and LSTM models. Overall, E<sub>cons</sub> offers a lightweight way to quantify explanation quality and to flag predictions supported by stable, convergent explanatory evidence. In addition, an ablation analysis shows that both the alignment and stability components contribute to the observed reliability stratification. Risk–coverage evaluation further indicates that E<sub>cons</sub> acts as a complementary signal to softmax confidence, supporting post-hoc auditing and selection under coverage constraints. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

