	url = {https://www.scopus.com/pages/publications/105053855453?origin=resultslist},
	abstract = {Feature attribution methods become unreliable in low-data regimes (N≪d), producing inconsistent explanations across bootstrap replicates. We propose BWA (Bootstrap Wasserstein Alignment), a geometric framework that projects each bootstrap-replicate attribution to a probability measure on the feature simplex and aggregates the replicates via a Wasserstein-barycenter consensus paired with a per-feature sign-abstention mechanism. We present two versions: BWA-v1 with a hard binomial sign test, and BWA-v2 with a magnitude-weighted soft sign and a per-feature median-absolute-value scale that preserves natural attribution magnitudes. BWA-v2 closes a documented sign-accuracy deficit of BWA-v1 by 5–15 percentage points across eight experiments spanning synthetic data (N=20, d=100, B=50, 100 trials), MNIST saliency (N=100, d=784, 5 seeds × 50 images), Golub leukemia gene expression (N=72, d∈{500,2000}), and four UCI tabular datasets (N∈{20,50}, d∈{13,30,34,60}). On sparse-signal domains BWA-v2 produces significantly sparser attribution maps than every Euclidean baseline: MNIST Gini 0.645 vs. 0.613 Vanilla Mean and 0.584 budget-matched SmoothGrad; gene-expression Gini 0.417 at d=500 and 0.427 at d=2000 vs. Vanilla Mean 0.397/0.405 (all p<sub>bonf</sub>≪0.001). On dense tabular UCI data BWA-v2 ties Vanilla Mean on every metric – a scope limitation we disclose explicitly. We pair the method with a bootstrap-level uncertainty σ<sub>UQ</sub> (model-retraining variance, an order of magnitude larger than SmoothGrad's input-noise variance) and a continuous per-feature soft-sign confidence signal, supporting explicit reliability estimation of attributions under data scarcity. Theoretically, Lemma 1 formalizes the worst-case norm-collapse failure of Euclidean averaging under sign-flip symmetry, motivating the geometric approach. We also clarify precisely what the Wasserstein barycenter contributes to each version: we prove that BWA-v2’s soft sign is an exact per-feature positive rescaling of the bootstrap mean (Proposition 2) and hence provably preserves its sign (Proposition 3) and is provably independent of the cost matrix (Proposition 4) – v2 closes BWA-v1’s sign-accuracy deficit by algebraic construction, not by geometric estimation, and the barycenter enters v2 only as an auxiliary uncertainty diagnostic. We verify this identity numerically with zero sign disagreements across 8465 features. BWA-v1’s barycenter remains load-bearing, and we report the one regime – domain-informed pathway recovery – where it demonstrably earns its cost. © 2026 Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

@CONFERENCE{Ishadya2026,
