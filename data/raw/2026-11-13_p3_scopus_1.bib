}

@ARTICLE{Kozomara2024171,
	author = {Kozomara, Nikola and Tešić, Miodrag and Jevtović, Milica},
	title = {Significance and Prognostic Value of Non-culprit Intermediate Stenosis in Patients Early After Primary Percutaneous Coronary Intervention},
	year = {2024},
	journal = {Lecture Notes in Networks and Systems},
	volume = {1216 LNNS},
