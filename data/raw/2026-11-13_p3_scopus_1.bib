@ARTICLE{Vu2026,
	author = {Vu, Thanh Duc and Do, Xuan Cho and Nguyen, Long Giang},
	title = {Silent failure in cross-network intrusion detection: label-efficient canary monitoring under rare attacks},
	year = {2026},
	journal = {Computer Networks},
	volume = {291},
	pages = {},
	doi = {10.1016/j.comnet.2026.112896},
	url = {https://www.scopus.com/pages/publications/105054857873?origin=resultslist},
	abstract = {An intrusion detector transferred to a new network can fail silently: its output scores can remain confident even when attack ranking has collapsed. We formalize canary monitoring, the periodic acquisition of a small labeled target sample to determine whether a frozen detector remains operational, and characterize its empirical behavior along four dimensions. First, under uniform i.i.d. sampling the probability that an AUROC canary contains both classes is 1-(1-r)<sup>B</sup>-r<sup>B</sup>; at the 1.44% Unraveled prevalence this probability is 0.516 for B = 50 and 0.766 for B = 100. A new pure-target response surface shows that this uniform-i.i.d. baseline is not a bound on selective sampling: at r = 1.44%, the finite-grid random estimate is 0.133/0.400/0.467/0.800 for B = 10/20/50/100, whereas a coverage-oriented rule reaches 0.506/0.978/1.000/1.000. Second, conclusions about acquisition are partly robust across LightGBM, logistic regression, and an MLP: uncertainty sampling remains consistently poor, while the ordering among stronger rules is deployment- and model-dependent. Third, label-free monitoring is not uniformly hopeless, but it is not portable: leave-one-deployment-out signals that work for one detector family can fail for another. Fourth, AUROC alone is insufficient for operational security; among 42 pure-target realizations with AUROC at least 0.75, 36 have TPR below 0.10 at 1% FPR. Dependence, pool size, asymmetric error costs, and abstention all materially change the operating point. The resulting prescription is therefore conditional rather than universal: estimate or bound prevalence, assess evidence availability, calibrate acquisition to the deployment, report low-FPR performance alongside AUROC, and abstain when the labeled evidence cannot support a verdict. © 2026},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Sinha20264896,
