	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Manoharan2026256,
	author = {Manoharan, Mohan Raj},
	title = {QEPC: Deferred-Evaluation Probabilistic Computing for Wearable AI - Architecture, Simulation Study, and Design Limits},
	year = {2026},
	journal = {IEEE Journal on Exploratory Solid-State Computational Devices and Circuits},
	volume = {12},
	pages = {256 - 266},
	doi = {10.1109/JXCDC.2026.3740368},
	url = {https://www.scopus.com/pages/publications/105053039009?origin=resultslist},
	abstract = {Wearable AI workloads such as sensor fusion, physiological inference, and uncertainty quantification are probabilistic, yet the neural processing units that serve them are deterministic matrix-multiply engines that discard distributional information at every layer. We describe quantum-eraser-inspired probabilistic computing (QEPC), a deferred-evaluation execution model in which probability mass functions are maintained in nonvolatile state and collapsed only when a terminal query demands a decision, and evaluate it on a measured wearable workload: heart-rate estimation from wrist photoplethysmography on PPG-DaLiA, under leave-one-subject-out validation. Three findings follow. First, inference cost becomes data-dependent: node activations track posterior ambiguity instead of a fixed window, giving 1.47× lower energy than a matched causal baseline at equal-or-better accuracy, and up to 5.66× - with graceful degradation. Second, and more consequentially, deferred evaluation is viable only with nonvolatile state retention. At the 0.5-Hz cadence of wearable inference, holding a probability mass function in volatile SRAM costs 744× the inference itself, which renders the approach net-negative. Third, the workload is bound by state movement rather than arithmetic: computation accounts for 1.3% of per-query energy, with memory access and interlayer transfer accounting for 96.5%. We also report what the approach does not deliver. Against an offline convolutional ensemble, the probabilistic estimator is substantially less accurate (15.0 versus 7.65 BPM mean absolute error), and in strictly causal operation temporal inference improves on naive spectral peak-picking by only 6.3%. Its advantage lies elsewhere: the posterior supplies a calibrated confidence signal at no additional cost (Spearman ρ =0.483 against error), and one entropy threshold governs both abstention and collapse. All results derive from behavioral simulation with a released, reproducible framework; no prototype has been fabricated.  © 2015 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

