@CONFERENCE{Wang20268897,
	author = {Wang, Han and Ji, Deyi and Zhu, Lanyun and Luo, Jiebo and Lee, Roy Ka-Wei},
	title = {StreamSense: Streaming Social Task Detection with Selective Vision-Language Model Routing},
	year = {2026},
	journal = {WWW 2026 - Proceedings of the ACM Web Conference 2026},
	pages = {8897 - 8906},
	doi = {10.1145/3774904.3793046},
	url = {https://www.scopus.com/pages/publications/105038524167?origin=resultslist},
	abstract = {Live streaming platforms require real-time monitoring and reaction to social signals, utilizing partial and asynchronous evidence from video, text, and audio. We propose StreamSense, a streaming detector that couples a lightweight streaming encoder with selective routing to a Vision-Language Model (VLM) expert. StreamSense handles most timestamps with the lightweight streaming encoder, escalates hard/ambiguous cases to the VLM, and defers decisions when context is insufficient. The encoder is trained using (i) a cross-modal contrastive term to align visual/audio cues with textual signals, and (ii) an IoU-weighted loss that down-weights poorly overlapping target segments, mitigating label interference across segment boundaries. We evaluate StreamSense on multiple social streaming detection tasks (e.g., sentiment classification and hate content moderation), and the results show that StreamSense achieves higher accuracy than VLM-only streaming while only occasionally invoking the VLM, thereby reducing average latency and compute. Our results indicate that selective escalation and deferral are effective primitives for understanding streaming social tasks. Code is publicly available on GitHub. © 2026 Owner/Author.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@CONFERENCE{Walanjkar2026444,
	author = {Walanjkar, Deepika Dattatraya and Thete, Sharda and Deshmukh, Monali and Sujithra, L.R. and Sajiv, G. and Nilekar, Prachi Makarand},
	title = {Development of a Cross-Modal AI-based Decision Support System using IoT Sensor Networks and Satellite Imagery for Precision Pest Management},
	year = {2026},
	journal = {Proceedings of 7th International Conference on Smart Systems and Inventive Technology, ICSSIT 2026},
	pages = {444 - 450},
	doi = {10.1109/ICSSIT69151.2026.11656663},
	url = {https://www.scopus.com/pages/publications/105049056190?origin=resultslist},
	abstract = {This paper presents the development of an Al-based decision support system that integrates simulated Internet of Things (IoT) sensor networks with satellite imagery to enable precision pest management without hardware deployment. The framework fuses environmental telemetry (temperature, humidity, and trap-count proxies) with multispectral vegetation indices to predict pest pressure and recommend timely interventions. A modular pipeline - comprising data harmonization, feature engineering, spatiotemporal modelling, and rule-to-action translation - drives an interpretable risk score. In a software-only proof-of-concept using public Sentinel-2 scenes and synthetically generated IoT series aligned to local weather, the proposed model demonstrated competitive performance against literature baselines. Illustratively, on held-out fields, the unified model achieved Accuracy of 96.42%, macro-F1 96.31, and AUC 0.981 while cutting false alarms relative to image-only and IoT-only ablations. Decision latency per field tile was under 812 ms on a CPU-only runtime, and the system produced actionable recommendations (spray deferral, targeted scouting, or biological control) under explicit economic thresholds. Unlike prior IoT-only or remote-sensing-only systems, the proposed fusion improves robustness under cloud cover, sensor outages, and phenological shifts by learning cross-modal compensation. This software design is readily transferrable to field prototypes and serves as a reference implementation for research and extension deployments. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Chen202645587,
	author = {Chen, Meihui and Liu, Jun and Xiu, Qingxiao and Qu, Jiayi},
	title = {HGT-PPO: A Hybrid Graph-Transformer Approach for Large-Scale DAG Task Scheduling in SAGIN},
	year = {2026},
	journal = {IEEE Internet of Things Journal},
	volume = {13},
	number = {19},
	pages = {45587 - 45604},
	doi = {10.1109/JIOT.2026.3717891},
	url = {https://www.scopus.com/pages/publications/105046313811?origin=resultslist},
	abstract = {Space-air-ground integrated network (SAGIN) provides a promising computing infrastructure for 6G applications, but scheduling large-scale directed acyclic graph (DAG) tasks in such networks remains challenging due to dynamic topology, heterogeneous resources, and complex intertask dependencies. This article investigates DAG task scheduling in SAGIN with the objective of minimizing the weighted cost of completion delay and energy consumption. To address the exponential action-space growth caused by large DAGs, we propose a dynamic task execution window (DTEW)-enabled hybrid graph-transformer (HGT)-proximal policy optimization (PPO) framework. DTEW dynamically constructs the executable task window at each decision epoch according to DAG dependency constraints and real-time resource feasibility, while incorporating bounded deferral and automatic retry strategies to improve scheduling flexibility and fault tolerance. Unlike prior graph neural network (GNN)-based schedulers that capture only explicit serial dependencies along DAG edges, the HGT-PPO architecture further models the latent contention structure among parallelizable subtasks within each execution window and the cross-domain alignment between task requirements and heterogeneous server capabilities, enabling a more comprehensive state representation for policy learning. Extensive experiments under varying DAG scales, server configurations, and network volatility conditions demonstrate that HGT-PPO consistently outperforms existing methods in total cost, task completion rate, and robustness. © 2026 IEEE. All rights reserved.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Kim2026,
	author = {Kim, Ryan SangBaek},
	title = {DefMoN: A reproducible framework for theory-grounded synthetic data generation in affective AI},
	year = {2026},
	journal = {Machine Learning with Applications},
	volume = {23},
	pages = {},
	doi = {10.1016/j.mlwa.2025.100817},
	url = {https://www.scopus.com/pages/publications/105027856006?origin=resultslist},
	abstract = {Modern NLP systems excel when labels are abundant but struggle with high-inference constructs that are costly to annotate and risky to synthesize without constraints. We present the Defensive Motivational Node framework, henceforth DefMoN (formerly DMN), which operationalizes Vaillant’s hierarchy of ego defenses and Plutchik’s psychoevolutionary emotions into a controllable generative process for text. We release DMN-Syn v1.0 — a quadri-lingual (EN/KO/FR/KA) corpus of 300 theory-constrained utterances — together with a complete, versioned research compendium (data, code, seeds, QC manifests, and evaluation scripts) archived on Zenodo (Kim, 2025). The full package is permanently available at https://doi.org/10.5281/zenodo.17101927 . On the modeling side, we treat defense recognition as 10-way sentence classification and fine-tune a multilingual Transformer (XLM-R) only on DMN-Syn v1. In-domain performance is high (EN macro-F<sub>1</sub>=0.97, MCC =0.96; KO macro-F<sub>1</sub>=0.96), and zero-shot transfer is strong (EN→KO macro-F<sub>1</sub>=0.81). When evaluated on a small, anonymized real-world benchmark, the model reaches Macro F<sub>1</sub>=0.62 with zero real training data, then rises to 0.76 with only k=64 supervised examples per class. Human annotators on that same benchmark agree with each other at κ=0.68, α=0.66. This shows that DefMoN is not a turnkey classifier, but a theory-grounded primer that enables data-efficient adaptation toward human-level ambiguity theory-grounded primer that enables data-efficient alignment to schema-coded human benchmark without large-scale annotation. We additionally quantify reliability —reporting ECE/MCE and coverage–performance curves for selective prediction—and show robustness under group-aware splits (template/scenario disjoint) and cue ablations, establishing structural coherence in the absence of large-scale human trials. Beyond raw scores, we foreground auditability . Each instance in DMN-Syn v1 is generated with fixed seeds, grouped splits, and guardrails that prevent label leakage and construct drift; validators, manifests, and code are released for byte-exact replication. Results support theory-constrained synthesis as a practical middle path between costly expert labeling and unconstrained LLM generation, particularly for low-resource and cross-lingual settings. Significance. By using psychological theory as an explicit generative constraint rather than a post hoc interpretation, DefMoN reframes synthetic data work as the operationalization of constructs for machine learning. The framework (i) standardizes guardrails to minimize bias amplification and drift, (ii) supplies small but theory-dense corpora that train reliable classifiers with uncertainty awareness, and (iii) provides auditable artifacts (seeds, manifests, validators) enabling reproducibility and extension to new defenses, languages, and dialogue-level settings. Terminology and branding. In prior releases and repositories we used the acronym DMN to denote Defensive Motivational Node . To avoid confusion with the neuroscience“Default Mode Network,” this article adopts the acronym DefMoN for the overall framework. Legacy dataset and repository names (e.g., DMN-Syn v1 ) are preserved for continuity and for reproducibility of prior work. Throughout the paper, we therefore use: DefMoN for the overall framework and method, DMN-Syn v1 for the released dataset and its artifacts, and “DMN node” to refer to an individual ( Defense , Emotion , Scenario ) tuple within that dataset. This split is intentional. Copyright © 2025. Published by Elsevier Ltd.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4; All Open Access; Gold Open Access}
}

@ARTICLE{Mitra2026,
	author = {Mitra, Uddalak and Ul Rehman, Shafiq},
	title = {Beyond Accuracy: Reliability-Aware Machine Learning for Handwriting-Based Alzheimer’s Disease Detection},
	year = {2026},
	journal = {Information (Switzerland)},
	volume = {17},
	number = {9},
	pages = {},
	doi = {10.3390/info17090876},
	url = {https://www.scopus.com/pages/publications/105051548609?origin=resultslist},
	abstract = {Reliable clinical decision support systems require not only high predictive accuracy but also trustworthy probability estimates and robust uncertainty quantification. However, most medical artificial intelligence (AI) studies primarily emphasize discrimination performance while overlooking systematic reliability evaluation. This study proposes a reliability-aware evaluation framework for Alzheimer’s disease detection that integrates discrimination analysis, statistical validation, probability calibration, uncertainty quantification, robustness assessment, and clinical decision analysis within a unified pipeline. Multiple machine learning classifiers and ensemble configurations were evaluated using repeated stratified cross-validation and assessed through discrimination and calibration metrics. Support Vector Machine achieved the highest ROC-AUC (0.955 ± 0.046), while Extra Trees obtained the highest Accuracy (0.878) and F1-score (0.887). Friedman analysis confirmed statistically significant differences among classifiers ((Formula presented.)). Platt scaling consistently improved probabilistic reliability, whereas Beta calibration demonstrated stable performance under noise, feature perturbation, and reduced-data scenarios. Uncertainty-aware selective prediction increased high-confidence diagnostic accuracy by up to 8.1%, and decision curve analysis demonstrated improved clinical utility. The reliability analysis identified calibration-aware stacking as the most reliable ensemble configuration. An independent cross-dataset evaluation on a heterogeneous Alzheimer’s disease clinical dataset with a substantially different feature space yielded stable discrimination (ROC-AUC = 0.858 ± 0.025) and calibration (ECE = 0.132 ± 0.019) after the STACK_CAL architecture was independently retrained from scratch. These findings provide evidence of the cross-dataset applicability of the proposed reliability-aware strategy across different clinical data modalities, while further prospective and independent validation remains necessary before real-world clinical deployment. © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Singh2026,
	author = {Singh, Chatter and Singh, Amar and Dhelim, Sahraoui},
	title = {SOFS-Rice: Self-Organized Field-Session discovery and Risk-Aware domain generalization for robust rice disease diagnosis across benchmark and North-Indian fields},
	year = {2026},
	journal = {Smart Agricultural Technology},
	volume = {14},
	pages = {},
	doi = {10.1016/j.atech.2026.102273},
	url = {https://www.scopus.com/pages/publications/105041408143?origin=resultslist},
	abstract = {Accurate rice disease diagnosis in real fields remains challenging because models trained on curated or benchmark datasets often degrade under deployment shifts in illumination, background clutter, device optics, and local agronomic context. We present SOFS-Rice, a practical framework for smart agriculture deployments that targets two operational gaps: (i) real-field datasets frequently lack reliable metadata for leakage-resistant evaluation, and (ii) decision support should withhold predictions when inputs are out-of-distribution or uncertain to reduce risky interventions. SOFS-Rice first constructs Self-Organized Field Sessions (SOFS) by clustering image embeddings and merging near-duplicates via perceptual hashes, enabling strict group-wise Train/Calibration/Test splits without manual metadata. We train a ConvNeXt-T teacher using a two-stage benchmark-to-field strategy: Stage 1 warm-up optionally leverages the publicly available Paddy doctor benchmark mapped to the four overlapping diseases, while Stage 2 fine-tunes on field data only to mitigate negative transfer. Domain generalization is encouraged through MixStyle with an epoch warm-up schedule. At inference, predictive uncertainty (MC-dropout) and energy-based OOD scoring are combined with split conformal set prediction to implement calibrated abstention. Finally, knowledge distillation produces a compact MobileNetV3 student evaluated under the same strict protocol, while MC-dropout inference cost is reported separately to avoid overstating real-time edge deployability. We position SOFS-Rice as a deployment-oriented evaluation and decision-support framework for small real-field datasets lacking reliable session metadata, rather than as a claim of universal cross-region generalization. On a 659-image North-Indian field dataset (four diseases), multi-seed evaluation confirms that random splits can substantially overestimate performance compared with SOFS group splits. The proposed risk-aware policy exposes explicit accuracy–coverage trade-offs and abstention reasons, enabling conservative decision support under realistic distribution shift without assuming consistent gains from the full pipeline. © 2026 The Author(s). Published by Elsevier B.V. This is an open access article under the CC BY license. http://creativecommons.org/licenses/by/4.0/},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Chen20261,
	author = {Chen, Shih-Chuan},
	title = {Distributed decision-making in multi-session academic information seeking: a process model of interruption, deferral, and reconstruction},
	year = {2026},
	journal = {Journal of Documentation},
	pages = {1 - 20},
	doi = {10.1108/JD-04-2026-0183},
	url = {https://www.scopus.com/pages/publications/105041043475?origin=resultslist},
	abstract = {Purpose – This study reconceptualises scholarly information seeking in multi-session contexts as a temporally distributed process and examines how decision-making unfolds across time. Design/methodology/approach – A qualitative research design was adopted, combining a two-week diary study with semi-structured interviews involving 15 participants. Data were analysed using thematic analysis and process modelling to capture behavioural patterns and decision processes across search sessions. Findings – The findings show that interruption is a normal condition that segments search into multiple sessions. Deferral enables users to postpone evaluation and distribute decision-making across time, while re-entry requires reconstruction of the search context. Through the interaction of these mechanisms, decision formation emerges as a gradual and evolving process rather than a single-point judgement. Research limitations/implications – The qualitative sample limits generalisability. Future research could incorporate quantitative methods to examine the proposed model across broader contexts. Practical implications – The findings suggest that information systems should support re-entry, ongoing information management and context reconstruction to better accommodate long-term search processes. Originality/value – This study proposes a process model that shifts the analytical focus from session-based behaviour to cross-temporal dynamics. It advances information behaviour research by reframing decision-making as an ongoing process, highlighting discontinuity as a defining feature of search and identifying deferral as a key mechanism linking search episodes. © 2026, Emerald Publishing Limited},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Li2026,
	author = {Li, Songrun and Zhang, Weiran and Wang, Yichen and Lei, Qi},
	title = {PC-Audit: A Decision-Reliability Framework for Auditing Validation-Based Machine-Learning Model Selection in Weak-Signal Financial Time Series},
	year = {2026},
	journal = {Applied Sciences (Switzerland)},
	volume = {16},
	number = {19},
