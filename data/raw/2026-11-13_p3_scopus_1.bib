@ARTICLE{Klingspohn2017,
	author = {Klingspohn, Waldemar and Mathea, Miriam and Ter Laak, Antonius and Heinrich, Nikolaus and Baumann, Knut},
	title = {Efficiency of different measures for defining the applicability domain of classification models},
	year = {2017},
	journal = {Journal of Cheminformatics},
