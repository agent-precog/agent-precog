@CONFERENCE{Yasmin2026,
	author = {Yasmin, Farjana and Antor, Md. Siam Uddin Molla and Khan, Siam and Podder, Nitun Kumar and Biswas, Md. Shohan and Uddin, Shah Md. Aftab},
	title = {Confidence-Aware Multi-Label Chest X-ray Screening: Temperature Scaling and Risk-Coverage Analysis on NIH14},
