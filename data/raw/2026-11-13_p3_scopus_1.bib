}

@ARTICLE{Costi202655,
	author = {Costi, Flavia and Covaci, Emanuel and Onchis, Darian},
	title = {Trustworthy EEG-Based Epilepsy Classification: Evaluating Explanation Consistency with the E_cons Index},
	year = {2026},
