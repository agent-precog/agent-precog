@CONFERENCE{Katta202623,
	author = {Katta, Mukunda Rao},
	title = {Adaptive Claim Level Hallucination Detection and Mitigation for BlackBox LLMs on Amazon Bedrock},
	year = {2026},
	journal = {2026 IEEE 5th World Conference on Applied Intelligence and Computing, AIC 2026},
