@ARTICLE{Suman2026,
	author = {Suman, Chanchal and Rana, Kapil and Kumar, Sanjit and Singh, Gopendra Vikram},
	title = {Knowing When Not to Answer: Mitigating Social Bias in LLMs via Epistemic Abstention},
