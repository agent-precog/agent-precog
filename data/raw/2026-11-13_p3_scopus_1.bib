@ARTICLE{Saxer2026497,
	author = {Saxer, Jasmin and Aigner, Isabella Maria and Linzmeier, Luise and Weiler, Andreas and Stockinger, Kurt},
	title = {Query Carefully: Detecting the Unanswerables in Text-to-SQL Tasks},
	year = {2026},
