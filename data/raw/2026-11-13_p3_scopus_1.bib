}

@ARTICLE{Li2027355,
	author = {Li, Qihui and Lu, Haodong and Kang, Ruixin},
	title = {Diagnosing Override Regimes in Multi-hop RAG Choosers: Decision-Relevant AUC and Rescue-Hurt Geometry},
	year = {2027},
	journal = {Lecture Notes in Computer Science},
	volume = {16995 LNCS},
	pages = {355 - 368},
	doi = {10.1007/978-981-92-5699-0_23},
	url = {https://www.scopus.com/pages/publications/105053828924?origin=resultslist},
	abstract = {RAG chooser architectures routinely report healthy out-of-fold (OOF) discrimination on is-this-candidate-correct?, yet exhibit a chooser-EM plateau: ranking signal fails to convert into top-1 exact-match (EM) gains over a strong default expert. This is a diagnostic study of why. On a learning-to-defer override pipeline with five feature groups on 2WikiMultihopQA with a Qwen3-8B backbone (n=1000) we introduce a decision-relevant-AUC metric and a rescue-hurt geometry. We use the pipeline as a diagnostic probe rather than as a proposed new chooser; the three findings below characterise when override-style evaluation is deployable. (1) Decision-relevant signal collapse: on rescue-vs-hurt rows decision-AUC is near random (0.575, bootstrap 95% CI [0.49, 0.66], straddling chance) while aggregate OOF AUC is a misleadingly healthy 0.72; the rescue: hurt asymmetry (63 : 119) imposes a negative structural ceiling, and the headline ΔEM is 0.0 pp ([+0.0,+0.7]). (2) Evidence features are non-contributory: a drop-one ablation shows only answer/query-shape features carry the OOF signal; dropping NLI, Dempster-Shafer cross-support, support, or witness agreement raises AUC. (3) No headroom under shared context: two external judges given both cells’ top-5 passages (no gold) – DeepSeek-V3 (ΔEM=-1.4 pp) and GPT-4o (-0.1 pp, overrides balanced 40 : 41) – both fail the pre-committed deployment bar, with a k=5 self-consistency arm ruling out a single-shot artefact. A Mistral cross-backbone slice shows the same diagnostic also identifies a deployable retrieval-aligned regime (decision-AUC 0.92, +3.0 pp at 13% override). We recommend override-style RAG chooser evaluations report decision-relevant AUC and rescue-vs-hurt geometry alongside standard ranking metrics. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2027.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

