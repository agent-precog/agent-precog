	year = {2026},
	journal = {Frontiers in Artificial Intelligence},
	volume = {9},
	pages = {},
	doi = {10.3389/frai.2026.1928858},
	url = {https://www.scopus.com/pages/publications/105055045919?origin=resultslist},
	abstract = {Introduction – Machine-learning classifiers deployed in security operations rarely receive timely ground-truth labels, so their health is monitored on an operational dashboard built from label-free proxies: confidence-based accuracy estimators, cross-model agreement, and conformal abstention. Performance degradation under distribution shift is countered with test-time adaptation and label-shift correction. This toolbox is validated predominantly on synthetic image-corruption benchmarks in which the shift is covariate-only and label-preserving, conditions that do not hold in the deployment regime that motivates the tools. Methods – We present a systematic, four-iteration audit of this entire toolbox on a naturally occurring temporal shift of high practical importance: network intrusion detectors trained on Canadian Institute for Cybersecurity Intrusion Detection System 2017 (CIC-IDS2017) and deployed on Communications Security Establishment-Canadian Institute for Cybersecurity Intrusion Detection System 2018 (CSE-CIC-IDS2018) traffic recorded one year later, with evaluation also performed in the reverse direction, over seven harmonized classes (benign plus six attack families) and 77 shared flow features, under a strict protocol in which no target-year labels influence training, adaptation, hyperparameters, or model selection. Sixteen method variants are evaluated, spanning marginal quantile alignment, BatchNorm (BN) adaptation, entropy-minimization adaptation with uniform and source-prior anchoring, conformal-filtered and agreement-filtered pseudo-labeling, drift-weighted feature subspaces, expectation-maximization (EM) label-shift correction, per-domain rank representations, dimensionless ratio features, and invariance training. Results – No evaluated variant outperforms the unadapted source model in both transfer directions. More consequentially, the monitoring dashboard inverts: the average-thresholded-confidence estimator assigns a predicted accuracy of 1.000 to a degenerate model whose recall on every attack family is exactly zero; cross-model agreement is maximized by the same degenerate model; label-free selectors choose the wrong model in 10-12 of 12 trials; and class-conditional conformal coverage collapses from a nominal 0.90 to as low as 0.016. The conformal abstention rate is the single label-free statistic that behaves correctly in every trial. Discussion – We formalize this inversion in two propositions, show via the expectation-maximization prior estimate that the shift violates the label-shift assumption, and identify the abstention rate as a zero-cost drift alarm. Our findings caution that the evaluated label-free monitoring and adaptation methods can certify a blind detector as perfect precisely when it is most dangerous, and we release the full harmonization and evaluation pipeline as a reproducible natural-shift benchmark. While the empirical scope is grounded in the CIC-IDS2017/CSE-CIC-IDS2018 pair, the structural failure modes are formalized analytically (Propositions 1 and 2), and their preconditions-classifier overconfidence under concept shift and correlated collapse across architectures-are present in any deployment context sharing these characteristics; we discuss the scope of generalizability explicitly in the Limitations section. Copyright © 2026 Ahmed, Rahaman, Roy and Alam.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Liu20261232,
