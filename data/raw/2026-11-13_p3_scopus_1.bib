}

@CONFERENCE{Liu2026837,
	author = {Liu, Xiaoqing and Wu, Fuxiang and Cheng, Jun},
	title = {POKG: Process-Oriented Knowledge Graph Recovery from Heterogeneous Industrial Assembly Documents with Conservative Abstention},
