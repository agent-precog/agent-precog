	doi = {10.1016/j.procs.2026.08.460},
	url = {https://www.scopus.com/pages/publications/105052832077?origin=resultslist},
	abstract = {Responsible personalized marketing requires calibrated, explainable, and restrained decisions, not only accurate response prediction. This paper presents an explainable adaptive controller with three auditable actions: do nothing, defer action, and contact now. The framework combines engineered retail features, policy rules, XGBoost probabilities, a constrained small-language-model (SLM) controller, threshold-based action selection, guardrails, and structured explanations. Experiments use a held-out 1,200-row evaluation split derived from the dunnhumby Complete Journey retail dataset. The study is framed as proxy policy-alignment evaluation rather than causal campaign-lift analysis, and final labels plus proxy-construction fields are excluded from predictive training and the SLM prompt. The adaptive controller achieves macro-F1 of 0.967, accuracy of 0.968, balanced accuracy of 0.968, ECE of 0.007, and Brier score of 0.063. For contact now, it achieves precision of 0.997 and F1 of 0.950. The results indicate that calibrated probabilities, deterministic policy constraints, bounded SLM reasoning, and guardrail verification can support practical and auditable personalized-marketing decisions. The framework provides a foundation for future causal evaluation using real campaign outcomes or online experiments.  © 2026 The Authors. Published by Elsevier B.V.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Zhang2025144,
	author = {Zhang, Zheng and Ai, Wenjie and Wells, Kevin and Rosewarne, David and Do, Thanh-Toan and Carneiro, Gustavo},
	title = {Learning to Complement and to Defer to Multiple Users},
	year = {2025},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics) },
	volume = {15114 LNCS},
	pages = {144 - 162},
	doi = {10.1007/978-3-031-72992-8_9},
	url = {https://www.scopus.com/pages/publications/85208542223?origin=resultslist},
	abstract = {With the development of Human-AI Collaboration in Classification (HAI-CC), integrating users and AI predictions becomes challenging due to the complex decision-making process. This process has three options: 1) AI autonomously classifies, 2) learning to complement, where AI collaborates with users, and 3) learning to defer, where AI defers to users. Despite their interconnected nature, these options have been studied in isolation rather than as components of a unified system. In this paper, we address this weakness with the novel HAI-CC methodology, called Learning to Complement and to Defer to Multiple Users (LECODU). LECODU not only combines learning to complement and learning to defer strategies, but it also incorporates an estimation of the optimal number of users to engage in the decision process. The training of LECODU maximises classification accuracy and minimises collaboration costs associated with user involvement. Comprehensive evaluations across real-world and synthesized datasets demonstrate LECODU’s superior performance compared to state-of-the-art HAI-CC methods. Remarkably, even when relying on unreliable users with high rates of label noise, LECODU exhibits significant improvement over both human decision-makers alone and AI alone (Supported by the Engineering and Physical Sciences Research Council (EPSRC) through grant EP/Y018036/1). Code is available at https://github.com/zhengzhang37/LECODU.git. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	type = {Conference paper},
