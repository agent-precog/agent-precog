	doi = {10.23919/FRUCT67853.2025.11239207},
	url = {https://www.scopus.com/pages/publications/105029718964?origin=resultslist},
	abstract = {Learning to defer enables machine learning models to selectively pass uncertain decisions to a human expert, improving reliability in critical settings. Existing approaches typically base deferral policies on the model's final layer, which is optimized for classification rather than calibrated deferral. In this work, we introduce a framework for learning deferral policies using intermediate representations from deep convolutional networks. We evaluate this approach on two benchmark datasets, Galaxy-Zoo and CIFAR-10H, across both learning-based and confidence-based deferral strategies. Our results show that hidden-layer features, particularly from deeper residual blocks, enable more effective deferral decisions and improve the accuracy-coverage trade-off. These findings highlight the value of internal features for selective deferral and motivate future architectures that disentangle classification and deferral components.  © 2025 FRUCT Oy.},
