	abstract = {Automated EEG-based seizure detection has benefited from deep learning, yet challenges related to probabilistic reliability, distributional shift, alarm burden, and patient-level variability continue to limit safe clinical deployment. This work proposes a Quality Assurance (QA) framework that treats seizure detection as a continuously governed clinical AI system rather than a standalone classifier. The framework introduces deployment-oriented mechanisms for monitoring probabilistic calibration, enforcing confidence-based risk control, and detecting distributional drift using statistically grounded criteria aligned with medical device lifecycle standards. Using convolutional, recurrent, and transformer-based EEG models as representative backbones, we evaluate the framework in a proof-of-concept case study on the CHB-MIT paediatric dataset under a subject-exclusive protocol. Results show that accuracy-oriented evaluation obscures critical system-level failure modes, including unsustainable alert volumes, calibration degradation, and sensitivity to cross-session variability. Post-hoc calibration improves probability fidelity, while confidence-based filtering and drift-aware QA enable explicit control over safety-coverage trade-offs. To better reflect clinical utility, we complement window-level analysis with event-level alarm consolidation and quantify the trade-off between seizure sensitivity, false alarms, and deferral-driven review load. These findings demonstrate that QA defines a tunable design space rather than a single optimal operating point, governed by clinical risk tolerance and workflow constraints. While broader validation across diverse populations and clinical settings is required, this work establishes QA as a necessary governance layer for clinical seizure detection and provides a foundation for deployment-oriented evaluation of medical AI systems. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Cosentino2026,
	author = {Cosentino, Cristian and Folino, Francesco and Marozzo, Fabrizio and Pontieri, Luigi},
	title = {Sustainable hybrid text classification: Enhancing encoder-only language models with NLI-derived pseudo-examples},
	year = {2026},
