@CONFERENCE{Deng2026425,
	author = {Deng, Yilang},
	title = {PromptFrag-C: Prompt-Induced Reliability Drift in Zero-Shot CLIP under Common Corruptions},
	year = {2026},
	journal = {2026 6th International Conference on Computer Science and Blockchain, CCSB 2026},
	pages = {425 - 429},
	doi = {10.1109/CCSB71176.2026.11716339},
	url = {https://www.scopus.com/pages/publications/105055341279?origin=resultslist},
	abstract = {In a zero-shot vision-language classifier, the prompt contributes directly to the class representation, yet paraphrases intended to preserve meaning may behave differently under distribution shift. We evaluated 12 fixed prompts and a probability ensemble using OpenAI-pretrained RN50 and ViT-B/32 CLIP backbones. The main experiment covered 15 CIFAR-10-C corruption types at five severity levels and measured accuracy, expected calibration error (ECE), and area under the risk-coverage curve (AURC). To avoid treating severity levels as independent replicates, prompt effects were tested after averaging over severity within each corruption. A leave-one-corruption-out (LOCO) rule selected prompts with a prespecified scalar score. The mean within-condition accuracy range was 11.66 percentage points for RN50 and 4.75 points for ViT-B/32. LOCO improved accuracy by 1.03 and 1.28 points, respectively, but increased ECE by 1.93 and 1.00 points. A three-objective Pareto audit found every LOCO selection to be nondominated; a 20-point weight grid selected four RN50 prompts but only one ViT prompt. On the independent CIFAR-10.1 v6 natural resampling shift, prompt accuracy spanned 7.90 and 4.00 points. The CIFAR-10-C-selected prompts exceeded the default by 0.25 and 0.80 points, but both paired 95% confidence intervals included zero. Thus, prompt sensitivity generalized more clearly than the advantage of any selected prompt. Robustness studies should disclose prompt sensitivity and report calibration or selective risk alongside accuracy. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Kaltchenko2026426,
	author = {Kaltchenko, Alexei and Grimoldby, Abigail},
	title = {Entropy-Based Confidence for Speech-to-Text Recognition},
	year = {2026},
	journal = {2026 IEEE 16th Annual Computing and Communication Workshop and Conference, CCWC 2026},
	pages = {426 - 431},
	doi = {10.1109/CCWC67433.2026.11393748},
	url = {https://www.scopus.com/pages/publications/105035617731?origin=resultslist},
	abstract = {Automatic speech recognition (ASR) is now widely deployed, but commercial APIs rarely expose reliable confidence scores. We study a simple entropy-based confidence measure for a closed-source audio-language model, gpt-4o-transcribe, which is unusual in exposing token-level log probabilities for raw speech, although currently only for the emitted token (top-1). We treat speech-to-text as a noisy measurement process and compute Shannon entropy from the token log probabilities (top-k plus a residual tail), then aggregate to an utterance-level statistic: average bits per token, which we map to a heuristic confidence score. Using a reproducible Python pipeline, we run gpt-4o-transcribe on LibriSpeech dev-clean and Mozilla Common Voice cv-validdev, including accent-filtered and synthetically noised subsets derived from Common Voice. Our work-in-progress experiments examine three ASR-specific aspects: ranking quality (ROC-AUC), calibration (reliability diagrams and expected calibration error), and selective prediction (risk-coverage curves). The method is model-native, requires no retraining or auxiliary networks, and uses only a single decoding pass and the probabilities already exposed by the API. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Uyyala2023,
