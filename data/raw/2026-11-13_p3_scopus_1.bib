@CONFERENCE{Ashok202515691,
	author = {Ashok, Dhananjay and Chaubey, Ashutosh and Arai, Hirona J. and May, Jonathan and Thomason, Jesse},
	title = {Can VLMs Recall Factual Associations From Visual References?},
	year = {2025},
	journal = {EMNLP 2025 - 2025 Conference on Empirical Methods in Natural Language Processing, Findings of EMNLP 2025},
	pages = {15691 - 15708},
	doi = {10.18653/v1/2025.findings-emnlp.850},
	url = {https://www.scopus.com/pages/publications/105028994848?origin=resultslist},
	abstract = {Through a controlled study, we identify a systematic deficiency in the multimodal grounding of Vision Language Models (VLMs). While VLMs can recall factual associations when provided a textual reference to an entity, their ability to do so is significantly diminished when the reference is visual instead. Forcing VLMs to rely on image representations of an entity halves their ability to recall factual knowledge, suggesting that VLMs struggle to link their internal knowledge of an entity with its image representation. We show that such linking failures are correlated with the expression of distinct patterns in model internal states, and that probes on these internal states achieve over 92% accuracy at flagging cases where the VLM response is unreliable. These probes can be applied, without retraining, to identify when a VLM will fail to correctly answer a question that requires an understanding of multimodal input. When used to facilitate selective prediction on a visual question answering task, the probes increase coverage by 7.87% (absolute) while also reducing the risk of error by 0.9% (absolute). Addressing the systematic, detectable deficiency is an important avenue in language grounding, and we provide informed recommendations for future directions. ©2025 Association for Computational Linguistics.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Zhu2022,
	author = {Zhu, Yinglun and Nowak, Robert},
	title = {Active Learning with Neural Networks: Insights from Nonparametric Statistics},
	year = {2022},
	journal = {Advances in Neural Information Processing Systems},
	volume = {35},
	pages = {},
	url = {https://www.scopus.com/pages/publications/85163168368?origin=resultslist},
	abstract = {Deep neural networks have great representation power, but typically require large numbers of training examples. This motivates deep active learning methods that can significantly reduce the amount of labeled training data. Empirical successes of deep active learning have been recently reported in the literature, however, rigorous label complexity guarantees of deep active learning have remained elusive. This constitutes a significant gap between theory and practice. This paper tackles this gap by providing the first near-optimal label complexity guarantees for deep active learning. The key insight is to study deep active learning from the nonparametric classification perspective. Under standard low noise conditions, we show that active learning with neural networks can provably achieve the minimax label complexity, up to disagreement coefficient and other logarithmic terms. When equipped with an abstention option, we further develop an efficient deep active learning algorithm that achieves polylog(1/ε) label complexity, without any low noise assumptions. We also provide extensions of our results beyond the commonly studied Sobolev/Hölder spaces and develop label complexity guarantees for learning in Radon BV<sup>2</sup> spaces, which have recently been proposed as natural function spaces associated with neural networks. © 2022 Neural information processing systems foundation. All rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 9}
}

@CONFERENCE{Liu20256107,
	author = {Liu, Xiaoou and Chen, Tiejin and Da, Longchao and Chen, Chacha and Lin, Zhen and Wei, Hua},
	title = {Uncertainty Quantification and Confidence Calibration in Large Language Models: A Survey},
	year = {2025},
	journal = {Proceedings of the ACM SIGKDD International Conference on Knowledge Discovery and Data Mining},
	volume = {2},
	pages = {6107 - 6117},
	doi = {10.1145/3711896.3736569},
	url = {https://www.scopus.com/pages/publications/105014313879?origin=resultslist},
	abstract = {Uncertainty quantification (UQ) enhances the reliability of Large Language Models (LLMs) by estimating confidence in outputs, enabling risk mitigation and selective prediction. However, traditional UQ methods struggle with LLMs due to computational constraints and decoding inconsistencies. Moreover, LLMs introduce unique uncertainty sources, such as input ambiguity, reasoning path divergence, and decoding stochasticity, that extend beyond classical aleatoric and epistemic uncertainty. To address this, we introduce a new taxonomy that categorizes UQ methods based on computational efficiency and uncertainty dimensions, including input, reasoning, parameter, and prediction uncertainty. We evaluate existing techniques, summarize existing benchmarks and metrics for UQ, assess their real-world applicability, and identify open challenges, emphasizing the need for scalable, interpretable, and robust UQ approaches to enhance LLM reliability. © 2025 Copyright held by the owner/author(s). Publication rights licensed to ACM.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 63; All Open Access; Bronze Open Access; Green Open Access}
}

@ARTICLE{Abdullah2025,
	author = {Abdullah and Fatima, Zulaikha and Sánchez Mejorada, Carlos Guzman and Ather, Muhammad Ateeb and Oropeza Rodríguez, José Luis and Sidorov, Grigori},
	title = {Fair and Explainable Multitask Deep Learning on Synthetic Endocrine Trajectories for Real-Time Prediction of Stress, Performance, and Neuroendocrine States},
	year = {2025},
	journal = {Computers},
	volume = {14},
	number = {12},
	pages = {},
	doi = {10.3390/computers14120515},
	url = {https://www.scopus.com/pages/publications/105026443081?origin=resultslist},
	abstract = {Cortisol and testosterone are key digital biomarkers reflecting neuroendocrine activity across the hypothalamic–pituitary–adrenal (HPA) and hypothalamic–pituitary–gonadal (HPG) axes, encoding stress adaptation and behavioral regulation. Continuous real-world monitoring remains challenging due to the sparsity of sensing and the complexity of multimodal data. This study introduces a synthetic sensor-driven computational framework that models hormone variability through data-driven simulation and predictive learning, eliminating the need for continuous biosensor input. A hybrid deep ensemble integrates biological, behavioral, and contextual data using bidirectional multitask learning with one-dimensional convolutional neural network (1D-CNN) and long short-term memory (LSTM) branches, meta-gated expert fusion, Bayesian variational layers with Monte Carlo Dropout, and adversarial debiasing. Synthetically derived longitudinal hormone profiles that were validated by Kolmogorov–Smirnov (KS), Wasserstein, maximum mean discrepancy (MMD), and dynamic time warping (DTW) metrics account for class imbalance and temporal sparsity. Our framework achieved up to 99.99% macro F1-score on augmented samples and more than 97% for unseen data with ECE below 0.001. Selective prediction further maximized the convergence of predictions for low-confidence cases, achieving 99.9992–99.9998% accuracy on 99.5% of samples, which were smaller than 5 MB in size so that they can be employed in real time when mounted on wearable devices. Explainability investigations revealed the most important features on both the physiological and behavioral levels, demonstrating framework capabilities for adaptive clinical or organizational stress monitoring. © 2025 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 10; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Yahyati2026,
	author = {Yahyati, Chaymae and Lamaakal, Ismail and ElMakkaoui, Khalid and Ouahbi, Ibrahim},
	title = {Uncertainty Quantification for the Internet of Things: Sources, Methods, Propagation, and Deployment},
	year = {2026},
	journal = {IEEE Internet of Things Journal},
	pages = {},
	doi = {10.1109/JIOT.2026.3738862},
	url = {https://www.scopus.com/pages/publications/105052359571?origin=resultslist},
	abstract = {Internet of Things (IoT) systems increasingly transform heterogeneous sensor observations into predictions, control commands, alarms, maintenance interventions, and other consequential actions. However, uncertainty can be introduced throughout this sensing-to-action chain by natural and behavioral variability, sensor noise and drift, incomplete or inconsistent data, unreliable communication, numerical approximation, model limitations, distribution shifts, adversarial manipulation, and uncertain decision consequences. Existing surveys typically examine only individual parts of this problem, such as sensor fusion, Bayesian learning, predictive uncertainty, IoT reliability, or TinyML deployment. This survey provides an end-to-end synthesis of uncertainty quantification (UQ) across the IoT continuum, from the physical environment and sensing layer to communication, edge/fog and cloud processing, model inference, decision-making, and actuation. We introduce a unified taxonomy connecting uncertainty sources and categories with their mathematical representations, quantification methods, propagation mechanisms, system actions, and deployment constraints. Statistical, Bayesian, Gaussian-process, interval, fuzzy, evidence-based, machine-learning, conformal, out-of-distribution, and drift-monitoring approaches are comparatively analyzed in terms of their assumptions, outputs, computational requirements, formal guarantees, and IoT suitability. Particular attention is given to uncertainty propagation, multisensor and multimodal fusion, uncertainty-aware sensing and offloading, selective prediction, risk-sensitive control, and UQ for TinyML and resource-constrained devices. Evidence from healthcare, industrial IoT, smart cities, energy, transportation, agriculture, environmental monitoring, and cybersecurity is synthesized to identify recurring practices and evaluation gaps. The survey concludes with a deployment-oriented evaluation protocol and a research roadmap toward online, distributed, resource-aware, certifiable, and end-to-end reliable uncertainty-aware IoT systems. © 2014 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Zhang202535174,
	author = {Zhang, Jingyu and Yu, Jiacan and Marone, Marc and Van Durme, Benjamin and Khashabi, Daniel},
	title = {Certified Mitigation of Worst-Case LLM Copyright Infringement},
	year = {2025},
	journal = {EMNLP 2025 - 2025 Conference on Empirical Methods in Natural Language Processing, Proceedings of the Conference},
	pages = {35174 - 35195},
	doi = {10.18653/v1/2025.emnlp-main.1784},
	url = {https://www.scopus.com/pages/publications/105040154560?origin=resultslist},
	abstract = {The exposure of large language models (LLMs) to copyrighted material during pre-training raises concerns about unintentional copyright infringement post deployment. This has driven the development of “copyright takedown” methods-post-training approaches aimed at preventing models from generating content substantially similar to copyrighted ones. While current mitigation approaches are somewhat effective for average-case risks, we demonstrate that they overlook worst-case copyright risks exhibited by the existence of long, verbatim quotes from copyrighted sources. We propose BLOOMSCRUB, a remarkably simple yet highly effective inference-time approach that provides certified copyright takedown. Our method repeatedly interleaves quote detection with rewriting techniques to transform potentially infringing segments. By leveraging efficient data sketches (Bloom filters), our approach enables scalable copyright screening-even for large-scale real-world corpora. When quotes beyond a length threshold cannot be removed, the system can abstain from responding, offering certified risk reduction. Experimental results show that BLOOMSCRUB reduces infringement risk, preserves utility, and accommodates different levels of enforcement stringency with adaptive abstention. Our results suggest that lightweight, inference-time methods can be surprisingly effective for copyright prevention. © 2025 Association for Computational Linguistics.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Kakarla20261476,
	author = {Kakarla, Praveena and Vimala, C.},
	title = {Multi-Scale Hybrid Capsule Network with Dynamic Self-Attention and Uncertainty-Aware Fusion for Robust Multi-Class Lung Disease Classification},
	year = {2026},
	journal = {Proceedings - 2nd International Conference on Modern Sustainable Systems, CMSS 2026},
	pages = {1476 - 1483},
	doi = {10.1109/CMSS69636.2026.11688710},
	url = {https://www.scopus.com/pages/publications/105052055393?origin=resultslist},
	abstract = {Automated interpretation of chest radiographs remains a challenging problem as thoracic abnormalities are highly variable in size, location, appearance and severity. Conventional convolutional neural networks (CNN) can learn local pathological patterns but may lose spatial relationships with repeated down sampling. On the other hand, transformer-based models can provide global context but have higher computational complexity. Moreover, many of the existing systems are over-confident and do not explicitly take into account the reliability of multi-scale features. To overcome these limitations, this paper proposes a Multi-Scale Hybrid Capsule Network with Dynamic Self-Attention and Uncertainty-Aware Fusion, named MSHC-DSAUF, for robust multi-label thoracic disease classification. The proposed framework captures localized, regional and diffuse abnormalities with parallel fine-, medium- and global-scale convolutional branches. An inputadaptive dynamic self-attention module is used to capture longrange anatomical dependencies and learn disease-relevant importance for individual attention heads. The resulting features are then passed through a hybrid convolutional-capsule encoder which combines semantic appearance information with vector-based spatial and hierarchical representations. Each scale-specific branch predicts disease logits and inputdependent variance, which are combined by a class-dependent uncertainty-aware fusion mechanism. The evaluateed framework on the NIH ChestX-ray14 dataset with patientindependent partitions and 14 labels of thoracic disease. Performance is evaluated with macro-AUC, micro-AUC, macro-F1 score, mean average precision, expected calibration error, Brier score, robustness and selective-prediction measures. We propose an approach for improving disease discrimination, probability calibration, uncertainty estimation and clinical referral reliability in automated chest radiograph analysis. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@BOOK{Jayalakshmi2026149,
	author = {Jayalakshmi, G. and Jayalakshmi, Ch. and Ramesh, M.},
	title = {Predictive Maintenance Using Tiny Machine Learning: A Revolutionary Approach to Proactive Equipment Maintenance},
	year = {2026},
	journal = {Tiny Machine Learning: Fundamentals, Applications, and Security},
	pages = {149 - 161},
	doi = {10.1002/9781394347124.ch7},
	url = {https://www.scopus.com/pages/publications/105043874218?origin=resultslist},
	abstract = {Predictive maintenance using tiny machine learning is a pioneering approach that harnesses the influence of machine learning to predict equipment failures, enabling convenient maintenance and minimizing complexity. This method involves training machine learning models on sensor data collected from devices and deploying these approaches on low-power devices such as microcontrollers. By adopting this approach, organizations can shift from traditional unconsidered maintenance, which often results in costly repairs, production losses, and safety risks, to an additional cost-effective and efficient solution. The benefits of this approach are important, including extended device lifespan, improved workplace safety, compact maintenance costs, and enhanced equipment consistency and performance. It also allows enterprises to transition to a proactive continuance strategy, minimizing unanticipated failures and their impact on production schedules. The working process of predictive maintenance using TinyML follows four main steps: data collection, model training, deployment, and real-time monitoring. Initially, sensor data is collected from the sensor devices, and machine learning models are trained to classify patterns or anomalies to may designate potential failures. These models are then organized on microcontrollers, which incessantly monitor the equipment in real time, predicting maintenance needs prior to failures occur. This approach has been effectively applied across diverse industries. For example, in automotive applications, accelerometers attached to every wheel can analyze vibrations to distinguish damage in the wheel or deferral system. Similarly, in engine maintenance, microphones are used to monitor engine sounds, identifying anomalies that could signal essential issues. Tools such as Edge Impulse Studio aid the development along with use of machine learning models on edge devices, while hardware like the Arduino Nano 33 BLE Sense offers a compressed, energy-efficient platform for executing these models. As the TinyML ecosystem continues to grow, predictive maintenance is hovering to revolutionize equipment executive by reducing costs, enhancing safety, as well as improving operational efficiency, driving its approval across an ample range of industries. © 2026 Scrivener Publishing LLC. All rights reserved.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Eller2024236,
