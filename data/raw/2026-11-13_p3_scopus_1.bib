	abstract = {We address report delays and priority mismatch during patient surges. We propose SA-UCA-CNN, a deployable, single-model framework for patient-level chest X-ray (CXR) triage. The method embeds a lightweight ViT-Adapter at each stage of a single CNN and fuses it with SAAF. This adds long-range and multi-scale representations with minimal overhead. During training, a Style-Consistency GAN performs crosshospital style alignment and long-tail augmentation. At inference, we keep only the CNN+Adapter path. We apply temperature scaling, selective prediction, and Monte-Carlo (MC) dropout. They map multi-label probabilities to three triage levels - urgent, high-priority, and routine - and provide calibrated uncertainty and Grad-CAM explanations. We train and internally validate on NIH ChestX-ray14. On CheXpert and MIMIC-CXR, the model reaches area under the receiver operating characteristic (AUROC)=0.900 and area under the precision-recall curve (AUPRC)=0.540, outperforming a pure CNN (0.820/0.410). The out-of-domain drop shrinks to AUROC=-0.018 with expected calibration error (E C E)=0.036. Inference latency is 22.5 ms. Ablations show that S3+S4 with medium-intensity style augmentation offers the best performance-cost trade-off. S2 + S3 + S4 performs slightly better but is slower. A GAN-only scheme supports ultra-low latency. An Adapter-only variant markedly improves calibration. Overall, the framework improves external generalization, long-tail recall, and risk consistency without adding deployment complexity. It provides an auditable and reproducible engineering path for clinical CXR triage. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Zhang20241087,
	author = {Zhang, Serena and Sambara, Sraavya and Banerjee, Oishi and Acosta, Julian N. and Fahrner, L. John and Rajpurkar, Pranav},
	title = {RadFlag: A Black-Box Hallucination Detection Method for Medical Vision Language Models},
	year = {2024},
	journal = {Proceedings of Machine Learning Research},
	volume = {259},
	pages = {1087 - 1103},
	url = {https://www.scopus.com/pages/publications/85219172410?origin=resultslist},
	abstract = {Generating accurate radiology reports from medical images is a clinically important but challenging task. While current vision language models show promise, they are prone to generating hallucinations, potentially compromising patient care. We introduce RadFlag, a black-box method to enhance the accuracy of radiology report generation. Our method uses a sampling-based flagging technique to find hallucinatory generations that should be removed. We first sample multiple reports at varying temperatures and then use a large language model to identify claims that are not consistently supported across samples, indicating that the model has low confidence in those claims. Using a calibrated threshold, we flag a fraction of these claims as likely hallucinations, which should undergo extra review or be automatically rejected. Our method achieves high precision when identifying both individual hallucinatory sentences and reports that contain hallucinations. As an easy-to-use, black-box system that only requires access to a model's temperature parameter, RadFlag is compatible with a wide range of radiology report generation models and has the potential to broadly improve the quality of automated radiology reporting. © 2024 S. Zhang, S. Sambara, O. Banerjee, J.N. Acosta, L.J. Fahrner & P. Rajpurkar.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

