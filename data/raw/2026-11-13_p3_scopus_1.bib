@CONFERENCE{Wang202633764,
	author = {Wang, Zhiyuan and Duan, Jinhao and Wang, Qingni and Zhu, Xiaofeng and Chen, Tianlong and Shi, Xiaoshuang and Xu, Kaidi},
	title = {COIN: Uncertainty-Guarding Selective Question Answering for Foundation Models with Provable Risk Guarantees},
	year = {2026},
