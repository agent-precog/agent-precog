@CONFERENCE{Bussari2026,
	author = {Bussari, Shravya and Punj, Prateek and Balakumar, Gayathri},
	title = {RAGSec: Retrieval-Augmented Generation for Cybersecurity Threat Intelligence in Enterprise Networks},
	year = {2026},
