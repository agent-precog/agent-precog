	doi = {10.1109/SCECS69812.2026.11565850},
	url = {https://www.scopus.com/pages/publications/105044148191?origin=resultslist},
	abstract = {Inverse kinematics for redundant robotic manipulators presents a persistent challenge owing to the nonlinear and often non-unique mapping from task space to joint space. This paper presents a systematic machine learning pipeline for learning the inverse kinematics of the NAO humanoid robot left arm from synthetic forward kinematics data. We investigate the effect of orientation representation, multi-output prediction strategy, residual learning, and ensemble stacking on both joint-space accuracy and task-space position error. Experiments show that replacing raw Euler angles with rotation matrix encoding, upgrading from ridge regression to kernel ridge regression, and combining predictions through non-negative least squares stacking collectively reduce task-space position RMSE from 125.06 mm to 43.14 mm, representing a 2.90-fold improvement over the baseline. An uncertainty quantification scheme derived from random forest prediction variance further enables selective prediction, achieving a 38.5% RMSE reduction at 50% coverage. © 2026 IEEE.},
