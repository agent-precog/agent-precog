@ARTICLE{Sun2027,
	author = {Sun, Bo and Jiang, Chunmao},
	title = {Reliability-aware granular-ball learning for noise-robust open-set selective classification},
	year = {2027},
	journal = {Applied Soft Computing},
	volume = {204},
	pages = {},
	doi = {10.1016/j.asoc.2026.116482},
	url = {https://www.scopus.com/pages/publications/105051267831?origin=resultslist},
	abstract = {Reliable classification requires abstention when a prediction is unsupported or likely to be wrong, especially when training labels are noisy and test samples may be out-of-distribution (OOD). We propose RAGB, a reliability-aware granular-ball classifier for noise-robust open-set selective classification. Starting from noisy in-distribution data, RAGB recursively partitions candidate regions using k-means and stores terminal balls with centers, radii, class distributions, and reliability scores combining purity, density, boundary safety, and label stability. For a query, the top-k balls yield proximity- and reliability-weighted class evidence, while the maximum continuous compatibility with any reliable ball defines granular support evidence. After temperature scaling, a class-balanced logistic gate maps probability and support features to acceptance; its targets distinguish correct known-class predictions from incorrect predictions and, when available, unknown-class samples. Experiments cover 16 multiclass tabular datasets, 48 held-out-class settings, three noise levels, and external detector hybrids. Granular support evidence provides the dominant gain over probability-only confidence. With repeated runs averaged at the dataset–held-out-class level and paired tests Holm-corrected, RAGB outperforms GB-NN under moderate and high noise, and under high noise it attains the lowest mean AURC, with no statistically significant difference detected relative to SVM/Random Forest hybrids using kNN distance or IsolationForest. Factor ablations show complementary, noise-dependent contributions rather than reliance on any single component. Limited OOD calibration improves the gate rapidly, while an OOD-free combined score retains most of the benefit. These results position RAGB as an interpretable soft-computing mechanism for abstention under joint label noise and open-set shift. © 2026 Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Elgohr2026,
