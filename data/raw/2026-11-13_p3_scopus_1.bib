	pages = {},
	doi = {10.1109/AIEI69164.2026.11497227},
	url = {https://www.scopus.com/pages/publications/105040833307?origin=resultslist},
	abstract = {Recently, deep neural networks (DNNs), which have been well proven in classification tasks, are overconfident when facing ambiguous or uncertain inputs and make decisions that are not reliable to be applied in serious application domains with safety issues. This issue is tackled by selective classification with an abstention mechanism that stops a classifier from generating predictions, whenever the predicted confidence is low. To concretely represent the effective use of the abstention mechanism in a neural classifier, this paper introduces a confidence-aware selective learning framework, where coverage-constrained risk minimization has been demonstrated by optimizing a common loss function, which takes both prediction accuracy and coverage into account. The proposed model is capable of learning discriminative representations and selective decision boundaries simultaneously. Experiments on the Fashion-MNIST datasets demonstrate that the proposed selective model achieved an accuracy of 95.31%, but it did not predict 27.02% of inputs that are uncertain. In contrast, we achieve an accuracy of 87.83% using a typical baseline classifier that does not have the option to abstain. The results indicate that selective prediction leads to a considerable increase in decision reliability, thus corresponding more directly to applications where a model's output should not show erratic behavior. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

