@CONFERENCE{Zhang202618055,
	author = {Zhang, Zheng and Nguyen, Cuong C. and Wells, Kevin and Do, Thanh-Toan and Rosewarne, David and Carneiro, Gustavo},
	title = {Coverage-Constrained Human-AI Cooperation with Multiple Experts},
