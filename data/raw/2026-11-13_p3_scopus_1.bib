@CONFERENCE{Bernardino202647,
	author = {Bernardino, Carlos and Costa, Carlos and Aparício, João},
	title = {Abstention-Aware Deepfake Screening with Multi-Model Ensembles: An Atomic Evaluation Framework},
	year = {2026},
	journal = {2026 International Conference on Intelligent Digitization of Systems and Services, IDSS 2026},
	pages = {47 - 54},
	doi = {10.1109/IDSS69894.2026.11691473},
	url = {https://www.scopus.com/pages/publications/105052019992?origin=resultslist},
	abstract = {The proliferation of AI-generated deepfakes poses major risks to information integrity, democratic processes, and national security. In operational settings, deepfake screening must handle both classification and model abstentions/refusals. In our experiments, a tested commercial vision-language model (VLM) exhibited safety-driven abstention behavior that can collapse automated recall under common REAL-by-default mappings. This paper presents an Atomic Evaluation Framework (AEF), developed using Design Science Research Methodology (DSRM), for abstention-aware, multi-model (LLM/VLM) ensemble screening with structured rationale outputs and auditability. We report four empirical findings: (1) self-judgment bias on own generations across five rhetorical profiles (N=100) shows +15.3% average overrating (t=18.07, p < 0.01), with independent cross-model evaluation indicating a “Safety-Induced Blind Spot”; (2) pilot results consistent with a “Safety–Security Paradox” in which a commercial VLM exhibits 100% abstention on a FaceForensics++ subset (N=20), yielding 0% recall under REAL-by-default mapping; (3) an abstention-aware fusion policy combined with an open-source VLM achieves 57.1% effective recall on the same subset, while a supervised baseline (XceptionNet) reaches 100% recall; and (4) a pilot user study with OSINT analysts (N=15) shows 55% trust improvement and 83% faster decision-making with explainable outputs. This paper contributes to the literature with: (1) empirical quantification of LLM self-judgment bias with cross-model validation; (2) an abstention-aware formulation and measurement of safety-induced screening failures in commercial VLMs; (3) an atomic, multi-model screening architecture that supports human triage and auditability; and (4) an open, sovereignty-enabling implementation supporting on-premise deployment. ©2026 IEEE.},
