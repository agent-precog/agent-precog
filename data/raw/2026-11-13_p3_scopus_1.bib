	note = {Cited by: 2}
}

@ARTICLE{Basu2024359,
	author = {Basu, Tathagata and Troffaes, Matthias C. M. and Einbeck, Jochen},
	title = {A Robust Bayesian Approach for Causal Inference Problems},
	year = {2024},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {14294 LNAI},
	pages = {359 - 371},
	doi = {10.1007/978-3-031-45608-4_27},
	url = {https://www.scopus.com/pages/publications/85177849211?origin=resultslist},
	abstract = {Causal inference concerns finding the treatment effect on subjects along with causal links between the variables and the outcome. However, the underlying heterogeneity between subjects makes the problem practically unsolvable. Additionally, we often need to find a subset of explanatory variables to understand the treatment effect. Currently, variable selection methods tend to maximise the predictive performance of the underlying model, and unfortunately, under limited data, the predictive performance is hard to assess, leading to harmful consequences. To address these issues, in this paper, we consider a robust Bayesian analysis which accounts for abstention in selecting explanatory variables in the high dimensional regression model. To achieve that, we consider a set of spike and slab priors through prior elicitation to obtain a set of posteriors for both the treatment and outcome model. We are specifically interested in the sensitivity of the treatment effect in high dimensional causal inference as well as identifying confounder variables. However, confounder selection can be deceptive in this setting, especially when a predictor is strongly associated with either the treatment or the outcome. To avoid that we apply a post-hoc selection scheme, attaining a smaller set of confounders as well as separate sets of variables which are only related to treatment or outcome model. Finally, we illustrate our method to show its applicability. © 2024, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

@ARTICLE{El-Ghareeb2026156818,
	author = {El-Ghareeb, Haitham A. and Abouhawwash, Mohamed},
	title = {No Representation Consistently Beats the Simple Baseline: A Pre-Registered Audit of Uncertainty Representations and Threshold Tuning for Edge Data-Quality Governance},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {156818 - 156845},
	doi = {10.1109/ACCESS.2026.3742903},
	url = {https://www.scopus.com/pages/publications/105054056438?origin=resultslist},
	abstract = {Higher-order uncertainty representations (fuzzy, intuitionistic, q -rung orthopair, neutrosophic) and metaheuristic threshold tuners are added to decision systems, yet rarely tested against simple baselines. We report a pre-registered, baseline-controlled audit of edge data-quality governance, where a device acts on or escalates each value. A sample-range bridge derives nine representations from one Monte Carlo Dropout stack, all feeding one unchanged decision engine; seven optimizers, two simple tuners, and a manual control tune its thresholds at an equal budget. On a synthetic benchmark and four real defect-labeled corpora, no higher-order representation consistently beats the max-softmax baseline on the governance risk-coverage area: significant differences reverse sign across datasets, and no channel outperforms the baseline on more than half of 50 trained model instances. The claim holds under the pre-registered construction, weakens for one channel under alternatives, and, among post hoc methods that keep the model, only temperature-scaled max-softmax helps. Threshold tuning cuts the binary selective-governance cost on the real corpora from 3.81 to 0.85, but every tuned policy escalates almost every cell and matches a fixed escalate-all policy; a coordinate grid costs the same as every metaheuristic, and conformal risk-threshold calibration bounds the escalation risk under a tested exchangeability assumption. The real corpora validate only the binary error-detection axis; the six-action policy is validated on the synthetic benchmark. Two exploratory case studies (uncertainty-inspired feature mappings for IoT sensor analytics; a three-valued PostgreSQL plan advisor) are audited separately. Practitioners should confront the probabilistic baseline, the normalized feature, and the fixed policy before claiming a benefit. © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

