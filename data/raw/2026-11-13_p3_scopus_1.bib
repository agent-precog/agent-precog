@ARTICLE{Fedynyshyn2026,
	author = {Fedynyshyn, Taras and Partyka, Olha and Opirskyy, Ivan and Konakbayev, Olzhas},
	title = {Evaluating Multimodal LLMs for Context-Aware Forensic Image Interpretation},
	year = {2026},
	journal = {International Journal of Networked and Distributed Computing},
