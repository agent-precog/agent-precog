@ARTICLE{Wang202670530,
	author = {Wang, Ziyi},
	title = {Quality-Aware Minutiae Matching for Forensic Fingerprints With Explicit No-Score Decisions},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {70530 - 70550},
	doi = {10.1109/ACCESS.2026.3691260},
	url = {https://www.scopus.com/pages/publications/105038829159?origin=resultslist},
	abstract = {Fingerprint recognition in forensic scenarios remains challenging due to noise, partial impressions, unstable ridge structure, and frequent matching failures under low evidence. We present a reproducible and auditable forensic fingerprint pipeline, positioned as a triage and short-listing tool that surfaces candidate evidence for analyst adjudication rather than as a general one-to-one verification system, which integrates robust preprocessing, multi-scale orientation fusion, structure-guided minutiae extraction, and adaptive minutiae matching with geometric consistency and quality-aware score fusion, together with an explicit no-score (abstention) mechanism driven by per-pair quality and geometric-consensus telemetry; an optional lightweight edge embedding branch (LightFeatNet) is provided for fast deployment. Experiments on FVC2002, a controlled robustness benchmark, and NIST SD302 genuine latent fingerprints show that profile-level operating control enables practical accuracy-reliability trade-offs, and that the abstention mechanism is operationally necessary on forensic-quality inputs (67.1% abstention on SD302). We further quantify operational behavior by reporting sensitivity to no-score handling, coverage-accuracy trade-offs, bootstrap confidence intervals for key metrics, and a cross-dataset out-of-distribution check for the learning branch. A side property of our design is that the abstention mechanism is implemented as a modular component that depends only on four per-pair telemetry fields (orientation coherence, extraction failure, inlier count, and the pair score itself); we verify this modularity by applying it on top of NBIS with the same parameters, improving NBIS from EER=0.053 to 0.032 and TPR@ FAR=10<sup>-3</sup>=0.832 to 0.925 on the scored subset, which is additional evidence that the abstention policy is a clean component rather than an ad-hoc trick bound to our scorer. © 2013 IEEE.},
