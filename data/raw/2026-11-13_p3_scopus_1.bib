}

@ARTICLE{Testagrose2026,
	author = {Testagrose, Conrad and Korfiatis, Panagiotis and Benfield, Justin and Cook, Cole J. and Kline, Timothy L. and Merkel, Peggy and Demirer, Mutlu and White, Richard D. and Bolan, Candice W. and Erdal, Barbaros S.},
	title = {Automated Prediction of Radiological Protocols Using Retrieval Augmented Generation},
