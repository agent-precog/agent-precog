	url = {https://www.scopus.com/pages/publications/105044942990?origin=resultslist},
	abstract = {Pneumonia remains a major global health concern, requiring timely and reliable diagnostic support, particularly in settings with limited access to expert radiological interpretation. Although deep learning models applied to chest X-ray (CXR) imaging have demonstrated high diagnostic accuracy, their clinical deployment is constrained by predictive overconfidence, limited calibration, and the absence of mechanisms to safely defer uncertain decisions. Addressing these challenges, this study presents a confidence-aware pneumonia screening framework based exclusively on chest X-ray images. The proposed approach employs a lightweight convolutional neural network built on MobileNetV2 using transfer learning to classify chest X-rays into normal and pneumonia categories. Beyond conventional performance evaluation, the framework explicitly incorporates predictive confidence to enable selective triage, allowing the model to automatically accept high-confidence predictions while escalating low-confidence cases for human review. Model reliability is assessed through calibration analysis using Expected Calibration Error (ECE), and clinical interpretability is supported via Gradient-weighted Class Activation Mapping (Grad-CAM), which highlights salient radiographic regions influencing predictions. Experimental results demonstrate strong discriminative performance (AUC-ROC 0.96) while enabling meaningful trade-offs between automation coverage and diagnostic risk. The findings indicate that uncertainty-aware selective screening can improve the safety, transparency, and trustworthiness of deep learning-based medical imaging systems. The framework is positioned as a practical decision-support tool and provides a foundation for future research toward extended and multimodal diagnostic workflows. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Jitkrittum2023,
	author = {Jitkrittum, Wittawat and Gupta, Neha and Menon, Aditya Krishna and Narasimhan, Harikrishna and Rawat, Ankit Singh and Kumar, Sanjiv},
	title = {When Does Confidence-Based Cascade Deferral Suffice?},
	year = {2023},
	journal = {Advances in Neural Information Processing Systems},
	volume = {36},
	pages = {},
	url = {https://www.scopus.com/pages/publications/85189799543?origin=resultslist},
	abstract = {Cascades are a classical strategy to enable inference cost to vary adaptively across samples, wherein a sequence of classifiers are invoked in turn.A deferral rule determines whether to invoke the next classifier in the sequence, or to terminate prediction.One simple deferral rule employs the confidence of the current classifier, e.g., based on the maximum predicted softmax probability.Despite being oblivious to the structure of the cascade - e.g., not modelling the errors of downstream models - such confidence-based deferral often works remarkably well in practice.In this paper, we seek to better understand the conditions under which confidence-based deferral may fail, and when alternate deferral strategies can perform better.We first present a theoretical characterisation of the optimal deferral rule, which precisely characterises settings under which confidence-based deferral may suffer.We then study post-hoc deferral mechanisms, and demonstrate they can significantly improve upon confidence-based deferral in settings where (i) downstream models are specialists that only work well on a subset of inputs, (ii) samples are subject to label noise, and (iii) there is distribution shift between the train and test set. © 2023 Neural information processing systems foundation. All rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 20}
}

