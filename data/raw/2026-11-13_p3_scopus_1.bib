	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@CONFERENCE{Manwatkar2024,
	author = {Manwatkar, Ashish Bapurao and Deshmukh, Rajesh Keshavrao and Junnarkar, Aparna Atul},
	title = {Dynamic Cluster Head Selection and Secure Routing Approach Industry 4.0 Framework for Precision Agriculture},
	year = {2024},
	journal = {2024 Asian Conference on Intelligent Technologies, ACOIT 2024},
	pages = {},
	doi = {10.1109/ACOIT62457.2024.10939356},
