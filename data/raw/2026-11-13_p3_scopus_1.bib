@ARTICLE{Butar20241144,
	author = {Butar, Jayadi Butar and Lusa, Sofian and Handayani, Sutia and Yusuf, Andi Akram},
	title = {Analyzing Abstention Discourse in Presidential Elections: Knowledge Discovery in X Using ML, LDA and SNA},
	year = {2024},
