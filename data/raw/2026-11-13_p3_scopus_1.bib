@CONFERENCE{Nojima2023,
	author = {Nojima, Yusuke and Kawano, Koyo and Shimahara, Hajime and Vernon, Eric and Masuyama, Naoki and Ishibuchi, Hisao},
	title = {Fuzzy Classifiers with a Two-Stage Reject Option},
	year = {2023},
