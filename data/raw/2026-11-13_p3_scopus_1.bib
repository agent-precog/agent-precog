@ARTICLE{Nguyen2026132599,
	author = {Nguyen, Hoang Hai},
	title = {A Hybrid Passive–Active Pipeline for On-Device Smart-TV Brand and Protocol Identification on iOS},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {132599 - 132609},
	doi = {10.1109/ACCESS.2026.3727368},
	url = {https://www.scopus.com/pages/publications/105049352911?origin=resultslist},
	abstract = {Universal smart-TV remote applications must discover a television on the local network and then identify its brand and control protocol before any command can be issued. On mobile platforms this is hard: heterogeneous ecosystems—Samsung Tizen, LG webOS, Roku ECP, Android TV Remote v2, Amazon Fire TV, Vizio SmartCast, and Apple TV Companion Link—expose overlapping and ambiguous service advertisements. In particular, the prevalence of Chromecast built-in causes Vizio SmartCast, Sony, and Google/Android televisions to advertise near-identical mDNS records, so purely passive (string-matching) identification either misclassifies them or fails outright. We present a three-stage, fully on-device pipeline implemented natively on iOS that i) performs passive fingerprinting over multi-service mDNS/SSDP advertisements but abstains on ambiguous signals instead of guessing; ii) resolves the abstained cases with a deterministic, parallel active probe that “knocks” on brand-specific endpoints (Vizio HTTPS:7345, Roku ECP:8060, Samsung Tizen:8001, Android TV Remote:6466); and iii) recovers the device MAC address from mDNS TXT records to enable Wake-on-LAN power-on. On a testbed spanning seven ecosystems, the proposed abstain-then-verify design raises brand-identification accuracy from 67.7% (passive-only) to 97.7% (+ 30.1 percentage points), fully resolves the Vizio/Android confusion (33.0% ⟶ 100 % on the ambiguous subset), and adds a median of only 0.48 s of active-probe latency. A naive Cast-tag heuristic, by contrast, mislabels Vizio SmartCast as Android in 100% of cases. The abstention behavior is further validated on a released synthetic mixed-vendor and mDNS-collision suite: 702 identification episodes across two networks with zero probe false positives. We further report Wake-on-LAN recovery and the effect of Apple’s Local Network privacy permission on discovery. © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

