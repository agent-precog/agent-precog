	author = {Tekawade, Rajvardhan Umesh and Nirmal, Devanshu Rajiv and Ohal, Ayush Sandip and Banchhod, Anish Sachin and Kolekar, Vikas K},
	title = {Extending Six Sigma for AI Automation Across Global Industries},
	year = {2026},
