	pages = {},
	doi = {10.1016/j.eswa.2026.134443},
	url = {https://www.scopus.com/pages/publications/105051098907?origin=resultslist},
	abstract = {Vision–language models (VLMs) can diagnose disputed regions in remote sensing change detection (CD), but placing their prompt-sensitive decisions on an automatic correction path creates a reliability risk. We audit this behavior with Qwen2.5-VL models and find that direct accept/rollback outputs vary with prompt wording, while descriptive labels remain useful for error analysis but also vary with context and model scale. We therefore separate offline VLM diagnosis from deployment-time arbitration and propose V4-Safe, a training-free rollback gate for a test-time-augmentation correction proposal. V4-Safe measures the baseline probability on the proposal’s edit support and restores the baseline when that support lies in a high-confidence region; it requires no VLM inference at deployment. Across a complete five-backbone by three-dataset matrix, V4-Safe yields positive mean F1 changes in 13 cells, an exact no-op in one degenerate cell, and a statistically indistinguishable (Formula presented) change in one cell; 9 of 15 gains remain significant after Holm correction. It reduces harmful edit rate from 41.90% to 7.68% on PDEFM-SYSU and from 10.87% to 4.88% on BIT-NJDS. External-backbone and zero-shot diagnostics further expose probability-scale and domain-transfer limits of the fixed threshold. These results position V4-Safe as an empirical reliability-control layer rather than a universal safety guarantee, and show why CD verification should report harmful edits, uncertainty intervals, and rollback-or-accept Oracle regret in addition to mean F1. © 2026 Published by Elsevier Ltd.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

