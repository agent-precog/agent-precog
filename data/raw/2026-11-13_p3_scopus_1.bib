}

@ARTICLE{Zhao2026,
	author = {Zhao, Zheng and Song, Doo Heon and Kim, Kwang Baek},
	title = {Fuzzy Attention Convolutional Neural Networks: A Novel Approach Combining Intuitionistic Fuzzy Sets and Deep Learning},
