	doi = {10.1109/THMS.2026.3714654},
	url = {https://www.scopus.com/pages/publications/105048715968?origin=resultslist},
	abstract = {Integrating machine learning with human expertise has become essential in human–AI collaboration, especially when models face uncertainty. A key challenge lies in determining when to defer to humans to optimize both accuracy and cost. Inspired by Kahneman’s dual-process theory, we propose the fallback cognitive deferral (FCD) framework, which models fast, automatic decisions via a machine-only module (System 1), and defers complex or uncertain cases to a human–AI hybrid module (System 2). Focusing on three alternative switching mechanisms, we introduce adaptive thresholding, reinforcement learning, and joint training—each representing a distinct deferral strategy that governs the transition between System 1 and System 2. A novel surrogate loss function is designed for System 2, incorporating expert-annotated labels and expert defer costs to mitigate excessive reliance on human input. Extensive experiments across image, text, and medical domains demonstrate favorable accuracy–coverage tradeoffs under varying levels of expert involvement. For example, on the correctional offender management profiling for alternative sanctions dataset, FCD Joint improves accuracy by 2.4% over the human-alone model and 4.1% over the machine-only baseline at 70% coverage. This work offers a cognitively grounded framework for efficient and scalable human–AI collaboration. © 2013 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
