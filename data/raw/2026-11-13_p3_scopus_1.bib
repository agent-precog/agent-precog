@ARTICLE{Guo2026,
	author = {Guo, Kaiqing and Jia, Yi and Gao, Meiyan and Xue, Dan},
	title = {TRIDENT: Missingness-Aware Selective Multiview Learning for Auditable Edge-Assisted Oncology Analytics},
	year = {2026},
	journal = {IEEE Internet of Things Journal},
	pages = {},
	doi = {10.1109/JIOT.2026.3740715},
	url = {https://www.scopus.com/pages/publications/105053391219?origin=resultslist},
	abstract = {Internet of Medical Things (IoMT) services can deliver complementary clinical, pathology, molecular, and device-derived evidence, but service interruptions and asynchronous acquisition make a complete patient state uncommon. We present TRIDENT, a missingness-aware selective inference layer for hospital edge or private-cloud analytics. Each source transmits a fixed-width feature vector together with a presence indicator and acquisition-time metadata. View-specific encoders replace unavailable views with learned tokens; a two-layer Transformer and an evidence-preserving residual head integrate the available information. An explicit all-missing rule prevents bias-only predictions, while Monte Carlo dropout and an independently calibrated prediction set route ambiguous cases to review. We evaluated TRIDENT on 376 TCGA-STAD records with two observed views - baseline clinicopathologic variables and tumor RNA expression - and an observed four-class molecular-subtype target. All imputation, encoding, gene selection, scaling, and principal-component analysis were fitted within each training partition. Ten prespecified train/validation/calibration/test splits were used. Under controlled view unavailability, TRIDENT achieved 0.812±0.038 accuracy and 0.926±0.015 macro-AUROC. Its accuracy did not differ significantly from Mask-MLP, DrFuse, M3Care, or TabM, but exceeded three tree-based missing-data pipelines in paired tests. At α = 0.10, empirical coverage was 0.941±0.028, the singleton rate was 0.604±0.168, and singleton accuracy was 0.944 ± 0.028. A 314-byte feature message and 0.334-MB model state support lightweight feature-level transfer, although connected-device traffic, energy, encryption overhead, and cross-site clinical generalization were not measured. The results establish a leakage-controlled, auditable inference study rather than an end-to-end IoMT deployment or a treatment recommendation system.  © 2014 IEEE.},
