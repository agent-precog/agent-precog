	abstract = {The demand for timely, individualized support in courses now outpaces the human capacity available to provide it, especially in large, online, and hybrid settings where students span time zones and academic backgrounds. Prior course-grounded AI teaching assistants, such as Georgia Tech’s Jill Watson and Harvard’s CS50 “Duck”, show that grounding an assistant in course materials lets it answer student questions far more reliably than a general-purpose chatbot. Yet such systems are typically tied to a single institution, limited to question answering, and not openly deployable; automated assessment, where it exists, is usually a separate tool disconnected from the tutoring assistant even though both depend on the same course knowledge. This paper presents TerrierTA, an open, multi-agent framework that unifies three course-grounded capabilities behind one orchestration engine: rubric-grounded automated assessment with self-consistency checks and human-in-the-loop review; course-grounded question answering and tutoring, through a per-course agent we call Rhett, that cites source material and abstains when a question falls outside the course corpus; and content generation for rubrics, model solutions, and individualized feedback. The system is built on a LangGraph state-graph engine with interrupt-based review gates, retrieval grounding scoped per course, an immutable audit trail, and multi-tenant isolation. TerrierTA further introduces a deployment model, in which any instructor can create a personal workspace and courses while institutions host organizations of courses, lowering the barrier that has confined prior systems to single campuses. We position TerrierTA against existing AI teaching assistants and report on an early deployment across three university courses. Contributions include the open multi-agent architecture, the per-course grounding-and-abstention design for trustworthy assessment, feedback, and tutoring, and the dual self-serve/institutional deployment model for equitable access. © ICST Institute for Computer Sciences, Social Informatics and Telecommunications Engineering 2027.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Workneh2027,
