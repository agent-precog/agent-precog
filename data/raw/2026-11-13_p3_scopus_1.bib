@ARTICLE{Du2026162708,
	author = {Du, Rui and Lu, Rongqing},
	title = {Cognition-Aware LLM Assistance for Light and Full Post-Editing: Cognitive Load Profiling and Adaptive Intervention from Keystroke Dynamics},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {162708 - 162734},
	doi = {10.1109/ACCESS.2026.3745280},
	url = {https://www.scopus.com/pages/publications/105054742633?origin=resultslist},
	abstract = {Large language models (LLMs) can improve machine-translation post-editing, but always-on assistance ignores whether support is needed at a given moment and can introduce unnecessary interruption or over-reliance. This problem is amplified by light post-editing (LPE) and full post-editing (FPE), which impose different quality targets and revision demands. We propose a cognition-aware LLM assistance framework that uses non-intrusive keystroke dynamics to connect trial-level workload grounding with selective adaptive intervention. The framework learns task-conditioned hierarchical representations that separate translator-level behavioral profiles from a latent within-trial workload-evidence trajectory, using post-task NASA-TLX only as training-time weak supervision. It then performs profile-calibrated online estimation with explicit uncertainty and abstention and applies a cognition-gated policy that selects the minimum useful assistance level. Evaluation combines a controlled English-Chinese LPE/FPE study with 64 translators and 1,536 sessions (CALPE-64) with three public translation-process resources. On CALPE-64, the proposed estimator achieves a session-level Macro-F1 of 0.781 and an ECE of 0.041. In the held-out human-LLM comparison, aggregate COMET reaches 0.837/0.872 for LPE/FPE while observed editing time and post-task NASA-TLX are lower than in the principal static and always-on conditions. Participant-level mixed-effects models, using translator and source as repeated-observation structure, confirm the primary time and workload contrasts after multiplicity correction. A separate temporally aligned validation check shows moderate within-participant convergence between the latent evidence trajectory and sparse short-horizon mental-effort probes, while matched-budget random-timing and text/QE timing controls are evaluated as offline mechanism diagnostics rather than counterfactual human outcomes. The local trajectory, behavioral recovery time, and unnecessary-intervention rate are therefore interpreted as model-derived operational evidence, not independent moment-to-moment cognitive ground truth. These results support conservative, minimum-necessary assistance while bounding stronger claims about the unique causal role of cognition-aware timing. © 2013 IEEE.},
