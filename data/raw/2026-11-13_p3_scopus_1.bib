@ARTICLE{Çetinkaya2027,
	author = {Çetinkaya, Ali},
	title = {Accuracy is not reliability: abstention-aware evaluation of large language models on bio-bibliographic claim verification in classical Islamic scholarship},
	year = {2027},
	journal = {Information Processing and Management},
	volume = {64},
