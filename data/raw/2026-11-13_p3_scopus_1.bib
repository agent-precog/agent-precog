	url = {https://www.scopus.com/pages/publications/105038568417?origin=resultslist},
	abstract = {Large Language Models (LLMs) have shown strong potential as conversational agents. Yet, their effectiveness remains limited by deficiencies in robust long-term memory - particularly in complex, long-term Web-based services such as online emotional support. However, existing long-term dialogue benchmarks primarily focus on static and explicit fact retrieval, failing to evaluate agents in these critical scenarios where user information is dispersed, implicit, and continuously evolving. To address this gap, we introduce ES-MemEval, a comprehensive benchmark that systematically evaluates five core memory capabilities - information extraction, temporal reasoning, conflict detection, abstention, and user modeling - in long-term emotional support scenarios, covering question answering, summarization, and dialogue generation tasks. To support the benchmark, we also propose EvoEmo, the first multi-session dataset for personalized long-term emotional support scenarios, capturing fragmented, implicit user disclosures and evolving user states. Extensive experiments on open-source long-context, commercial, and retrieval-augmented (RAG) LLMs reveal that explicit long-term memory is essential to reduce hallucinations and enable effective personalization. At the same time, RAG enhances factual consistency but struggles with temporal dynamics and evolving user states. These findings highlight both the potential and limitations of current paradigms, encouraging the development of more robust memory-retrieval integration in long-term personalized dialogue systems. © 2026 Owner/Author.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Jasmin2026671,
	author = {Jasmin, T.J. and Rajagopalan, Niranjana and Gopal, Savitha},
	title = {Reducing Hallucinations in Oncology Question Answering Using Confidence-Gated Retrieval-Augmented Generation},
	year = {2026},
	journal = {2026 International Conference on Smart Communication and Sustainable Technologies, ICSCST 2026},
	pages = {671 - 678},
	doi = {10.1109/ICSCST70031.2026.11709521},
	url = {https://www.scopus.com/pages/publications/105054117465?origin=resultslist},
	abstract = {Hallucinations in LLMs are a major issue in developing medical question-answering systems, as the creation of false information can lead to serious safety risks. The Retrieval-Augmented Generation (RAG) model reduces this issue by relying on external knowledge sources. However, in traditional RAG, it is still possible to generate responses even when there is weak or irrelevant evidence.This paper aims to present a novel RAG model that uses cross-encoder re-ranking in conjunction with confidence-gated abstention to ensure that responses are only generated when there is enough evidence. The model was tested using 62 oncology-related questions obtained from a dataset of cancer information in Japanese. The experiment was conducted using closed-domain retrieval of Cancer Information Service (CIS) database information and open-domain retrieval of Google search results. The generative model used in this experiment was GPT-3.5 and GPT-4.The experiment was conducted, and the results show that the proposed model significantly reduces hallucinations compared to traditional RAG. The experiment using open-domain retrieval showed a reduction in conditional hallucinations from 28.0% to 8.82% for GPT-3.5 and from 26.7% to 2.17% for GPT-4. The experiment conducted in this paper proved that combining semantic re-ranking with confidence-gated abstention improves the reliability of AI-based medical information systems.  © 2026 IEEE.},
