@ARTICLE{Simioni202520326,
	author = {Simioni, Joao A. and Viegas, Eduardo K. and Santin, Altair O. and de Matos, Everton},
	title = {An Energy-Efficient Intrusion Detection Offloading Based on DNN for Edge Computing},
	year = {2025},
	journal = {IEEE Internet of Things Journal},
	volume = {12},
