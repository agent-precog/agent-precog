@CONFERENCE{Kumar2026,
	author = {Kumar, Praneya and Deepankar, Anubhav and Kumar, Saksham and Bohat, Vijay Kumar},
	title = {LAVENDER: Lightweight Abstention-Aware Verification for Behavioural and Factual Hallucination Detection in Large Language Models},
	year = {2026},
	journal = {2026 IEEE Guwahati Subsection Conference, GCON 2026},
	pages = {},
	doi = {10.1109/GCON69192.2026.11648944},
	url = {https://www.scopus.com/pages/publications/105049040461?origin=resultslist},
	abstract = {Large Language Models (LLMs) have displayed strong performance across a vast set of reasoning and language tasks, yet they often generate confident responses even in the absence of sufficient information, a phenomenon commonly known as hallucination. Conventional evaluation metrics such as accuracy fail to adequately detect this behaviour, as they focus only on correctness in answerable cases while not prioritising unjustified confidence in unanswerable cases. In this paper, we propose a lightweight and model-agnostic framework for detecting hallucination behaviour in LLM responses through verification-aware evaluation. We evaluate four contemporary LLMs under identical zero-shot conditions. Behavioural hallucination is identified by whether models abstain on unanswerable questions, while semantic similarity techniques are used to assess unsupported or fabricated responses. Experimental results reveal that although all evaluated models achieve high accuracy on answerable instances, they frequently exhibit systematic hallucination behaviour by generating answers for unanswerable problems. These findings demonstrate that high accuracy does not necessarily imply trustworthy model behaviour. Our proposed framework offers an efficient and practical solution for hallucination detection without requiring model retraining or additional infrastructure. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
