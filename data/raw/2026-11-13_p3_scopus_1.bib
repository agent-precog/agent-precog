@ARTICLE{Bastola2026,
	author = {Bastola, Laxmi Prasad and Luo, Senlin and Munna, Md Minhazul Islam and Khan, Sohrab},
	title = {Empirical fair auditing of high-confidence failures under distribution shift},
	year = {2026},
	journal = {Knowledge-Based Systems},
