@ARTICLE{Jeon2026104995,
	author = {Jeon, Kyungmin and Park, Seongyun and Jeong, Daesik},
	title = {TrustDTI: Trustworthy Drug-Target Interaction Prediction via Evidential Deep Learning and Selective Abstention},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {104995 - 105005},
	doi = {10.1109/ACCESS.2026.3707193},
	url = {https://www.scopus.com/pages/publications/105043634864?origin=resultslist},
	abstract = {Accurate prediction of Drug-Target Interactions (DTI) is a fundamental step in accelerating the drug discovery process and repositioning existing drugs. Although deep learning models have demonstrated significant potential in DTI prediction, they often suffer from overconfidence and produce unreliable predictions in out-of-distribution (OOD) or cold-start scenarios, posing substantial risks in critical biomedical applications. Furthermore, evaluating these models without rigorous control for data leakage - such as overlapping drug-target pairs between the training and testing sets - often leads to inflated performance metrics. To address these limitations we propose TrustDTI, which is a reliable DTI prediction framework built on an enhanced multi-modal architecture. TrustDTI extracts molecular features using a Hybrid Drug Encoder (combining pretrained KPGT and DrugGNN representations) and protein representations using a graph attention encoder that refines ESM-2 residue features over a residue contact graph derived from predicted 3D structures. A bidirectional co-attention block and gated channel fusion module capture complex inter-modal interactions. Crucially, TrustDTI introduces a Deep Evidential Head that models the output as a Dirichlet distribution, quantifying both the epistemic and aleatoric uncertainties. Coupled with a Selective Head, the model dynamically defers predictions on highly uncertain pairs. Evaluated under a rigorous cross-domain cold-start protocol on BindingDB and DAVIS with exact-match overlap removal, TrustDTI achieves the best Matthews Correlation Coefficient (MCC) across all four cold-start settings; on the in-domain unseen-drug and unseen-protein splits of BIOSNAP, it attains the highest Area Under the Receiver Operating Characteristic curve (AUROC) among all compared methods. More importantly, by abstaining from its most uncertain predictions the model substantially improves reliability, demonstrating that explicitly quantifying uncertainty yields trustworthy decisions in the high-stakes setting of drug discovery. © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

@ARTICLE{Ganie2026,
	author = {Ganie, Aadil Gani and Ezzini, Saad and Nouioua, Mourad},
	title = {CLARITY: An End-to-End Retrieval-Augmented Generation Pipeline for Ontology-Aligned Industrial Device Auto-Configuration},
	year = {2026},
	journal = {IEEE Internet of Things Journal},
	pages = {},
	doi = {10.1109/JIOT.2026.3743453},
	url = {https://www.scopus.com/pages/publications/105053782875?origin=resultslist},
	abstract = {Commissioning an industrial field device still requires an automation engineer to locate the correct manual, extract dozens of protocol-specific parameters (register maps, node identifiers, station addresses, baud rates), and transcribe them into a supervisory system, a workflow that is slow, expensive, and vulnerable to transcription errors whose consequences range from silent data loss to unsafe actuator behavior. This paper presents CLARITY (Context-aware LLM-Assisted Retrieval and Intelligent Auto-configuraTion sYstem), a fully on-premises pipeline that automates this workflow for Modbus, OPC UA, Profibus DP, and CANopen devices. CLARITY chunks device manuals into a hybrid knowledge base combining 1024-dimensional BGE-M3 dense embeddings, BM25 sparse retrieval, and an ontology-graph term boost fused by Reciprocal Rank Fusion; reranks candidates with a sigmoid-normalized cross-encoder; guards a local llama3.1:8b generator with a two-stage abstention gate (rerank-score threshold and IRI resolution ratio); validates generated JSON-LD configurations against protocol-specific SHACL shapes; and deploys through protocol adapters with post-deployment read-back verification. We contribute a component-wise evaluation methodology with evidence-grounded relevance labels and release the full harness. On a 71-chunk corpus with 28 field-level queries, hybrid retrieval with reranking reaches HitRate@10 of 0.964 and MRR@10 of 0.625; rerank scores of documented and undocumented queries separate by a factor of 8.6 with no overlap, so a wide threshold band yields perfect abstention decisions. The generator attains micro field-level F<sub>1</sub> = 0.867 with a systematic failure isolated to the OPC UA schema, a defect that component-wise evaluation localizes to the generator and its validation shape rather than retrieval, and that read-back verification catches in every run. Across 15 end-to-end runs on an H100 GPU (a deliberately small benchmark, whose success rates we therefore report with 95% Wilson confidence intervals), documented devices are commissioned in 2.6 to 6.6 seconds with no unsafe writes (0/15; upper 95% bound 0.20) and every failing run terminating in an explicit, machine-readable failure signal (7/7 detected). Modbus and OPC UA are exercised over live network I/O with read-back, whereas Profibus DP and CANopen are validated structurally without bus I/O; all generation uses a single local open-weights model (llama3.1:8b); holding retrieval and validation fixed and swapping only the generator, four open on-premises models all attain field-level F<sub>1</sub> between 0.83 and 0.97, indicating the accuracy is a property of the pipeline rather than of one model. A case study then applies the pipeline to a Universal Robots UR5e collaborative robot, with the vendor’s published manuals as the only corpus and a physics-simulated UR5e behind the vendor’s documented Modbus register map as a live deployment target: all three commissioning runs deploy the correct four-register configuration with field-level F<sub>1</sub> = 1.0 and pass sentinel, read-back, physical-consistency, and liveness checks, while retrieval quality drops sharply on the vendor’s table-heavy documents and the benchmark-calibrated abstention threshold does not transfer, requiring recalibration from the measured score separation of the new corpus. We argue that this defense-in-depth safety profile, correct behavior of the whole despite an imperfect generator, is the property industrial adoption actually requires, and we characterize its cost, latency, and limits. © 2014 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Bashir2026104,
	author = {Bashir, Albashir and Qureshi, Ayesha Wasim and Malek, Mohd Fareq Abd},
	title = {Mixed-Criticality, Carbon-Aware Task Scheduling for Smart-Grid Edge-Cloud Computing: A Simulation-Based Heuristic},
	year = {2026},
	journal = {Proceedings - 2nd International Conference on Modern Sustainable Systems, CMSS 2026},
	pages = {104 - 109},
	doi = {10.1109/CMSS69636.2026.11689409},
	url = {https://www.scopus.com/pages/publications/105052052356?origin=resultslist},
	abstract = {Smart-grid edge-cloud networks host computational workloads of sharply different operational criticality, from millisecond-sensitive protection and control functions to delay-tolerant analytics and forecasting. Existing scheduling approaches address this heterogeneity only partially: dual-priority service differentiation protects delay-critical tasks but ignores energy cost, while carbon and price aware temporal deferral improves sustainability but ignores task criticality. This paper proposes a lightweight scheduling heuristic that unifies both principles, guaranteeing critical tasks unconditional first claim on compute capacity while deferring flexible tasks toward loweremission, lower-cost execution windows using a fast range-minimum lookahead over short-term carbon and price forecasts. The heuristic is evaluated through a discrete-event simulation driven by real UK National Grid ESO regional carbon-intensity data across eight independently selected weekdays in 2023, with a workload arrival rate calibrated from the Alibaba 2018 Cluster Trace, benchmarked against four baselines, and validated through an ablation study, a weight-sensitivity analysis, and a forecast-uncertainty experiment using the real FPN-BOA discrepancy distribution. The proposed heuristic eliminates critical-task deadline violations, reducing C O2 emissions by 22.9% and energy cost by 7.1% relative to an unaware baseline, all differences statistically significant at p<1 0-5 under paired t-tests. A carbon-aware earliest-deadline-first baseline achieves a larger raw reduction (48.8%) with zero violations, so the proposed method's principal contribution is a structural reliability guarantee that holds by construction, independent of arrival-pattern coincidence. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

