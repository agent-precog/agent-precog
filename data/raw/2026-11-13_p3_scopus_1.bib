@ARTICLE{Nguyen2027420,
	author = {Nguyen, Van-Hau},
	title = {Selective Intrusion Detection via Cost-Sensitive Three-Way Decision and Variational Autoencoders},
	year = {2027},
	journal = {Lecture Notes in Computer Science},
	volume = {16918 LNCS},
	pages = {420 - 432},
	doi = {10.1007/978-981-92-5641-9_33},
	url = {https://www.scopus.com/pages/publications/105055479353?origin=resultslist},
	abstract = {Unsupervised network intrusion detection systems face a fundamental trade-off between coverage and reliability, particularly on modern datasets with significant distribution shift between training and deployment. Conventional one-class classifiers are forced to assign every input to either normal or attack, even when evidence is ambiguous, leading to costly false positives and missed intrusions. We propose a cost-sensitive three-way decision framework that integrates Variational Autoencoder (VAE) based anomaly scoring with Yao’s decision-theoretic rough set formulation, enabling the system to accept a sample as normal, flag it as an attack, or abstain on ambiguous inputs. We introduce a rank-calibrated anomaly score, derived from the empirical distribution of training-normal reconstruction errors, which serves as a practical substitute for conditional probability under the unsupervised one-class setting where genuine probability calibration is intractable. Classification is formulated as expected-cost minimization parameterized by the costs of false positives, false negatives, and abstention, yielding a tunable operating-point selection mechanism. Experiments on NSL-KDD and UNSW-NB15 benchmarks show that our approach achieves F1 scores of 0.862 and 0.789 at modest abstention rates of 12.6% and 15.2%, outperforming the strongest baseline by 6.1 and 5.5 F1 points on NSL-KDD and UNSW-NB15 respectively. A Pareto analysis further demonstrates that the framework provides a flexible coverage-reliability trade-off suitable for diverse security operational contexts. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2027.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Alazba2026167424,
	author = {Alazba, Amal and Sonbul, Marwa S. and Almujeiwil, Albandri and Aljurayban, Nouf Saleh and Almadhi, Amal and Alsalhi, Reem and Alameer, Abdulmajeed},
	title = {Detecting Privacy and Accessibility Violations in Cookie Consent Banners: A Compliance-Aware RAG Framework Evaluated on Saudi Government-Affiliated Websites},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {167424 - 167443},
	doi = {10.1109/ACCESS.2026.3746507},
	url = {https://www.scopus.com/pages/publications/105054698178?origin=resultslist},
	abstract = {Cookie consent banners are a primary mechanism for obtaining user consent to data collection, yet many employ dark patterns that undermine free and informed choice. Despite the Saudi Personal Data Protection Law (PDPL), the prevalence of such patterns across Saudi government-affiliated websites, and the effectiveness of automated methods to detect them, remains unexamined. This study presents the first systematic, regulation-based assessment of dark patterns in cookie consent interfaces on 320 Saudi government-affiliated websites, evaluated jointly against the PDPL and the Web Content Accessibility Guidelines (WCAG 2.1). Using an original, dual-annotated dataset (Cohen's Kappa, $κ = 0.786$ ) and a seven-class compliance-aware taxonomy, we find that 58.8% of websites do not have a consent interface at all, and that among websites that display a consent interface, 86.4% contain at least one dark pattern, most frequently implied consent, and absent or hidden reject options, collectively undermining free consent under PDPL Article 7. We further develop and compare four detection models within a single controlled framework: a rule-based baseline, two Retrieval-Augmented Generation (RAG) variants, and a voting ensemble. Both RAG models significantly outperform the rule-based baseline (McNemar's test, p < 0.001), with full-context Vectorless-RAG the strongest individual model (Macro-F1 = 0.523); the voting ensemble performs comparably but yields no significant improvement over it. The study contributes an original dataset, a pattern-to-regulation knowledge base, and a deployable compliance analyzer.  © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@CONFERENCE{Nguyen202632555,
	author = {Nguyen, Vy and Xu, Ziqi and Chan, Jeffrey and He, Estrid and Xia, Feng and Zhang, Xiuzhen},
	title = {Hallucinate Less by Thinking More: Aspect-Based Causal Abstention for Large Language Models},
	year = {2026},
	journal = {Proceedings of the AAAI Conference on Artificial Intelligence},
	volume = {40},
	number = {38},
	pages = {32555 - 32563},
	doi = {10.1609/aaai.v40i38.40532},
	url = {https://www.scopus.com/pages/publications/105034605421?origin=resultslist},
	abstract = {Large Language Models (LLMs) often produce fluent but factually incorrect responses, a phenomenon known as hallucination. Abstention, where the model chooses not to answer and instead outputs phrases such as I don’t know, is a common safeguard. However, existing abstention methods typically rely on post-generation signals, such as generation variations or feedback, which limits their ability to prevent unreliable responses in advance. In this paper, we introduce Aspect-Based Causal Abstention (ABCA), a new framework that enables early abstention by analysing the internal diversity of LLM knowledge through causal inference. This diversity reflects the multifaceted nature of parametric knowledge acquired from various sources, representing diverse aspects such as disciplines, legal contexts, or temporal frames. ABCA estimates causal effects conditioned on these aspects to assess the reliability of knowledge relevant to a given query. Based on these estimates, we enable two types of abstention: Type-1, where aspect effects are inconsistent (knowledge conflict), and Type-2, where aspect effects consistently support abstention (knowledge insufficiency). Experiments on standard benchmarks demonstrate that ABCA improves abstention reliability, achieves state-of-the-art performance, and enhances the interpretability of abstention decisions. © 2026, Association for the Advancement of Artificial Intelligence (www.aaai.org). All rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

@ARTICLE{Yi2026191,
	author = {Yi, Chufan and Qu, Hongyu and Xuan, Shiyu and Yan, Rui and Shu, Xiangbo and Zhao, Fang and Xie, Guo-Sen},
	title = {Test-Time Counterfactual Calibration for Hallucination-Resistant Temporal Grounding},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {17064 LNCS},
	pages = {191 - 209},
	doi = {10.1007/978-3-032-37196-6_11},
	url = {https://www.scopus.com/pages/publications/105054114820?origin=resultslist},
	abstract = {Existing video temporal grounding methods typically operate under a closed-world assumption, relying on the implicit premise that every natural language query must have a corresponding event somewhere in the video. This always-answer paradigm severely compresses the decision boundary during training, as models are seldom exposed to the alternative hypothesis that the queried event may be absent. Consequently, when users ask about specific events that cannot be matched in the video within an open-world environment, these models exhibit systematic temporal hallucinations. This may stem from incorrect attribution of textual, visual, or multimodal information, leading them to confidently generate plausible time frames for events that do not actually exist. To address this limitation, we propose HRVTG, a test-time adaptation framework that dynamically calibrates the decision boundary of the model during inference. Built upon a frozen grounding backbone, the proposed framework constructs three types of counterfactual hallucination probes in a self-supervised manner, targeting the aforementioned hallucinations. We dynamically reshape the decision boundary through abstention signals from counterfactual probes and consistency rewards from genuine queries. This is executed by introducing the GRPO algorithm, effectively reformulating the task into an online policy optimization problem in reinforcement learning. Furthermore, we introduce decoupled metrics to independently evaluate hallucination resistance and real-event grounding. Experiments indicate that our method suppresses hallucinated responses to fabricated queries. It achieves accurate selective prediction while maintaining strong grounding performance on real events. The code will be released at https://github.com/CVL-hub/HRVTG. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Yao2027115,
	author = {Yao, Kang and Tian, Congcong and Ren, Zhijie and Cheng, Quanbo and Cui, Jinjiang and Fu, Weiwei},
	title = {Dempster–Shafer Evidence Calibration for Conflict-Aware Knowledge Graph Reasoning},
	year = {2027},
	journal = {Lecture Notes in Computer Science},
	volume = {17126 LNCS},
	pages = {115 - 132},
	doi = {10.1007/978-3-032-42015-2_6},
	url = {https://www.scopus.com/pages/publications/105055380806?origin=resultslist},
	abstract = {An edge assigned confidence 0.4 may reflect either scant evidence or substantial but conflicting evidence. A scalar confidence cannot distinguish these cases: the former calls for more evidence, whereas the latter calls for resolving genuine disagreement. We present EviDS-KG, a framework that retains the Dempster–Shafer (DS) state of every edge (support, opposition, ignorance, and the conflict coefficient K) and uses this shared state in three modules. DS calibration maps scores to probabilities with conflict-stratified isotonic maps and extensions that read the full state. A DS message gate reweights messages in a graph neural backbone, while a DS path adapter adds a residual that suppresses opposing or conflict-annotated edges. We prove that conflict routing never increases calibration risk and improves it strictly when the optimal calibration map varies with conflict. We also give a distribution-free guarantee for K-based abstention. Using adjudication labels from a language model that is not given the DS state, the calibrators outperform ten recent baselines on a psychiatric graph, NL27k, and CN15k. Under noise, the gated CompGCN raises ranking MRR from 0.727 to 0.814 on the psychiatric graph and from 0.434 to 0.631 on FB15k-237. DS-Conf also attains the lowest confidence-prediction MSE reported under the standard protocol on CN15k and NL27k. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2027.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Watanabe2026681,
