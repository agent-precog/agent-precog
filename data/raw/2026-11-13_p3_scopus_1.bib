	doi = {10.1109/ICSC67292.2026.00056},
	url = {https://www.scopus.com/pages/publications/105037833264?origin=resultslist},
	abstract = {Due to the nature of their architecture, Large Language Models (LLMs) typically produce responses even when no coherent answer exists. In this paper, we introduce a principled, geometric mechanism that enables LLMs to abstain in such circumstances. Our approach is grounded in the notion of a Continuous State Machine (CSM), which is a glass-box model of LLM inference dynamics. In particular, a CSM can be instantiated from an ontology so that the geometry of its latent semantic space reflects that ontology. This means, among other things, that input probes trace trajectories through semantic space until either converging to a concept attractor (in-domain) or remaining isolated in null space (out-of-domain), enabling the system to distinguish realizable from non-realizable input. © 2026 IEEE.},
