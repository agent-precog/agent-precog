@CONFERENCE{Cocchieri202629573,
	author = {Cocchieri, Alessio and Ragazzi, Luca and Tagliavini, Giuseppe and Moro, Gianluca},
	title = {LLMs (Almost) Never Abstain Under Medical Uncertainty},
	year = {2026},
