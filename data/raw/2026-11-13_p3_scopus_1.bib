@ARTICLE{Adilbekov20261405,
	author = {Adilbekov, Alibek and de Jesus, Luigi Carlo and Lucena, Joe Robert Paul and Baigulbayeva, Moldir and Alnazirov, Ruslan and Moldakhmetov, Sayat},
	title = {HIRA-DGA: Hierarchical Invariant Representations and Abstention for Cross-Source Power Transformer Fault Diagnosis},
	year = {2026},
	journal = {Journal of Intelligent Decision Making and Information Science},
	volume = {3},
