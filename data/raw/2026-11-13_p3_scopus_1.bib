	doi = {10.1007/978-3-032-29558-3_12},
	url = {https://www.scopus.com/pages/publications/105047545204?origin=resultslist},
	abstract = {Surveillance anomaly detection under weak supervision must deliver interpretable, frame-level detection (AUROC, AP, F1) at edge-feasible cost, yet prior work fragments into three gaps: reconstruction gates are fast but semantically shallow, object detectors lack open-vocabulary reasoning, and vision-language models (VLMs) are expressive but orders of magnitude slower than millisecond gates. VLM-centric detectors, moreover, rarely pair broker-mediated multi-agent operation with reconstruction-first escalation and stabilized textual semantics. We present a three-stage, early-exit cascade with event-driven and cyclical agents over a publish–subscribe backbone, invoking a VLM only after autoencoder and YOLO stages and mapping free text to categories with abstention. On UCF-Crime, the full cascade reaches 74.47% frame-level AUC with 91.67% AP and 81.04% F1 while exiting 72.1% of frames before the VLM; ShanghaiTech and XD-Violence show analogous trends with early-exit rates above 65%. Measured Stage I latency is ∼6.32 ms/frame versus ∼2340 ms per VLM event (∼370×), and multi-stream tests sustain over 90 FPS at 16 concurrent streams on our testbed. Autoencoder PSNR/SSIM during training characterize gate fidelity, not detection scores. Together, detection metrics, selective VLM use, and throughput evidence address limitations of both static cascades and undifferentiated multi-agent LLM tooling for surveillance. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Zhenissov2026,
