@ARTICLE{Sajno2025282,
	author = {Sajno, Elena and Beretta, Andrea and DE GASPARI, Stefano and Giannotti, Fosca and Pedreschi, Dino and Pellungrini, Roberto and Pugnana, Andrea and Pupillo, Chiara and Repetto, Claudia and Sansoni, Maria and Villani, Daniela and Riva, Giuseppe},
