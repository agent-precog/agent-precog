@ARTICLE{Dang2026,
	author = {Dang, Jr-Fong and Wang, Li-Na and Chen, Tzu-Li},
	title = {Intelligent defect‑detection framework integrating a modified YOLO algorithm, a domain knowledge graph, and RAG‑enabled large language model},
	year = {2026},
