@ARTICLE{Sunil Kumar2026379,
	author = {Sunil Kumar, P. and Reddi, Seethi Venkata Sai Gowtham and Sai Chaitanya, P.},
	title = {DRIFTBENCH: Long-Horizon Memory Benchmark For AI Agents},
	year = {2026},
