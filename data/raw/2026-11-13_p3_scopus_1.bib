@CONFERENCE{Marques20261091,
	author = {Marques, Francisco and Lourenco, Andre and Silva, Pedro and Mateus, Marcio and Fernandes, Daniel and Ferreira, Nuno and Soares, Salviano Pinto and Augusto, Diana and Teixeira, Tiago},
	title = {Curated Uncertainty Exchange: A Deployment Pattern for Trustworthy AI in Expertise-Curated Environments, Motivated by a Heritage-Viticulture Re-Analysis},
	year = {2026},
