	pages = {},
	doi = {10.1109/TSG.2026.3736696},
	url = {https://www.scopus.com/pages/publications/105051660713?origin=resultslist},
	abstract = {This paper develops a voltage-security-constrained demand-response framework for a four-port dc fast-charging station and compares four policies: proportional sharing (PQ), earliest-deadline-first (EDF), deadline-aware receding-horizon allocation (DC-RHC), and battery-augmented control (BA-RHC). The formulation embeds feasible electric-vehicle charging states, converter limits, exact battery charge/discharge exclusivity, sampled Volt-VAR support, and a marginal Gaussian voltage chance constraint within a decoupled three-phase LinDistFlow feeder. Session-energy and dwell-time distributions are calibrated to 12,945 field charging sessions. Under a nominal 100-kW, four-hour event, unconditional completion is 38.46%, 61.54%, and 78.85% for proportional sharing, DC-RHC, and BA-RHC, with the earliest-deadline-first benchmark at 75.00%. Across 500-realization Monte Carlo studies the certified ordering is DC-RHC (worst LCB 60.73%) < EDF (74.73%) < BA-RHC (76.81%), with all paired EDF>DC-RHC tests at p < 10<sup>−</sup><sup>200</sup> and BA-RHC>EDF at p < 10<sup>−</sup><sup>5</sup>; BA-RHC approaches but does not reach the prescribed 80% target at the busy-hub λ = 7 design point, with completion rising to 88.89% in a lower-utilization sensitivity run (λ = 3.3); a battery-size sweep shows completion saturating at the 1-MWh nominal capacity. An unbalanced OpenDSS replay of 720 snapshots (five policies) converges with zero low-voltage events, and online solve times stay below 24 ms. Economic screening gives a base event value of $238.84 against a 300-event/year recovery threshold when storage is valued as the same-scaffold gain over DC-RHC; valued against the stronger earliest-deadline-first baseline the increment is smaller and the recovery gap wider, so the modeled 24 events/year leave storage far short of recovery either way, with storage setting no incremental billing peak relative to the same-scaffold DC-RHC baseline. Reliability results are conditional on the assumed traffic model; under the field-calibrated dispatch the corrected joint-Gaussian voltage certificate holds up to a forecast-error scale of σw = 90 kW, with empirical zero-violation coverage across all tested levels. © 2026 Institute of Electrical and Electronics Engineers Inc.. All rights reserved.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

@ARTICLE{Vantaku2026,
	author = {Vantaku, Chiranjeevi and Avakian, Amy},
	title = {RADAR: A Prototype for Grounding Large Language Model Consult Support in an ACR-Structured Appropriateness Knowledge Base with Citation Validation and Abstention},
	year = {2026},
	journal = {Journal of Imaging Informatics in Medicine},
	pages = {},
	doi = {10.1007/s10278-026-02326-y},
	url = {https://www.scopus.com/pages/publications/105051506345?origin=resultslist},
	abstract = {Large language models (LLMs) answer medical questions fluently but fabricate statements and citations too often to be trusted unaided at the point of care. We describe RADAR (Radiology Appropriateness Decision and Advisory Resource), a prototype retrieval-augmented consult-support pipeline that grounds an LLM in a knowledge base structured like the American College of Radiology (ACR) Appropriateness Criteria at the level of individual clinical variants. The knowledge base is synthetic (twelve variants across five topics) because the official criteria are copyrighted. The design is deliberately conservative: a BM25 retriever, an absolute-score abstention gate, a structured-output generator bound by an in-prompt grounding contract, and a deterministic validator that strips any recommendation whose citation does not resolve to a retrieved chunk. We report a development set (eight scenarios, seven off-domain probes) used during parameter selection and a held-out set written after all parameters were frozen (36 scenarios, three per variant, and 24 clinically adjacent probes), evaluated in a deterministic retrieval-only mode and in the full pipeline over five independent runs at temperature 0. Retrieval alone ranked the correct variant first in 25 of 36 held-out scenarios (69.4%; 95% CI 51.9–83.7) but always placed it within the top five, and the score gate stopped only 3 of 22 clinically adjacent probes. The full pipeline (claude-sonnet-4–6, temperature 0, five runs) selected the correct variant and top procedure in every run for 33 of 36 scenarios (91.7%; 95% CI 77.5–98.2) and in 33 or 34 of 36 scenarios in each individual run; every failed run was a false abstention on a thunderclap-headache presentation, and no run of any scenario recommended a wrong variant. It refused 17 of 22 clinically adjacent probes (77.3%; 54.6–92.2). All 721 emitted citations resolved to a retrieved chunk. The findings characterize a proof of concept: lexical retrieval delivers topic routing and citation traceability, while variant selection and realistic abstention depend on the generator acting as a semantic reranker, and the residual failures are refusals rather than wrong answers. Clinical readiness will require licensed ACR content, a larger reference-standard set, and prospective evaluation. © The Author(s) 2026.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Johansson2026,
