@CONFERENCE{Farhad202638,
	author = {Farhad, Moomal and Masud, Mohammad and Abdul Rasheed, Ashika Sameem and Musthfa, Namya},
	title = {How Linguistic Variation Shapes Hallucination Risk in Large Language Models: A Psychometric Perspective},
	year = {2026},
	journal = {AISC 2026 - 2026 Australasian Information Security Conference},
	pages = {38 - 46},
	doi = {10.1145/3793638.3793643},
	url = {https://www.scopus.com/pages/publications/105036552650?origin=resultslist},
	abstract = {Large Language Models (LLMs) are increasingly used in clinical decision support, patient communication, and digital medical information services. However, hallucinations, which are confident yet incorrect medical statements, pose serious safety and security risks. These risks become even greater when they are triggered by variations in a user's linguistic style. This study systematically investigates how tone and grammatical quality shape hallucination behavior in medical LLMs using the medical subset of the publicly available TruthfulQA dataset. We generate 15 controlled prompt variants per question based on tone and grammar variations, and evaluate two models, DeepSeek-V3 and Med42-8B, using GPT-4.1-mini as an external judge to score correctness, hallucination, harmfulness, abstention, and overconfidence. Drawing inspiration from psychometric testing, each tone grammar prompt variant is treated as an item probing latent susceptibility traits, enabling us to quantify tone sensitivity, robustness to linguistic noise, and vulnerability to pressured prompting. Our results reveal strong tone-grammar interaction effects, showing that DeepSeek-V3 remains stable across all 15 conditions, while Med42-8B exhibits substantial variability. Neutral tone combined with mild grammatical noise yields the highest hallucination rates, while polite tone produces the lowest accuracy and increased abstention and overconfidence, exposing distinct vulnerability profiles. Mixed-effects psychometric modelling further shows that Med42-8B has significantly higher question-level difficulty variance (ICC 27.4% vs. 10.6%) and heightened sensitivity to both tone and linguistic noise. Together, these findings establish a psychometric framework for identifying linguistic conditions that increase hallucination risk, offering actionable insights for safer LLM deployment, robust prompt design, and the development of tone-aware safety mechanisms in medical AI systems. © 2026 Copyright held by the owner/author(s).},
