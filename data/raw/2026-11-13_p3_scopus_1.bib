	title = {Explainable Reliability-Gated EEG–EMG Fusion for Offline Early Gesture and Intention Recognition with Potential Relevance to Human–Robot Collaboration},
	year = {2026},
	journal = {International Journal of Computational Intelligence Systems},
	volume = {19},
