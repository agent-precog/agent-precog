}

@ARTICLE{Alrasheedy2026,
	author = {Alrasheedy, Mashary N. and Tiun, Sabrina and Fauzi, Fariza},
	title = {When Emotions Conflict: A Reliability-Aware Framework for Arabic Multi-Label Emotion Detection},
	year = {2026},
	journal = {Technologies},
