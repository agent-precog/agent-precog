	url = {https://www.scopus.com/pages/publications/105042368321?origin=resultslist},
	abstract = {Occult fractures of the scaphoid and distal radius remain difficult to detect on initial wrist radiographs, and false-negative interpretations can delay treatment, leading to nonunion, avascular necrosis, and long-term functional impairment. Existing deep learning systems for radiograph analysis are typically designed as closed binary classifiers that must output a definitive normal or abnormal label for every input, with no mechanism to express diagnostic uncertainty. This design assumption is misaligned with clinical practice, where ambiguous wrist radiographs routinely prompt immobilisation and referral for CT or MRI rather than a forced binary decision. This paper introduces an uncertainty-aware triage pipeline for wrist radiographs that replaces the forced binary output with a three-way policy: confident normal, confident abnormal, or deferred for advanced imaging. A ResNet-50 backbone fine-tuned on the wrist subset of MURA v1.1 is augmented with Monte Carlo (MC) dropout inference. Across T = 30 stochastic forward passes per study, the sample mean provides a calibrated abnormality score while the sample variance quantifies epistemic uncertainty. A data-driven uncertainty threshold γ routes high-variance studies directly to CT/MRI referral. At a 25% deferral rate, the system reduces missed fractures from 295 to 221 - a 25.1% reduction - while accuracy on auto-diagnosed cases remains essentially unchanged. These results show that uncertainty quantification is a practical and clinically meaningful mechanism for improving patient safety in AI-assisted fracture screening. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

