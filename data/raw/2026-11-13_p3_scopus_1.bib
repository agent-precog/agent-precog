@CONFERENCE{Liu20244816,
	author = {Liu, Shuqi and Cao, Yuzhou and Zhang, Qiaozhen and Feng, Lei and An, Bo},
	title = {Mitigating Underfitting in Learning to Defer with Consistent Losses},
	year = {2024},
	journal = {Proceedings of Machine Learning Research},
	volume = {238},
	pages = {4816 - 4824},
	url = {https://www.scopus.com/pages/publications/85194173566?origin=resultslist},
	abstract = {Learning to defer (L2D) allows the classifier to defer its prediction to an expert for safer predictions, by balancing the system’s accuracy and extra costs incurred by consulting the expert. Various loss functions have been proposed for L2D, but they were shown to cause the underfitting of trained classifiers when extra consulting costs exist, resulting in degraded performance. In this paper, we propose a novel loss formulation that can mitigate the underfitting issue while maintaining statistical consistency. We first show that our formulation can avoid a common characteristic shared by most existing losses, which has been shown to be a cause of underfitting, and show that it can be combined with the representative losses for L2D to enhance their performance and yield consistent losses. We further study the regret transfer bounds of the proposed losses and experimentally validate its improvements over existing methods. Copyright 2024 by the author(s).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 9}
}

@ARTICLE{Mahbub2025243,
	author = {Mahbub, Tahira and Parvin, Rehana and Ahmed, Tofayel and Ridoy, Rafayet Rahman},
	title = {Harnessing Explainable AI and Biomarker Insights for Robust Breast Cancer Detection},
	year = {2025},
	journal = {IEEE International WIE Conference on Electrical and Computer Engineering/WIECON-ECE},
	number = {2025},
	pages = {243 - 248},
	doi = {10.1109/WIECON-ECE69386.2025.11525910},
	url = {https://www.scopus.com/pages/publications/105042677699?origin=resultslist},
	abstract = {Breast cancer remains one of the most common causes of cancer death worldwide, emphasizing the need to spot it early and accurately. The paper aims to detect early of breast cancer by the predictive performance of 11 models including Support Vector Machine (SVM), Logistic Regression, Decision Tree, Random Forest(RF), AdaBoost, Gradient Boosting Machine (GBM), XGBoost, LightGBM, CatBoost, K-Nearest Neighbor and Multilayer Perceptron (MLP) on Coimbra breast cancer dataset (n = 116). Data preprocessing dealt with outliers by cross-module treatment and feature scaling. We next performed Boruta-based feature selection, finding that what was most relevant biomarkers but likely just under threshold levels included age, BMI, HOMA, Resistin and glucose. Model evaluation was completed using accuracy, precision, recall, F1score, ROC-AUC, calibration curves and Brier scores. GBM achieved the highest accuracy (96%) with well calibrated probability estimates, while KNN and other boosting methods also performed well. A selective prediction framework with confidence threshold (τ) was implemented to improve clinical practicality, allowing for 10% automation of case classification and expert review for the remaining 90% with uncertain forecasts. Explainability was dealt with using SHAP, PDP, and ICE analysis, with glucose and Resistin emerging as the major influencing biomarkers all along, consistent with established medical knowledge. The results indicate that the combination of ensemble learning, selective prediction, and interpretability techniques offers a robust method for biomarker-based breast cancer detection which is readily applicable in clinical practice.  © 2025 IEEE.},
