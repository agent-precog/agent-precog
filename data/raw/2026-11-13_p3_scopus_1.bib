	abstract = {The adoption of machine learning for diabetes prediction often produces unequal outcomes across demographic groups because most models are trained on imbalanced datasets and evaluated without fairness metrics. This issue reduces clinical reliability because predictions tend to favour majority groups when sensitive attributes are not assessed for bias. The absence of integrated fairness mitigation limits the ability of healthcare models to deliver equitable decisions. This paper introduces a hybrid fairness-aware framework called FAIR-Diabetes, which integrates data-level and algorithm-level mitigation within a unified workflow. The framework combines Adaptive Synthetic Sampling and Reject Option Classification to improve consistency across demographic groups. The Pima Indians Diabetes Dataset was used for evaluation. Median-based imputation addressed missing values, Z-score standardisation supported feature scaling, and Adaptive Synthetic Sampling (ADASYN) corrected class imbalance. Logistic Regression served as the baseline model to isolate the effects of fairness mitigation. The model provides interpretable coefficients and stable probability scores required for Reject Option Classification. This choice controls model complexity and ensures observed fairness changes arise from ADASYN and decision-level adjustment rather than model architecture. The probability scores are required to define the low-confidence region for Reject Option Classification. Reject Option Classification then adjusted low-confidence predictions and reduced disparities across AgeGroup subgroups. Model evaluation incorporated performance metrics and fairness metrics. The results show improved recall and a substantial reduction in recall disparity between AgeGroup subgroups, while overall accuracy decreased slightly but remained stable. These improvements indicate reduced prediction disparities across AgeGroup subgroups. The findings demonstrate that integrating fairness mitigation at multiple stages supports transparent and ethically reliable diabetes prediction.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Aziz2026680,
	author = {Aziz, Moh Abdullah and Widowati and Sutrisno},
	title = {Voter Behavior Analysis via a Compartment-Based Optimal Control Approach: A Case Study in the 2024 Central Java Regional Election},
	year = {2026},
	journal = {Proceeding - ISIBER 2026: International Seminar on Intelligent Business and Edge-Computing Research},
	pages = {680 - 685},
	doi = {10.1109/ISIBER68248.2026.11470184},
	url = {https://www.scopus.com/pages/publications/105037609238?origin=resultslist},
	abstract = {Low voter participation remains a persistent challenge in regional elections in Indonesia, undermining the effectiveness of direct democratic processes. This study introduces a novel discrete-time, multi-region compartment-based modeling framework to analyze voter participation dynamics and abstention behavior during a regional election. The proposed model integrates dynamical systems analysis with optimal control theory to systematically evaluate policy interventions aimed at enhancing voter engagement. Local stability properties of the system are investigated, enabling a precise characterization of long-term participation patterns around equilibrium states. In addition, Pontryagin's Maximum Principle is employed to derive optimal intervention strategies that balance effectiveness and implementation costs. The analysis identifies two meaningful equilibrium regimes, full participation and partial abstention, and establishes sufficient conditions for their stability. Three policy-relevant control variables are incorporated: public awareness initiatives, innovative candidate communication strategies, and improvements in voter accessibility. Numerical simulations were performed using data from the 2024 Central Java Regional Election. Results illustrate how these interventions interact dynamically across regions and demonstrate their effectiveness in reducing abstention rates, increasing voter registration, and strengthening electoral support. This work provides a quantitative decision-support framework for designing evidence-based strategies to improve voter participation in regional elections. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Gummadavelli20261611,
	author = {Gummadavelli, Vinay and Imtiaz, Usman and Prabagaran, A. and Kolla, Siva Hemanth and Bavirisetty, Naga Srinivas and Kondapalli, Saanvika Reddy},
	title = {Discovering and Repairing Blind Spots in LLM-as-a-Judge Evaluation of Multi-Turn AI Systems},
	year = {2026},
	journal = {International Conference on Intelligent and Sustainable AI Systems, ICOSAAS 2026 - Conference Proceedings},
	pages = {1611 - 1618},
	doi = {10.1109/ICOSAAS68663.2026.11648543},
	url = {https://www.scopus.com/pages/publications/105048465338?origin=resultslist},
	abstract = {The widespread use of Large Language Models (LLMs) as automated evaluators for multi-turn conversational AI systems is due to their scalability and adaptability. Nonetheless, LLM-as-a-judge systems often have systemic blind spots, leading to the neglect of certain flaws because to insufficient, inflexible, or biased assessment standards. This project investigates if disparities between human annotations and LLM evaluations might function as a diagnostic instrument to identify missing evaluation criteria and improve rubric design. By developing a rubric, we provide a systematic framework that may identify indications of disagreement, categorize them to uncover concealed defect patterns, and initiate new aspects of evaluation. The proposed improvements to the rubric are assessed using previously inspected datasets to verify its universality and reliability. We provide a confidence-aware abstention mechanism that detects doubtful predictions and refers them to human assessors to enhance safety and dependability. Experimental results demonstrate that the proposed technique improves defect memory, optimizes the calibration of confidence and accuracy in defect prediction, decreases false alarms, and lowers total annotation costs. Our findings suggest that human disagreement should be regarded not just as noise, but as a crucial signal that might enhance LLM-based assessment systems over time. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Kong2027315,
	author = {Kong, Kaige and Zhou, Zili},
	title = {CARE-KGQA: Refusal-Aware Answerability Recovery for Knowledge Graph Question Answering},
	year = {2027},
	journal = {Lecture Notes in Computer Science},
	volume = {16994 LNCS},
	pages = {315 - 329},
	doi = {10.1007/978-981-92-5696-9_20},
	url = {https://www.scopus.com/pages/publications/105054089674?origin=resultslist},
	abstract = {Retrieval-centric KGQA systems supply LLMs with compact graph evidence, but retrieval sufficiency does not necessarily imply answer realization: even when the retrieved graph partially anchors the target entity or relation chain, the answer stage may still abstain under incomplete evidence, alias mismatch, or a missing final attribute hop. We study this post-retrieval failure mode as answerability recovery: recovering graph-anchored answerable cases without converting abstentions into unsupported guesses. We propose CARE-KGQA, a refusal-aware answer-stage policy under a fixed Graph-COM/SubgraphRAG-style retrieval backbone. CARE-KGQA combines graph-aware prompting, refusal-like output detection, triggered Direct-Completion fallback, and answer-format normalization into a unified selective-recovery procedure that decides per query whether to keep the initial answer path, route a recoverable failure to a second-pass completion, or return an evaluator-compatible answer set. This fixed-backbone design isolates answer-stage behavior and shifts the evaluation question from “how often does the system answer?” to “how well does it balance recovery against wrong drift?” We evaluate CARE-KGQA using an aligned Macro-F1/Hit comparison and a stricter within-backbone view that separately tracks accuracy, abstention, and wrong drift. Under the strict evaluator, CARE-KGQA improves Hit@1 on CWQ from 57.35 to 63.98 with GPT-4o-mini and from 53.24 to 63.55 with qwen-plus, while trading a moderate Wrong increase for substantially reduced abstention and higher accuracy. Abstention-pool analysis further shows a stronger recovery–drift balance than aggressive low-abstention variants: on qwen-plus/CWQ, wrong transitions per strict recovery drop from 23.5–32.3 to about 3.9. These results suggest that KGQA answer stages should be evaluated not by abstention minimization alone, but by recovery–drift balance with explicit wrong-drift control. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2027.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Rehman2026193,
	author = {Rehman, Tayyab and De Gasperis, Giovanni and Shmahell, Aly},
	title = {Multi-agent Coordination for Latency Constrained Vision Language Anomaly Detection in Surveillance Systems},
