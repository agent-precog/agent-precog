@CONFERENCE{Susilowati2026,
	author = {Susilowati, Diah Ayu and Nugroho, Yusuf Sulistyo and Wahyuni, Cahyaningtyas Sekar},
	title = {Multi-label Text Classification for Programming Language Tags Prediction on Stack Overflow Using SVM and T5},
	year = {2026},
	journal = {SIML 2026 - International Conference on Smart Computing, Internet of Things, and Machine Learning},
	pages = {},
	doi = {10.1109/SIML69834.2026.11621615},
	url = {https://www.scopus.com/pages/publications/105047173429?origin=resultslist},
	abstract = {Stack Overflow (SO) is a technical discussion platform focused on programming and technology. Each question is labeled with tags to facilitate categorization. However, tagging is performed manually by users, and a single question may contain multiple labels, making it a multi-label classification problem. This study aims to develop and compare two models for automatic programming language tag classification on SO questions: a Support Vector Machine (SVM) model using TF-IDF features and a deep learning-based Text-to-Text Transfer Transformer (T5) model. Model performance was evaluated using Precision, Recall, F1-Score (micro and macro average), Hamming Loss, and Subset Accuracy. The results show that the SVM model achieved a Micro F1-Score of 0.720 and a Macro F1-Score of 0.711, with a Micro Recall of 0.909 and a Subset Accuracy of 0.414. Meanwhile, the T5 model obtained a Micro F1-Score of 0.552 and a Macro F1-Score of 0.082, with a lower Hamming Loss of 0.000. These results indicate that SVM demonstrates more stable and balanced performance, particularly in handling frequently occurring labels, while T5 shows more selective predictions with lower per-label error but reduced performance on less frequent tags. Overall, automatic multi-label classification methods can effectively support tag recommendation and improve label grouping accuracy on platforms such as SO, while highlighting the trade-offs between conventional machine learning and transformer-based approaches. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
