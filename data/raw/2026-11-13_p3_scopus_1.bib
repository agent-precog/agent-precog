@ARTICLE{Far2026814,
	author = {Far, Parimehr Morassa and Beheshti, Amin and Taeb, Kamyar and Shammasi, Alireza and Shahsavandi, Ali and Newton, M. A. Hakim},
	title = {PRISM: A Calibrated Multi-Signal Trust Framework for KG-Based Selective Prediction in API Service Ecosystems},
	year = {2026},
