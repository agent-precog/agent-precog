@ARTICLE{Jung2026154150,
	author = {Jung, Woo Jin and Kang, Ah Reum},
	title = {A Feasibility Study of Treatment-Anchored Silver Labeling for Phenotyping Using VitalDB and Interpretable Machine Learning},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {154150 - 154167},
	doi = {10.1109/ACCESS.2026.3738129},
	url = {https://www.scopus.com/pages/publications/105052514776?origin=resultslist},
	abstract = {This study evaluates the exploratory feasibility of treatment-anchored silver labeling for perioperative phenotyping using VitalDB. Cases were processed sequentially in historical VitalDB query order until 300 assignments were obtained from 2113 successfully loaded and evaluable cases; 1813 were left unassigned (85.8%), and the surgical-stimulation-like Class 3 contained four cases. In the four-class-inclusive analysis, gradient boosting using all 109 features achieved mean macro-F1 of 0.884, whereas the same-label 36-feature leakage-restricted model achieved 0.334 (balanced accuracy 0.335) and Class 3 F1 was 0. The post hoc Class-3-excluded sensitivity yielded leakage-restricted macro-F1 of 0.430. Both strict results exceeded their corresponding empirical permutation-null expectations (p=0.0050 and p=0.0010), indicating limited above-null discrimination. Nested training-only tuning changed strict gradient-boosting macro-F1 by -0.005 and + 0.016 in the four-class and Class-3-excluded analyses, respectively, without altering this interpretation. Assigned cases differed from abstained cases, and stricter construct-preserving abstention did not materially improve leakage-restricted macro-F1. In exploratory downstream analyses, postoperative and intensive care unit (ICU) length of stay differed across classes after Holm correction, whereas mortality and the acute-kidney-injury proxy did not; four-class adjusted models were not estimable because Class 3 had four cases. PhysioNet/Computers in Cardiology 2009 supported only mean arterial pressure (MAP) event component portability (MAP < 65 mmHg sensitivity 1.000, specificity 0.935), and the University of Queensland analysis did not meet the frozen temporal-resolution support gate. These findings characterize rule recoverability, limited residual structure, and the evidence boundaries of treatment-anchored silver labeling; clinician-referenced and construct-complete external validation remain necessary for stronger phenotype-level claims.  © 2013 IEEE.},
